write_temporary_contents() {
    local temporary_path=$1
    local contents=$2

    temporary_file_is_safe "$temporary_path" || return 1
    temporary_file_is_safe "$temporary_path" || return 1
    temporary_file_is_safe "$temporary_path" || return 1
    require_runtime_temporary_file "$temporary_path" || return 1
    (
        umask 077
        printf '%s\n' "$contents" > "$temporary_path"
    ) || return 1
    durable_sync_file "$temporary_path"
}

install_temporary_file() {
    local temporary_path=$1
    local destination=$2
    local destination_parent=${destination%/*}
    local temporary_identity
    local destination_parent_identity
    local destination_identity

    [ "$destination_parent" != "$destination" ] || destination_parent=.

    temporary_identity=$(temporary_file_identity "$temporary_path") || return 1
    temporary_file_is_safe "$temporary_path" || return 1
    temporary_file_identity_matches "$temporary_path" "$temporary_identity" || return 1
    destination_parent_identity=$(atomic_destination_parent_identity "$destination_parent") || return 1
    atomic_destination_is_safe "$destination" || return 1
    destination_identity=$(atomic_destination_identity "$destination") || return 1
    atomic_destination_parent_identity_matches "$destination_parent" "$destination_parent_identity" || return 1
    atomic_destination_identity_matches "$destination" "$destination_identity" || return 1
    if [ "$platform_kind" = windows ]; then
        local helper_windows
        local source_windows
        local destination_windows
        local parent_windows

        [ -f "$durable_move_helper" ] && [ ! -L "$durable_move_helper" ] || return 1
        source_windows=$(cygpath -aw -- "$temporary_path") || return 1
        destination_windows=$(cygpath -aw -- "$destination") || return 1
        parent_windows=$(cygpath -aw -- "$destination_parent") || return 1
        helper_windows=$(cygpath -aw -- "$durable_move_helper") || return 1
        temporary_file_identity_matches "$temporary_path" "$temporary_identity" || return 1
        atomic_destination_parent_identity_matches "$destination_parent" "$destination_parent_identity" || return 1
        atomic_destination_is_safe "$destination" || return 1
        atomic_destination_identity_matches "$destination" "$destination_identity" || return 1
        if ! powershell.exe \
            -NoProfile \
            -NonInteractive \
            -ExecutionPolicy Bypass \
            -File "$helper_windows" \
            -SourcePath "$source_windows" \
            -DestinationPath "$destination_windows" \
            -DestinationDirectory "$parent_windows" \
            >/dev/null 2>&1; then
            return 1
        fi
    else
        if ! mv -f -- "$temporary_path" "$destination"; then
            return 1
        fi
        durable_sync_directory "$destination_parent" || return 1
    fi
    if [ -e "$temporary_path" ] || [ -L "$temporary_path" ] ||
        [ ! -f "$destination" ] || [ -L "$destination" ] ||
        ! atomic_destination_is_safe "$destination"; then
        return 1
    fi
}

runtime_temporary_path_is_safe() {
    local temporary_path=$1
    local temporary_parent=${temporary_path%/*}

    [ -n "$temporary_path" ] || return 1
    path_chain_is_safe "$temporary_path" || return 1
    [ "$temporary_parent" != "$temporary_path" ] || temporary_parent=.
    [ ! -L "$temporary_path" ] || return 1
    [ -d "$temporary_parent" ] || return 1
    [ ! -L "$temporary_parent" ] || return 1
    if [ -e "$temporary_path" ] && [ ! -f "$temporary_path" ]; then
        return 1
    fi
}

require_runtime_temporary_file() {
    local temporary_path=$1

    runtime_temporary_path_is_safe "$temporary_path" && [ -f "$temporary_path" ] ||
        fail "unsafe AgentQ runtime temporary file: $temporary_path"
}

remove_runtime_temporary_file() {
    local temporary_path=$1
    local description=${2:-runtime temporary file}

    if runtime_temporary_path_is_safe "$temporary_path"; then
        if ! rm -f -- "$temporary_path"; then
            printf '%s: failed to remove AgentQ %s: %s\n' "$program" "$description" "$temporary_path" >&2
            return 1
        fi
        if [ -e "$temporary_path" ] || [ -L "$temporary_path" ]; then
            printf '%s: AgentQ %s remained after cleanup: %s\n' "$program" "$description" "$temporary_path" >&2
            return 1
        fi
        return 0
    fi
    printf '%s: refusing to remove an unsafe AgentQ %s: %s\n' "$program" "$description" "$temporary_path" >&2
    return 2
}

cleanup_temporary_file_after_make_failure() {
    local temporary_path=$1

    if temporary_file_is_safe "$temporary_path"; then
        remove_runtime_temporary_file "$temporary_path" 'temporary file'
        return $?
    fi
    printf '%s: refusing to remove an unsafe AgentQ temporary file: %s\n' "$program" "$temporary_path" >&2
    return 2
}

make_temporary_file() {
    local directory=$1
    local prefix=$2
    local suffix=${3:-}
    local owner
    local temporary
    local temporary_identity
    local directory_identity
    local final_path

    [ -d "$directory" ] && [ ! -L "$directory" ] || return 1
    owner=$(temporary_owner_token) || return 1
    temporary=$(mktemp "$directory/${prefix}.${owner}.XXXXXX") || return 1
    if [ -n "$suffix" ]; then
        final_path="${temporary}${suffix}"
        temporary_identity=$(temporary_file_identity "$temporary") || {
            cleanup_temporary_file_after_make_failure "$temporary" || return 1
            return 1
        }
        directory_identity=$(atomic_destination_parent_identity "$directory") || {
            cleanup_temporary_file_after_make_failure "$temporary" || return 1
            return 1
        }
        if ! temporary_file_is_safe "$temporary" ||
            ! atomic_destination_parent_identity_matches "$directory" "$directory_identity" ||
            [ -e "$final_path" ] || [ -L "$final_path" ]; then
            cleanup_temporary_file_after_make_failure "$temporary" || return 1
            return 1
        fi
        temporary_file_identity_matches "$temporary" "$temporary_identity" || {
            return 1
        }
        atomic_destination_parent_identity_matches "$directory" "$directory_identity" || {
            return 1
        }
        if ! mv -f -- "$temporary" "$final_path"; then
            cleanup_temporary_file_after_make_failure "$temporary" || return 1
            return 1
        fi
        if ! temporary_file_is_safe "$final_path" ||
            [ -e "$temporary" ] || [ -L "$temporary" ]; then
            cleanup_temporary_file_after_make_failure "$final_path" || return 1
            return 1
        fi
    else
        final_path=$temporary
    fi
    if ! temporary_file_is_safe "$final_path"; then
        return 1
    fi
    printf '%s\n' "$final_path"
}

process_is_confirmed_dead() {
    local process_pid=$1
    local expected_identity=${2:-}
    local process_state
    local observed_identity

    process_state=$(process_identity_state "$process_pid") || return 1
    case "$process_state" in
        dead)
            return 0
            ;;
        alive:*)
            [ -n "$expected_identity" ] || return 1
            observed_identity=${process_state#alive:}
            [ "$observed_identity" != "$expected_identity" ]
            ;;
        *)
            return 1
            ;;
    esac
}

read_lock_metadata() {
    local lock_path=$1
    local LC_ALL=C
    local lock_contents=''
    local lock_sample=''
    local lock_read_status=0
    local lock_metadata_limit=4096
    local lock_directory
    local lock_parent_directory

    lock_pid=''
    lock_identity=''
    if declare -F lock_metadata_file_is_safe >/dev/null 2>&1; then
        lock_metadata_file_is_safe "$lock_path" || return 1
    else
        case "$lock_path" in
            */*)
                lock_directory=${lock_path%/*}
                [ -n "$lock_directory" ] || lock_directory=/
                ;;
            *)
                lock_directory=.
                ;;
        esac
        case "$lock_directory" in
            */*)
                lock_parent_directory=${lock_directory%/*}
                [ -n "$lock_parent_directory" ] || lock_parent_directory=/
                ;;
            *)
                lock_parent_directory=.
                ;;
        esac
        path_chain_is_safe "$lock_path" || return 1
        [ ! -L "$lock_parent_directory" ] || return 1
        [ ! -L "$lock_directory" ] || return 1
        [ ! -L "$lock_path" ] || return 1
        [ -f "$lock_path" ] || return 1
        [ -r "$lock_path" ] || return 1
    fi
    if declare -F lock_metadata_file_is_safe >/dev/null 2>&1; then
        lock_metadata_file_is_safe "$lock_path" || return 1
    else
        path_chain_is_safe "$lock_path" || return 1
        [ ! -L "$lock_parent_directory" ] || return 1
        [ ! -L "$lock_directory" ] || return 1
        [ ! -L "$lock_path" ] || return 1
        [ -f "$lock_path" ] || return 1
        [ -r "$lock_path" ] || return 1
    fi
    if lock_sample=$(
        head -c "$((lock_metadata_limit + 1))" -- "$lock_path" 2>/dev/null
        lock_read_status=$?
        printf '\001'
        exit "$lock_read_status"
    ); then
        case "$lock_sample" in
            *$'\001')
                lock_sample=${lock_sample%$'\001'}
                ;;
            *)
                return 1
                ;;
        esac
        [ "${#lock_sample}" -le "$lock_metadata_limit" ] || return 1
        lock_contents=$lock_sample
    elif [ -e "$lock_path" ] || [ -L "$lock_path" ]; then
        return 1
    else
        lock_contents=''
    fi
    IFS="$(printf '\t')" read -r lock_pid lock_identity <<EOF
$lock_contents
EOF
    lock_pid=${lock_pid%$'\r'}
    lock_identity=${lock_identity%$'\r'}
}

write_lock_metadata() {
    local lock_path=$1
    local lock_directory=''
    local lock_parent_directory=''
    local temporary_path=''

    path_chain_is_safe "$lock_path" || return 1
    if [ -z "$current_lock_pid" ] || [ -z "$current_lock_identity" ]; then
        set_current_process_lock_metadata || return 1
    fi

    case "$lock_path" in
        */*)
            lock_directory=${lock_path%/*}
            [ -n "$lock_directory" ] || lock_directory=/
            ;;
        *)
            lock_directory=.
            ;;
    esac
    case "$lock_directory" in
        */*)
            lock_parent_directory=${lock_directory%/*}
            [ -n "$lock_parent_directory" ] || lock_parent_directory=/
            ;;
        *)
            lock_parent_directory=.
            ;;
    esac
    [ ! -L "$lock_parent_directory" ] || return 1
    [ ! -L "$lock_directory" ] || return 1
    [ ! -L "$lock_path" ] || return 1
    [ -d "$lock_directory" ] || return 1
    temporary_path=$(make_temporary_file "$lock_directory" '.agentq-lock-metadata') || return 1
    if ! write_temporary_contents "$temporary_path" "$(printf '%s\t%s' "$current_lock_pid" "$current_lock_identity")" ||
        ! install_temporary_file "$temporary_path" "$lock_path"; then
        if ! remove_runtime_temporary_file "$temporary_path" 'lock metadata temporary file'; then
            printf '%s: failed to clean AgentQ lock metadata temporary file: %s\n' "$program" "$lock_path" >&2
            return 1
        fi
        return 1
    fi
}

lock_directory_is_stale_empty() {
    local lock_directory=$1
    local lock_mtime=''
    local current_epoch=''
    local child=''

    path_chain_is_safe "$lock_directory" || return 1
    [ ! -L "$lock_directory" ] || return 1
    [ -d "$lock_directory" ] || return 1
    [ ! -e "$lock_directory/pid" ] && [ ! -L "$lock_directory/pid" ] || return 1
    child=$(find "$lock_directory" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null) || return 1
    [ -z "$child" ] || return 1
    lock_mtime=$(stat_mtime "$lock_directory") || return 1
    current_epoch=$(date +%s) || return 1
    case "$lock_mtime" in
        ''|*[!0-9]*) return 1 ;;
    esac
    case "$current_epoch" in
        ''|*[!0-9]*) return 1 ;;
    esac
    [ "$current_epoch" -ge "$lock_mtime" ] || return 1
    [ $((current_epoch - lock_mtime)) -ge "$lock_empty_grace_seconds" ]
}

lock_is_owned_by_current_process() {
    local lock_path=$1

    read_lock_metadata "$lock_path" || return 1
    [ -n "$lock_identity" ] || return 1
    set_current_process_lock_metadata || return 1
    [ "$current_lock_pid" = "$lock_pid" ] && [ "$current_lock_identity" = "$lock_identity" ]
}

