atomic_destination_identity() {
    local destination=$1
    local destination_identity=''

    [ ! -L "$destination" ] || return 1
    if [ -e "$destination" ]; then
        [ -f "$destination" ] || return 1
        if destination_identity=$(stat_device_inode "$destination"); then
            :
        else
            return 1
        fi
        case "$destination_identity" in
            ''|*[!0-9:]*|*:*:*) return 1 ;;
        esac
        printf 'present:%s\n' "$destination_identity"
    else
        printf '%s\n' absent
    fi
}

atomic_destination_identity_matches() {
    local destination=$1
    local expected_identity=$2
    local observed_identity

    [ -n "$expected_identity" ] || return 1
    if [ "$expected_identity" = absent ]; then
        [ ! -e "$destination" ] && [ ! -L "$destination" ]
        return
    fi
    observed_identity=$(atomic_destination_identity "$destination") || return 1
    [ "$observed_identity" = "$expected_identity" ]
}

durable_sync_file() {
    local path=$1

    [ "$platform_kind" = unix ] || return 0
    [ -n "$path" ] || return 1
    temporary_file_is_safe "$path" || return 1
    temporary_file_is_safe "$path" || return 1
    AGENTQ_DURABLE_PATH=$path perl -MIO::Handle -MFcntl=:DEFAULT -e '
        my $path = $ENV{AGENTQ_DURABLE_PATH};
        my $ok = eval {
            sysopen(my $handle, $path, O_RDONLY) or die;
            $handle->sync() or die;
            close($handle) or die;
            1;
        };
        exit($ok ? 0 : 1);
    ' >/dev/null 2>&1
}

