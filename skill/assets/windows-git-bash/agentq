create_request_record() {
    local request_id=$1
    local payload=$2
    local task_label=$3
    local created_at
    local payload_file
    local payload_jq_file
    local command_status

    created_at=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
    payload_file=$(umask 077; make_temporary_file "$runtime_directory" '.agentq-payload') || return 1
    if ! require_runtime_temporary_file "$payload_file" ||
        ! require_runtime_temporary_file "$payload_file" ||
        ! require_runtime_temporary_file "$payload_file" ||
        ! printf '%s\n' "$payload" > "$payload_file" ||
        ! require_runtime_temporary_file "$payload_file"; then
        cleanup_request_payload_after_failure "$payload_file" || return 1
        return 1
    fi
    if ! payload_jq_file=$(jq_file_argument "$payload_file") ||
        ! require_runtime_temporary_file "$payload_file"; then
        cleanup_request_payload_after_failure "$payload_file" || return 1
        return 1
    fi
    require_runtime_temporary_file "$payload_file" || {
        cleanup_request_payload_after_failure "$payload_file" || return 1
        return 1
    }
    if jq -cn \
        --arg request_id "$request_id" \
        --slurpfile payload "$payload_jq_file" \
        --arg task_label "$task_label" \
        --arg created_at "$created_at" \
        '{
            version: 1,
            request_id: $request_id,
            payload: $payload[0],
            task_label: $task_label,
            state: "prepared",
            task_id: null,
            task_created_at: null,
            created_at: $created_at
        }'; then
        command_status=0
    else
        command_status=$?
    fi
    if ! remove_runtime_temporary_file "$payload_file"; then
        printf '%s: failed to remove the temporary request payload file\n' "$program" >&2
        [ "$command_status" -ne 0 ] || command_status=1
    fi
    return "$command_status"
}

set_request_state() {
    local record=$1
    local state=$2
    local task_id=${3:-null}
    local task_created_at=${4:-null}

    if [ "$task_id" != null ]; then
        validate_task_id_precision "$task_id"
    fi
    jq -ce \
        --arg state "$state" \
        --argjson task_id "$task_id" \
        --argjson task_created_at "$task_created_at" \
        '.state = $state | .task_id = $task_id | .task_created_at = $task_created_at' \
        <<<"$record"
}

make_request_tombstone() {
    local record=$1
    local removed_at=${2:-}

    if [ -z "$removed_at" ]; then
        removed_at=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
    fi

    jq -ce --arg removed_at "$removed_at" '
        if .state == "removed" then {
            version,
            request_id,
            task_id,
            task_created_at,
            state,
            removed_at: $removed_at
        }
        else error("cannot archive a non-removed AgentQ request")
        end
    ' <<<"$record"
}

request_tombstone_matches_record() {
    local tombstone=$1
    local record=$2
    local request_id
    local task_id
    local task_created_at

    request_id=$(jq -r '.request_id' <<<"$record")
    task_id=$(jq -r '.task_id' <<<"$record")
    task_created_at=$(jq -r '.task_created_at' <<<"$record")
    jq -e \
        --arg request_id "$request_id" \
        --arg task_id "$task_id" \
        --arg task_created_at "$task_created_at" '
        def canonical_integer_string:
            tostring
            | sub("^0+"; "")
            | if . == "" then "0" else . end;
        .request_id == $request_id
        and (.task_id | canonical_integer_string) == ($task_id | canonical_integer_string)
        and .task_created_at == $task_created_at
        and .state == "removed"
    ' <<<"$tombstone" >/dev/null
}

archive_removed_request() {
    local request_id=$1
    local record=$2
    local record_path
    local tombstone_path
    local tombstone
    local existing_tombstone

    [ "$(jq -r '.state' <<<"$record")" = removed ] || fail "cannot archive a non-removed AgentQ request: $request_id"
    record_path=$(request_record_path "$request_id")
    tombstone_path=$(request_tombstone_path "$request_id")
    tombstone=$(make_request_tombstone "$record")

    if [ -e "$tombstone_path" ]; then
        existing_tombstone=$(read_request_tombstone "$request_id") || fail "invalid AgentQ request tombstone: $tombstone_path"
        request_tombstone_matches_record "$existing_tombstone" "$record" || fail "AgentQ request tombstone conflicts with the active record: $request_id"
        tombstone=$existing_tombstone
    else
        write_request_tombstone "$request_id" "$tombstone" || return 1
    fi

    remove_runtime_temporary_file "$record_path" 'request record' || return 1
    remove_cancellation_marker_for_task \
        "$(jq -r '.task_id' <<<"$record")" \
        "$(jq -r '.task_created_at' <<<"$record")" || return 1
    printf '%s\n' "$tombstone"
}

write_runtime_marker() {
    local marker_path=$1
    local value=$2
    local marker_directory=${marker_path%/*}
    local marker_name=${marker_path##*/}
    local temporary

    temporary=$(umask 077; make_temporary_file "$marker_directory" ".${marker_name}" '.new') ||
        fail "cannot create temporary AgentQ runtime marker: $marker_path"

    if ! write_temporary_contents "$temporary" "$value" ||
        ! install_temporary_file "$temporary" "$marker_path"; then
        if ! remove_runtime_temporary_file "$temporary" 'runtime marker temporary file'; then
            fail "cannot write AgentQ runtime marker; temporary cleanup failed: $marker_path"
        fi
        fail "cannot write AgentQ runtime marker: $marker_path"
    fi
}

repair_removed_request_records() {
    local record_files=()
    local record_path
    local request_id
    local record
    local record_state
    local record_ids=()
    local output

    shopt -s nullglob
    record_files=("$request_directory"/*.json)
    shopt -u nullglob
    [ "${#record_files[@]}" -gt 0 ] || return 0

    # The request ids are collected here, in the parent shell: the body loop
    # below runs left of a pipe, so an array filled there would never arrive
    # (the $( )/pipeline trap this repo has recorded four times).  The
    # filename-shape check is kept here verbatim.
    for record_path in "${record_files[@]}"; do
        request_id=${record_path##*/}
        request_id=${request_id%.json}
        is_request_id "$request_id" || fail "invalid AgentQ request record filename: $record_path"
        record_ids+=("$request_id")
    done

    # Fast path: the guards AND the aggregate run inside ONE subshell whose
    # stderr is discarded.  Any guard failure, a length mismatch, a malformed
    # record, or a body that cannot be read makes it exit non-zero -- and then
    # the original per-file loop below runs verbatim and reproduces the exact
    # stderr and exit status (guard message + the caller's "missing ..." line,
    # or jq's own parse error plus both fail messages).  This is what makes the
    # fold byte-for-byte faithful: an aggregate jq cannot reproduce a per-file
    # jq's error text, so any failure falls back to the code that can.
    #
    # On a well-formed tree it emits one "id\nrecord" pair per removed record
    # (usually none), which is all repair ever acts on -- the other states are
    # validated but not otherwise consulted.
    if output=$(
        {
            for record_path in "${record_files[@]}"; do
                request_record_path_guards_or_fail "$record_path"
                printf '%s\n' "$(<"$record_path")"
            done | jq -rs --args "$request_removed_records_filter" -- "${record_ids[@]}"
        } 2>/dev/null
    ); then
        while IFS= read -r request_id; do
            [ -n "$request_id" ] || continue
            IFS= read -r record || fail "cannot archive removed AgentQ request during repair: $request_id"
            archive_removed_request "$request_id" "$record" >/dev/null ||
                fail "cannot archive removed AgentQ request during repair: $request_id"
        done <<<"$output"
        return 0
    fi

    # Fallback: the original loop, unchanged.  record_task_id is not read here
    # (repair only branches on the state), so it is not decoded.
    for record_path in "${record_files[@]}"; do
        request_id=${record_path##*/}
        request_id=${request_id%.json}
        is_request_id "$request_id" || fail "invalid AgentQ request record filename: $record_path"
        output=$(read_request_record_state_and_body "$request_id") ||
            fail "missing AgentQ request record during recovery: $record_path"
        record_state=${output%%$'\n'*}
        output=${output#*$'\n'}
        record=${output#*$'\n'}
        if [ "$record_state" = removed ]; then
            if ! archive_removed_request "$request_id" "$record" >/dev/null; then
                fail "cannot archive removed AgentQ request during repair: $request_id"
            fi
        fi
    done
}

migrate_removed_request_records() {
    local marker_value=''

    if [ -e "$request_layout_marker" ] || [ -L "$request_layout_marker" ]; then
        runtime_marker_file_is_safe "$request_layout_marker" || fail "invalid AgentQ request layout marker: $request_layout_marker"
        runtime_marker_file_is_safe "$request_layout_marker" || fail "invalid AgentQ request layout marker: $request_layout_marker"
        IFS= read -r marker_value < "$request_layout_marker" || marker_value=''
        [ "$marker_value" = v2 ] || fail "unsupported AgentQ request layout marker: $request_layout_marker"
    else
        write_runtime_marker "$request_layout_marker" v2
    fi

    # A tombstone and its active record cannot be switched atomically. Recheck
    # every layout load so a crash after writing the tombstone repairs itself.
    repair_removed_request_records
}

request_tombstones_need_pruning() {
    local current_epoch
    local marker_epoch=''

    if [ ! -e "$request_tombstone_prune_marker" ] && [ ! -L "$request_tombstone_prune_marker" ]; then
        return 0
    fi
    runtime_marker_file_is_safe "$request_tombstone_prune_marker" || fail "invalid AgentQ tombstone prune marker: $request_tombstone_prune_marker"
    runtime_marker_file_is_safe "$request_tombstone_prune_marker" || fail "invalid AgentQ tombstone prune marker: $request_tombstone_prune_marker"
    IFS= read -r marker_epoch < "$request_tombstone_prune_marker" || marker_epoch=''
    is_positive_integer "$marker_epoch" || return 0
    current_epoch=$(date +%s)
    is_positive_integer "$current_epoch" || fail 'cannot determine the current time for AgentQ tombstone pruning'
    [ "$current_epoch" -lt "$marker_epoch" ] && return 1
    [ $((current_epoch - marker_epoch)) -ge "$request_tombstone_prune_interval" ]
}

prune_request_tombstones() {
    local current_epoch

    request_tombstones_need_pruning || return 0
    path_chain_is_safe "$request_tombstone_directory" ||
        fail "invalid AgentQ request tombstone directory path: $request_tombstone_directory"
    find "$request_tombstone_directory" -type f -name '*.json' -mtime +"$request_tombstone_retention_days" -exec rm -f -- {} + || fail 'failed to prune expired AgentQ request tombstones'
    current_epoch=$(date +%s)
    is_positive_integer "$current_epoch" || fail 'cannot determine the current time for AgentQ tombstone pruning'
    write_runtime_marker "$request_tombstone_prune_marker" "$current_epoch"
}

ensure_request_record_layout() {
    prune_runtime_temporary_files
    prune_request_temporary_files
    prune_cancellation_temporary_files
    migrate_removed_request_records
    prune_request_tombstones
}

