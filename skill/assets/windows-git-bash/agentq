    path_chain_is_safe "$request_lock_directory" || fail "invalid AgentQ request lock directory path: $request_lock_directory"
    path_chain_is_safe "$request_tombstone_directory" || fail "invalid AgentQ request tombstone directory path: $request_tombstone_directory"
    [ ! -L "$request_directory" ] || fail "invalid AgentQ request directory path: $request_directory"
    [ ! -L "$request_lock_directory" ] || fail "invalid AgentQ request lock directory path: $request_lock_directory"
    [ ! -L "$request_tombstone_directory" ] || fail "invalid AgentQ request tombstone directory path: $request_tombstone_directory"
    [ -d "$request_directory" ] || fail "missing AgentQ request directory: $request_directory"
    [ -d "$request_lock_directory" ] || fail "missing AgentQ request lock directory: $request_lock_directory"
    [ -d "$request_tombstone_directory" ] || fail "missing AgentQ request tombstone directory: $request_tombstone_directory"

    if [ "$platform_kind" = unix ]; then
        chmod 700 "$request_directory" "$request_lock_directory" "$request_tombstone_directory" || fail "cannot secure AgentQ request directory: $request_directory"
    fi
}

ensure_runtime_directory() {
    path_chain_is_safe "$runtime_directory" || fail "invalid AgentQ runtime directory path: $runtime_directory"
    [ ! -L "$runtime_directory" ] || fail "invalid AgentQ runtime directory path: $runtime_directory"
    [ -d "$runtime_directory" ] || fail "missing AgentQ runtime directory: $runtime_directory"

    if [ "$platform_kind" = unix ]; then
        chmod 700 "$runtime_directory" || fail "cannot secure AgentQ runtime directory: $runtime_directory"
    fi
}

maintenance_lock_is_stale() {
    local lock_pid=''
    local lock_identity=''

    case "$platform_kind" in
        unix)
            [ -d "$maintenance_lock_directory" ] || return 1
            read_lock_metadata "$maintenance_lock_directory/pid" || return 1
            ;;
        windows)
            [ -f "$maintenance_lock_directory" ] && [ ! -L "$maintenance_lock_directory" ] || return 1
            read_lock_metadata "$maintenance_lock_directory" || return 1
            ;;
    esac

    process_is_confirmed_dead "$lock_pid" "$lock_identity"
}

recover_stale_maintenance_lock() {
    local lock_pid=''
    local lock_identity=''

    if ! path_chain_is_safe "$maintenance_lock_directory"; then
        printf '%s: refusing to recover an unsafe AgentQ maintenance lock: %s\n' "$program" "$maintenance_lock_directory" >&2
        return 2
    fi
    if maintenance_lock_is_stale; then
        # Re-confirm immediately before removing.  Between the staleness
        # decision above and the removal below another process may have
        # removed and recreated the lock with a LIVE holder; without the
        # re-read, the ms-wide window deletes that live lock and both holders
        # believe they own it (measured 2026-10-06 by widening the window with
        # a sleep; the installer's recover_stale_maintenance_lock has
        # re-confirmed since 2026-09-24 and smoke/11 pins it with a stateful
        # `ps` stub -- this server copy went straight to the removal).
        case "$platform_kind" in
            unix)
                maintenance_lock_pid_path="$maintenance_lock_directory/pid"
                if [ -e "$maintenance_lock_pid_path" ] || [ -L "$maintenance_lock_pid_path" ]; then
                    read_lock_metadata "$maintenance_lock_pid_path" ||
                        fail "cannot re-read the stale AgentQ maintenance lock metadata: $maintenance_lock_directory"
                    if ! process_is_confirmed_dead "$lock_pid" "$lock_identity"; then
                        printf '%s: the AgentQ maintenance lock holder could not be re-confirmed dead; refusing to remove it: %s\n' "$program" "$maintenance_lock_directory" >&2
                        return 2
                    fi
                fi
                if ! remove_runtime_temporary_file "$maintenance_lock_directory/pid" 'stale maintenance lock metadata'; then
                    fail "cannot recover stale AgentQ maintenance lock: $maintenance_lock_directory"
                fi
                rmdir -- "$maintenance_lock_directory" 2>/dev/null || fail "cannot recover stale AgentQ maintenance lock: $maintenance_lock_directory"
                ;;
            windows)
                if [ -e "$maintenance_lock_directory" ] && [ ! -L "$maintenance_lock_directory" ]; then
                    read_lock_metadata "$maintenance_lock_directory" ||
                        fail "cannot re-read the stale AgentQ maintenance lock metadata: $maintenance_lock_directory"
                    if ! process_is_confirmed_dead "$lock_pid" "$lock_identity"; then
                        printf '%s: the AgentQ maintenance lock holder could not be re-confirmed dead; refusing to remove it: %s\n' "$program" "$maintenance_lock_directory" >&2
                        return 2
                    fi
                fi
                if ! remove_runtime_temporary_file "$maintenance_lock_directory" 'stale maintenance lock'; then
                    fail "cannot recover stale AgentQ maintenance lock: $maintenance_lock_directory"
                fi
                [ ! -e "$maintenance_lock_directory" ] && [ ! -L "$maintenance_lock_directory" ] || fail "cannot recover stale AgentQ maintenance lock: $maintenance_lock_directory"
                ;;
        esac
    fi
}

ensure_not_in_maintenance() {
    if [ -L "$maintenance_lock_directory" ]; then
        fail "invalid AgentQ maintenance lock path: $maintenance_lock_directory"
    fi
    if [ -e "$maintenance_lock_directory" ]; then
        case "$platform_kind" in
            unix)
                [ -d "$maintenance_lock_directory" ] || fail "invalid AgentQ maintenance lock path: $maintenance_lock_directory"
                ;;
            windows)
                [ -f "$maintenance_lock_directory" ] || fail "invalid AgentQ maintenance lock path: $maintenance_lock_directory"
                ;;
        esac
        recover_stale_maintenance_lock
    fi
    if [ -e "$maintenance_lock_directory" ]; then
        fail "AgentQ maintenance is in progress; retry after the installer completes"
    fi
}

release_owned_lock() {
    local lock_path=$1
    local lock_kind=$2
    local pid_path
    local remove_status

    [ -n "$lock_path" ] || return 0
    if ! path_chain_is_safe "$lock_path"; then
        printf '%s: refusing to remove an unsafe AgentQ %s lock: %s\n' "$program" "$lock_kind" "$lock_path" >&2
        return 2
    fi
    if [ ! -e "$lock_path" ] && [ ! -L "$lock_path" ]; then
        return 0
    fi
    if [ ! -d "$lock_path" ] || [ -L "$lock_path" ]; then
        printf '%s: refusing to remove an unsafe AgentQ %s lock: %s\n' "$program" "$lock_kind" "$lock_path" >&2
        return 2
    fi
    pid_path="$lock_path/pid"
    if runtime_temporary_path_is_safe "$pid_path"; then
        :
    else
        printf '%s: refusing to remove an unsafe AgentQ lock metadata: %s\n' "$program" "$pid_path" >&2
        return 2
    fi
    if lock_is_owned_by_current_process "$pid_path"; then
        :
    else
        return 0
    fi
    if remove_runtime_temporary_file "$pid_path" 'lock metadata'; then
        :
    else
        remove_status=$?
        return "$remove_status"
    fi
    if ! rmdir -- "$lock_path"; then
        printf '%s: failed to remove AgentQ %s lock directory: %s\n' "$program" "$lock_kind" "$lock_path" >&2
        return 1
    fi
    if [ -e "$lock_path" ] || [ -L "$lock_path" ]; then
        printf '%s: AgentQ %s lock directory remained after cleanup: %s\n' "$program" "$lock_kind" "$lock_path" >&2
        return 1
    fi
    return 0
}

release_request_lock() {
    local lock_path=$request_lock
    local release_status

    if release_owned_lock "$lock_path" request; then
        request_lock=''
        return 0
    else
        release_status=$?
        return "$release_status"
    fi
}

release_operation_lock() {
    local lock_path=$operation_lock
    local release_status

    if release_owned_lock "$lock_path" operation; then
        operation_lock=''
        return 0
    else
        release_status=$?
        return "$release_status"
    fi
}

cleanup() {
    local cleanup_status=0

    if [ -n "$compact_log_raw_file" ]; then
        remove_runtime_temporary_file "$compact_log_raw_file" 'compact log raw log file' || cleanup_status=1
        compact_log_raw_file=''
    fi
    if [ -n "$reconcile_raw_status_file" ]; then
        remove_runtime_temporary_file "$reconcile_raw_status_file" 'reconciliation raw status file' || cleanup_status=1
        reconcile_raw_status_file=''
    fi
    if [ -n "$group_raw_file" ]; then
        remove_runtime_temporary_file "$group_raw_file" 'group raw response file' || cleanup_status=1
        group_raw_file=''
    fi
    release_request_metadata_files || cleanup_status=1
    release_operation_lock || cleanup_status=1
    release_request_lock || cleanup_status=1
    return "$cleanup_status"
}

trap cleanup EXIT

acquire_operation_lock() {
    local candidate="$operation_lock_directory"
    local candidate_parent
    local attempt=0
    local lock_pid=''
    local lock_identity=''

    case "$candidate" in
        */*)
            candidate_parent=${candidate%/*}
            [ -n "$candidate_parent" ] || candidate_parent=/
            ;;
        *)
            candidate_parent=.
            ;;
    esac

    path_chain_is_safe "$candidate" || fail "invalid AgentQ operation lock path: $candidate"
    [ -z "$operation_lock" ] || return 0
    ensure_not_in_maintenance
    set_current_process_lock_metadata || fail "cannot determine AgentQ operation lock owner"

    while [ "$attempt" -lt "$lock_acquire_attempts" ]; do
        [ ! -L "$candidate_parent" ] || fail "invalid AgentQ operation lock parent path: $candidate_parent"
        [ ! -L "$candidate" ] || fail "invalid AgentQ operation lock path: $candidate"
        if mkdir -- "$candidate" 2>/dev/null; then
            if ! write_lock_metadata "$candidate/pid"; then
                attempt=$((attempt + 1))
                [ "$attempt" -lt "$lock_acquire_attempts" ] ||
                    fail "cannot initialize AgentQ operation lock: $candidate"
                sleep "$lock_retry_delay_seconds"
                continue
            fi
            operation_lock=$candidate
            if [ -e "$maintenance_lock_directory" ] || [ -L "$maintenance_lock_directory" ]; then
                if ! release_operation_lock; then
                    fail "cannot release AgentQ operation lock while maintenance lock is present: $candidate"
                fi
                ensure_not_in_maintenance
                continue
            fi
            if ! ensure_request_record_layout; then
                fail "cannot prepare AgentQ request record layout: $candidate"
            fi
            return 0
        fi

        [ ! -L "$candidate_parent" ] || fail "invalid AgentQ operation lock parent path: $candidate_parent"
        [ ! -L "$candidate" ] || fail "invalid AgentQ operation lock path: $candidate"
        if read_lock_metadata "$candidate/pid"; then
            if process_is_confirmed_dead "$lock_pid" "$lock_identity"; then
                if ! remove_stale_lock "$candidate" operation "$lock_pid" "$lock_identity"; then
                    fail "cannot recover stale AgentQ operation lock: $candidate"
                fi
                continue
            fi
        elif lock_directory_is_stale_empty "$candidate"; then
            if ! remove_stale_lock "$candidate" operation '' '' true; then
                fail "cannot recover empty AgentQ operation lock: $candidate"
            fi
            continue
        fi

        attempt=$((attempt + 1))
        sleep "$lock_retry_delay_seconds"
    done

    fail "AgentQ operation is already in progress: $candidate" lock_contention
}

operation_lock_is_held() {
    [ -n "$operation_lock" ] && [ -d "$operation_lock" ]
}

with_operation_lock() {
    local command_status
    local release_status

    if operation_lock_is_held; then
        "$@"
        return
    fi

    acquire_operation_lock
    if "$@"; then
        command_status=0
    else
        command_status=$?
    fi
    if release_operation_lock; then
        :
    else
        release_status=$?
        [ "$command_status" -ne 0 ] || command_status=$release_status
    fi
    return "$command_status"
}

remove_stale_lock() {
    local lock_path=$1
    local lock_kind=$2
    local expected_pid=${3:-}
    local expected_identity=${4:-}
    local require_empty=${5:-false}
    local pid_path
    local remove_status

    [ -n "$lock_path" ] || return 1
    if ! path_chain_is_safe "$lock_path"; then
        printf '%s: refusing to recover an unsafe AgentQ %s lock: %s\n' "$program" "$lock_kind" "$lock_path" >&2
        return 2
    fi
    if [ ! -d "$lock_path" ] || [ -L "$lock_path" ]; then
        printf '%s: refusing to recover an unsafe AgentQ %s lock: %s\n' "$program" "$lock_kind" "$lock_path" >&2
        return 2
    fi
    pid_path="$lock_path/pid"
    if [ "$require_empty" = true ]; then
        if [ -e "$pid_path" ] || [ -L "$pid_path" ]; then
            printf '%s: AgentQ %s lock changed while recovering its empty directory: %s\n' "$program" "$lock_kind" "$lock_path" >&2
            return 2
        fi
    elif [ -n "$expected_pid" ]; then
        if ! read_lock_metadata "$pid_path" ||
            [ "$lock_pid" != "$expected_pid" ] ||
            [ "$lock_identity" != "$expected_identity" ]; then
            printf '%s: AgentQ %s stale lock identity changed during recovery: %s\n' "$program" "$lock_kind" "$lock_path" >&2
            return 2
        fi
    fi
    if [ -e "$pid_path" ] || [ -L "$pid_path" ]; then
        if remove_runtime_temporary_file "$pid_path" 'stale lock metadata'; then
            :
        else
            remove_status=$?
            return "$remove_status"
        fi
    fi
    if ! rmdir -- "$lock_path"; then
        printf '%s: failed to remove AgentQ %s stale lock directory: %s\n' "$program" "$lock_kind" "$lock_path" >&2
        return 1
    fi
    if [ -e "$lock_path" ] || [ -L "$lock_path" ]; then
        printf '%s: AgentQ %s stale lock directory remained after cleanup: %s\n' "$program" "$lock_kind" "$lock_path" >&2
        return 1
    fi
    return 0
}

run_pueue() {
    case "$platform_kind" in
        windows)
            env -i \
                HOME="$agentq_home" \
                USER="$agentq_user" \
                USERNAME="$agentq_user" \
                USERPROFILE="$agentq_userprofile" \
                APPDATA="$agentq_appdata" \
                LOCALAPPDATA="$agentq_localappdata" \
                HOMEDRIVE="$agentq_homedrive" \
                HOMEPATH="$agentq_homepath" \
                SystemRoot="$agentq_systemroot" \
                SystemDrive="$agentq_systemdrive" \
                WINDIR="$agentq_windir" \
                ComSpec="$agentq_comspec" \
                PATHEXT="$agentq_pathext" \
                TEMP="$agentq_temp" \
                TMP="$agentq_tmp" \
                MSYSTEM="$agentq_msystem" \
                MSYS_NO_PATHCONV=1 \
                PATH="$agentq_windows_path" \
                "$pueue_bin" --config "$pueue_config_path" "$@"
            ;;
        unix)
            env -i \
                HOME="$HOME" \
                USER="${USER:-$(id -un)}" \
                LOGNAME="${LOGNAME:-${USER:-$(id -un)}}" \
                PATH="$PATH" \
                SHELL="${SHELL:-/bin/sh}" \
                LANG="${LANG:-C.UTF-8}" \
                "$pueue_bin" --config "$config_path" "$@"
            ;;
    esac
}

managed_daemon_is_active() {
    case "$platform_kind" in
        windows)
            command -v powershell.exe >/dev/null 2>&1 || return 1
            # shellcheck disable=SC2016
            AGENTQ_PUEUED_PATH="$pueued_path_windows" powershell.exe \
                -NoProfile \
                -NonInteractive \
                -Command '
                    $target = $env:AGENTQ_PUEUED_PATH
                    foreach ($process in @(Get-Process -Name pueued -ErrorAction SilentlyContinue)) {
                        try {
                            if ($process.Path -ieq $target) {
                                exit 0
                            }
                        } catch {
                        }
                    }
                    exit 1
                ' >/dev/null 2>&1
            ;;
        unix)
            case "$platform" in
                Linux*)
                    command -v systemctl >/dev/null 2>&1 || return 1
                    systemctl --user is-active --quiet agentq-pueued.service
                    ;;
                Darwin*)
                    command -v launchctl >/dev/null 2>&1 || return 1
                    macos_launch_service_target
                    launchctl print "$macos_launch_service" 2>/dev/null \
                        | grep -q 'state = running'
                    ;;
                *)
                    return 1
                    ;;
            esac
            ;;
    esac
}

start_managed_daemon() {
    case "$platform_kind" in
        windows)
            [ -r "$startup_script" ] || fail "missing AgentQ startup script: $startup_script"
            command -v powershell.exe >/dev/null 2>&1 || fail 'powershell.exe is required to start Pueue on Windows'
            if ! powershell.exe \
                -NoProfile \
                -NonInteractive \
                -ExecutionPolicy Bypass \
                -File "$startup_script_path" >/dev/null; then
                fail 'failed to start the managed Windows Pueue daemon'
            fi
            ;;
        unix)
            case "$platform" in
                Linux*)
                    command -v systemctl >/dev/null 2>&1 || fail 'systemctl is required to start AgentQ on Linux'
                    if ! systemctl --user start agentq-pueued.service; then
                        fail 'failed to start systemd user service agentq-pueued.service'
                    fi
                    ;;
                Darwin*)
                    command -v launchctl >/dev/null 2>&1 || fail 'launchctl is required to start AgentQ on macOS'
                    macos_launch_service_target
                    case "$macos_launch_service" in
                        system/*)
                            fail 'system LaunchDaemon com.agentq.pueued is inactive; rerun the AgentQ installer in an interactive sudo session'
                            ;;
                    esac
                    if ! launchctl kickstart "$macos_launch_service"; then
                        fail 'failed to start launchd service com.agentq.pueued'
                    fi
                    ;;
            esac
            ;;
    esac
}

macos_launch_service_target() {
    local macos_uid

    macos_uid=$(id -u)
    macos_launch_service="system/com.agentq.pueued"
    if [ -f /Library/LaunchDaemons/com.agentq.pueued.plist ] || launchctl print "$macos_launch_service" >/dev/null 2>&1; then
        return 0
    fi

    macos_launch_service="gui/$macos_uid/com.agentq.pueued"
    if launchctl print "$macos_launch_service" >/dev/null 2>&1; then
        return 0
    fi

    macos_launch_service="user/$macos_uid/com.agentq.pueued"
    if launchctl print "$macos_launch_service" >/dev/null 2>&1; then
        return 0
    fi

    macos_launch_service="gui/$macos_uid/com.agentq.pueued"
    if launchctl print "gui/$macos_uid" >/dev/null 2>&1; then
        return 0
    fi

    macos_launch_service="user/$macos_uid/com.agentq.pueued"
}

ensure_daemon() {
    local attempt=0

    ensure_not_in_maintenance

    if run_pueue status --json >/dev/null 2>&1; then
        recover_removing_requests || fail 'failed to recover removing AgentQ requests'
        return 0
    fi

    if managed_daemon_is_active; then
        while [ "$attempt" -lt "$startup_attempts" ]; do
            if run_pueue status --json >/dev/null 2>&1; then
                recover_removing_requests || fail 'failed to recover removing AgentQ requests'
                return 0
            fi
            attempt=$((attempt + 1))
            sleep 1
        done

        fail 'Pueue daemon service is active but unreachable; refusing to restart it because AgentQ tasks may still be running'
    fi

    ensure_not_in_maintenance
    start_managed_daemon
    attempt=0
    while [ "$attempt" -lt "$startup_attempts" ]; do
        if run_pueue status --json >/dev/null 2>&1; then
            recover_removing_requests || fail 'failed to recover removing AgentQ requests'
            return 0
        fi
        attempt=$((attempt + 1))
        sleep 1
    done

    fail "Pueue daemon is unavailable after ${startup_attempts}s"
}

ensure_group() {
    local group_file
    local group_exists=false
    local jq_status

    group_file=$(umask 077; make_temporary_file "$runtime_directory" '.agentq-group' '.json') ||
        fail 'cannot allocate a group status temporary file'
    group_raw_file=$group_file
    require_runtime_temporary_file "$group_file"
    require_runtime_temporary_file "$group_file"
    require_runtime_temporary_file "$group_file"
    require_runtime_temporary_file "$group_file"
    if ! run_pueue group --json > "$group_file"; then
        fail 'cannot inspect the AgentQ group'
    fi
    require_runtime_temporary_file "$group_file"
    jq -e 'type == "object"' < "$group_file" >/dev/null ||
        fail 'AgentQ group response is invalid JSON'
    if jq -e --arg name "$group_name" 'has($name)' < "$group_file" >/dev/null; then
        group_exists=true
    else
        jq_status=$?
        case "$jq_status" in
            1) ;;
            *) fail 'cannot inspect the AgentQ group' ;;
        esac
    fi
    remove_runtime_temporary_file "$group_file" 'group raw response file' ||
        fail 'failed to clean AgentQ group raw response temporary file'
    group_raw_file=''
    if [ "$group_exists" = true ]; then
        if ! run_pueue parallel --group "$group_name" 1 >/dev/null; then
            return 1
        fi
    else
        if ! run_pueue group add --parallel 1 "$group_name" >/dev/null; then
            return 1
        fi
    fi
}

verify_group() {
    local group_file

    group_file=$(umask 077; make_temporary_file "$runtime_directory" '.agentq-group' '.json') ||
        fail 'cannot allocate a group status temporary file'
    group_raw_file=$group_file
    require_runtime_temporary_file "$group_file"
    require_runtime_temporary_file "$group_file"
    require_runtime_temporary_file "$group_file"
    require_runtime_temporary_file "$group_file"
    run_pueue group --json > "$group_file" || fail 'cannot inspect the AgentQ group'
    require_runtime_temporary_file "$group_file"
    jq -e --arg name "$group_name" '
        (.[$name] | type) == "object"
        and .[$name].parallel_tasks == 1
    ' < "$group_file" >/dev/null || fail "AgentQ group is missing or has unexpected parallelism: $group_name"
    remove_runtime_temporary_file "$group_file" 'group raw response file' || fail 'failed to clean AgentQ group raw response temporary file'
    group_raw_file=''
}

normalize_workdir() {
    local input=$1

    case "$platform_kind" in
        windows)
            case "$input" in
                /*|[A-Za-z]:[\\/]*|\\\\*) ;;
                *) fail "working directory must be absolute: $input" ;;
            esac
            local unix_path
            local windows_path
            unix_path=$(cygpath -u "$input" 2>/dev/null) || fail "invalid working directory: $input"
            [ -d "$unix_path" ] || fail "working directory does not exist: $input"
            windows_path=$(cygpath -aw "$unix_path") || fail "cannot normalize working directory: $input"
            printf '%s\n' "$windows_path"
            ;;
        unix)
            case "$input" in
                /*) ;;
                *) fail "working directory must be absolute: $input" ;;
            esac
            [ -d "$input" ] || fail "working directory does not exist: $input"
            # The cd can still fail if the directory vanished since the check;
            # report it here so the caller's `|| return` never swallows a silent
            # empty path.
            (CDPATH=; cd -- "$input" && pwd -P) || fail "cannot resolve the working directory: $input"
            ;;
    esac
}

# shellcheck disable=SC2016
compact_filter='
def canonical_integer_string:
    tostring
    | sub("^0+"; "")
    | if . == "" then "0" else . end;
def same_task_id($left; $right):
    ($left | canonical_integer_string) == ($right | canonical_integer_string);
def lifecycle:
    .status as $status
    | if ($status | has("Running")) then $status.Running
      elif ($status | has("Done")) then $status.Done
      else {} end;
def compact:
    lifecycle as $lifecycle
    | {
        id,
        label,
        group,
        path,
        created_at,
        start: ($lifecycle.start // null),
        end: ($lifecycle.end // null),
        status
    };
def decorate($markers; $requests):
    . as $task
    | ($markers | map(select(
        same_task_id(.task_id; $task.id)
        and (.created_at == $task.created_at)
    )) | first) as $marker
    | ($requests | map(select(
        (.state == "accepted" or .state == "removing")
        and same_task_id(.task_id; $task.id)
        and (.task_created_at == $task.created_at)
    )) | first) as $request
    | if $request == null then . else
        .label = $request.payload.label
        | .agentq = ((.agentq // {}) + {
            request_id: $request.request_id,
            removal_pending: ($request.state == "removing")
        })
      end
    | if $marker == null then .
      elif $marker.state == "requested" then
        .agentq = ((.agentq // {}) + {
            cancellation_requested_at: $marker.requested_at,
            cancellation_reason: $marker.reason
        })
      else
        .agentq = ((.agentq // {}) + {
            cancellation_pending_at: $marker.requested_at,
            cancellation_reason: $marker.reason
        })
      end;
'

load_cancellation_markers() {
    local marker_files=()
    local marker_path
    local marker_parent
    local marker_task_id
    local marker

    shopt -s nullglob
    marker_files=("$cancellation_directory"/*.json)
    shopt -u nullglob

    if [ "${#marker_files[@]}" -eq 0 ]; then
        printf '%s\n' '[]'
        return 0
    fi

    {
        for marker_path in "${marker_files[@]}"; do
            marker_task_id=${marker_path##*/}
            marker_task_id=${marker_task_id%.json}
            is_task_id "$marker_task_id" || fail "invalid AgentQ cancellation marker filename: $marker_path"
            [ "$(canonical_task_id "$marker_task_id")" = "$marker_task_id" ] ||
                fail "non-canonical AgentQ cancellation marker filename: $marker_path"
            path_chain_is_safe "$marker_path" ||
                fail "invalid AgentQ cancellation marker path: $marker_path"
            marker_parent=${marker_path%/*}
            [ -n "$marker_parent" ] || marker_parent=.
            [ -d "$marker_parent" ] && [ ! -L "$marker_parent" ] ||
                fail "invalid AgentQ cancellation marker path: $marker_path"
            [ -f "$marker_path" ] && [ ! -L "$marker_path" ] ||
                fail "invalid AgentQ cancellation marker path: $marker_path"
            request_metadata_file_is_safe "$marker_path" ||
                fail "invalid AgentQ cancellation marker path: $marker_path"
            request_metadata_file_is_safe "$marker_path" ||
                fail "invalid AgentQ cancellation marker path: $marker_path"
            validate_task_id_precision "$marker_task_id"
            marker=$(cancellation_marker_is_valid "$marker_path" "$marker_task_id") ||
                fail "invalid AgentQ cancellation marker: $marker_path"
            printf '%s\n' "$marker"
        done
    } | jq -cse '
        def valid_task_id:
            if type != "number" then
                false
            else
                (. >= 0) and ((floor) == .)
            end;
        def valid_marker:
            (.task_id | valid_task_id)
            and (.created_at | type) == "string"
            and (.created_at | length) > 0
            and (.requested_at | type) == "string"
            and (.requested_at | length) > 0
            and (.reason | type) == "string"
            and (.reason | length) > 0
            and ((.state? == null) or .state == "pending" or .state == "requested");
        if all(.[]; valid_marker) then
            map(if .state? == null then . + {state: "requested"} else . end)
        else error("invalid AgentQ cancellation marker")
        end
    '
}

request_record_path() {
    local request_id=$1

    is_request_id "$request_id" || fail "invalid AgentQ request record id: $request_id"
    printf '%s/%s.json\n' "$request_directory" "$request_id"
}

request_tombstone_path() {
    local request_id=$1

    is_request_id "$request_id" || fail "invalid AgentQ request tombstone id: $request_id"
    printf '%s/%s.json\n' "$request_tombstone_directory" "$request_id"
}

request_task_label() {
    printf 'agentq:%s\n' "$1"
}

# The record predicate, kept in one place so the validating reader and the
# reader that also needs `.state` cannot drift apart.
request_record_filter='
        def valid_task_id:
            if type != "number" then
                false
            else
                (. >= 0) and ((floor) == .)
            end;
        if (
            (.version == 1)
            and (.request_id == $request_id)
            and (.payload | type) == "object"
            and (.payload.workdir | type) == "string"
            and (.payload.label | type) == "string"
            and (.payload.argv | type) == "array"
            and all(.payload.argv[]; type == "string")
            and (.task_label == ("agentq:" + .request_id))
            and (.state == "prepared" or .state == "adding" or .state == "accepted" or .state == "removing" or .state == "removed")
            and (
                if .state == "prepared" or .state == "adding" then
                    .task_id == null and .task_created_at == null
                else
                    (.task_id | valid_task_id)
                    and (.task_created_at | type) == "string"
                    and (.task_created_at | length) > 0
                end
            )
            and (.created_at | type) == "string"
            and (.created_at | length) > 0
        ) then . else error("invalid AgentQ request record") end
'

# The batch form of `request_record_filter`: validate every record against its
# own filename-derived id (positional binding, exactly as load_request_records
# does), then emit, for each record in state `removed`, its request id and its
# serialisation as two lines.  This exists so repair can find the removed records
# in ONE jq instead of one per file, while keeping the predicate identical to the
# per-file reader -- note it uses `request_record_filter` (which ACCEPTS
# `removed`), NOT the `load_request_records` filter, whose `valid_request` gate
# rejects `removed` (see PLAN.md A23).  The parameter is named `$request_id` on
# purpose: it is the same name the embedded filter references, so the body is
# reused verbatim rather than rewritten.  `tojson` framing (not @tsv) matches
# recover_removing_requests; @tsv would double-escape what tojson already emits.
request_removed_records_filter="
def valid(\$request_id): (
$request_record_filter
);
. as \$records
| (\$ARGS.positional) as \$ids
| if ((\$records | length) != (\$ids | length)) then
    error(\"invalid AgentQ request record\")
  else . end
| [ range(0; length) as \$i | (\$records[\$i] | valid(\$ids[\$i])) ]
| .[]
| select(.state == \"removed\")
| (.request_id, tojson)
"

# The batch form of `request_record_filter` that emits EVERY record's identity
# and body (not only the removed ones): the wait-recovery scan needs the state
# and task id of every record to decide which one matches the vanished task.
# Same positional binding and same predicate as the per-file reader, so the two
# cannot drift (rule E).  Four lines per record: request id, state, task id
# (empty when null, matching the per-file reader's `// ""`), and the body.
request_records_states_filter="
def valid(\$request_id): (
$request_record_filter
);
. as \$records
| (\$ARGS.positional) as \$ids
| if ((\$records | length) != (\$ids | length)) then
    error(\"invalid AgentQ request record\")
  else . end
| range(0; length) as \$i
| (\$records[\$i] | valid(\$ids[\$i]))
| (\$ids[\$i], .state, ((.task_id // \"\") | tostring), tojson)
"

# The tombstone predicate, kept in one place so the validating reader and the
# batch reader below cannot drift (rule E).
request_tombstone_filter='
        def valid_task_id:
            if type != "number" then
                false
            else
                (. >= 0) and ((floor) == .)
            end;
        if (
            (.version == 1)
            and (.request_id == $request_id)
            and (.task_id | valid_task_id)
            and (.task_created_at | type) == "string"
            and (.task_created_at | length) > 0
            and (.state == "removed")
            and (.removed_at | type) == "string"
            and (.removed_at | length) > 0
        ) then .
        else error("invalid AgentQ request tombstone")
        end
'

# The batch form of `request_tombstone_filter`: validate every tombstone against
# its own filename-derived id, then emit, per tombstone, its request id, task id
# and task_created_at as three lines.  Lets the wait-recovery scan find the
# matching tombstone in ONE jq instead of three per file.
request_tombstones_states_filter="
def valid(\$request_id): (
$request_tombstone_filter
);
. as \$tombstones
| (\$ARGS.positional) as \$ids
| if ((\$tombstones | length) != (\$ids | length)) then
    error(\"invalid AgentQ request tombstone\")
  else . end
| range(0; length) as \$i
| (\$tombstones[\$i] | valid(\$ids[\$i]))
| (\$ids[\$i], (.task_id | tostring), .task_created_at)
"

# The batch form of the `select(.task_id == $id) | .task_created_at // empty`
# probe that task_instance_created_at_is_recorded runs per file.  TOLERANT on
# purpose: the per-file loop swallows a malformed file (`2>/dev/null ||
# continue`) and keeps scanning, so this filter must NOT be used where a bad
# record should fail closed.  It answers a single boolean: does ANY slurped
# file record this task id with this creation time?  A malformed file makes the
# whole slurp fail, which sends the caller to its verbatim fallback.
request_instance_probe_filter='
[ .[] | select(.task_id == $id) | select((.task_created_at // empty) == $expected) ]
| length > 0
'

request_record_is_valid() {
    local record_path=$1
    local request_id=$2

    request_metadata_file_is_safe "$record_path" ||
        fail "invalid AgentQ request record path: $record_path"
    validate_task_id_precision_in_file "$record_path"
    request_metadata_file_is_safe "$record_path" ||
        fail "invalid AgentQ request record path: $record_path"
    jq -ce --arg request_id "$request_id" "$request_record_filter" < "$record_path"
}

request_tombstone_is_valid() {
    local tombstone_path=$1
    local request_id=$2

    request_metadata_file_is_safe "$tombstone_path" ||
        fail "invalid AgentQ request tombstone path: $tombstone_path"
    validate_task_id_precision_in_file "$tombstone_path"
    request_metadata_file_is_safe "$tombstone_path" ||
        fail "invalid AgentQ request tombstone path: $tombstone_path"
    jq -ce --arg request_id "$request_id" "$request_tombstone_filter" < "$tombstone_path"
}

# The tombstone-path guard sequence, in ONE place so the per-file reader above
# and the batch reader in wait_reconcile_missing_task cannot drift (rule E).
# Mirrors read_request_tombstone + request_tombstone_is_valid: existence, then
# the four safety re-checks with the precision probe between the last two.  It
# calls `fail`, so a caller that discards stderr to fall back gets the same
# verdict as the per-file path.
request_tombstone_path_guards_or_fail() {
    local tombstone_path=$1
    [ -e "$tombstone_path" ] || [ -L "$tombstone_path" ] ||
        fail "invalid AgentQ request tombstone path: $tombstone_path"
    request_metadata_file_is_safe "$tombstone_path" || fail "invalid AgentQ request tombstone path: $tombstone_path"
    request_metadata_file_is_safe "$tombstone_path" || fail "invalid AgentQ request tombstone path: $tombstone_path"
    request_metadata_file_is_safe "$tombstone_path" || fail "invalid AgentQ request tombstone path: $tombstone_path"
    validate_task_id_precision_in_file "$tombstone_path"
    request_metadata_file_is_safe "$tombstone_path" || fail "invalid AgentQ request tombstone path: $tombstone_path"
}

request_records_filter='
def valid_task_id:
    if type != "number" then
        false
    else
        (. >= 0) and ((floor) == .)
    end;
def valid_record($request_id):
    (.version == 1)
    and (.request_id == $request_id)
    and (.payload | type) == "object"
    and (.payload.workdir | type) == "string"
    and (.payload.label | type) == "string"
    and (.payload.argv | type) == "array"
    and all(.payload.argv[]; type == "string")
    and (.task_label == ("agentq:" + .request_id))
    and (.state == "prepared" or .state == "adding" or .state == "accepted" or .state == "removing" or .state == "removed")
    and (
        if .state == "prepared" or .state == "adding" then
            .task_id == null and .task_created_at == null
        else
            (.task_id | valid_task_id)
            and (.task_created_at | type) == "string"
            and (.task_created_at | length) > 0
        end
    )
    and (.created_at | type) == "string"
    and (.created_at | length) > 0;
def valid_request:
    (.version == 1)
    and (.request_id | type) == "string"
    and (.payload | type) == "object"
    and (.payload.workdir | type) == "string"
    and (.payload.label | type) == "string"
    and (.payload.argv | type) == "array"
    and all(.payload.argv[]; type == "string")
    and (.task_label == ("agentq:" + .request_id))
    and (.state == "prepared" or .state == "adding" or .state == "accepted" or .state == "removing")
    and (
        if .state == "prepared" or .state == "adding" then
            .task_id == null and .task_created_at == null
        else
            (.task_id | valid_task_id)
            and (.task_created_at | type) == "string"
            and (.task_created_at | length) > 0
        end
    )
    and (.created_at | type) == "string"
    and (.created_at | length) > 0;
. as $records
| ($ARGS.positional) as $request_ids
| if (($records | length) != ($request_ids | length)) then
    error("invalid AgentQ request record")
  else . end
| [ range(0; length) as $index
    | .[$index] as $record
    | if ($record | valid_record($request_ids[$index])) then $record
      else error("invalid AgentQ request record")
      end ]
| if all(.[]; valid_request) then . else error("invalid AgentQ request record") end
'

load_request_records() {
    local record_files=()
    local record_ids=()
    local record_path
    local record_parent
    local request_id
    local record

    shopt -s nullglob
    record_files=("$request_directory"/*.json)
    shopt -u nullglob

    if [ "${#record_files[@]}" -eq 0 ]; then
        printf '%s\n' '[]'
        return 0
    fi

    # The request ids are collected here, in the parent shell: the loop that
    # feeds jq below runs inside a pipeline subshell, so an array filled there
    # would never reach the jq invocation.  This loop is pure bash and forks
    # nothing.
    for record_path in "${record_files[@]}"; do
        request_id=${record_path##*/}
        record_ids+=("${request_id%.json}")
    done

    {
    for record_path in "${record_files[@]}"; do
        request_id=${record_path##*/}
        request_id=${request_id%.json}
        is_request_id "$request_id" || fail "invalid AgentQ request record filename: $record_path"
        path_chain_is_safe "$record_path" ||
            fail "invalid AgentQ request record path: $record_path"
        record_parent=${record_path%/*}
        [ -n "$record_parent" ] || record_parent=.
        [ -d "$record_parent" ] && [ ! -L "$record_parent" ] ||
            fail "invalid AgentQ request record path: $record_path"
        [ -f "$record_path" ] && [ ! -L "$record_path" ] ||
            fail "invalid AgentQ request record path: $record_path"
        request_metadata_file_is_safe "$record_path" ||
            fail "invalid AgentQ request record path: $record_path"
        request_metadata_file_is_safe "$record_path" ||
            fail "invalid AgentQ request record path: $record_path"
        # The two re-checks request_record_is_valid() used to perform are kept
        # verbatim: they are bash builtins that fork nothing, so removing them
        # would shrink the TOCTOU window's coverage for no gain.  Only the
        # three jq invocations per file are gone -- their verdict is reached by
        # the single aggregate jq below.
        validate_task_id_precision_in_file "$record_path"
        request_metadata_file_is_safe "$record_path" ||
            fail "invalid AgentQ request record path: $record_path"
        request_metadata_file_is_safe "$record_path" ||
            fail "invalid AgentQ request record path: $record_path"
        record=$(<"$record_path") || fail "invalid AgentQ request record: $record_path"
        printf '%s\n' "$record"
        done
    } | jq -cse --args "$request_records_filter" -- "${record_ids[@]}"
}

release_request_metadata_files() {
    local cleanup_status=0

    if [ -n "$request_records_file" ]; then
        remove_runtime_temporary_file "$request_records_file" || cleanup_status=1
        request_records_file=''
    fi
    if [ -n "$cancellation_markers_file" ]; then
        remove_runtime_temporary_file "$cancellation_markers_file" || cleanup_status=1
        cancellation_markers_file=''
    fi
    request_records_jq_file=''
    cancellation_markers_jq_file=''
    return "$cleanup_status"
}

cleanup_request_metadata_after_setup_failure() {
    if ! release_request_metadata_files; then
        printf '%s: failed to clean AgentQ request metadata temporary files after setup failure\n' "$program" >&2
        return 1
    fi
}

cleanup_task_identity_metadata_after_failure() {
