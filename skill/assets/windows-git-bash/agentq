jq_file_argument() {
    local path=$1

    if [ "$platform_kind" = windows ]; then
        cygpath -aw -- "$path"
    else
        printf '%s\n' "$path"
    fi
}

prepare_request_metadata_files() {
    release_request_metadata_files || return 1
    request_records_file=$(umask 077; make_temporary_file "$runtime_directory" '.agentq-request-records' '.json') || return 1
    cancellation_markers_file=$(umask 077; make_temporary_file "$runtime_directory" '.agentq-cancellation-markers' '.json') || {
        cleanup_request_metadata_after_setup_failure || return 1
        return 1
    }

    if ! require_runtime_temporary_file "$request_records_file" ||
        ! require_runtime_temporary_file "$request_records_file" ||
        ! require_runtime_temporary_file "$request_records_file" ||
        ! require_runtime_temporary_file "$request_records_file" ||
        ! load_request_records > "$request_records_file" ||
        ! require_runtime_temporary_file "$cancellation_markers_file" ||
        ! require_runtime_temporary_file "$cancellation_markers_file" ||
        ! require_runtime_temporary_file "$cancellation_markers_file" ||
        ! require_runtime_temporary_file "$cancellation_markers_file" ||
        ! load_cancellation_markers > "$cancellation_markers_file" ||
        ! require_runtime_temporary_file "$request_records_file" ||
        ! require_runtime_temporary_file "$cancellation_markers_file"; then
        release_request_metadata_files
        return 1
    fi
    if ! request_records_jq_file=$(jq_file_argument "$request_records_file") ||
        ! require_runtime_temporary_file "$request_records_file" ||
        ! cancellation_markers_jq_file=$(jq_file_argument "$cancellation_markers_file") ||
        ! require_runtime_temporary_file "$cancellation_markers_file"; then
        release_request_metadata_files
        return 1
    fi
}

# Validate the record and print, in one jq run, three lines: the state, the
# task id (empty when null), and the compact record.  `repair` needs the state to
# decide whether to archive and used to read it with a SECOND jq on the record it
# had just validated -- one wasted process per file.
#
# The output goes to stdout and the caller captures it with `$( )`, which is not
# a style choice: it is what keeps the failure path identical to the one this
# replaces.  The validating `fail` inside then terminates only that subshell, so
# the caller's own `|| fail "missing ... during recovery"` still produces the
# second message.  Assigning the values to variables here instead would let
# `fail` exit the whole server and silently drop that message -- an observable
# contract change that the recorded-stderr comparison in smoke/18 caught.
#
# `jq -r` puts each value on its own line, so no separator character is needed
# (and none is safe: `-c` would JSON-encode a TAB into backslash-t, which never
# matches a literal tab).
read_request_record_state_and_body() {
    local request_id=$1
    local record_path

    is_request_id "$request_id" || fail "invalid AgentQ request record id: $request_id"
    record_path=$(request_record_path "$request_id")
    if [ ! -e "$record_path" ] && [ ! -L "$record_path" ]; then
        return 1
    fi
    request_record_path_guards_or_fail "$record_path"

    jq -re --arg request_id "$request_id" \
        "$request_record_filter | .state, (.task_id // \"\" | tostring), tojson" < "$record_path" ||
        fail "invalid AgentQ request record: $record_path"
}

# The record-path guard sequence, in ONE place so the per-file reader above and
# the batch reader in repair_removed_request_records cannot drift (rule E: the
# same mechanism written twice is this repo's recurring defect).  It calls
# `fail`, so a caller that needs the two-message recovery contract must run it
# inside a subshell -- exactly as read_request_record_state_and_body's caller
# does -- while a caller that discards stderr to fall back gets the same verdict.
request_record_path_guards_or_fail() {
    local record_path=$1
    request_metadata_file_is_safe "$record_path" || fail "invalid AgentQ request record path: $record_path"
    request_metadata_file_is_safe "$record_path" || fail "invalid AgentQ request record path: $record_path"
    validate_task_id_precision_in_file "$record_path"
    request_metadata_file_is_safe "$record_path" || fail "invalid AgentQ request record path: $record_path"
    request_metadata_file_is_safe "$record_path" || fail "invalid AgentQ request record path: $record_path"
}

read_request_record() {
    local request_id=$1
    local record_path

    is_request_id "$request_id" || fail "invalid AgentQ request record id: $request_id"
    record_path=$(request_record_path "$request_id")
    if [ ! -e "$record_path" ] && [ ! -L "$record_path" ]; then
        return 1
    fi
    request_metadata_file_is_safe "$record_path" || fail "invalid AgentQ request record path: $record_path"
    request_metadata_file_is_safe "$record_path" || fail "invalid AgentQ request record path: $record_path"

    request_record_is_valid "$record_path" "$request_id" || fail "invalid AgentQ request record: $record_path"
}

read_request_tombstone() {
    local request_id=$1
    local tombstone_path

    is_request_id "$request_id" || fail "invalid AgentQ request tombstone id: $request_id"
    tombstone_path=$(request_tombstone_path "$request_id")
    if [ ! -e "$tombstone_path" ] && [ ! -L "$tombstone_path" ]; then
        return 1
    fi
    request_metadata_file_is_safe "$tombstone_path" || fail "invalid AgentQ request tombstone path: $tombstone_path"
    request_metadata_file_is_safe "$tombstone_path" || fail "invalid AgentQ request tombstone path: $tombstone_path"

    request_tombstone_is_valid "$tombstone_path" "$request_id" || fail "invalid AgentQ request tombstone: $tombstone_path"
}

prune_request_temporary_files_in_directory() {
    local directory=$1
    local kind=$2
    local temporary_path
    local temporary_name
    local temporary_stem
    local temporary_request_id
    local temporary_pid
    local temporary_random
    local candidate_stem
    local candidate_base
    local candidate_request_id
    local candidate_pid
    local candidate_random
    local candidate_valid

    shopt -s nullglob
    for temporary_path in "$directory"/.*.json; do
        path_chain_is_safe "$temporary_path" ||
            fail "invalid AgentQ $kind temporary record path: $temporary_path"
        [ -f "$temporary_path" ] && [ ! -L "$temporary_path" ] ||
            fail "invalid AgentQ $kind temporary record path: $temporary_path"
        temporary_name=${temporary_path##*/}
        temporary_stem=${temporary_name#.}
        temporary_stem=${temporary_stem%.json}
        temporary_request_id=''
        temporary_pid=''
        temporary_random=''
        case "$temporary_name" in
            .agentqtmp.*.json)
                candidate_stem=${temporary_name#.agentqtmp.}
                candidate_stem=${candidate_stem%.json}
                candidate_random=${candidate_stem##*.}
                candidate_base=${candidate_stem%.*}
                candidate_request_id=${candidate_base%.*}
                candidate_pid=${candidate_base##*.}
                candidate_valid=true
                case "$candidate_base" in
                    *.*) ;;
                    *) candidate_valid=false ;;
                esac
                case "$candidate_random" in
                    ''|*[!A-Za-z0-9]*) candidate_valid=false ;;
                esac
                if [ "$candidate_valid" = true ] &&
                    is_request_id "$candidate_request_id" &&
                    is_positive_integer "$candidate_pid"; then
                    temporary_request_id=$candidate_request_id
                    temporary_pid=$candidate_pid
                    temporary_random=$candidate_random
                fi
                ;;
        esac
        if [ -z "$temporary_request_id" ]; then
            case "$temporary_stem" in
                *.*) ;;
                *) fail "invalid AgentQ $kind temporary process id: $temporary_path" ;;
            esac
            temporary_request_id=${temporary_stem%.*}
            temporary_pid=${temporary_stem##*.}
        fi
        is_request_id "$temporary_request_id" ||
            fail "invalid AgentQ $kind temporary request id: $temporary_path"
        is_positive_integer "$temporary_pid" ||
            fail "invalid AgentQ $kind temporary process id: $temporary_path"
        rm -f -- "$temporary_path" ||
            fail "cannot remove stale AgentQ $kind temporary record: $temporary_path"
    done
    shopt -u nullglob
}

prune_request_temporary_files() {
    prune_request_temporary_files_in_directory "$request_directory" request
    prune_request_temporary_files_in_directory "$request_tombstone_directory" tombstone
}

prune_cancellation_temporary_files() {
    local temporary_path
    local temporary_name
    local temporary_stem
    local temporary_task_id
    local temporary_pid
    local temporary_random

    shopt -s nullglob
    for temporary_path in "$cancellation_directory"/.*.json; do
        path_chain_is_safe "$temporary_path" ||
            fail "invalid AgentQ cancellation temporary file path: $temporary_path"
        [ -f "$temporary_path" ] && [ ! -L "$temporary_path" ] ||
            fail "invalid AgentQ cancellation temporary file path: $temporary_path"
        temporary_name=${temporary_path##*/}
        case "$temporary_name" in
            .agentqcancel.*.json)
                temporary_stem=${temporary_name#.agentqcancel.}
                temporary_stem=${temporary_stem%.json}
                temporary_random=${temporary_stem##*.}
                temporary_stem=${temporary_stem%.*}
                case "$temporary_random" in
                    ''|*[!A-Za-z0-9]*) fail "invalid AgentQ cancellation temporary nonce: $temporary_path" ;;
                esac
                ;;
            .*.*.json)
                temporary_stem=${temporary_name#.}
                temporary_stem=${temporary_stem%.json}
                ;;
            *)
                fail "invalid AgentQ cancellation temporary task id: $temporary_path"
                ;;
        esac
        case "$temporary_stem" in
            *.*) ;;
            *) fail "invalid AgentQ cancellation temporary process id: $temporary_path" ;;
        esac
        temporary_task_id=${temporary_stem%.*}
        temporary_pid=${temporary_stem##*.}
        is_task_id "$temporary_task_id" ||
            fail "invalid AgentQ cancellation temporary task id: $temporary_path"
        [ "$(canonical_task_id "$temporary_task_id")" = "$temporary_task_id" ] ||
            fail "non-canonical AgentQ cancellation temporary task id: $temporary_path"
        is_positive_integer "$temporary_pid" ||
            fail "invalid AgentQ cancellation temporary process id: $temporary_path"
        rm -f -- "$temporary_path" ||
            fail "cannot remove stale AgentQ cancellation temporary file: $temporary_path"
    done
    shopt -u nullglob
}

prune_runtime_temporary_files() {
    local temporary_path
    local temporary_name
    local temporary_stem
    local temporary_pid

    shopt -s nullglob
    for temporary_path in \
        "$runtime_directory"/.agentq-payload.* \
        "$runtime_directory"/.agentq-status.*.json \
        "$runtime_directory"/.agentq-task.*.json \
        "$runtime_directory"/.agentq-request-records.*.json \
        "$runtime_directory"/.agentq-cancellation-markers.*.json \
        "$runtime_directory"/.agentq-request-tombstones-v2.*.new \
        "$runtime_directory"/.agentq-request-tombstones-pruned-at.*.new \
        "$runtime_directory"/.agentq-group.*.json \
        "$runtime_directory"/.agentq-reconcile-status.*.json \
        "$runtime_directory"/.agentq-log.*.json; do
        path_chain_is_safe "$temporary_path" ||
            fail "invalid AgentQ runtime temporary file path: $temporary_path"
        [ -f "$temporary_path" ] && [ ! -L "$temporary_path" ] ||
            fail "invalid AgentQ runtime temporary file path: $temporary_path"
        temporary_name=${temporary_path##*/}
        case "$temporary_name" in
            .agentq-payload.*)
                temporary_stem=${temporary_name#.agentq-payload.}
                temporary_pid=${temporary_stem%%.*}
                [ "$temporary_stem" != "$temporary_pid" ] ||
                    fail "invalid AgentQ runtime temporary process id: $temporary_path"
                ;;
            .agentq-status.*.json)
                temporary_stem=${temporary_name#.agentq-status.}
                temporary_stem=${temporary_stem%.json}
                temporary_pid=${temporary_stem%%.*}
                ;;
            .agentq-task.*.json)
                temporary_stem=${temporary_name#.agentq-task.}
                temporary_stem=${temporary_stem%.json}
                temporary_pid=${temporary_stem%%.*}
                ;;
            .agentq-request-records.*.json)
                temporary_stem=${temporary_name#.agentq-request-records.}
                temporary_stem=${temporary_stem%.json}
                temporary_pid=${temporary_stem%%.*}
                ;;
            .agentq-cancellation-markers.*.json)
                temporary_stem=${temporary_name#.agentq-cancellation-markers.}
                temporary_stem=${temporary_stem%.json}
                temporary_pid=${temporary_stem%%.*}
                ;;
            # These three prefixes were created but never pruned: a SIGKILL
            # between creation and removal left them in the runtime directory
            # forever (measured 2026-10-06: `kill -9` during `logs` left
            # .agentq-log.*.json in place across later runs).
            .agentq-group.*.json)
                temporary_stem=${temporary_name#.agentq-group.}
                temporary_stem=${temporary_stem%.json}
                temporary_pid=${temporary_stem%%.*}
                ;;
            .agentq-reconcile-status.*.json)
                temporary_stem=${temporary_name#.agentq-reconcile-status.}
                temporary_stem=${temporary_stem%.json}
                temporary_pid=${temporary_stem%%.*}
                ;;
            .agentq-log.*.json)
                temporary_stem=${temporary_name#.agentq-log.}
                temporary_stem=${temporary_stem%.json}
                temporary_pid=${temporary_stem%%.*}
                ;;
            .agentq-request-tombstones-v2.*.new)
                temporary_stem=${temporary_name#.agentq-request-tombstones-v2.}
                temporary_stem=${temporary_stem%.new}
                temporary_pid=${temporary_stem%%.*}
                ;;
            .agentq-request-tombstones-pruned-at.*.new)
                temporary_stem=${temporary_name#.agentq-request-tombstones-pruned-at.}
                temporary_stem=${temporary_stem%.new}
                temporary_pid=${temporary_stem%%.*}
                ;;
            *)
                fail "invalid AgentQ runtime temporary file path: $temporary_path"
                ;;
        esac
        is_positive_integer "$temporary_pid" ||
            fail "invalid AgentQ runtime temporary process id: $temporary_path"
        if process_is_confirmed_dead "$temporary_pid"; then
            remove_runtime_temporary_file "$temporary_path" ||
                fail "cannot remove stale AgentQ runtime temporary file: $temporary_path"
        fi
    done
    shopt -u nullglob
}

write_request_record() {
