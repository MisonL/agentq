lookup() {
    [ "$#" -eq 1 ] || fail 'lookup requires one request id'
    is_request_id "$1" || fail 'request id must be 16-128 ASCII letters, numbers, dots, underscores, or hyphens and start with a letter or number'

    local request_id=$1
    local record
    local tombstone
    local task
    local task_id
    local task_created_at
    local record_state
    local read_status

    acquire_request_lock "$request_id"
    acquire_operation_lock
    if record=$(read_request_record "$request_id"); then
        :
    else
        read_status=$?
        [ "$read_status" -eq 1 ] || return "$read_status"
        if tombstone=$(read_request_tombstone "$request_id"); then
            task_id=$(jq -r '.task_id' <<<"$tombstone")
            validate_task_id_precision "$task_id"
            jq -cn --arg request_id "$request_id" --argjson task_id "$task_id" '{request_id: $request_id, task_id: $task_id, state: "removed"}'
            return 5
        else
            read_status=$?
            [ "$read_status" -eq 1 ] || return "$read_status"
        fi
        jq -cn --arg request_id "$request_id" '{request_id: $request_id, task_id: null, state: "not_found"}'
        return 3
    fi
    if [ "$(jq -r '.state' <<<"$record")" = removed ]; then
        if ! record=$(archive_removed_request "$request_id" "$record"); then
            fail "cannot archive removed AgentQ request while looking up: $request_id"
        fi
        task_id=$(jq -r '.task_id' <<<"$record")
        validate_task_id_precision "$task_id"
        jq -cn --arg request_id "$request_id" --argjson task_id "$task_id" '{request_id: $request_id, task_id: $task_id, state: "removed"}'
        return 5
    fi

    if [ "$(jq -r '.state' <<<"$record")" = removing ]; then
        ensure_daemon
        if record=$(read_request_record "$request_id"); then
            [ "$(jq -r '.state' <<<"$record")" = removing ] || fail "unexpected AgentQ request state after removal recovery: $request_id"
            task_id=$(jq -r '.task_id' <<<"$record")
            validate_task_id_precision "$task_id"
            jq -cn --arg request_id "$request_id" --argjson task_id "$task_id" '{request_id: $request_id, task_id: $task_id, state: "removing"}'
            return 4
        elif tombstone=$(read_request_tombstone "$request_id"); then
            task_id=$(jq -r '.task_id' <<<"$tombstone")
            validate_task_id_precision "$task_id"
            jq -cn --arg request_id "$request_id" --argjson task_id "$task_id" '{request_id: $request_id, task_id: $task_id, state: "removed"}'
            return 5
        else
            fail "AgentQ request disappeared while recovering removal: $request_id"
        fi
    fi

    if [ "$(jq -r '.state' <<<"$record")" = accepted ]; then
        ensure_daemon
        verify_group
        reconcile_accepted_rc=0
        record=$(reconcile_accepted_request "$request_id" "$record") || reconcile_accepted_rc=$?
        if [ "$reconcile_accepted_rc" -eq 4 ]; then
            jq -cn --arg request_id "$request_id" '{request_id: $request_id, task_id: null, state: "ambiguous"}'
            printf '%s: multiple Pueue tasks share the AgentQ label for this request; the server cannot choose safely: %s\n' "$program" "$request_id" >&2
            return 4
        fi
        if [ "$reconcile_accepted_rc" -ne 0 ] && [ "$reconcile_accepted_rc" -ne 1 ]; then
            fail 'cannot inspect Pueue while reconciling an AgentQ request'
        fi
        if [ "$reconcile_accepted_rc" -eq 0 ]; then
            task_id=$(jq -r '.task_id' <<<"$record")
            request_response "$request_id" "$task_id" true
            return 0
        fi

        task_id=$(jq -r '.task_id' <<<"$record")
        validate_task_id_precision "$task_id"
        jq -cn --arg request_id "$request_id" --argjson task_id "$task_id" '{request_id: $request_id, task_id: $task_id, state: "removed"}'
        return 5
    fi

    task_id=$(jq -r '.task_id // empty' <<<"$record")
    if [ -z "$task_id" ]; then
        ensure_daemon
        verify_group
        find_request_task_rc=0
        task=$(find_request_task "$(jq -r '.task_label' <<<"$record")") || find_request_task_rc=$?
        if [ "$find_request_task_rc" -eq 4 ]; then
            jq -cn --arg request_id "$request_id" '{request_id: $request_id, task_id: null, state: "ambiguous"}'
            printf '%s: multiple Pueue tasks share the AgentQ label for this request; the server cannot choose safely: %s\n' "$program" "$request_id" >&2
            return 4
        fi
        if [ "$find_request_task_rc" -ne 0 ] && [ "$find_request_task_rc" -ne 1 ]; then
            fail 'cannot inspect Pueue while reconciling an AgentQ request'
        fi
        if [ "$find_request_task_rc" -eq 0 ]; then
            if ! jq -e '
                if type != "object" then
                    false
                elif (.id | type) != "number" then
                    false
                elif (.id < 0) or ((.id | floor) != .id) then
                    false
                elif (.created_at | type) != "string" then
                    false
                elif (.created_at | length) == 0 then
                    false
                else
                    true
                end
            ' <<<"$task" >/dev/null; then
                fail "invalid visible Pueue task metadata while looking up AgentQ request: $request_id"
            fi
            task_id=$(jq -r '.id' <<<"$task")
            task_created_at=$(jq -r '.created_at' <<<"$task")
            validate_task_id_precision "$task_id"
            record=$(set_request_state "$record" accepted "$task_id" "$(jq -Rn --arg value "$task_created_at" '$value')")
            if ! write_request_record "$request_id" "$record"; then
                fail "cannot persist accepted AgentQ request while looking up: $request_id"
            fi
            request_response "$request_id" "$task_id" true
            return 0
        else
            record_state=$(jq -r '.state' <<<"$record")
            if [ "$record_state" = prepared ]; then
                jq -cn --arg request_id "$request_id" '{request_id: $request_id, task_id: null, state: "not_started"}'
                return 3
            fi
            jq -cn --arg request_id "$request_id" '{request_id: $request_id, task_id: null, state: "ambiguous"}'
            return 4
        fi
    fi

    fail "invalid AgentQ request state while looking up: $(jq -r '.state' <<<"$record")"
}

