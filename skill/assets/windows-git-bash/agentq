path_chain_is_safe() {
    local candidate_path=$1
    local current_path
    local remaining_path
    local path_component

    [ -n "$candidate_path" ] || return 1
    case "$candidate_path" in
        /*)
            current_path=/
            remaining_path=${candidate_path#/}
            ;;
        *)
            current_path=.
            remaining_path=$candidate_path
            ;;
    esac

    while [ -n "$remaining_path" ]; do
        path_component=${remaining_path%%/*}
        if [ "$path_component" = "$remaining_path" ]; then
            remaining_path=
        else
            remaining_path=${remaining_path#*/}
        fi
        case "$path_component" in
            ''|.)
                continue
                ;;
            ..)
                return 1
                ;;
        esac
        if [ "$current_path" = / ]; then
            current_path="/$path_component"
        else
            current_path="$current_path/$path_component"
        fi
        [ ! -L "$current_path" ] || return 1
    done
}

