    local task
    local task_created_at
    local task_compact_status=0
    shift

    if [ "$#" -gt 0 ]; then
        [ "$#" -eq 2 ] && [ "$1" = --tail ] || fail 'logs accepts only --tail <lines>'
        if [ "$2" = all ]; then
            tail_lines=all
        else
            is_positive_integer "$2" || fail '--tail must be a positive integer or all'
            tail_lines=$(canonical_task_id "$2")
        fi
    fi

    ensure_daemon
    task=$(compact_task "$task_id") || task_compact_status=$?
    report_compact_task_failure "$task_compact_status" "$task_id"
