acquire_request_lock() {
    local request_id=$1
    local candidate="$request_lock_directory/$request_id"
    local candidate_parent
    local attempt=0
    local lock_pid=''
    local lock_identity=''

    case "$candidate" in
        */*)
            candidate_parent=${candidate%/*}
            [ -n "$candidate_parent" ] || candidate_parent=/
            ;;
        *)
            candidate_parent=.
            ;;
    esac

    path_chain_is_safe "$candidate" || fail "invalid AgentQ request lock path: $candidate"
    set_current_process_lock_metadata || fail "cannot determine AgentQ request lock owner"

    while [ "$attempt" -lt "$lock_acquire_attempts" ]; do
        [ ! -L "$candidate_parent" ] || fail "invalid AgentQ request lock parent path: $candidate_parent"
        [ ! -L "$candidate" ] || fail "invalid AgentQ request lock path: $candidate"
        if mkdir -- "$candidate" 2>/dev/null; then
            if ! write_lock_metadata "$candidate/pid"; then
                attempt=$((attempt + 1))
                [ "$attempt" -lt "$lock_acquire_attempts" ] ||
                    fail "cannot initialize AgentQ request lock: $candidate"
                sleep "$lock_retry_delay_seconds"
                continue
            fi
            request_lock=$candidate
            return 0
        fi

        [ ! -L "$candidate_parent" ] || fail "invalid AgentQ request lock parent path: $candidate_parent"
        [ ! -L "$candidate" ] || fail "invalid AgentQ request lock path: $candidate"
        if read_lock_metadata "$candidate/pid"; then
            if process_is_confirmed_dead "$lock_pid" "$lock_identity"; then
                if ! remove_stale_lock "$candidate" request "$lock_pid" "$lock_identity"; then
                    fail "cannot recover stale AgentQ request lock: $candidate"
                fi
                continue
            fi
        elif lock_directory_is_stale_empty "$candidate"; then
            if ! remove_stale_lock "$candidate" request '' '' true; then
                fail "cannot recover empty AgentQ request lock: $candidate"
            fi
            continue
        fi

        attempt=$((attempt + 1))
        sleep "$lock_retry_delay_seconds"
    done

    fail "AgentQ request is already being submitted: $request_id" lock_contention
}

find_request_task() {
    local task_label=$1
    local raw_status_file
    local matches
    local match_count
    local task

    raw_status_file=$(umask 077; make_temporary_file "$runtime_directory" '.agentq-reconcile-status' '.json') ||
        fail 'cannot allocate a reconciliation status temporary file'
    reconcile_raw_status_file=$raw_status_file
    require_runtime_temporary_file "$raw_status_file"
    require_runtime_temporary_file "$raw_status_file"
    require_runtime_temporary_file "$raw_status_file"
    require_runtime_temporary_file "$raw_status_file"
    # A transient Pueue read failure must NOT be reported as "no matching task".
    # `fail` is `exit 2`, and `exit` inside the `$( )` at every call site ends only
    # the subshell: the caller then sees an empty string and a false condition,
    # concludes the task is gone, and archives a LIVE request as `removed`.
    # Return a distinct status instead; each caller raises the hard failure in its
    # own shell (see the guard at the top of the matching `else`).
    run_pueue status --json > "$raw_status_file" || {
        remove_runtime_temporary_file "$raw_status_file" 'reconciliation raw status file' || true
        reconcile_raw_status_file=''
        return 3
    }
    require_runtime_temporary_file "$raw_status_file"
    validate_pueue_task_id_precision_in_file "$raw_status_file"
    require_runtime_temporary_file "$raw_status_file"
    validate_pueue_task_shape_in_file "$raw_status_file"
    require_runtime_temporary_file "$raw_status_file"
    matches=$(jq -ce --arg group "$group_name" --arg task_label "$task_label" '
        [
            .tasks[]
            | select(.group == $group and .label == $task_label)
            | {id, created_at}
        ]
    ' < "$raw_status_file") || {
        remove_runtime_temporary_file "$raw_status_file" 'reconciliation raw status file' || true
        reconcile_raw_status_file=''
        return 3
    }
    match_count=$(jq -r 'length' <<<"$matches")

    case "$match_count" in
        0)
            remove_runtime_temporary_file "$raw_status_file" 'reconciliation raw status file' || fail 'failed to clean AgentQ reconciliation raw status temporary file'
            reconcile_raw_status_file=''
            return 1
            ;;
        1)
            task=$(jq -c '.[0]' <<<"$matches") || {
                remove_runtime_temporary_file "$raw_status_file" 'reconciliation raw status file' || fail 'failed to clean AgentQ reconciliation raw status temporary file'
                reconcile_raw_status_file=''
                fail 'cannot render the matching Pueue task while reconciling an AgentQ request'
            }
            remove_runtime_temporary_file "$raw_status_file" 'reconciliation raw status file' || fail 'failed to clean AgentQ reconciliation raw status temporary file'
            reconcile_raw_status_file=''
            printf '%s\n' "$task"
            ;;
        *)
            remove_runtime_temporary_file "$raw_status_file" 'reconciliation raw status file' || true
            reconcile_raw_status_file=''
            return 4
            ;;
    esac
}

validate_visible_task_metadata() {
    local task=$1

    jq -e '
        if type != "object" then
            false
        elif (.id | type) != "number" then
            false
        elif (.id < 0) or ((.id | floor) != .id) then
            false
        elif (.created_at | type) != "string" then
            false
        elif (.created_at | length) == 0 then
            false
        else
            true
        end
    ' <<<"$task" >/dev/null ||
        fail 'invalid visible Pueue task metadata while recovering an AgentQ submit'
}

reconcile_accepted_request() {
    local request_id=$1
    local record=$2
    local task_label
    local expected_task_id
    local expected_task_created_at
    local task
    local observed_task_id
    local observed_task_created_at

    [ "$(jq -r '.state' <<<"$record")" = accepted ] || fail "cannot reconcile a non-accepted AgentQ request: $request_id"
    task_label=$(jq -r '.task_label' <<<"$record")
    expected_task_id=$(jq -r '.task_id' <<<"$record")
    expected_task_created_at=$(jq -r '.task_created_at' <<<"$record")
    is_task_id "$expected_task_id" || fail "invalid task id in AgentQ request record: $request_id"
    validate_task_id_precision "$expected_task_id"

    find_request_task_rc=0
    task=$(find_request_task "$task_label") || find_request_task_rc=$?
    if [ "$find_request_task_rc" -ne 0 ] && [ "$find_request_task_rc" -ne 1 ]; then
        return "$find_request_task_rc"
    fi
    if [ "$find_request_task_rc" -eq 0 ]; then
        if ! jq -e '
            if type != "object" then
                false
            elif (.id | type) != "number" then
                false
            elif (.id < 0) or ((.id | floor) != .id) then
                false
            elif (.created_at | type) != "string" then
                false
            elif (.created_at | length) == 0 then
                false
            else
                true
            end
        ' <<<"$task" >/dev/null; then
            fail "invalid visible Pueue task metadata while reconciling AgentQ request: $request_id"
        fi
        observed_task_id=$(jq -r '.id' <<<"$task")
        observed_task_created_at=$(jq -r '.created_at' <<<"$task")
        validate_task_id_precision "$observed_task_id"
        if [ "$observed_task_id" != "$expected_task_id" ] || [ "$observed_task_created_at" != "$expected_task_created_at" ]; then
            fail "AgentQ request record does not match the visible Pueue task: $request_id"
        fi
        printf '%s\n' "$record"
        return 0
    fi

    record=$(set_request_state "$record" removed "$expected_task_id" "$(jq -Rn --arg value "$expected_task_created_at" '$value')")
    if ! record=$(archive_removed_request "$request_id" "$record"); then
        printf '%s: failed to archive removed AgentQ request during recovery: %s\n' "$program" "$request_id" >&2
        return 1
    fi
    printf '%s\n' "$record"
    return 1
}

