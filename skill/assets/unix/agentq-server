            ;;
    esac
    [ ! -L "$lock_parent_directory" ] || return 1
    [ ! -L "$lock_directory" ] || return 1
    [ ! -L "$lock_path" ] || return 1
    [ -d "$lock_directory" ] || return 1
    temporary_path=$(make_temporary_file "$lock_directory" '.agentq-lock-metadata') || return 1
    if ! write_temporary_contents "$temporary_path" "$(printf '%s\t%s' "$current_lock_pid" "$current_lock_identity")" ||
        ! install_temporary_file "$temporary_path" "$lock_path"; then
        if ! remove_runtime_temporary_file "$temporary_path" 'lock metadata temporary file'; then
            printf '%s: failed to clean AgentQ lock metadata temporary file: %s\n' "$program" "$lock_path" >&2
            return 1
        fi
        return 1
    fi
}

lock_directory_is_stale_empty() {
    local lock_directory=$1
    local lock_mtime=''
    local current_epoch=''
    local child=''

    path_chain_is_safe "$lock_directory" || return 1
    [ ! -L "$lock_directory" ] || return 1
    [ -d "$lock_directory" ] || return 1
    [ ! -e "$lock_directory/pid" ] && [ ! -L "$lock_directory/pid" ] || return 1
    child=$(find "$lock_directory" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null) || return 1
    [ -z "$child" ] || return 1
    lock_mtime=$(stat_mtime "$lock_directory") || return 1
    current_epoch=$(date +%s) || return 1
    case "$lock_mtime" in
        ''|*[!0-9]*) return 1 ;;
    esac
    case "$current_epoch" in
        ''|*[!0-9]*) return 1 ;;
    esac
    [ "$current_epoch" -ge "$lock_mtime" ] || return 1
    [ $((current_epoch - lock_mtime)) -ge "$lock_empty_grace_seconds" ]
}

lock_is_owned_by_current_process() {
    local lock_path=$1

    read_lock_metadata "$lock_path" || return 1
    [ -n "$lock_identity" ] || return 1
    set_current_process_lock_metadata || return 1
    [ "$current_lock_pid" = "$lock_pid" ] && [ "$current_lock_identity" = "$lock_identity" ]
}

ensure_cancellation_directory() {
    path_chain_is_safe "$cancellation_directory" || fail "invalid AgentQ cancellation directory path: $cancellation_directory"
    [ ! -L "$cancellation_directory" ] || fail "invalid AgentQ cancellation directory path: $cancellation_directory"
    [ -d "$cancellation_directory" ] || fail "missing AgentQ cancellation directory: $cancellation_directory"

    if [ "$platform_kind" = unix ]; then
        chmod 700 "$cancellation_directory" || fail "cannot secure cancellation directory: $cancellation_directory"
    fi
}

ensure_data_directory() {
    path_chain_is_safe "$agentq_root" || fail "invalid AgentQ root path: $agentq_root"
    [ ! -L "$agentq_root" ] || fail "invalid AgentQ root path: $agentq_root"
    [ -d "$agentq_root" ] || fail "missing AgentQ root directory: $agentq_root"
    path_chain_is_safe "$data_directory" || fail "invalid AgentQ data directory path: $data_directory"
    [ ! -L "$data_directory" ] || fail "invalid AgentQ data directory path: $data_directory"
    [ -d "$data_directory" ] || fail "missing AgentQ data directory: $data_directory"
}

ensure_task_log_directory() {
    path_chain_is_safe "$task_log_directory" || fail "invalid AgentQ task log directory path: $task_log_directory"
    [ ! -L "$task_log_directory" ] || fail "invalid AgentQ task log directory path: $task_log_directory"
    [ -d "$task_log_directory" ] || fail "missing AgentQ task log directory: $task_log_directory"
}

ensure_request_directory() {
    path_chain_is_safe "$request_directory" || fail "invalid AgentQ request directory path: $request_directory"
    path_chain_is_safe "$request_lock_directory" || fail "invalid AgentQ request lock directory path: $request_lock_directory"
    path_chain_is_safe "$request_tombstone_directory" || fail "invalid AgentQ request tombstone directory path: $request_tombstone_directory"
    [ ! -L "$request_directory" ] || fail "invalid AgentQ request directory path: $request_directory"
    [ ! -L "$request_lock_directory" ] || fail "invalid AgentQ request lock directory path: $request_lock_directory"
    [ ! -L "$request_tombstone_directory" ] || fail "invalid AgentQ request tombstone directory path: $request_tombstone_directory"
    [ -d "$request_directory" ] || fail "missing AgentQ request directory: $request_directory"
    [ -d "$request_lock_directory" ] || fail "missing AgentQ request lock directory: $request_lock_directory"
    [ -d "$request_tombstone_directory" ] || fail "missing AgentQ request tombstone directory: $request_tombstone_directory"

    if [ "$platform_kind" = unix ]; then
        chmod 700 "$request_directory" "$request_lock_directory" "$request_tombstone_directory" || fail "cannot secure AgentQ request directory: $request_directory"
    fi
}

ensure_runtime_directory() {
    path_chain_is_safe "$runtime_directory" || fail "invalid AgentQ runtime directory path: $runtime_directory"
    [ ! -L "$runtime_directory" ] || fail "invalid AgentQ runtime directory path: $runtime_directory"
    [ -d "$runtime_directory" ] || fail "missing AgentQ runtime directory: $runtime_directory"

    if [ "$platform_kind" = unix ]; then
        chmod 700 "$runtime_directory" || fail "cannot secure AgentQ runtime directory: $runtime_directory"
    fi
}

maintenance_lock_is_stale() {
    local lock_pid=''
    local lock_identity=''

    case "$platform_kind" in
        unix)
            [ -d "$maintenance_lock_directory" ] || return 1
            read_lock_metadata "$maintenance_lock_directory/pid" || return 1
            ;;
        windows)
            [ -f "$maintenance_lock_directory" ] && [ ! -L "$maintenance_lock_directory" ] || return 1
            read_lock_metadata "$maintenance_lock_directory" || return 1
            ;;
    esac

    process_is_confirmed_dead "$lock_pid" "$lock_identity"
}

recover_stale_maintenance_lock() {
    local lock_pid=''
    local lock_identity=''
    local maintenance_lock_pid_path

    if ! path_chain_is_safe "$maintenance_lock_directory"; then
        printf '%s: refusing to recover an unsafe AgentQ maintenance lock: %s\n' "$program" "$maintenance_lock_directory" >&2
        printf '%s: reason=protocol_error\n' "$program" >&2
        return 2
    fi
    if maintenance_lock_is_stale; then
        # Re-confirm immediately before removing.  Between the staleness
        # decision above and the removal below another process may have
        # removed and recreated the lock with a LIVE holder; without the
        # re-read, the ms-wide window deletes that live lock and both holders
        # believe they own it (measured 2026-10-06 by widening the window with
        # a sleep; the installer's recover_stale_maintenance_lock has
        # re-confirmed since 2026-09-24 and smoke/11 pins it with a stateful
        # `ps` stub -- this server copy went straight to the removal).
        case "$platform_kind" in
            unix)
                maintenance_lock_pid_path="$maintenance_lock_directory/pid"
                if [ -e "$maintenance_lock_pid_path" ] || [ -L "$maintenance_lock_pid_path" ]; then
                    read_lock_metadata "$maintenance_lock_pid_path" ||
                        fail "cannot re-read the stale AgentQ maintenance lock metadata: $maintenance_lock_directory"
                    if ! process_is_confirmed_dead "$lock_pid" "$lock_identity"; then
                        printf '%s: the AgentQ maintenance lock holder could not be re-confirmed dead; refusing to remove it: %s\n' "$program" "$maintenance_lock_directory" >&2
                        printf '%s: reason=protocol_error\n' "$program" >&2
                        return 2
                    fi
                fi
                if ! remove_runtime_temporary_file "$maintenance_lock_directory/pid" 'stale maintenance lock metadata'; then
                    fail "cannot recover stale AgentQ maintenance lock: $maintenance_lock_directory"
                fi
                rmdir -- "$maintenance_lock_directory" 2>/dev/null || fail "cannot recover stale AgentQ maintenance lock: $maintenance_lock_directory"
                ;;
            windows)
                if [ -e "$maintenance_lock_directory" ] && [ ! -L "$maintenance_lock_directory" ]; then
                    read_lock_metadata "$maintenance_lock_directory" ||
                        fail "cannot re-read the stale AgentQ maintenance lock metadata: $maintenance_lock_directory"
                    if ! process_is_confirmed_dead "$lock_pid" "$lock_identity"; then
                        printf '%s: the AgentQ maintenance lock holder could not be re-confirmed dead; refusing to remove it: %s\n' "$program" "$maintenance_lock_directory" >&2
                        printf '%s: reason=protocol_error\n' "$program" >&2
                        return 2
                    fi
                fi
                if ! remove_runtime_temporary_file "$maintenance_lock_directory" 'stale maintenance lock'; then
                    fail "cannot recover stale AgentQ maintenance lock: $maintenance_lock_directory"
                fi
                [ ! -e "$maintenance_lock_directory" ] && [ ! -L "$maintenance_lock_directory" ] || fail "cannot recover stale AgentQ maintenance lock: $maintenance_lock_directory"
                ;;
        esac
    fi
}

ensure_not_in_maintenance() {
    if [ -L "$maintenance_lock_directory" ]; then
        fail "invalid AgentQ maintenance lock path: $maintenance_lock_directory"
    fi
    if [ -e "$maintenance_lock_directory" ]; then
        case "$platform_kind" in
            unix)
                [ -d "$maintenance_lock_directory" ] || fail "invalid AgentQ maintenance lock path: $maintenance_lock_directory"
                ;;
            windows)
                [ -f "$maintenance_lock_directory" ] || fail "invalid AgentQ maintenance lock path: $maintenance_lock_directory"
                ;;
        esac
        recover_stale_maintenance_lock
    fi
    if [ -e "$maintenance_lock_directory" ]; then
        # lock_contention, not the default protocol_error: the message already
        # tells the caller to retry, and an installer window is exactly the
        # "retryable, nothing you passed is wrong" case that class names.
        fail "AgentQ maintenance is in progress; retry after the installer completes" lock_contention
    fi
}

release_owned_lock() {
    local lock_path=$1
    local lock_kind=$2
    local pid_path
    local remove_status

    [ -n "$lock_path" ] || return 0
    if ! path_chain_is_safe "$lock_path"; then
        printf '%s: refusing to remove an unsafe AgentQ %s lock: %s\n' "$program" "$lock_kind" "$lock_path" >&2
        return 2
    fi
    if [ ! -e "$lock_path" ] && [ ! -L "$lock_path" ]; then
        return 0
    fi
    if [ ! -d "$lock_path" ] || [ -L "$lock_path" ]; then
        printf '%s: refusing to remove an unsafe AgentQ %s lock: %s\n' "$program" "$lock_kind" "$lock_path" >&2
        return 2
    fi
    pid_path="$lock_path/pid"
    if runtime_temporary_path_is_safe "$pid_path"; then
        :
    else
        printf '%s: refusing to remove an unsafe AgentQ lock metadata: %s\n' "$program" "$pid_path" >&2
        return 2
    fi
    if lock_is_owned_by_current_process "$pid_path"; then
        :
    else
        return 0
    fi
    if remove_runtime_temporary_file "$pid_path" 'lock metadata'; then
        :
    else
        remove_status=$?
        return "$remove_status"
    fi
    if ! rmdir -- "$lock_path"; then
        printf '%s: failed to remove AgentQ %s lock directory: %s\n' "$program" "$lock_kind" "$lock_path" >&2
        return 1
    fi
    if [ -e "$lock_path" ] || [ -L "$lock_path" ]; then
        printf '%s: AgentQ %s lock directory remained after cleanup: %s\n' "$program" "$lock_kind" "$lock_path" >&2
        return 1
    fi
    return 0
}

release_request_lock() {
    local lock_path=$request_lock
    local release_status

    if release_owned_lock "$lock_path" request; then
        request_lock=''
        return 0
    else
        release_status=$?
        return "$release_status"
    fi
}

release_operation_lock() {
    local lock_path=$operation_lock
    local release_status

    if release_owned_lock "$lock_path" operation; then
        operation_lock=''
        return 0
    else
        release_status=$?
        return "$release_status"
    fi
}

cleanup() {
    local cleanup_status=0

    if [ -n "$compact_log_raw_file" ]; then
        remove_runtime_temporary_file "$compact_log_raw_file" 'compact log raw log file' || cleanup_status=1
        compact_log_raw_file=''
    fi
    if [ -n "$reconcile_raw_status_file" ]; then
        remove_runtime_temporary_file "$reconcile_raw_status_file" 'reconciliation raw status file' || cleanup_status=1
        reconcile_raw_status_file=''
    fi
    if [ -n "$group_raw_file" ]; then
        remove_runtime_temporary_file "$group_raw_file" 'group raw response file' || cleanup_status=1
        group_raw_file=''
    fi
    release_request_metadata_files || cleanup_status=1
    release_operation_lock || cleanup_status=1
    release_request_lock || cleanup_status=1
    return "$cleanup_status"
}

# `|| true` for the same measured reason the POSIX clients' EXIT traps carry it
# (measured 2026-10-13 on bash and dash): under `set -e` a non-zero return from
# the trap body trips errexit and the shell exits with the CLEANUP's status,
# discarding the protocol code the body produced -- a successful `exit 0` reads
# as 1, and a `wait`'s 5/6 or a `fail`'s 2 (reason line already printed) read as
# an undifferentiated 1.  The cleanup steps fold their own failures into
# `cleanup_status` and print messages; the exit code must stay the body's.
trap 'cleanup || true' EXIT

# One NON-BLOCKING pass of the stale-lock recovery that acquire_operation_lock
# performs in its retry loop.  Lock-free reads skip the lock, but the stale-lock
# recovery contract (smoke/03) is pinned through `status`: an empty backdated
# lock, or one whose recorded holder is confirmed dead, must still be cleaned by
# the next command that touches the runtime.  A LIVE lock is left alone and the
# read proceeds anyway -- that is the whole point of the lock-free read; the
# live holder's own release path owns that lock.
recover_stale_operation_lock_for_read() {
    local candidate="$operation_lock_directory"
    local stale_read_recovery_status

    [ -e "$candidate" ] || [ -L "$candidate" ] || return 0
    path_chain_is_safe "$candidate" || fail "invalid AgentQ operation lock path: $candidate"
    [ ! -L "$candidate" ] || fail "invalid AgentQ operation lock path: $candidate"
    [ -d "$candidate" ] || fail "invalid AgentQ operation lock path: $candidate"
    if read_lock_metadata "$candidate/pid"; then
        if process_is_confirmed_dead "$lock_pid" "$lock_identity"; then
            # A READ does not need this lock at all (that is the whole point of
            # the lock-free read paths), so clearing a stale one is best-effort:
            # if the lock is no longer the one we inspected -- a concurrent run
            # removed it, or a writer just created a live one -- the right
            # answer is to carry on, not to fail.  Failing here made two
            # concurrent reads race: the loser exited 2 with
            # reason=protocol_error while the winner succeeded (measured
            # 2026-10-16 by reading remove_stale_lock's return values: 2 means
            # "unsafe or changed", 1 means a real removal failure).  Only the
            # real failure is fatal.  remove_stale_lock still prints its
            # one-line diagnostic for the changed case, so a rare race is
            # visible on stderr without turning a successful read into an
            # error.
            if remove_stale_lock "$candidate" operation "$lock_pid" "$lock_identity"; then
                :
            else
                stale_read_recovery_status=$?
                [ "$stale_read_recovery_status" -eq 2 ] ||
                    fail "cannot recover stale AgentQ operation lock: $candidate"
            fi
        fi
    elif lock_directory_is_stale_empty "$candidate"; then
        if remove_stale_lock "$candidate" operation '' '' true; then
            :
        else
            stale_read_recovery_status=$?
            [ "$stale_read_recovery_status" -eq 2 ] ||
                fail "cannot recover empty AgentQ operation lock: $candidate"
        fi
    fi
    return 0
}

acquire_operation_lock() {
    local candidate="$operation_lock_directory"
    local candidate_parent
    local attempt=0
    local lock_pid=''
    local lock_identity=''
    local lock_mtime
    local current_epoch
    local lock_holder_age
    local operation_lock_holder
    local operation_lock_message

    case "$candidate" in
        */*)
            candidate_parent=${candidate%/*}
            [ -n "$candidate_parent" ] || candidate_parent=/
            ;;
        *)
            candidate_parent=.
            ;;
    esac

    path_chain_is_safe "$candidate" || fail "invalid AgentQ operation lock path: $candidate"
    [ -z "$operation_lock" ] || return 0
    ensure_not_in_maintenance
    set_current_process_lock_metadata || fail "cannot determine AgentQ operation lock owner"

    while [ "$attempt" -lt "$lock_acquire_attempts" ]; do
        [ ! -L "$candidate_parent" ] || fail "invalid AgentQ operation lock parent path: $candidate_parent"
        [ ! -L "$candidate" ] || fail "invalid AgentQ operation lock path: $candidate"
        if mkdir -- "$candidate" 2>/dev/null; then
            if ! write_lock_metadata "$candidate/pid"; then
                attempt=$((attempt + 1))
                [ "$attempt" -lt "$lock_acquire_attempts" ] ||
                    fail "cannot initialize AgentQ operation lock: $candidate"
                sleep "$lock_retry_delay_seconds"
                continue
            fi
            operation_lock=$candidate
            if [ -e "$maintenance_lock_directory" ] || [ -L "$maintenance_lock_directory" ]; then
                if ! release_operation_lock; then
                    fail "cannot release AgentQ operation lock while maintenance lock is present: $candidate"
                fi
                ensure_not_in_maintenance
                continue
            fi
            if ! ensure_request_record_layout; then
                fail "cannot prepare AgentQ request record layout: $candidate"
            fi
            return 0
        fi

        [ ! -L "$candidate_parent" ] || fail "invalid AgentQ operation lock parent path: $candidate_parent"
        [ ! -L "$candidate" ] || fail "invalid AgentQ operation lock path: $candidate"
        if read_lock_metadata "$candidate/pid"; then
            if process_is_confirmed_dead "$lock_pid" "$lock_identity"; then
                if ! remove_stale_lock "$candidate" operation "$lock_pid" "$lock_identity"; then
                    fail "cannot recover stale AgentQ operation lock: $candidate"
                fi
                continue
            fi
        elif lock_directory_is_stale_empty "$candidate"; then
            if ! remove_stale_lock "$candidate" operation '' '' true; then
                fail "cannot recover empty AgentQ operation lock: $candidate"
            fi
            continue
        fi

        attempt=$((attempt + 1))
        sleep "$lock_retry_delay_seconds"
    done

    # The retry loop's last read_lock_metadata left lock_pid/lock_identity
    # populated (when the lock carries a pid file), so surface the holder:
    # the session-log mining run of 2026-10-15 found the most expensive real
    # usage shape was a caller unable to tell a live operation from a stale
    # lock -- including a stale Windows lock that survived 17 days, where no
    # agent dared clean it precisely because nothing said who held it.
    operation_lock_holder=''
    if [ -n "$lock_pid" ]; then
        operation_lock_holder="held by pid $lock_pid (started: $lock_identity)"
    fi
    lock_holder_age=''
    lock_mtime=$(stat_mtime "$candidate") || lock_mtime=''
    if [ -n "$lock_mtime" ]; then
        current_epoch=$(date +%s) || current_epoch=''
        case "$lock_mtime$current_epoch" in
            *[!0-9]*) ;;
            *)
                # Clamp at zero.  A negative age (the lock directory's mtime is
                # in the FUTURE -- clock skew, or an NFS/VM clock correction)
                # would print `lock age -3s`, which reads as nonsense to the
                # operator this line exists for and could be mistaken for a
                # sentinel.  `0s` is the honest answer: "just now, by this
                # clock".  Measured 2026-10-16: with only the arithmetic, a
                # future mtime printed a negative age.
                lock_holder_age=$((current_epoch - lock_mtime))
                [ "$lock_holder_age" -ge 0 ] || lock_holder_age=0
                ;;
        esac
    fi
    operation_lock_message="AgentQ operation is already in progress: $candidate"
    if [ -n "$operation_lock_holder" ]; then
        operation_lock_message="$operation_lock_message ($operation_lock_holder"
        if [ -n "$lock_holder_age" ]; then
            operation_lock_message="$operation_lock_message, lock age ${lock_holder_age}s"
        fi
        operation_lock_message="$operation_lock_message)"
    fi
    fail "$operation_lock_message" lock_contention
}

operation_lock_is_held() {
    [ -n "$operation_lock" ] && [ -d "$operation_lock" ]
}

with_operation_lock() {
    local command_status
    local release_status

    if operation_lock_is_held; then
        "$@"
        return
    fi

    acquire_operation_lock
    if "$@"; then
        command_status=0
    else
        command_status=$?
    fi
    if release_operation_lock; then
        :
    else
        release_status=$?
        if [ "$command_status" -eq 0 ]; then
            command_status=$release_status
            # The command succeeded but the operation lock could not be
            # released.  release_owned_lock already printed a human message for
            # each shape, but the contract requires EVERY exit-2 path to carry a
            # machine-readable reason line -- and this code (2 for an unsafe
            # lock path, 1 for another cleanup failure) reaches the top level
            # here.  Without this line a caller reading `reason=` saw an empty
            # class and could misread the server's status.
            if [ "$command_status" -eq 2 ]; then
                printf '%s: reason=protocol_error\n' "$program" >&2
            fi
        fi
    fi
    return "$command_status"
}

remove_stale_lock() {
    local lock_path=$1
    local lock_kind=$2
    local expected_pid=${3:-}
    local expected_identity=${4:-}
    local require_empty=${5:-false}
    local pid_path
    local remove_status

    [ -n "$lock_path" ] || return 1
    if ! path_chain_is_safe "$lock_path"; then
        printf '%s: refusing to recover an unsafe AgentQ %s lock: %s\n' "$program" "$lock_kind" "$lock_path" >&2
        return 2
    fi
    if [ ! -d "$lock_path" ] || [ -L "$lock_path" ]; then
        printf '%s: refusing to recover an unsafe AgentQ %s lock: %s\n' "$program" "$lock_kind" "$lock_path" >&2
        return 2
    fi
    pid_path="$lock_path/pid"
    if [ "$require_empty" = true ]; then
        if [ -e "$pid_path" ] || [ -L "$pid_path" ]; then
            printf '%s: AgentQ %s lock changed while recovering its empty directory: %s\n' "$program" "$lock_kind" "$lock_path" >&2
            return 2
        fi
    elif [ -n "$expected_pid" ]; then
        if ! read_lock_metadata "$pid_path" ||
            [ "$lock_pid" != "$expected_pid" ] ||
            [ "$lock_identity" != "$expected_identity" ]; then
            printf '%s: AgentQ %s stale lock identity changed during recovery: %s\n' "$program" "$lock_kind" "$lock_path" >&2
            return 2
        fi
    fi
    if [ -e "$pid_path" ] || [ -L "$pid_path" ]; then
        if remove_runtime_temporary_file "$pid_path" 'stale lock metadata'; then
            :
        else
            remove_status=$?
            return "$remove_status"
        fi
    fi
    if ! rmdir -- "$lock_path"; then
        printf '%s: failed to remove AgentQ %s stale lock directory: %s\n' "$program" "$lock_kind" "$lock_path" >&2
        return 1
    fi
    if [ -e "$lock_path" ] || [ -L "$lock_path" ]; then
        printf '%s: AgentQ %s stale lock directory remained after cleanup: %s\n' "$program" "$lock_kind" "$lock_path" >&2
        return 1
    fi
    return 0
}

run_pueue() {
    case "$platform_kind" in
        windows)
            env -i \
                HOME="$agentq_home" \
                USER="$agentq_user" \
                USERNAME="$agentq_user" \
                USERPROFILE="$agentq_userprofile" \
                APPDATA="$agentq_appdata" \
                LOCALAPPDATA="$agentq_localappdata" \
                HOMEDRIVE="$agentq_homedrive" \
                HOMEPATH="$agentq_homepath" \
                SystemRoot="$agentq_systemroot" \
                SystemDrive="$agentq_systemdrive" \
                WINDIR="$agentq_windir" \
                ComSpec="$agentq_comspec" \
                PATHEXT="$agentq_pathext" \
                TEMP="$agentq_temp" \
                TMP="$agentq_tmp" \
                MSYSTEM="$agentq_msystem" \
                MSYS_NO_PATHCONV=1 \
                PATH="$agentq_windows_path" \
                "$pueue_bin" --config "$pueue_config_path" "$@"
