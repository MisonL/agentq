task_identity_is_unambiguous() {
    local task=$1
    local command_status

    if ! prepare_request_metadata_files; then
        return 1
    fi
    if ! require_runtime_temporary_file "$request_records_file" ||
        ! require_runtime_temporary_file "$cancellation_markers_file"; then
        cleanup_task_identity_metadata_after_failure || return 1
        return 1
    fi
    if ! require_runtime_temporary_file "$request_records_file" ||
        ! require_runtime_temporary_file "$cancellation_markers_file"; then
        cleanup_task_identity_metadata_after_failure || return 1
        return 1
    fi
    if jq -ne --slurpfile requests "$request_records_jq_file" --argjson task "$task" '
        def canonical_integer_string:
            tostring
            | sub("^0+"; "")
            | if . == "" then "0" else . end;
        def same_task_id($left; $right):
            ($left | canonical_integer_string) == ($right | canonical_integer_string);
        [
            $requests[0][]
            | select(
                (.state == "accepted" or .state == "removing")
                and same_task_id(.task_id; $task.id)
            )
        ] as $matches
        | if ($matches | length) == 0 then
            true
          elif ($matches | length) == 1 then
            ($matches[0].task_created_at == $task.created_at)
          else
            false
          end
    ' >/dev/null; then
        command_status=0
    else
        command_status=$?
    fi
    release_request_metadata_files || command_status=1
    return "$command_status"
}

wait_reconcile_missing_task() {
    local task_id=$1
    local allow_untracked=${2:-false}
    local tombstone_files=()
    local record_files=()
    local path
    local request_id
    local tombstone
    local record
    local record_state
    local record_task_id
    local record_ids=()
    local tombstone_ids=()
    local tombstone_task_id
    local tombstone_created_at
    local output
    local wait_read_status=0
    local wait_tombstone_status=0
    local matched_request_id=''
    local matched_record=''
    local matched_tombstone_request_id=''
    local matched_tombstone_created_at=''
    local task_created_at
    local raw_status_file

    validate_task_id_precision "$task_id"
    shopt -s nullglob
    tombstone_files=("$request_tombstone_directory"/*.json)
    record_files=("$request_directory"/*.json)
    shopt -u nullglob

    if [ "${#record_files[@]}" -gt 0 ]; then
        # The ids are collected in the parent shell: the body loop below runs
        # left of a pipe, so an array filled there would never arrive (the
        # $( )/pipeline trap this repo has recorded four times).
        for path in "${record_files[@]}"; do
            request_id=${path##*/}
            request_id=${request_id%.json}
            is_request_id "$request_id" || fail "invalid AgentQ request record filename: $path"
            record_ids+=("$request_id")
        done
        # Fast path: ONE aggregate jq yields four lines per record (id, state,
        # task id, body) instead of one jq per file -- this scan is the wait
        # path's dominant cost at scale.  The guards AND the aggregate run in
        # one subshell whose stderr is discarded, so any failure (guard,
        # length mismatch, malformed record, unreadable body) falls back to the
        # verbatim per-file loop below and reproduces its exact stderr/exit.
        if output=$(
            {
                for path in "${record_files[@]}"; do
                    request_record_path_guards_or_fail "$path"
                    printf '%s\n' "$(<"$path")"
                done | jq -rs --args "$request_records_states_filter" -- "${record_ids[@]}"
            } 2>/dev/null
        ); then
            while IFS= read -r request_id && IFS= read -r record_state &&
                IFS= read -r record_task_id && IFS= read -r record; do
                case "$record_state" in
                    accepted|removing)
                        validate_task_id_precision "$record_task_id"
                        if [ "$(canonical_task_id "$record_task_id")" = "$(canonical_task_id "$task_id")" ]; then
                            [ -z "$matched_record" ] || fail "multiple AgentQ request records match task id: $task_id"
                            matched_request_id=$request_id
                            matched_record=$record
                        fi
                        ;;
                esac
            done <<<"$output"
        else
            for path in "${record_files[@]}"; do
                request_id=${path##*/}
                request_id=${request_id%.json}
                is_request_id "$request_id" || fail "invalid AgentQ request record filename: $path"
                # rc=1 is the vanished verdict (the reader returns it when the
                # record is gone rather than unsafe); every other failure keeps
                # the original loud `fail`.  Same reader, same rule -- the
                # repair fallback and this one must not disagree about what
                # "gone" means.
                wait_read_status=0
                output=$(read_request_record_state_and_body "$request_id") ||
                    wait_read_status=$?
                if [ "${wait_read_status:-0}" -eq 1 ]; then
                    wait_read_status=0
                    continue
                fi
                if [ "${wait_read_status:-0}" -ne 0 ]; then
                    wait_read_status=0
                    fail "missing AgentQ request record during wait recovery: $path"
                fi
                record_state=${output%%$'\n'*}
                output=${output#*$'\n'}
                record_task_id=${output%%$'\n'*}
                record=${output#*$'\n'}
                case "$record_state" in
                    accepted|removing)
                        validate_task_id_precision "$record_task_id"
                        if [ "$(canonical_task_id "$record_task_id")" = "$(canonical_task_id "$task_id")" ]; then
                            [ -z "$matched_record" ] || fail "multiple AgentQ request records match task id: $task_id"
                            matched_request_id=$request_id
                            matched_record=$record
                        fi
                        ;;
                esac
            done
        fi
    fi

    if [ -z "$matched_record" ]; then
        if [ "${#tombstone_files[@]}" -gt 0 ]; then
            for path in "${tombstone_files[@]}"; do
                request_id=${path##*/}
                request_id=${request_id%.json}
                is_request_id "$request_id" || fail "invalid AgentQ request tombstone filename: $path"
                tombstone_ids+=("$request_id")
            done
            # Fast path: ONE aggregate jq yields three lines per tombstone (id,
            # task id, created_at) instead of three jq per file.  Same
            # fast-path/fallback contract as the record scan above: any failure
            # falls back to the verbatim per-file loop and reproduces its exact
            # stderr/exit.  The first match in glob order wins, as the loop's
            # `break` did.
            if output=$(
                {
                    for path in "${tombstone_files[@]}"; do
                        # Same `null` placeholder as the record scan above: a
                        # tombstone removed between the glob and the read must
                        # not abort the whole scan, and a bare `continue` would
                        # drop a line while the positional binding still carries
                        # its id.
                        if ! request_tombstone_path_guards_or_fail "$path"; then
                            printf 'null\n'
                            continue
                        fi
                        printf '%s\n' "$(<"$path")"
                    done | jq -rs --args "$request_tombstones_states_filter" -- "${tombstone_ids[@]}"
                } 2>/dev/null
            ); then
                while IFS= read -r request_id && IFS= read -r tombstone_task_id &&
                    IFS= read -r tombstone_created_at; do
                    validate_task_id_precision "$tombstone_task_id"
                    if [ "$(canonical_task_id "$tombstone_task_id")" = "$(canonical_task_id "$task_id")" ]; then
                        matched_tombstone_request_id=$request_id
                        matched_tombstone_created_at=$tombstone_created_at
                        break
                    fi
                done <<<"$output"
            else
                for path in "${tombstone_files[@]}"; do
                    request_id=${path##*/}
                    request_id=${request_id%.json}
                    is_request_id "$request_id" || fail "invalid AgentQ request tombstone filename: $path"
                    # vanish-between-glob-and-read is the concurrent-archiver
                    # race (2026-10-13): skip, the scanner converges on the
                    # next invocation instead of exiting 2 with a misleading
                    # "missing tombstone" on a file that never belonged to us.
                    #
                    # The status is captured rather than folded with `|| fail`:
                    # read_request_tombstone returns 1 for GONE (the skip
                    # verdict this loop wants) and 2 via `fail` for a real
                    # violation, so the two must not be collapsed -- the exact
                    # mistake this file records for the record-side fallback.
                    wait_tombstone_status=0
                    tombstone=$(read_request_tombstone "$request_id") ||
                        wait_tombstone_status=$?
                    if [ "${wait_tombstone_status:-0}" -eq 1 ]; then
                        wait_tombstone_status=0
                        continue
                    fi
                    if [ "${wait_tombstone_status:-0}" -ne 0 ]; then
                        wait_tombstone_status=0
                        fail "missing AgentQ request tombstone during wait recovery: $path"
                    fi
                    validate_task_id_precision "$(jq -r '.task_id' <<<"$tombstone")"
                    if [ "$(canonical_task_id "$(jq -r '.task_id' <<<"$tombstone")")" = "$(canonical_task_id "$task_id")" ]; then
                        matched_tombstone_request_id=$request_id
                        matched_tombstone_created_at=$(jq -r '.task_created_at' <<<"$tombstone")
                        break
                    fi
                done
            fi
        fi
        if [ -z "$matched_tombstone_request_id" ] && [ "$allow_untracked" != true ]; then
            return 1
        fi
    fi

    raw_status_file=$(umask 077; make_temporary_file "$runtime_directory" '.agentq-reconcile-status' '.json') || {
        jq -cn --argjson task_id "$task_id" '{task_id: $task_id, state: "unavailable"}'
        printf '%s: cannot allocate a status temporary file before waiting for task %s; the final state is unavailable\n' "$program" "$task_id" >&2
        return 6
    }
    reconcile_raw_status_file=$raw_status_file
    require_runtime_temporary_file "$raw_status_file"
    require_runtime_temporary_file "$raw_status_file"
    require_runtime_temporary_file "$raw_status_file"
    require_runtime_temporary_file "$raw_status_file"
    if ! run_pueue status --json > "$raw_status_file"; then
        if ! remove_runtime_temporary_file "$raw_status_file" 'reconciliation raw status file'; then
            printf '%s: failed to clean AgentQ reconciliation raw status temporary file: %s\n' "$program" "$raw_status_file" >&2
        fi
        reconcile_raw_status_file=''
        jq -cn --argjson task_id "$task_id" '{task_id: $task_id, state: "unavailable"}'
        printf '%s: cannot inspect task %s before wait; the final state is unavailable\n' "$program" "$task_id" >&2
        return 6
    fi
    if ! require_runtime_temporary_file "$raw_status_file"; then
        if ! remove_runtime_temporary_file "$raw_status_file" 'reconciliation raw status file'; then
            printf '%s: failed to clean AgentQ reconciliation raw status temporary file: %s\n' "$program" "$raw_status_file" >&2
        fi
        reconcile_raw_status_file=''
        jq -cn --argjson task_id "$task_id" '{task_id: $task_id, state: "unavailable"}'
        printf '%s: status temporary file became unavailable before wait reconciliation\n' "$program" >&2
        return 6
    fi
    # This recovery path parses the raw status directly instead of going
    # through raw_compact_task. Apply the same file-level precision guard
    # before any jq operation so an unsupported parser cannot round an
    # unrelated persisted task id while deciding whether this task vanished.
    validate_pueue_task_id_precision_in_file "$raw_status_file"
    require_runtime_temporary_file "$raw_status_file"
    validate_pueue_task_shape_in_file "$raw_status_file"
    if ! require_runtime_temporary_file "$raw_status_file"; then
        if ! remove_runtime_temporary_file "$raw_status_file" 'reconciliation raw status file'; then
            printf '%s: failed to clean AgentQ reconciliation raw status temporary file: %s\n' "$program" "$raw_status_file" >&2
        fi
        reconcile_raw_status_file=''
        jq -cn --argjson task_id "$task_id" '{task_id: $task_id, state: "unavailable"}'
        printf '%s: status temporary file became unavailable before wait task lookup\n' "$program" >&2
        return 6
    fi
    if ! jq -e '(.tasks | type) == "object"' < "$raw_status_file" >/dev/null; then
        if remove_runtime_temporary_file "$raw_status_file" 'reconciliation raw status file'; then
            reconcile_raw_status_file=''
        fi
        jq -cn --argjson task_id "$task_id" '{task_id: $task_id, state: "unavailable"}'
        printf '%s: Pueue returned an invalid status before waiting for task %s\n' "$program" "$task_id" >&2
        return 6
    fi
    if jq -e --arg id "$task_id" '.tasks[$id] != null' < "$raw_status_file" >/dev/null; then
        if remove_runtime_temporary_file "$raw_status_file" 'reconciliation raw status file'; then
            reconcile_raw_status_file=''
        fi
        jq -cn --argjson task_id "$task_id" '{task_id: $task_id, state: "unavailable"}'
        printf '%s: task %s still exists but cannot be rendered before wait\n' "$program" "$task_id" >&2
        return 6
    fi

    if ! remove_runtime_temporary_file "$raw_status_file" 'reconciliation raw status file'; then
        jq -cn --argjson task_id "$task_id" '{task_id: $task_id, state: "unavailable"}'
        printf '%s: final state for task %s is unavailable because the status temporary file could not be cleaned\n' "$program" "$task_id" >&2
        return 6
    fi
    reconcile_raw_status_file=''

    if [ -n "$matched_record" ]; then
        task_created_at=$(jq -r '.task_created_at' <<<"$matched_record")
        # Errexit is OFF (this function runs as an `if` condition); a bare `$( )`
        # failure would archive an empty record and the wait would then report
        # `removed` for a task whose record was destroyed.
        record=$(set_request_state "$matched_record" removed "$task_id" "$(jq -Rn --arg value "$task_created_at" '$value')") || {
            jq -cn --argjson task_id "$task_id" '{task_id: $task_id, state: "unavailable"}'
            printf '%s: final state for task %s is unavailable because the request record could not be updated\n' "$program" "$task_id" >&2
            return 6
        }
        if ! archive_removed_request "$matched_request_id" "$record" >/dev/null; then
            jq -cn --argjson task_id "$task_id" '{task_id: $task_id, state: "unavailable"}'
            printf '%s: final state for task %s is unavailable because request archival failed\n' "$program" "$task_id" >&2
            return 6
        fi
    elif [ -n "$matched_tombstone_request_id" ]; then
        remove_cancellation_marker_for_task "$task_id" "$matched_tombstone_created_at" || {
            jq -cn --argjson task_id "$task_id" '{task_id: $task_id, state: "unavailable"}'
            printf '%s: final state for task %s is unavailable because the cancellation marker could not be cleaned\n' "$program" "$task_id" >&2
            return 6
        }
    fi
    jq -cn --argjson task_id "$task_id" '{task_id: $task_id, state: "removed"}'
    if [ "$allow_untracked" = true ]; then
        printf '%s: task %s was removed while waiting\n' "$program" "$task_id" >&2
    elif [ -n "$matched_record" ]; then
        printf '%s: task %s was removed before wait\n' "$program" "$task_id" >&2
    elif [ -n "$matched_tombstone_request_id" ]; then
        printf '%s: task %s was already removed before wait\n' "$program" "$task_id" >&2
    else
        printf '%s: task %s was removed while waiting\n' "$program" "$task_id" >&2
    fi
    return 5
}

task_is_done() {
    jq -e '.status | has("Done")' >/dev/null
}

task_is_queued() {
    jq -e '.status | has("Queued")' >/dev/null
}

task_succeeded() {
    jq -e '.status.Done.result == "Success"' >/dev/null
}

task_log_path() {
    local task_id=$1

    validate_task_id_precision "$task_id"
    [ "$(canonical_task_id "$task_id")" = "$task_id" ] ||
        fail "non-canonical AgentQ task id: $task_id"
    printf '%s/%s.log\n' "$task_log_directory" "$task_id"
}

task_log_file_is_safe() {
    local log_path=$1
    local log_parent=${log_path%/*}

    [ -n "$log_path" ] || return 1
    path_chain_is_safe "$log_path" || return 1
    [ "$log_parent" != "$log_path" ] || log_parent=.
    [ -f "$log_path" ] || return 1
    [ ! -L "$log_path" ] || return 1
    [ -d "$log_parent" ] || return 1
    [ ! -L "$log_parent" ] || return 1
}

require_task_log_file() {
    local log_path=$1

    task_log_file_is_safe "$log_path" || fail "unsafe AgentQ task log path: $log_path"
}

cancellation_marker_path() {
    local task_id=$1

    validate_task_id_precision "$task_id"
    [ "$(canonical_task_id "$task_id")" = "$task_id" ] ||
        fail "non-canonical AgentQ task id: $task_id"
    printf '%s/%s.json\n' "$cancellation_directory" "$task_id"
}

cancellation_marker_is_valid() {
    local marker_path=$1
    local task_id=$2
    local marker_read_status
    local marker_body

    # Validate the decimal text before jq parses it.  This direct helper is
    # used by read_cancellation_marker(), so relying only on
    # load_cancellation_markers() would let a low-precision jq round an
    # unsafe persisted id on the single-marker path.
    # Returns 1 when the marker VANISHED (a concurrent archiver), so both
    # callers can skip it; `fail` still ends the process on a real violation.
    request_metadata_file_is_safe "$marker_path" || {
        tracked_path_vanished "$marker_path" && return 1
        fail "invalid AgentQ cancellation marker path: $marker_path"
    }
    validate_task_id_precision_in_file "$marker_path"
    request_metadata_file_is_safe "$marker_path" || {
        tracked_path_vanished "$marker_path" && return 1
        fail "invalid AgentQ cancellation marker path: $marker_path"
    }
    # Silent read, then jq from the string.  The guard above and the open below
    # are separated by a window in which an archiver can remove the marker;
    # `jq < "$marker_path"` then prints bash's OWN redirection error on stderr,
    # and the clients capture the remote stderr to look for `reason=` -- so a
    # benign race left unexplained text on a call that succeeded.  Measured
    # 2026-10-23: `status` exited 0 with `<path>: No such file or directory` on
    # stderr.  Same shape as the record and tombstone readers.
    marker_read_status=0
    marker_body=$(cat -- "$marker_path" 2>/dev/null) || marker_read_status=$?
    if [ "$marker_read_status" -ne 0 ]; then
        tracked_path_vanished "$marker_path" && return 1
        fail "invalid AgentQ cancellation marker path: $marker_path"
    fi
    jq -ce --arg task_id "$task_id" '
        def valid_task_id:
            if type != "number" then
                false
            else
                (. >= 0) and ((floor) == .)
            end;
        def canonical_integer_string:
            tostring
            | sub("^0+"; "")
            | if . == "" then "0" else . end;
        if (
            (.task_id | valid_task_id)
            and (.task_id | canonical_integer_string) == ($task_id | canonical_integer_string)
            and (.created_at | type) == "string"
            and (.created_at | length) > 0
            and (.requested_at | type) == "string"
            and (.requested_at | length) > 0
            and (.reason | type) == "string"
            and (.reason | length) > 0
            and ((.state? == null) or .state == "pending" or .state == "requested")
        ) then
            if .state? == null then . + {state: "requested"} else . end
        else error("invalid AgentQ cancellation marker") end
    ' <<<"$marker_body"
}

read_cancellation_marker() {
    local task_id=$1
    local marker_path
    local marker_status

    marker_path=$(cancellation_marker_path "$task_id")
    if [ ! -e "$marker_path" ] && [ ! -L "$marker_path" ]; then
        return 1
    fi
    # NO direct guards here: cancellation_marker_is_valid runs the same
    # identity checks as its first step, and a second walk of an unchanged
    # path buys nothing (the measurement that trimmed load_request_records and
    # the record/tombstone readers).  More importantly, these two lines used to
    # `fail` BEFORE the vanish-tolerant validator could see the file, so the
    # comment below ("a vanished marker is no marker") was not true of this
    # function: an archiver removing the marker between the existence check and
    # here turned a lock-free `status` into exit 2 + `invalid ... path`.
    # Measured 2026-10-22 by injecting the rm at exactly that point.
    #
    # A vanished marker is "no marker" for every caller of this function.
    marker_status=0
    cancellation_marker_is_valid "$marker_path" "$task_id" || marker_status=$?
    if [ "$marker_status" -eq 1 ]; then
        return 1
    elif [ "$marker_status" -ne 0 ]; then
        fail "invalid AgentQ cancellation marker: $marker_path"
    fi
    return 0
}

# compact_task/raw_compact_task exit 4 only when Pueue ANSWERED and this id is
# not visible; 1 (read failure) and 2/5 (malformed status) mean the task's
# existence is UNKNOWN.  Folding all of them into "unknown AgentQ task id"
# tells the caller to fix its arguments when the truth is "Pueue could not be
# read, retry" -- the same misattribution find_request_task's callers had and
# the 2026-09-24 fix addressed there (measured 2026-10-07: an injected
# transient failure on logs/cancel/remove each reported "unknown task id").
# rc=0 returns so callers can use this as a guard.
report_compact_task_failure() {
    local compact_status=$1
    local task_id=$2

    [ "$compact_status" -ne 0 ] || return 0
    if [ "$compact_status" -eq 4 ]; then
        fail "unknown AgentQ task id: $task_id"
    fi
    fail "cannot inspect Pueue while reading AgentQ task: $task_id"
}

write_cancellation_marker() {
    local task_id=$1
    local created_at=$2
    local requested_at=$3
    local state=$4
    local marker
    local temporary
    local marker_contents

    validate_task_id_precision "$task_id"
    case "$state" in
        pending|requested) ;;
        *) fail "invalid AgentQ cancellation marker state: $state" ;;
    esac

    marker=$(cancellation_marker_path "$task_id")
    temporary=$(umask 077; make_temporary_file "$cancellation_directory" ".agentqcancel.${task_id}" '.json') ||
        fail "cannot create temporary AgentQ cancellation marker: $task_id"
    marker_contents=$(jq -cn \
        --argjson task_id "$task_id" \
        --arg created_at "$created_at" \
        --arg requested_at "$requested_at" \
        --arg reason 'user_requested' \
        --arg state "$state" \
        '{task_id: $task_id, created_at: $created_at, requested_at: $requested_at, reason: $reason, state: $state}') || {
        if ! remove_runtime_temporary_file "$temporary" 'cancellation marker temporary file'; then
            fail "cannot encode AgentQ cancellation marker; temporary cleanup failed: $task_id"
        fi
        fail "cannot encode AgentQ cancellation marker: $task_id"
    }
    if ! write_temporary_contents "$temporary" "$marker_contents" ||
        ! install_temporary_file "$temporary" "$marker"; then
        if ! remove_runtime_temporary_file "$temporary" 'cancellation marker temporary file'; then
            fail "cannot write AgentQ cancellation marker; temporary cleanup failed: $task_id"
        fi
        fail "cannot write AgentQ cancellation marker: $task_id"
    fi
}

remove_cancellation_marker() {
    local task_id=$1
    local marker

    marker=$(cancellation_marker_path "$task_id")
    remove_runtime_temporary_file "$marker" 'cancellation marker'
}

remove_cancellation_marker_for_task() {
    local task_id=$1
    local expected_created_at=$2
    local marker
    local read_status

    if marker=$(read_cancellation_marker "$task_id"); then
        [ "$(jq -r '.created_at' <<<"$marker")" = "$expected_created_at" ] || return 0
        remove_cancellation_marker "$task_id"
    else
        read_status=$?
        [ "$read_status" -eq 1 ] || return "$read_status"
    fi
}

wait_for_task() {
    local task_id=$1
    local task
    local task_created_at
    local wait_status=0
    local reconcile_status=0

    validate_task_id_precision "$task_id"
    ensure_daemon
    if task=$(compact_task "$task_id"); then
        task_created_at=$(jq -er '.created_at | strings' <<<"$task") || fail "invalid creation time for AgentQ task: $task_id"
        if ! task_identity_is_unambiguous "$task"; then
            jq -cn --argjson task_id "$task_id" '{task_id: $task_id, state: "unavailable"}'
            printf '%s: task %s has an ambiguous AgentQ identity; the final state is unavailable\n' "$program" "$task_id" >&2
            return 6
        fi
    else
        if wait_reconcile_missing_task "$task_id"; then
            reconcile_status=0
        else
            reconcile_status=$?
        fi
        case "$reconcile_status" in
            5|6)
                return "$reconcile_status"
                ;;
            1)
                fail "unknown AgentQ task id: $task_id"
                ;;
            *)
                return "$reconcile_status"
                ;;
        esac
    fi
    if ! release_operation_lock; then
        fail "cannot release AgentQ operation lock before waiting for task: $task_id"
    fi
    if run_pueue wait --quiet "$task_id"; then
        :
    else
        wait_status=$?
    fi

    if ! task=$(compact_task "$task_id"); then
        if wait_reconcile_missing_task "$task_id" true; then
            reconcile_status=0
        else
            reconcile_status=$?
        fi
        case "$reconcile_status" in
            5|6)
                return "$reconcile_status"
                ;;
            *)
                jq -cn --argjson task_id "$task_id" '{task_id: $task_id, state: "unavailable"}'
                printf '%s: final state for task %s is unavailable after pueue wait\n' "$program" "$task_id" >&2
                return 6
                ;;
        esac
    fi
    if ! jq -e --arg expected_id "$task_id" --arg expected_created_at "$task_created_at" \
        'def canonical_integer_string:
            tostring
            | sub("^0+"; "")
            | if . == "" then "0" else . end;
        (.id | canonical_integer_string) == ($expected_id | canonical_integer_string)
        and .created_at == $expected_created_at' <<<"$task" >/dev/null; then
        jq -cn --argjson task_id "$task_id" '{task_id: $task_id, state: "unavailable"}'
        printf '%s: task %s changed identity while waiting; the final state is unavailable\n' "$program" "$task_id" >&2
        return 6
    fi
    if ! task_is_done <<<"$task"; then
        printf '%s: pueue wait exited %s before task %s completed\n' "$program" "$wait_status" "$task_id" >&2
        return 1
    fi
    if ! jq -e '
        (.status | type) == "object"
        and (.status.Done | type) == "object"
        and (.status.Done | has("result"))
        and (.status.Done.result | if type == "string" then length > 0
            elif type == "object" then length > 0
            else false
            end)
    ' <<<"$task" >/dev/null; then
        jq -cn --argjson task_id "$task_id" '{task_id: $task_id, state: "unavailable"}'
        printf '%s: task %s has an invalid Done.result; the final state is unavailable\n' "$program" "$task_id" >&2
        return 6
    fi

    jq -cn --argjson task "$task" '{task: $task}'

    if [ "$wait_status" -ne 0 ]; then
        printf '%s: pueue wait exited %s for task %s\n' "$program" "$wait_status" "$task_id" >&2
        # pueue's own exit code is NOT an AgentQ contract code.  Returning it
        # raw let a pueue/clap failure (2=usage) surface as a server exit 2 with
        # no reason line, and a theoretical 42-45/124 (the client-only range)
        # leak out of a server that must never emit it.  The task did not reach
        # a completed state and the operation failed -- the contract code for
        # that is 1 (general failure).  Measured 2026-10-12: a stub `pueue wait`
        # returning 124 produced `wait exit=124 reason=0`.
        return 1
    fi

    task_succeeded <<<"$task"
}

compact_log() {
    local task_id=$1
    local tail_lines=$2
    local task=${3:-}
    local expected_created_at=${4:-}
    local log_args=(log --json "$task_id")
    local log_path
    local command_status
    local log_encoded
    local log_encode_status

    log_path=$(task_log_path "$task_id")
    if [ "$tail_lines" = all ]; then
        log_args+=(--full)
    else
        log_args+=(--lines "$tail_lines")
    fi

    compact_log_raw_file=$(umask 077; make_temporary_file "$runtime_directory" '.agentq-log' '.json') || return 1
    if ! runtime_temporary_path_is_safe "$compact_log_raw_file"; then
        fail "unsafe AgentQ runtime temporary file: $compact_log_raw_file"
    fi
    if ! runtime_temporary_path_is_safe "$compact_log_raw_file"; then
        fail "unsafe AgentQ runtime temporary file: $compact_log_raw_file"
    fi
    require_runtime_temporary_file "$compact_log_raw_file"
    if run_pueue "${log_args[@]}" > "$compact_log_raw_file"; then
        :
    else
        # `pueue log` failing is a general failure, not a contract code; passing
        # pueue's own exit code through could surface 42-45/124 from the server
        # (see the submit/wait/remove sites).
        cleanup_compact_log_raw_file || true
        return 1
    fi
    require_runtime_temporary_file "$compact_log_raw_file"
    validate_pueue_task_id_precision_in_file "$compact_log_raw_file"
    require_runtime_temporary_file "$compact_log_raw_file"
    validate_pueue_log_shape_in_file "$compact_log_raw_file"

    if [ -n "$expected_created_at" ] &&
        ! require_runtime_temporary_file "$compact_log_raw_file"; then
        cleanup_compact_log_raw_file || return 1
        return 1
    fi
    if [ -n "$expected_created_at" ] && ! jq -e \
        --arg id "$task_id" \
        --arg expected_created_at "$expected_created_at" \
        'def canonical_integer_string:
            tostring
            | sub("^0+"; "")
            | if . == "" then "0" else . end;
        (.[$id].task.id | canonical_integer_string) == ($id | canonical_integer_string)
        and .[$id].task.created_at == $expected_created_at' \
        < "$compact_log_raw_file" >/dev/null; then
        jq -cn --argjson task_id "$task_id" '{task_id: $task_id, state: "unavailable"}'
        printf '%s: task %s changed identity while reading logs; the log is unavailable\n' "$program" "$task_id" >&2
        command_status=6
        cleanup_compact_log_raw_file || command_status=1
        return "$command_status"
    fi

    require_runtime_temporary_file "$compact_log_raw_file"
    if jq -e --arg id "$task_id" '
        (.[$id].output? | if type == "string" then . else "" end)
        | contains("(Pueue error) Failed to read local log output file:")
          and contains("stream did not contain valid UTF-8")
    ' < "$compact_log_raw_file" >/dev/null; then
        require_task_log_file "$log_path"
        [ -r "$log_path" ] || fail "Pueue reported a non-UTF-8 task log, but the raw log is unavailable: $log_path"
        command -v base64 >/dev/null 2>&1 || fail 'base64 is required to return a non-UTF-8 task log'
        if [ -z "$task" ]; then
            # A bare `[ -n "$task" ] || task=$(compact_task …)` would let
            # compact_task's failure exit code (jq's 5 for malformed metadata)
            # escape as this function's return under `set -e`, with no reason
            # line -- the value 5 the contract reserves for a removed task.
            task=$(compact_task "$task_id") ||
                fail "cannot inspect Pueue while reading AgentQ task logs: $task_id"
        fi
        require_task_log_file "$log_path"

        # The log is read by a TOOL, not by a shell redirect, and the tool's own
        # stderr is dropped: `base64 < "$log_path"` fails with the SHELL's
        # "<path>: No such file or directory" (a redirection error is written
        # before the redirect applies, so no `2>/dev/null` on it can help), and
        # `tail ... | base64` under `set -o pipefail` turns a vanished log into a
        # non-zero pipeline whose only message would be "cannot encode" -- the
        # wrong cause, for a file that was simply gone.  Measured 2026-10-23 by
        # deleting the log between require_task_log_file and the read: exit 2,
        # `tail: <path>: No such file or directory` on stderr (which the clients
        # scan for `reason=`), and `cannot encode non-UTF-8 task log`.
        #
        # The base64 text is captured first so the two failures can be told
        # apart below.  An empty log legitimately yields an empty string, so
        # emptiness is NOT the failure signal -- the status is.
        log_encoded=''
        log_encode_status=0
        if [ "$tail_lines" = all ]; then
            log_encoded=$(cat -- "$log_path" 2>/dev/null | base64) ||
                log_encode_status=$?
        else
            log_encoded=$(tail -n "$tail_lines" "$log_path" 2>/dev/null | base64) ||
                log_encode_status=$?
        fi
        if [ "$log_encode_status" -ne 0 ]; then
            # Exit 2 for BOTH arms, matching the adjacent pre-existing condition
            # above (`Pueue reported a non-UTF-8 task log, but the raw log is
            # unavailable`), which is the same situation one line earlier: the
            # log content cannot be delivered.  A distinct code here would make
            # two neighbouring branches describe one state in two vocabularies.
            if tracked_path_vanished "$log_path"; then
                fail "the task log disappeared while it was being read: $task_id"
            fi
            fail "cannot encode non-UTF-8 task log for AgentQ task: $task_id"
        fi
        if printf '%s' "$log_encoded" | tr -d '\r\n' | jq -Rsc --argjson task "$task" '
                {
                    task: $task,
                    output: null,
                    output_encoding: "base64",
                    output_base64: .
                }
            '; then
            command_status=0
        else
            command_status=$?
        fi
        cleanup_compact_log_raw_file || command_status=1
        # See the note at this function's tail: a non-zero jq status must not
        # escape as the contract's 5 (removed) with no reason line.
        if [ "$command_status" -ne 0 ]; then
            fail "cannot encode non-UTF-8 task log for AgentQ task: $task_id"
        fi
        return 0
    fi

    if ! prepare_request_metadata_files; then
        command_status=1
        cleanup_compact_log_metadata_after_failure || command_status=1
        cleanup_compact_log_raw_file || command_status=1
        return "$command_status"
    fi
    if ! require_runtime_temporary_file "$request_records_file" ||
        ! require_runtime_temporary_file "$cancellation_markers_file"; then
        command_status=1
        cleanup_compact_log_metadata_after_failure || command_status=1
        cleanup_compact_log_raw_file || command_status=1
        return "$command_status"
    fi
    require_runtime_temporary_file "$compact_log_raw_file"
    if jq -ce --arg id "$task_id" \
        --slurpfile markers "$cancellation_markers_jq_file" \
        --slurpfile requests "$request_records_jq_file" "
        $compact_filter
        .[\$id]
        | {
            task: (
                .task
                | compact
                | decorate(\$markers[0]; \$requests[0])
                | if ((type == \"object\")
                      and ((.id | type) == \"number\")
                      and (.id >= 0)
                      and ((.id | floor) == .id)
                      and ((.created_at | type) == \"string\")
                      and ((.created_at | length) > 0)) then
                    .
                  else
                    error(\"invalid visible Pueue task metadata\")
                  end
            ),
            output
        }
    " < "$compact_log_raw_file"; then
        command_status=0
    else
        command_status=$?
    fi
    release_request_metadata_files || command_status=1
    cleanup_compact_log_raw_file || command_status=1
    # jq's `error("invalid visible Pueue task metadata")` exits 5 -- the code
    # the contract reserves for a REMOVED task.  `logs` calls this bare, so
    # returning it raw made a malformed status look like a removed task with no
    # body and no reason line (the same defect fixed in compact_status).  A
    # status we cannot parse is a protocol failure, not a task state.
    if [ "$command_status" -ne 0 ]; then
        fail 'cannot inspect Pueue while reading AgentQ task logs'
    fi
    return 0
}

submit() {
    local workdir=''
    local label='command'
    local request_id=''
    local normalized_workdir
    local payload
    local task_label
    local record
    local task
    local task_id
    local observed_task_id
    local task_created_at
    local record_state
    local pueue_add_status=0
    local recovered=false

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --workdir)
                [ "$#" -ge 2 ] || fail '--workdir requires a directory'
                workdir=$2
                shift 2
                ;;
            --label)
                [ "$#" -ge 2 ] || fail '--label requires a value'
                label=$2
                shift 2
                ;;
            --request-id)
                [ "$#" -ge 2 ] || fail '--request-id requires a value'
                request_id=$2
                shift 2
                ;;
            --)
                shift
                break
                ;;
            *)
                fail "unknown submit option: $1"
                ;;
        esac
    done

    [ -n "$workdir" ] || fail '--workdir is required'
    is_request_id "$request_id" || fail '--request-id must be 16-128 ASCII letters, numbers, dots, underscores, or hyphens and start with a letter or number'
    [ "$#" -gt 0 ] || fail 'submit requires a command after --'

    # normalize_workdir reports through `fail`, which inside the command
    # substitution ends only the subshell -- the assignment would otherwise
    # silently yield the empty string, and because with_operation_lock calls
    # the command in an `if` context errexit is disabled for this whole body,
    # so nothing downstream would stop the empty path from being persisted and
    # handed to `pueue add --working-directory`.  Measured on 2026-10-06: an
    # invalid --workdir printed the rejection and still enqueued with "".
    normalized_workdir=$(normalize_workdir "$workdir") || return $?
    # Same trap as `normalize_workdir` above: this runs inside `with_operation_lock`'s
    # `if "$@"` body, where errexit is disabled, and a bare `$( )` assignment that
    # fails leaves the variable EMPTY (the inner failure only ends the subshell).
    # `request_payload` calls jq; a transient jq failure would then persist
    # `"payload":null` and -- worse -- the request still reaches `pueue add`, so
    # the user's command runs while submit reports an ambiguous failure.
    # Measured 2026-10-13 by making the jq call fail once.
    payload=$(request_payload "$normalized_workdir" "$label" "$@") || return $?
    task_label=$(request_task_label "$request_id")

    acquire_request_lock "$request_id"
    acquire_operation_lock

    if record=$(read_request_record "$request_id"); then
        request_payload_matches "$record" "$payload" || fail "request id was already used with different submit arguments: $request_id"

        record_state=$(jq -r '.state' <<<"$record")
        if [ "$record_state" = removed ]; then
            if ! archive_removed_request "$request_id" "$record" >/dev/null; then
                fail "cannot archive removed AgentQ request while submitting: $request_id"
            fi
            fail "request id was already consumed by a task that has been removed: $request_id"
        fi
        if [ "$record_state" = accepted ]; then
            ensure_daemon
            if ! ensure_group; then
                fail "cannot ensure AgentQ group while submitting: $request_id"
            fi
            reconcile_accepted_rc=0
            record=$(reconcile_accepted_request "$request_id" "$record") || reconcile_accepted_rc=$?
            if [ "$reconcile_accepted_rc" -eq 4 ]; then
                jq -cn --arg request_id "$request_id" '{request_id: $request_id, task_id: null, state: "ambiguous"}'
                printf '%s: multiple Pueue tasks share the AgentQ label for this request; the server cannot choose safely: %s\n' "$program" "$request_id" >&2
                return 4
            fi
            if [ "$reconcile_accepted_rc" -ne 0 ] && [ "$reconcile_accepted_rc" -ne 1 ]; then
                fail 'cannot inspect Pueue while reconciling an AgentQ request'
            fi
            if [ "$reconcile_accepted_rc" -eq 0 ]; then
                task_id=$(jq -r '.task_id' <<<"$record")
                request_response "$request_id" "$task_id" true
                return 0
            fi

            fail "request id was already consumed by a task that is no longer available: $request_id"
        fi
        if [ "$record_state" = removing ]; then
            ensure_daemon
            if record=$(read_request_record "$request_id"); then
                [ "$(jq -r '.state' <<<"$record")" = removing ] || fail "unexpected AgentQ request state after removal recovery: $request_id"
                # The contract table files `removing` under exit 4 alongside
                # ambiguous: the removal intent is durable but unfinished, so
                # the caller must stop rather than resubmit.  lookup answers
                # this same state with 4 and a JSON body; a bare exit 2 here
                # told callers to fix their arguments instead.
                task_id=$(jq -r '.task_id' <<<"$record")
                validate_task_id_precision "$task_id"
                jq -cn --arg request_id "$request_id" --argjson task_id "$task_id" '{request_id: $request_id, task_id: $task_id, state: "removing"}'
                printf '%s: request id has a pending removal; retry remove to finish it: %s\n' "$program" "$request_id" >&2
                return 4
            elif read_request_tombstone "$request_id" >/dev/null; then
                fail "request id was already consumed by a task that has been removed: $request_id"
            else
                fail "AgentQ request disappeared while recovering removal: $request_id"
            fi
        fi
    elif read_request_tombstone "$request_id" >/dev/null; then
        fail "request id was already consumed by a task that has been removed: $request_id"
    else
        # Same `$( )`-in-errexit-off trap as `request_payload` above: the inner
        # jq failure only ends the assignment's subshell, an empty `record`
        # reaches `write_request_record`, and the resulting one-newline file
        # fails `request_record_filter` in `load_request_records` -- the shared
        # gate EVERY command runs, so one transient jq failure would poison
        # status/lookup/wait/cancel/remove/logs/doctor on this host until the
        # file is removed by hand.  Measured 2026-10-13.
        record=$(create_request_record "$request_id" "$payload" "$task_label") || {
            fail "cannot build the prepared AgentQ request record: $request_id"
        }
        if ! write_request_record "$request_id" "$record"; then
            fail "cannot persist prepared AgentQ request: $request_id"
        fi
    fi

    ensure_daemon
    if ! ensure_group; then
        fail "cannot ensure AgentQ group while submitting: $request_id"
    fi

        find_request_task_rc=0
        task=$(find_request_task "$task_label") || find_request_task_rc=$?
        if [ "$find_request_task_rc" -eq 4 ]; then
            jq -cn --arg request_id "$request_id" '{request_id: $request_id, task_id: null, state: "ambiguous"}'
            printf '%s: multiple Pueue tasks share the AgentQ label for this request; the server cannot choose safely: %s\n' "$program" "$request_id" >&2
            return 4
        fi
        if [ "$find_request_task_rc" -ne 0 ] && [ "$find_request_task_rc" -ne 1 ]; then
            fail 'cannot inspect Pueue while reconciling an AgentQ request'
        fi
        if [ "$find_request_task_rc" -eq 0 ]; then
            validate_visible_task_metadata "$task"
            task_id=$(jq -r '.id' <<<"$task")
            task_created_at=$(jq -r '.created_at' <<<"$task")
            validate_task_id_precision "$task_id"
            recovered=true
    else
        record_state=$(jq -r '.state' <<<"$record")
        if [ "$record_state" = adding ]; then
            jq -cn --arg request_id "$request_id" '{request_id: $request_id, task_id: null, state: "ambiguous"}'
            printf '%s: request may have reached Pueue but no matching task is visible; refusing to enqueue it again: %s\n' "$program" "$request_id" >&2
            return 4
        fi

        [ "$record_state" = prepared ] || fail "invalid AgentQ request state: $record_state"
        # Same `$( )` trap: a jq failure here leaves `record` empty and the
        # empty write REPLACES a valid `prepared` record -- the prepared state
        # (safe to retry) is destroyed in favour of an unreadable file.  Measured
        # 2026-10-13.
        record=$(set_request_state "$record" adding) || {
            fail "cannot update the AgentQ request record to adding: $request_id"
        }
        if ! write_request_record "$request_id" "$record"; then
            fail "cannot persist adding AgentQ request: $request_id"
        fi

        if task_id=$(run_pueue add \
            --group "$group_name" \
            --working-directory "$normalized_workdir" \
            --label "$task_label" \
            --print-task-id \
            --escape \
            -- \
            "$@"); then
            is_task_id "$task_id" || fail "Pueue returned an invalid task id: $task_id"
            validate_task_id_precision "$task_id"

            if task=$(raw_compact_task "$task_id"); then
                validate_visible_task_metadata "$task"
                observed_task_id=$(jq -er '.id' <<<"$task") || fail "Pueue returned a task without a valid id: $task_id"
                validate_task_id_precision "$observed_task_id"
                [ "$(canonical_task_id "$observed_task_id")" = "$(canonical_task_id "$task_id")" ] ||
                    fail "Pueue returned a task with a mismatched id: $task_id"
                task_created_at=$(jq -er '.created_at' <<<"$task")
            else
                find_request_task_rc=0
                task=$(find_request_task "$task_label") || find_request_task_rc=$?
                if [ "$find_request_task_rc" -eq 4 ]; then
                    jq -cn --arg request_id "$request_id" '{request_id: $request_id, task_id: null, state: "ambiguous"}'
                    printf '%s: multiple Pueue tasks share the AgentQ label for this request; the server cannot choose safely: %s\n' "$program" "$request_id" >&2
                    return 4
                fi
                if [ "$find_request_task_rc" -ne 0 ] && [ "$find_request_task_rc" -ne 1 ]; then
                    fail 'cannot inspect Pueue while reconciling an AgentQ request'
                fi
                if [ "$find_request_task_rc" -eq 0 ]; then
                    validate_visible_task_metadata "$task"
                    task_id=$(jq -r '.id' <<<"$task")
                    task_created_at=$(jq -r '.created_at' <<<"$task")
                    validate_task_id_precision "$task_id"
                    recovered=true
                else
                    jq -cn --arg request_id "$request_id" '{request_id: $request_id, task_id: null, state: "ambiguous"}'
                    printf '%s: Pueue accepted a request id but no matching task is visible; use lookup before any manual retry: %s\n' "$program" "$request_id" >&2
                    return 4
                fi
            fi
        else
            pueue_add_status=$?
            find_request_task_rc=0
            task=$(find_request_task "$task_label") || find_request_task_rc=$?
            if [ "$find_request_task_rc" -eq 4 ]; then
                jq -cn --arg request_id "$request_id" '{request_id: $request_id, task_id: null, state: "ambiguous"}'
                printf '%s: multiple Pueue tasks share the AgentQ label for this request; the server cannot choose safely: %s\n' "$program" "$request_id" >&2
                return 4
            fi
            if [ "$find_request_task_rc" -ne 0 ] && [ "$find_request_task_rc" -ne 1 ]; then
                fail 'cannot inspect Pueue while reconciling an AgentQ request'
            fi
            if [ "$find_request_task_rc" -eq 0 ]; then
                validate_visible_task_metadata "$task"
                task_id=$(jq -r '.id' <<<"$task")
                task_created_at=$(jq -r '.created_at' <<<"$task")
                validate_task_id_precision "$task_id"
                recovered=true
            else
                printf '%s: Pueue add exited %s and the request outcome is unresolved; use lookup before any manual retry: %s\n' \
                    "$program" "$pueue_add_status" "$request_id" >&2
                # pueue's exit code is not an AgentQ contract code: returning it
                # raw let a pueue/clap failure (2=usage) become a server exit 2
                # with no reason line, and could leak 42-45/124 (the client-only
                # range) from a server that must never emit it.  `pueue add`
                # failing with the request unreconciled is a general failure.
                # Measured 2026-10-12: a stub `pueue add` returning 43 produced
                # `submit exit=43 reason=0`.
                return 1
            fi
        fi
    fi

    is_task_id "$task_id" || fail "Pueue returned an invalid task id: $task_id"
    validate_task_id_precision "$task_id"
    [ -n "$task_created_at" ] || fail "Pueue returned a task without a creation time: $task_id"
    # Same errexit-off `$( )` trap as the prepared/adding transitions in this
    # function: an empty record here would overwrite the `adding` record after
    # the task was already enqueued.
    record=$(set_request_state "$record" accepted "$task_id" "$(jq -Rn --arg value "$task_created_at" '$value')") || {
        fail "cannot update the AgentQ request record to accepted: $request_id"
    }
    if ! write_request_record "$request_id" "$record"; then
        fail "cannot persist accepted AgentQ request: $request_id"
    fi
    remove_cancellation_marker_for_task "$task_id" "$task_created_at" ||
        fail "cannot remove stale AgentQ cancellation marker after submit: $task_id"
    request_response "$request_id" "$task_id" "$recovered"
}

submit_with_operation_lock() {
    with_operation_lock submit "$@"
}

lookup() {
    [ "$#" -eq 1 ] || fail 'lookup requires one request id'
    is_request_id "$1" || fail 'request id must be 16-128 ASCII letters, numbers, dots, underscores, or hyphens and start with a letter or number'

    local request_id=$1
    local record
    local tombstone
    local task
    local task_id
    local task_created_at
    local record_state
    local read_status

    acquire_request_lock "$request_id"
    acquire_operation_lock
    if record=$(read_request_record "$request_id"); then
        :
    else
        read_status=$?
        [ "$read_status" -eq 1 ] || return "$read_status"
        if tombstone=$(read_request_tombstone "$request_id"); then
            task_id=$(jq -r '.task_id' <<<"$tombstone")
            validate_task_id_precision "$task_id"
            jq -cn --arg request_id "$request_id" --argjson task_id "$task_id" '{request_id: $request_id, task_id: $task_id, state: "removed"}'
            return 5
        else
            read_status=$?
            [ "$read_status" -eq 1 ] || return "$read_status"
        fi
        jq -cn --arg request_id "$request_id" '{request_id: $request_id, task_id: null, state: "not_found"}'
        return 3
    fi
    if [ "$(jq -r '.state' <<<"$record")" = removed ]; then
        if ! record=$(archive_removed_request "$request_id" "$record"); then
            fail "cannot archive removed AgentQ request while looking up: $request_id"
        fi
        task_id=$(jq -r '.task_id' <<<"$record")
        validate_task_id_precision "$task_id"
        jq -cn --arg request_id "$request_id" --argjson task_id "$task_id" '{request_id: $request_id, task_id: $task_id, state: "removed"}'
        return 5
    fi

    if [ "$(jq -r '.state' <<<"$record")" = removing ]; then
        ensure_daemon
        if record=$(read_request_record "$request_id"); then
            [ "$(jq -r '.state' <<<"$record")" = removing ] || fail "unexpected AgentQ request state after removal recovery: $request_id"
            task_id=$(jq -r '.task_id' <<<"$record")
            validate_task_id_precision "$task_id"
            jq -cn --arg request_id "$request_id" --argjson task_id "$task_id" '{request_id: $request_id, task_id: $task_id, state: "removing"}'
            return 4
        elif tombstone=$(read_request_tombstone "$request_id"); then
            task_id=$(jq -r '.task_id' <<<"$tombstone")
            validate_task_id_precision "$task_id"
            jq -cn --arg request_id "$request_id" --argjson task_id "$task_id" '{request_id: $request_id, task_id: $task_id, state: "removed"}'
            return 5
        else
            fail "AgentQ request disappeared while recovering removal: $request_id"
        fi
    fi

    if [ "$(jq -r '.state' <<<"$record")" = accepted ]; then
        ensure_daemon
        verify_group
        reconcile_accepted_rc=0
        record=$(reconcile_accepted_request "$request_id" "$record") || reconcile_accepted_rc=$?
        if [ "$reconcile_accepted_rc" -eq 4 ]; then
            jq -cn --arg request_id "$request_id" '{request_id: $request_id, task_id: null, state: "ambiguous"}'
            printf '%s: multiple Pueue tasks share the AgentQ label for this request; the server cannot choose safely: %s\n' "$program" "$request_id" >&2
            return 4
        fi
        if [ "$reconcile_accepted_rc" -ne 0 ] && [ "$reconcile_accepted_rc" -ne 1 ]; then
            fail 'cannot inspect Pueue while reconciling an AgentQ request'
        fi
        if [ "$reconcile_accepted_rc" -eq 0 ]; then
            task_id=$(jq -r '.task_id' <<<"$record")
            request_response "$request_id" "$task_id" true
            return 0
        fi

        task_id=$(jq -r '.task_id' <<<"$record")
        validate_task_id_precision "$task_id"
        jq -cn --arg request_id "$request_id" --argjson task_id "$task_id" '{request_id: $request_id, task_id: $task_id, state: "removed"}'
        return 5
    fi

    task_id=$(jq -r '.task_id // empty' <<<"$record")
    if [ -z "$task_id" ]; then
        ensure_daemon
        verify_group
        find_request_task_rc=0
        task=$(find_request_task "$(jq -r '.task_label' <<<"$record")") || find_request_task_rc=$?
        if [ "$find_request_task_rc" -eq 4 ]; then
            jq -cn --arg request_id "$request_id" '{request_id: $request_id, task_id: null, state: "ambiguous"}'
            printf '%s: multiple Pueue tasks share the AgentQ label for this request; the server cannot choose safely: %s\n' "$program" "$request_id" >&2
            return 4
        fi
        if [ "$find_request_task_rc" -ne 0 ] && [ "$find_request_task_rc" -ne 1 ]; then
            fail 'cannot inspect Pueue while reconciling an AgentQ request'
        fi
        if [ "$find_request_task_rc" -eq 0 ]; then
            if ! jq -e '
                if type != "object" then
                    false
                elif (.id | type) != "number" then
                    false
                elif (.id < 0) or ((.id | floor) != .id) then
                    false
                elif (.created_at | type) != "string" then
                    false
                elif (.created_at | length) == 0 then
                    false
                else
                    true
                end
            ' <<<"$task" >/dev/null; then
                fail "invalid visible Pueue task metadata while looking up AgentQ request: $request_id"
            fi
            task_id=$(jq -r '.id' <<<"$task")
            task_created_at=$(jq -r '.created_at' <<<"$task")
            validate_task_id_precision "$task_id"
            # Same errexit-off `$( )` trap as the submit-side accepted transition.
            record=$(set_request_state "$record" accepted "$task_id" "$(jq -Rn --arg value "$task_created_at" '$value')") || {
                fail "cannot update the AgentQ request record to accepted while looking up: $request_id"
            }
            if ! write_request_record "$request_id" "$record"; then
                fail "cannot persist accepted AgentQ request while looking up: $request_id"
            fi
            request_response "$request_id" "$task_id" true
            return 0
        else
            record_state=$(jq -r '.state' <<<"$record")
            if [ "$record_state" = prepared ]; then
                jq -cn --arg request_id "$request_id" '{request_id: $request_id, task_id: null, state: "not_started"}'
                return 3
            fi
            jq -cn --arg request_id "$request_id" '{request_id: $request_id, task_id: null, state: "ambiguous"}'
            return 4
        fi
    fi

    fail "invalid AgentQ request state while looking up: $(jq -r '.state' <<<"$record")"
}

lookup_with_operation_lock() {
    with_operation_lock lookup "$@"
}

logs() {
    [ "$#" -ge 1 ] || fail 'logs requires one task id'
    is_task_id "$1" || fail 'task id must be a non-negative integer'

    local task_id=$1
    local tail_lines=200
    local task
    local task_created_at
    local task_compact_status=0
    shift

    if [ "$#" -gt 0 ]; then
        [ "$#" -eq 2 ] && [ "$1" = --tail ] || fail 'logs accepts only --tail <lines>'
        if [ "$2" = all ]; then
            tail_lines=all
        else
            is_positive_integer "$2" || fail '--tail must be a positive integer or all'
            tail_lines=$(canonical_task_id "$2")
        fi
    fi

    ensure_daemon
    task=$(compact_task "$task_id") || task_compact_status=$?
    report_compact_task_failure "$task_compact_status" "$task_id"
    task_created_at=$(jq -er '.created_at | strings' <<<"$task") || fail "invalid creation time for AgentQ task: $task_id"
    if ! task_identity_is_unambiguous "$task"; then
        jq -cn --argjson task_id "$task_id" '{task_id: $task_id, state: "unavailable"}'
        printf '%s: task %s has an ambiguous AgentQ identity; the log is unavailable\n' "$program" "$task_id" >&2
        return 6
    fi
    if ! release_operation_lock; then
        fail "cannot release AgentQ operation lock before reading logs: $task_id"
    fi
    compact_log "$task_id" "$tail_lines" "$task" "$task_created_at"
}

logs_with_read_lock() {
    # Read WITHOUT the operation lock.  The lock exists to serialise writers
    # over the request-record layout; a read still runs the layout check
    # (repair/migrate) because that is where a MALFORMED record fails loudly
    # -- without it, a corrupt record surfaced as a bare exit 1 with jq noise
    # instead of exit 2 + reason=protocol_error (measured against the locked
    # baseline, 2026-10-15).  The concurrent-writer hazard this creates is
    # bounded: repair's archive path is idempotent under races (tombstone
    # write is temp+install atomic, an existing tombstone must MATCH, and the
    # record removal is rm -f, which is a no-op on an already-archived
    # record), so two concurrent repairs converge instead of corrupting.
    # The maintenance check stays: maintenance mode must still stop reads.
    ensure_not_in_maintenance
    recover_stale_operation_lock_for_read
    migrate_removed_request_records
    logs "$@"
}

status() {
    # $1 (optional): "summary" or a task id.  An empty value keeps the
    # historical full-queue output.  --summary emits the compact JSON summary
    # (see compact_status_summary).  --task <id> reuses compact_task and wraps
    # the decorated task the same way `logs` and `wait` do -- {"task": {...}} --
    # so a caller reads the same field whichever single-task view it uses, and
    # the inner shape is exactly one entry of the full output.  A task that
    # cannot be read is folded through report_compact_task_failure, so an
    # unknown id is `unknown AgentQ task id`/exit 2 rather than a raw jq 4.
    local status_mode=$1
    local status_task_id
    local status_task_status=0
    local status_task

    ensure_daemon
    verify_group
    if [ -n "$status_mode" ]; then
        case "$status_mode" in
            summary)
                compact_status_summary
                ;;
            *)
                is_task_id "$status_mode" || fail 'status accepts --summary or --task <id>'
                validate_task_id_precision "$status_mode"
                status_task_id=$(canonical_task_id "$status_mode")
                if status_task=$(compact_task "$status_task_id"); then
                    :
                else
                    status_task_status=$?
                fi
                report_compact_task_failure "$status_task_status" "$status_task_id"
                printf '{"task":%s}\n' "$status_task"
                ;;
        esac
    else
        compact_status
    fi
}

status_with_read_lock() {
    # Read WITHOUT the operation lock -- same reasoning as logs_with_read_lock,
    # including stale-lock recovery and the migrate call for loud
    # malformed-record failures.  "$@" forwards the optional summary/task mode.
    ensure_not_in_maintenance
    recover_stale_operation_lock_for_read
    migrate_removed_request_records
    status "$@"
}

doctor() {
    # $1 (optional): "full".  The default queue section is the compact summary
    # (see compact_status_summary) -- doctor is the documented first call on a
    # new host, and its full decorated dump was the 124KB output that callers
    # truncated ~2600 times across the mined sessions.  `doctor --full` keeps
    # the historical full queue JSON for callers that inspect per-task agentq
    # metadata.  The version diagnostic lines on stderr are unchanged.
    local doctor_mode=${1:-}
    printf 'agentq=' >&2
    printf '%s\n' "$agentq_version" >&2
    printf 'pueue=' >&2
    # `|| printf`: a binary that exists but cannot execute (corrupt, wrong ABI)
    # must not leak its own status as the server's exit code -- doctor is the
    # documented first call on a new host, and the contract says this program
    # only ever exits 0-6.  require_executable checks -x, not runnability.
    "$pueue_bin" --version >&2 || printf '%s\n' 'unavailable' >&2
    printf 'pueued=' >&2
    "$pueued_bin" --version >&2 || printf '%s\n' 'unavailable' >&2

    case "$platform_kind" in
        windows)
            printf 'scheduled_task=' >&2
            if powershell.exe -NoProfile -NonInteractive -Command "Get-ScheduledTask -TaskName 'AgentQ Pueued' -ErrorAction Stop | Select-Object TaskName,State | ConvertTo-Json -Compress" >&2; then
                :
            else
                printf '%s: scheduled startup task is unavailable; on-demand daemon startup remains available\n' "$program" >&2
            fi
            ;;
        unix)
            case "$platform" in
                Linux*)
                    printf 'systemd_user_service=' >&2
                    systemctl --user is-active agentq-pueued.service >&2 || true
                    printf 'systemd_linger=' >&2
                    loginctl show-user "$(id -un)" -p Linger --value >&2 || true
                    ;;
                Darwin*)
                    printf 'launchd_service=' >&2
                    macos_launch_service_target
                    launchctl print "$macos_launch_service" >/dev/null 2>&1 && printf '%s\n' active >&2 || printf '%s\n' inactive >&2
                    printf 'launchd_domain=%s\n' "${macos_launch_service%/com.agentq.pueued}" >&2
                    ;;
            esac
            ;;
    esac

    ensure_daemon
    verify_group
    if [ "$doctor_mode" = full ]; then
        compact_status
    else
        compact_status_summary
    fi
}

doctor_with_read_lock() {
    # The diagnostic lines above compact_status are read-only; ensure_daemon
    # inside status/doctor CAN start the service, but that side effect is the
    # documented doctor behaviour and independent of the operation lock.  The
    # lock itself is dropped: same reasoning as status_with_read_lock.
    ensure_not_in_maintenance
    recover_stale_operation_lock_for_read
    migrate_removed_request_records
    doctor "$@"
}

# Replaying a cancel whose task has already left Pueue.
#
# A confirmed cancellation is recorded in the task's cancellation marker with
# state "requested", and that marker outlives the task.  Once the task is gone
# from Pueue, cancel_task can no longer read it, so without this the replay
# falls through to "unknown AgentQ task id" and exits 2 -- the same code as an
# argument error.  A caller told to retry a cancel must not see that.
#
# The marker is the right evidence: it is only ever written after Pueue
# confirmed the cancel (kill or remove).  This path is reached only when no
# task with this id is visible in Pueue, so a live task cannot be misreported
# as a replay.
# The creation time recorded for a task id in an AgentQ request record or
# tombstone.  A record covers a task that is still tracked; a tombstone covers
# one already removed.  Returns 1 when neither exists, i.e. this id was never
# tracked by AgentQ.
# Does any record or tombstone for this task id carry this exact creation time?
#
# This answers the question the replay guard actually asks: "is there evidence
# that a task INSTANCE with this creation time held this id?".  It deliberately
# does NOT return the first creation time found.  Pueue recycles numeric task
# ids, so one id accumulates one record per instance that used it; returning the
# first match compares the marker against whichever instance happens to sort
# first, which for a reused id is an EARLIER one -- the guard then rejects a
# valid replay and the caller is told (exit 2, "unknown AgentQ task id") that its
# retry was malformed.  Measured on a real host: 7 records on one id, marker
# naming the 7th instance, first match naming the 1st.
task_instance_created_at_is_recorded() {
    local task_id=$1
    local expected_created_at=$2
    # Evidence grade.  "any" (default) accepts a request record or a tombstone;
    # "tombstone" accepts ONLY a tombstone.  A tombstone proves AgentQ already
    # removed the task, so it stands on its own while Pueue is unreadable; an
    # accepted record only proves that SOME instance of this (recyclable) id was
    # tracked, which an earlier instance satisfies just as well as the live one.
    local evidence_grade=${3:-any}
    local path request_id created_at
    local file_body
    local records=()
    local tombstones=()

    shopt -s nullglob
    records=("$request_directory"/*.json)
    tombstones=("$request_tombstone_directory"/*.json)
    shopt -u nullglob

    # Fast path: ONE aggregate jq answers the whole question, instead of one
    # jq per record and per tombstone.  TOLERANT like the loop it replaces: a
    # malformed file makes the slurp fail, and the fallback below then reproduces
    # the per-file scan's skip-and-continue exactly.  The two lists are scanned
    # separately (as the loop did) so a hit in the records is reported without
    # ever reading a tombstone.
    local combined=()
    # `probe` is declared local here rather than left as a bare write: bash
    # resolves an unlocalized assignment through the DYNAMIC scope, and
    # install_jq_line_ending_shim declares its own `local probe`.  The two
    # functions do not sit on one stack today, which is exactly the argument
    # that stops being true the next time someone adds a call.
    local probe
    if [ "$evidence_grade" != tombstone ]; then
        if [ "${#records[@]}" -gt 0 ]; then combined+=("${records[@]}"); fi
    fi
    if [ "${#tombstones[@]}" -gt 0 ]; then combined+=("${tombstones[@]}"); fi
    if [ "${#combined[@]}" -gt 0 ]; then
        if probe=$( {
                for path in "${combined[@]}"; do
                    request_id=${path##*/}
                    request_id=${request_id%.json}
                    is_request_id "$request_id" || continue
                    printf '%s\n' "$(<"$path")"
                done | jq -rs --argjson id "$task_id" --arg expected "$expected_created_at" \
                    "$request_instance_probe_filter"
            } 2>/dev/null ); then
            [ "$probe" = true ] && return 0
            return 1
        fi
    fi
    # Fallback: the original per-file scan, unchanged apart from the grade.
    if [ "$evidence_grade" != tombstone ] && [ "${#records[@]}" -gt 0 ]; then
        for path in "${records[@]}"; do
            request_id=${path##*/}
            request_id=${request_id%.json}
            is_request_id "$request_id" || continue
            # Silent read before the jq: `... < "$path" 2>/dev/null` looks like
            # it suppresses everything, but a REDIRECTION error is the shell's
            # own write and happens before the redirect applies -- bash prints
            # `<path>: No such file or directory` regardless (measured
            # 2026-10-23).  The clients scan the remote stderr for `reason=`,
            # so a record vanishing mid-scan must not leave that line behind.
            # `cat`'s error, by contrast, IS cat's own write and is suppressed.
            file_body=$(cat -- "$path" 2>/dev/null) || continue
            created_at=$(jq -r --argjson id "$task_id" \
                'select(.task_id == $id) | .task_created_at // empty' <<<"$file_body" 2>/dev/null) || continue
            if [ "$created_at" = "$expected_created_at" ]; then
                return 0
            fi
        done
    fi
    if [ "${#tombstones[@]}" -gt 0 ]; then
        for path in "${tombstones[@]}"; do
            request_id=${path##*/}
            request_id=${request_id%.json}
            is_request_id "$request_id" || continue
            # Silent read before the jq: `... < "$path" 2>/dev/null` looks like
            # it suppresses everything, but a REDIRECTION error is the shell's
            # own write and happens before the redirect applies -- bash prints
            # `<path>: No such file or directory` regardless (measured
            # 2026-10-23).  The clients scan the remote stderr for `reason=`,
            # so a record vanishing mid-scan must not leave that line behind.
            # `cat`'s error, by contrast, IS cat's own write and is suppressed.
            file_body=$(cat -- "$path" 2>/dev/null) || continue
            created_at=$(jq -r --argjson id "$task_id" \
                'select(.task_id == $id) | .task_created_at // empty' <<<"$file_body" 2>/dev/null) || continue
            if [ "$created_at" = "$expected_created_at" ]; then
                return 0
            fi
        done
    fi
    return 1
}

cancelled_task_replay() {
    local task_id=$1
    local evidence_grade=${2:-any}
    local marker
    local marker_created_at

    # Quiet exploratory read: a corrupt marker must not emit the machine
    # reason line on a call that goes on to succeed -- `fail` inside the
    # substitution prints message + reason=protocol_error while the caller
    # treats the marker as absent (measured 2026-10-06).  The marker is
    # advisory and the success path overwrites it, so a silent fallback
    # here is the self-healing direction; the redirect is INSIDE the
    # substitution because an outer one would not suppress it.  The
    # fail-closed consumer of a corrupt marker is
    # remove_cancellation_marker_for_task, which keeps the loud read.
    marker=$(read_cancellation_marker "$task_id" 2>/dev/null) || return 1
    [ "$(jq -r '.state' <<<"$marker")" = requested ] || return 1
    # Pueue reuses numeric task ids, so a marker alone does not prove that the
    # task being asked about is the one that was cancelled.  Pin it to the same
    # task INSTANCE by requiring the marker's creation time to match the
    # creation time recorded for this id in an AgentQ request record or
    # tombstone.  Without this, a marker left behind by an earlier task that
    # reused the id would make an unrelated task look like a replay.
    marker_created_at=$(jq -r '.created_at' <<<"$marker")
    task_instance_created_at_is_recorded "$task_id" "$marker_created_at" "$evidence_grade" || return 1
    jq -cn --argjson task_id "$task_id" \
        --arg requested_at "$(jq -r '.requested_at' <<<"$marker")" \
        '{task_id: $task_id, action: "cancel_requested", cancellation_requested_at: $requested_at, reused: true}'
}

cancel_task() {
    local task_id=$1
    local task
    local created_at
    local requested_at
    local marker
    local marker_state=''
    local marker_created_at=''
    local raw_compact_status=0
    local replay_evidence

    ensure_daemon
    # One status call, not two: raw_compact_task already fails for an unknown
    # id, so a separate existence probe would only duplicate the Pueue call.
    if task=$(raw_compact_task "$task_id"); then
        # `|| fail`, not a bare assignment: cancel_task runs inside the lock's
        # `if "$@"` body where errexit is suspended.  An empty created_at would
        # be persisted into the cancellation marker, and valid_marker requires a
        # non-empty one -- every later read of that marker would fail closed
        # (exit 2), poisoning this task id until the file is removed by hand.
        created_at=$(jq -er '.created_at' <<<"$task") ||
            fail "cannot read the Pueue task creation time for cancellation: $task_id"
    else
        # $? is still raw_compact_task's status at the top of the else branch.
        raw_compact_status=$?
        # Two GRADES of replay evidence, because the two kinds do not say the
        # same thing:
        #   - a TOMBSTONE means AgentQ already removed the task; it cannot come
        #     back, so a replay is safe even while Pueue is unreadable;
        #   - an ACCEPTED RECORD only means some instance of this id was
        #     tracked.  Pueue recycles ids, so a record left by an EARLIER
        #     instance satisfies the instance binding exactly, and on a read
        #     failure (rc 1/2/5) the task this call is about may be a different,
        #     still-running one.  The binding has no discriminating power there
        #     and a replay would answer "cancelled" (exit 0) about a live task.
        # So rc=4 (Pueue answered "not visible") accepts either grade;
        # an unreadable Pueue accepts tombstones only.  smoke/15 pins the
        # tombstone half, smoke/03 the rc=4 half.
        if [ "$raw_compact_status" -eq 4 ]; then
            replay_evidence=any
        else
            replay_evidence=tombstone
        fi
        cancelled_task_replay "$task_id" "$replay_evidence" && return 0
        if [ "$raw_compact_status" -eq 4 ]; then
            # The task is gone, but a marker may still record that the
            # cancellation outcome was never confirmed.  "unknown AgentQ task
            # id" would misattribute that -- the id is known (its record or
            # tombstone is on disk); what is unresolved is whether the cancel
            # took effect.  Report the degraded contract instead.  Measured
            # 2026-10-06: a pending marker left by the failed-kill/failed-remove
            # paths reached exactly this line.
            if marker=$(read_cancellation_marker "$task_id" 2>/dev/null); then
                if [ "$(jq -r '.state' <<<"$marker")" = pending ]; then
                    requested_at=$(jq -r '.requested_at' <<<"$marker")
                    jq -cn --argjson task_id "$task_id" --arg requested_at "$requested_at" '{task_id: $task_id, state: "cancellation_pending", cancellation_requested_at: $requested_at}'
                    printf '%s: the task is gone while the cancellation outcome remains unresolved: %s\n' "$program" "$task_id" >&2
                    return 4
                fi
            fi
        fi
        # Pueue could not be read (rc 1/2/5): nothing was mutated.  This stays
        # in the default protocol_error class, deliberately and in agreement
        # with logs/remove, which answer the same condition the same way --
        # smoke/15 asserts one reason for all three.  A distinct class here
        # would make three commands describe one state in two vocabularies.
        report_compact_task_failure "$raw_compact_status" "$task_id"
    fi

    # Quiet exploratory read; see cancelled_task_replay for why.
    if marker=$(read_cancellation_marker "$task_id" 2>/dev/null); then
        marker_created_at=$(jq -r '.created_at' <<<"$marker")
        if [ "$marker_created_at" = "$created_at" ]; then
            marker_state=$(jq -r '.state' <<<"$marker")
            requested_at=$(jq -r '.requested_at' <<<"$marker")
        else
            remove_cancellation_marker_for_task "$task_id" "$created_at" ||
                fail "cannot remove stale AgentQ cancellation marker: $task_id"
        fi
    fi

    if [ "$marker_state" = requested ]; then
        jq -cn --argjson task_id "$task_id" --arg requested_at "$requested_at" '{task_id: $task_id, action: "cancel_requested", cancellation_requested_at: $requested_at, reused: true}'
        return 0
    fi

    if task_is_done <<<"$task"; then
        if [ "$marker_state" = pending ]; then
            jq -cn --argjson task_id "$task_id" --arg requested_at "$requested_at" '{task_id: $task_id, state: "cancellation_pending", cancellation_requested_at: $requested_at}'
            printf '%s: task completed while the cancellation outcome remains unresolved: %s\n' "$program" "$task_id" >&2
            return 4
        fi
        fail "task is not running: $task_id" task_not_running
    fi

    if [ "$marker_state" != pending ]; then
        requested_at=$(date -u '+%Y-%m-%dT%H:%M:%SZ') || return 1
        # an empty requested_at fails valid_marker and bricks load_cancellation_markers
        write_cancellation_marker "$task_id" "$created_at" "$requested_at" pending
    fi

    if task_is_queued <<<"$task"; then
        if run_pueue remove "$task_id" >/dev/null; then
            write_cancellation_marker "$task_id" "$created_at" "$requested_at" requested
            jq -cn --argjson task_id "$task_id" --arg requested_at "$requested_at" '{task_id: $task_id, action: "cancel_requested", cancellation_requested_at: $requested_at, cancellation_mode: "queued_removed"}'
            return 0
        fi

        jq -cn --argjson task_id "$task_id" --arg requested_at "$requested_at" '{task_id: $task_id, state: "cancellation_pending", cancellation_requested_at: $requested_at}'
        printf '%s: failed to remove the queued task; the cancellation request remains pending: %s\n' "$program" "$task_id" >&2
        return 4
    fi

    if ! run_pueue kill "$task_id" >/dev/null; then
        jq -cn --argjson task_id "$task_id" --arg requested_at "$requested_at" '{task_id: $task_id, state: "cancellation_pending", cancellation_requested_at: $requested_at}'
        printf '%s: failed to confirm cancellation; the request remains pending: %s\n' "$program" "$task_id" >&2
        return 4
    fi

    write_cancellation_marker "$task_id" "$created_at" "$requested_at" requested
    jq -cn --argjson task_id "$task_id" --arg requested_at "$requested_at" '{task_id: $task_id, action: "cancel_requested", cancellation_requested_at: $requested_at}'
}

# Batch removal by user label: `remove --label <label> --confirm`.
#
# Removes every live task whose DECORATED label equals <label> -- the label the
# submitting caller chose and the one `status` shows, not Pueue's raw
# `agentq:<request-id>` (which no caller sets).  The candidate ids come from one
# compact_status snapshot; each id is then removed through remove_task, the same
# code path a single `remove <id>` takes, so per-task semantics (removing-state
# reconciliation, tombstone handling, id-reuse identity checks) cannot drift
# between the two forms.
#
# Each removal runs inside a command-substitution subshell so its `fail` (exit
# 2) cannot abort the batch: an item that vanished, is ambiguous, or otherwise
# cannot be removed is recorded as {"task_id":N,"removed":false,"state":"failed"}
# and the loop continues -- one bad id must not silently skip the rest.  The
# per-item stderr is suppressed on purpose: those are the inner fail()'s reason
# lines, and this command's own exit is 0 or 1, not 2, so printing reason= here
# would break the "every exit-2 path carries a reason line" contract.  The whole
# batch runs under one operation lock (the caller takes it), so no concurrent
# queue mutation can interleave with it.
remove_tasks_by_label() {
    local match_label=$1
    local snapshot
    local label_ids
    local item_id
    local item_output
    local item_status
    local item_failure_entry
    local result_lines=''
    local removed_count=0
    local failed_count=0

    [ -n "$match_label" ] || fail 'remove --label requires a non-empty label'

    ensure_daemon
    # `|| return $?` is load-bearing: inside with_operation_lock's `if "$@"` body
    # `set -e` is off, so a bare `$( )` assignment that fails would fall through
    # with an empty snapshot and remove nothing while reporting success -- the
    # fail-open this repository has measured twice (2026-10-06).
    snapshot=$(compact_status) || return $?

    label_ids=$(jq -r --arg task_label "$match_label" '
        [ .tasks | to_entries[] | select(.value.label == $task_label) | (.key | tostring) ]
        | sort_by(tonumber)
        | .[]
    ' <<<"$snapshot") || fail 'cannot select AgentQ tasks by label'

    while IFS= read -r item_id; do
        [ -n "$item_id" ] || continue
        item_status=0
        item_output=''
        if item_output=$(remove_task "$item_id" 2>/dev/null); then
            :
        else
            item_status=$?
        fi
        if [ "$item_status" -eq 0 ] && [ -n "$item_output" ]; then
            result_lines="$result_lines$item_output"$'\n'
            removed_count=$((removed_count + 1))
        else
            # The guard sits OUTSIDE the `$( )`: a `|| fail` inside it would only
            # end the substitution subshell, leaving `result_lines` unchanged
            # and the batch reporting one fewer entry with exit 0 -- the
            # fail-open this repository has measured twice (2026-10-06).  Every
            # other `$( )` in this function carries its guard this way; this one
            # carried none.
            item_failure_entry=$(jq -cn --argjson task_id "$item_id" '{task_id: $task_id, removed: false, state: "failed"}') ||
                fail 'cannot render an AgentQ batch removal failure entry'
            result_lines="$result_lines$item_failure_entry"$'\n'
            failed_count=$((failed_count + 1))
        fi
    done <<<"$label_ids"

    jq -cs '.' <<<"$result_lines" || fail 'cannot render AgentQ batch removal results'

    if [ "$failed_count" -gt 0 ]; then
        printf '%s: %s of %s tasks with label %s were not removed\n' \
            "$program" "$failed_count" "$((removed_count + failed_count))" "$match_label" >&2
        return 1
    fi
    return 0
}

remove_task() {
    local task_id=$1
    local removable_task
    local request_id
    local record
    local removable_status=0

    ensure_daemon
    removable_task=$(compact_task "$task_id") || removable_status=$?
    report_compact_task_failure "$removable_status" "$task_id"
    if mark_request_removing "$removable_task"; then
        :
    else
        return $?
    fi
    if run_pueue remove "$task_id" >/dev/null; then
        if mark_request_removed "$removable_task"; then
            :
        else
            return $?
        fi
        jq -cn --argjson task_id "$task_id" '{task_id: $task_id, removed: true}'
        return 0
    fi

    if request_id=$(request_id_from_task "$removable_task"); then
        :
    else
        return $?
    fi
    if [ -n "$request_id" ] && record=$(read_request_record "$request_id"); then
        if [ "$(jq -r '.state' <<<"$record")" = removing ] && reconcile_removing_request "$request_id" "$record" >/dev/null; then
            jq -cn --argjson task_id "$task_id" '{task_id: $task_id, removed: true, recovered: true}'
            return 0
        fi
    fi

    printf '%s: Pueue removal did not complete; the AgentQ request remains in removing state: %s\n' "$program" "$task_id" >&2
    # pueue's exit code is not an AgentQ contract code (see the submit and wait
    # sites): a raw pass-through could surface 42-45/124 from the server.  The
    # removal did not complete -- a general failure.  Measured 2026-10-12: a
    # stub `pueue remove` returning 44 produced `remove exit=44 reason=0`.
    return 1
}

main() {
    # Declared here so this dispatcher cannot write into a same-named local of
    # whatever it calls (bash resolves an unqualified assignment through the
    # DYNAMIC scope: an unlocalized write inside a callee lands in its CALLER's
    # local).  `status_mode`, `doctor_mode` and `task_id` are locals in the
    # functions below; without these three lines every `task_id=` here was a
    # write into whatever frame happened to be on top.  Measured 2026-10-23 with
    # a two-function probe: an unlocalized write in the callee is visible to a
    # caller that declared `local` for the same name.
    local status_mode=''
    local doctor_mode=''
    local task_id

    [ "$#" -ge 1 ] || {
        usage >&2
        printf '%s: reason=protocol_error\n' "$program" >&2
        exit 2
    }

    require_executable "$pueue_bin"
    require_executable "$pueued_bin"
    detect_stat_flavor || fail 'cannot determine how to read file identity on this platform'
    config_file_is_safe "$config_path" || fail "missing or unsafe Pueue config: $config_path"
    ensure_runtime_dependencies
    ensure_data_directory
    ensure_task_log_directory
    ensure_cancellation_directory
    ensure_request_directory
    ensure_runtime_directory
    ensure_not_in_maintenance

    case "$1" in
        submit)
            shift
            submit_with_operation_lock "$@"
            ;;
        lookup)
            shift
            lookup_with_operation_lock "$@"
            ;;
        status)
            shift
            status_mode=''
            if [ "$#" -eq 1 ]; then
                [ "$1" = '--summary' ] || fail 'status accepts --summary or --task <id>'
                status_mode=summary
            elif [ "$#" -eq 2 ]; then
                [ "$1" = '--task' ] || fail 'status accepts --summary or --task <id>'
                # Validate the id HERE, not only inside status(): status() reads
                # an empty mode as "the full queue" and the literal `summary` as
                # the summary mode, so `status --task ""` (a shell variable that
                # never got set) returned the whole queue with exit 0 and
                # `status --task summary` returned the summary -- both a success
                # response of the wrong shape, which a caller parsing {"task":...}
                # cannot tell from the right one (measured 2026-10-16).
                is_task_id "$2" || fail 'task id must be a non-negative integer'
                status_mode=$2
            elif [ "$#" -ne 0 ]; then
                fail 'status accepts --summary or --task <id>'
            fi
            status_with_read_lock "$status_mode"
            ;;
        logs)
            shift
            [ "$#" -ge 1 ] || fail 'logs requires one task id'
            is_task_id "$1" || fail 'task id must be a non-negative integer'
            validate_task_id_precision "$1"
            task_id=$(canonical_task_id "$1")
            logs_with_read_lock "$task_id" "${@:2}"
            ;;
        cancel)
            [ "$#" -eq 2 ] || fail 'cancel requires one task id'
            is_task_id "$2" || fail 'task id must be a non-negative integer'
            validate_task_id_precision "$2"
            task_id=$(canonical_task_id "$2")
            with_operation_lock cancel_task "$task_id"
            ;;
        wait)
            [ "$#" -eq 2 ] || fail 'wait requires one task id'
            is_task_id "$2" || fail 'task id must be a non-negative integer'
            validate_task_id_precision "$2"
            task_id=$(canonical_task_id "$2")
            with_operation_lock wait_for_task "$task_id"
            ;;
        remove)
            if [ "$#" -ge 2 ] && [ "$2" = '--label' ]; then
                [ "$#" -eq 4 ] || fail 'remove --label requires exactly a label and --confirm'
                [ "$4" = '--confirm' ] || fail 'remove --label requires --confirm: a batch removal must be explicitly acknowledged'
                [ -n "$3" ] || fail 'remove --label requires a non-empty label'
                with_operation_lock remove_tasks_by_label "$3"
            else
                [ "$#" -eq 2 ] || fail 'remove requires one task id, or --label <label> --confirm'
                is_task_id "$2" || fail 'task id must be a non-negative integer'
                validate_task_id_precision "$2"
                task_id=$(canonical_task_id "$2")
                with_operation_lock remove_task "$task_id"
            fi
            ;;
        doctor)
            shift
            doctor_mode=''
            if [ "$#" -eq 1 ]; then
                [ "$1" = '--full' ] || fail 'doctor accepts --full or no arguments'
                doctor_mode=full
            elif [ "$#" -ne 0 ]; then
                fail 'doctor accepts --full or no arguments'
            fi
            doctor_with_read_lock "$doctor_mode"
            ;;
        -h|--help|help)
            usage
            ;;
        *)
            fail "unknown command: $1"
            ;;
    esac
}

main "$@"
