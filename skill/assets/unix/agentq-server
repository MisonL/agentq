    fi
    if [ -n "$cancellation_markers_file" ]; then
        remove_runtime_temporary_file "$cancellation_markers_file" || cleanup_status=1
        cancellation_markers_file=''
    fi
    request_records_jq_file=''
    cancellation_markers_jq_file=''
    return "$cleanup_status"
}

