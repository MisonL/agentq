                temporary_pid=${temporary_stem%%.*}
                ;;
            .agentq-request-tombstones-v2.*.new)
                temporary_stem=${temporary_name#.agentq-request-tombstones-v2.}
                temporary_stem=${temporary_stem%.new}
                temporary_pid=${temporary_stem%%.*}
                ;;
            .agentq-request-tombstones-pruned-at.*.new)
                temporary_stem=${temporary_name#.agentq-request-tombstones-pruned-at.}
                temporary_stem=${temporary_stem%.new}
                temporary_pid=${temporary_stem%%.*}
                ;;
            *)
                fail "invalid AgentQ runtime temporary file path: $temporary_path"
                ;;
        esac
        is_positive_integer "$temporary_pid" ||
            fail "invalid AgentQ runtime temporary process id: $temporary_path"
        if process_is_confirmed_dead "$temporary_pid"; then
            remove_runtime_temporary_file "$temporary_path" ||
                fail "cannot remove stale AgentQ runtime temporary file: $temporary_path"
        fi
    done
    shopt -u nullglob
}

write_request_record() {
    local request_id=$1
    local record=$2
    local record_path
    local temporary

    record_path=$(request_record_path "$request_id")
    temporary=$(umask 077; make_temporary_file "$request_directory" ".agentqtmp.${request_id}" '.json') ||
        fail "cannot create temporary AgentQ request record: $request_id"
    if ! write_temporary_contents "$temporary" "$record" ||
        ! install_temporary_file "$temporary" "$record_path"; then
        if ! remove_runtime_temporary_file "$temporary" 'request record temporary file'; then
            fail "cannot write AgentQ request record; temporary cleanup failed: $request_id"
        fi
        fail "cannot write AgentQ request record: $request_id"
    fi
}

write_request_tombstone() {
    local request_id=$1
    local tombstone=$2
    local tombstone_path
    local temporary

    tombstone_path=$(request_tombstone_path "$request_id")
    temporary=$(umask 077; make_temporary_file "$request_tombstone_directory" ".agentqtmp.${request_id}" '.json') ||
        fail "cannot create temporary AgentQ tombstone: $request_id"
    if ! write_temporary_contents "$temporary" "$tombstone" ||
        ! install_temporary_file "$temporary" "$tombstone_path"; then
        if ! remove_runtime_temporary_file "$temporary" 'tombstone temporary file'; then
            fail "cannot write AgentQ tombstone; temporary cleanup failed: $request_id"
        fi
        fail "cannot write AgentQ tombstone: $request_id"
    fi
}

cleanup_request_payload_after_failure() {
    local payload_file=$1

    if ! remove_runtime_temporary_file "$payload_file" 'request payload file'; then
        printf '%s: failed to clean AgentQ request payload temporary file: %s\n' "$program" "$payload_file" >&2
        return 1
    fi
}

cleanup_compact_status_raw_status_after_failure() {
    local raw_status_file=$1

    if ! remove_runtime_temporary_file "$raw_status_file" 'compact status raw status file'; then
        printf '%s: failed to clean AgentQ compact status raw status temporary file: %s\n' "$program" "$raw_status_file" >&2
        return 1
    fi
}

cleanup_raw_compact_task_raw_status_after_failure() {
    local raw_status_file=$1

    if ! remove_runtime_temporary_file "$raw_status_file" 'raw compact task raw status file'; then
        printf '%s: failed to clean AgentQ raw compact task raw status temporary file: %s\n' "$program" "$raw_status_file" >&2
        return 1
    fi
}

cleanup_compact_task_raw_task_after_failure() {
    local raw_task_file=$1

    if ! remove_runtime_temporary_file "$raw_task_file" 'compact task raw task file'; then
        printf '%s: failed to clean AgentQ compact task raw task temporary file: %s\n' "$program" "$raw_task_file" >&2
        return 1
    fi
