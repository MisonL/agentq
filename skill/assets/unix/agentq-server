# The identity helpers below all want the same two things from stat, and every
# call used to probe both flavors: GNU's `-c` (always fails on BSD) and BSD's
# `-f`.  On a machine where a fork+exec costs ~15ms and one status call makes
# dozens of them, that doubled the cost for no benefit.  Probe the flavor once
# per process, then use only the form this platform actually supports.
#
# detect_stat_flavor() must run in the top-level shell: a command substitution
# runs in a subshell, so a cache written from inside one would be discarded.
detect_stat_flavor() {
    if [ -n "$stat_flavor" ]; then
        return 0
    fi
    if stat -c '%d:%i' -- "$script_directory" >/dev/null 2>&1; then
        stat_flavor=gnu
    elif stat -f '%d:%i' "$script_directory" >/dev/null 2>&1; then
        stat_flavor=bsd
    else
        return 1
    fi
}

# Emit `device:inode` for a path, or return non-zero.  Callers validate the
# output exactly as before.  Falls back to probing when the cache is unset, so
# this stays correct when called outside main().
stat_device_inode() {
    local path=$1
    local identity=''

    if [ -z "$stat_flavor" ]; then
        detect_stat_flavor || return 1
    fi
    if [ "$stat_flavor" = gnu ]; then
        identity=$(stat -c '%d:%i' -- "$path" 2>/dev/null) || return 1
    else
        identity=$(stat -f '%d:%i' "$path" 2>/dev/null) || return 1
    fi
    printf '%s\n' "$identity"
}

# Modification time as whole seconds; GNU spells it %Y, BSD spells it %m.
stat_mtime() {
    local path=$1
    local mtime=''

    if [ -z "$stat_flavor" ]; then
        detect_stat_flavor || return 1
    fi
    if [ "$stat_flavor" = gnu ]; then
        mtime=$(stat -c %Y "$path" 2>/dev/null) || return 1
    else
        mtime=$(stat -f %m "$path" 2>/dev/null) || return 1
    fi
    printf '%s\n' "$mtime"
}

temporary_file_identity() {
    local temporary_path=$1
    local temporary_identity=''

    if temporary_identity=$(stat_device_inode "$temporary_path"); then
        :
    else
        return 1
    fi
    case "$temporary_identity" in
        ''|*[!0-9:]*|*:*:*) return 1 ;;
    esac
    printf '%s\n' "$temporary_identity"
}

temporary_file_identity_matches() {
