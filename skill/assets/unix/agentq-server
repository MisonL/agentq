recover_removing_requests() {
    local records
    local record
    local request_id
    local reconcile_status

    # `|| return $?` is load-bearing, and its absence was measured: this
    # function is called as `recover_removing_requests || fail ...`, a
    # CONDITIONAL context where `set -e` is suspended, so a bare `$( )` whose
    # command failed left `records` empty and the function returned 0 -- the
    # caller saw success.  Measured 2026-10-16: with a record vanishing mid-scan,
    # `load_request_records` wrote `jq: error ... invalid AgentQ request record`
    # to stderr while `status` still exited 0 and lost a task's label
    # decoration.  Same fail-open shape as the batch-removal snapshot guard.
    records=$(load_request_records) || return $?
    # The request id and the record's own serialisation are emitted together,
    # one pair of lines per removing record, so the second jq invocation the
    # original ran per record disappears.  `tojson` is byte-identical to the
    # `jq -c` the record already went through, and it escapes newlines inside
    # string values, so record content cannot break the line-pair framing.
    while IFS= read -r request_id; do
        [ -n "$request_id" ] || continue
        IFS= read -r record || fail "cannot recover removing AgentQ request: $request_id"
        if reconcile_removing_request "$request_id" "$record" >/dev/null; then
            continue
        else
            reconcile_status=$?
        fi
        [ "$reconcile_status" -eq 1 ] ||
            fail "cannot recover removing AgentQ request: $request_id"
    done < <(jq -r '.[] | select(.state == "removing") | .request_id, tojson' <<<"$records")
}

request_response() {
    local request_id=$1
    local task_id=$2
    local reused=$3

    validate_task_id_precision "$task_id"
    jq -cn \
        --arg request_id "$request_id" \
        --argjson task_id "$task_id" \
        --argjson reused "$reused" \
        '{task_id: $task_id, request_id: $request_id, reused: $reused}'
}

request_id_from_task() {
    local task=$1
    local request_id
    local metadata_request_id
    local task_label

    metadata_request_id=$(jq -r '.agentq.request_id // empty' <<<"$task")
    task_label=$(jq -r '.label // empty' <<<"$task")
    case "$task_label" in
        agentq:*)
            request_id=${task_label#agentq:}
            if [ -n "$metadata_request_id" ] && [ "$metadata_request_id" != "$request_id" ]; then
                # The decorated label is the USER payload label, not Pueue's raw
                # `agentq:<request-id>`: decorate overwrites .label with
                # payload.label, so a user label that itself starts with
                # `agentq:` collides with the prefix here.  The authoritative
                # identity is the metadata request id attached by the same
                # decorate pass (or the raw compact label when the task is not
                # decorated); only distrust the label when BOTH disagree.
                # Measured 2026-10-13 (review round 4): a payload label
                # `agentq:foo` made every `remove` of that task exit 2
                # "conflicting request identities" forever.
                request_id=$metadata_request_id
            fi
            ;;
        *)
            request_id=$metadata_request_id
            ;;
    esac
    if [ -z "$request_id" ]; then
        fail 'AgentQ task metadata does not identify its request'
    fi

    printf '%s\n' "$request_id"
}

validate_task_removal() {
    local task=$1
    local request_id
    local record
    local task_id
    local task_created_at

    validate_visible_task_metadata "$task"
    if request_id=$(request_id_from_task "$task"); then
        :
    else
        return $?
    fi
    [ -n "$request_id" ] || return 0
    is_request_id "$request_id" || fail "invalid request id attached to task removal: $request_id"

    record=$(read_request_record "$request_id") || fail "missing AgentQ request record while removing task: $request_id"
    task_id=$(jq -r '.id' <<<"$task")
    task_created_at=$(jq -r '.created_at' <<<"$task")
    case "$(jq -r '.state' <<<"$record")" in
        accepted|removing) ;;
        *) fail "AgentQ request is not accepted or removing while removing task: $request_id" ;;
    esac
    validate_task_id_precision "$task_id"
    [ "$(jq -r '.task_id' <<<"$record")" = "$task_id" ] || fail "AgentQ request record does not match the task being removed: $request_id"
    [ "$(jq -r '.task_created_at' <<<"$record")" = "$task_created_at" ] || fail "AgentQ request record does not match the task creation time being removed: $request_id"
}

mark_request_removing() {
    local task=$1
    local request_id
    local record
    local task_id
    local task_created_at

    if validate_task_removal "$task"; then
        :
    else
        return $?
    fi
    if request_id=$(request_id_from_task "$task"); then
        :
    else
        return $?
    fi
    [ -n "$request_id" ] || return 0

    record=$(read_request_record "$request_id") || fail "missing AgentQ request record while preparing task removal: $request_id"
    if [ "$(jq -r '.state' <<<"$record")" = accepted ]; then
        task_id=$(jq -r '.id' <<<"$task")
        task_created_at=$(jq -r '.created_at' <<<"$task")
        # Errexit is OFF (this function runs as an `if` condition); a bare `$( )`
        # failure would write an empty record over the valid `accepted` one.
        record=$(set_request_state "$record" removing "$task_id" "$(jq -Rn --arg value "$task_created_at" '$value')") || {
            fail "cannot update the AgentQ request record to removing: $request_id"
        }
        if ! write_request_record "$request_id" "$record"; then
            fail "cannot persist removing AgentQ request: $request_id"
        fi
    fi
}

mark_request_removed() {
    local task=$1
    local request_id
    local record
    local task_id
    local task_created_at

    if validate_task_removal "$task"; then
        :
    else
        return $?
    fi
    if request_id=$(request_id_from_task "$task"); then
        :
    else
        return $?
    fi
    [ -n "$request_id" ] || return 0

    record=$(read_request_record "$request_id") || fail "missing AgentQ request record while removing task: $request_id"
    [ "$(jq -r '.state' <<<"$record")" = removing ] || fail "AgentQ request removal was not prepared: $request_id"
    task_id=$(jq -r '.id' <<<"$task")
    task_created_at=$(jq -r '.created_at' <<<"$task")
    # Same errexit-off guard as mark_request_removing: an empty record must not
    # reach archive_removed_request.
    record=$(set_request_state "$record" removed "$task_id" "$(jq -Rn --arg value "$task_created_at" '$value')") || {
        fail "cannot update the AgentQ request record to removed: $request_id"
    }
    if ! archive_removed_request "$request_id" "$record" >/dev/null; then
        fail "cannot archive removed AgentQ request while removing task: $request_id"
    fi
}

compact_status_summary() {
    # A compact view of the agentq group: for each task, its id, queue state,
    # label and -- for finished tasks -- the Done result.  Same raw-status
    # snapshot discipline as compact_status (single `pueue status --json`,
    # precision + shape guards) but NO request-record join and a much smaller
    # per-task payload, so an agent can answer "what is in the queue" without
    # pulling a full decorated dump: measured 2026-10-15 (session-log mining) a
    # 258-task doctor emitted 124291 bytes and callers truncated it ~2600 times.
    #
    # The output is JSON, not lines, because every AgentQ success response is
    # JSON and the clients validate it structurally before reporting success:
    #   {"tasks": {"<id>": {"id":N,"state":"Done","result":"Success","label":...}},
    #    "group": {...} | null, "summary": true}
    # `state` is "Done" for finished tasks and the joined Pueue status key(s)
    # otherwise; `result` is present only for Done.  The `summary` marker lets a
    # consumer tell this shape from the full one.  A task whose shape cannot be
    # summarised fails the whole summary (jq error -> caller's fold -> exit 2),
    # never a silent gap: the created_at check that the full compactor makes is
    # repeated here so `doctor`'s malformed-status contract holds in this mode
    # too (smoke/02).
    local command_status
    local raw_status_file

    raw_status_file=$(umask 077; make_temporary_file "$runtime_directory" '.agentq-status' '.json') || return 1

    if require_runtime_temporary_file "$raw_status_file" &&
        run_pueue status --json > "$raw_status_file" &&
        require_runtime_temporary_file "$raw_status_file"; then
        validate_pueue_task_id_precision_in_file "$raw_status_file"
        require_runtime_temporary_file "$raw_status_file"
        validate_pueue_task_shape_in_file "$raw_status_file"
        require_runtime_temporary_file "$raw_status_file"
        if jq -c --arg group "$group_name" '
            . as $status
            | {
                tasks: (
                    $status.tasks
                    | to_entries
                    | map(select(.value.group == $group))
                    | sort_by(.value.id)
                    | map(
                        if ((.value.id | type) == "number")
                           and ((.value.id | floor) == .value.id)
                           and (.value.id >= 0)
                           and ((.value.created_at | type) == "string")
                           and ((.value.created_at | length) > 0)
                           # label may be null: the Pueue task label is optional,
                           # so a task added to the group directly (`pueue add -g
                           # agentq`) has none.  The full-status guard does not
                           # require a label either; requiring one here made the
                           # DEFAULT doctor view fail (exit 2) on a queue that
                           # `doctor --full` and `status --task` read fine
                           # (measured 2026-10-16).
                           and (((.value.label | type) == "string") or (.value.label == null))
                           and ((.value.status | type) == "object") then
                            {
                                key: (.value.id | tostring),
                                value: (
                                    if ((.value.status.Done | type) == "object")
                                       and (.value.status.Done | has("result")) then
                                        {id: .value.id, state: "Done", result: .value.status.Done.result, label: .value.label}
                                    else
                                        {id: .value.id, state: ([.value.status | keys[]] | join(",")), label: .value.label}
                                    end
                                )
                            }
                        else
                            error("invalid task in AgentQ status summary")
                        end
                    )
                    | from_entries
                ),
                group: ($status.groups[$group] // null),
                summary: true
            }
        ' < "$raw_status_file"; then
            command_status=0
        else
            command_status=$?
        fi
    else
        command_status=$?
    fi
    remove_runtime_temporary_file "$raw_status_file" || command_status=1
    if [ "$command_status" -ne 0 ]; then
        fail 'cannot summarise Pueue status for AgentQ'
    fi
    return 0
}

compact_status() {
    local command_status
    local raw_status_file

    raw_status_file=$(umask 077; make_temporary_file "$runtime_directory" '.agentq-status' '.json') || return 1

    if ! prepare_request_metadata_files; then
        cleanup_compact_status_raw_status_after_failure "$raw_status_file" || return 1
        return 1
    fi
    if require_runtime_temporary_file "$raw_status_file" &&
        require_runtime_temporary_file "$raw_status_file" &&
        require_runtime_temporary_file "$raw_status_file" &&
        require_runtime_temporary_file "$raw_status_file" &&
        run_pueue status --json > "$raw_status_file" &&
        require_runtime_temporary_file "$raw_status_file" &&
        validate_pueue_task_id_precision_in_file "$raw_status_file" &&
        require_runtime_temporary_file "$raw_status_file" &&
        validate_pueue_task_shape_in_file "$raw_status_file" &&
        require_runtime_temporary_file "$raw_status_file" &&
        jq -c --arg group "$group_name" \
        --slurpfile markers "$cancellation_markers_jq_file" \
        --slurpfile requests "$request_records_jq_file" "
        $compact_filter
        {
            tasks: (
                .tasks
                | with_entries(
                    select(.value.group == \$group)
                    | .value |= (
                        compact
                        | decorate(\$markers[0]; \$requests[0])
                        | if ((type == \"object\")
                              and ((.id | type) == \"number\")
                              and (.id >= 0)
                              and ((.id | floor) == .id)
                              and ((.created_at | type) == \"string\")
                              and ((.created_at | length) > 0)) then
                            .
                          else
                            error(\"invalid visible Pueue task metadata\")
                          end
                    )
                )
            ),
            group: (.groups[\$group] // null)
        }
    " < "$raw_status_file"; then
        command_status=0
    else
        command_status=$?
    fi
    remove_runtime_temporary_file "$raw_status_file" || command_status=1
    release_request_metadata_files || command_status=1
    # The jq filter above ends in `error("invalid visible Pueue task
    # metadata")`, which exits jq with 5.  Returning that raw made `status` and
    # `doctor` exit 5 -- the code the contract reserves for a REMOVED task, with
    # no JSON body and no reason line, so a caller reading 5 as "removed" was
    # misled (measured 2026-10-12: a Pueue task missing `created_at` produced
    # `status exit=5 stdout=[] reason=0`).  Every other caller that compacts a
    # task -- logs, wait, cancel, remove -- folds a non-zero status through
    # report_compact_task_failure instead; fold here too.  A malformed status
    # is "Pueue could not be inspected", which is a protocol failure (exit 2 +
    # reason), not a task state.
    if [ "$command_status" -ne 0 ]; then
        fail 'cannot inspect Pueue while reading AgentQ status'
    fi
    return 0
}

