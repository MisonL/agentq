create_request_record() {
    local request_id=$1
    local payload=$2
    local task_label=$3
    local created_at
    local payload_file
    local payload_jq_file
    local command_status

    created_at=$(date -u '+%Y-%m-%dT%H:%M:%SZ') || return 1
    # An empty created_at is rejected by request_record_filter and would brick
    # load_request_records for every command until the file is hand-deleted --
    # the same $() family guarded everywhere else; remaining site (2026-10-13).
    payload_file=$(umask 077; make_temporary_file "$runtime_directory" '.agentq-payload') || return 1
    if ! require_runtime_temporary_file "$payload_file" ||
        ! require_runtime_temporary_file "$payload_file" ||
        ! require_runtime_temporary_file "$payload_file" ||
        ! printf '%s\n' "$payload" > "$payload_file" ||
        ! require_runtime_temporary_file "$payload_file"; then
        cleanup_request_payload_after_failure "$payload_file" || return 1
        return 1
    fi
    if ! payload_jq_file=$(jq_file_argument "$payload_file") ||
        ! require_runtime_temporary_file "$payload_file"; then
        cleanup_request_payload_after_failure "$payload_file" || return 1
        return 1
    fi
    require_runtime_temporary_file "$payload_file" || {
        cleanup_request_payload_after_failure "$payload_file" || return 1
        return 1
    }
    if jq -cn \
        --arg request_id "$request_id" \
        --slurpfile payload "$payload_jq_file" \
        --arg task_label "$task_label" \
        --arg created_at "$created_at" \
        '{
            version: 1,
            request_id: $request_id,
            payload: $payload[0],
            task_label: $task_label,
            state: "prepared",
            task_id: null,
            task_created_at: null,
            created_at: $created_at
        }'; then
        command_status=0
    else
        command_status=$?
    fi
    if ! remove_runtime_temporary_file "$payload_file"; then
        printf '%s: failed to remove the temporary request payload file\n' "$program" >&2
        [ "$command_status" -ne 0 ] || command_status=1
    fi
    return "$command_status"
}

set_request_state() {
    local record=$1
    local state=$2
    local task_id=${3:-null}
    local task_created_at=${4:-null}

    if [ "$task_id" != null ]; then
        validate_task_id_precision "$task_id"
    fi
    jq -ce \
        --arg state "$state" \
        --argjson task_id "$task_id" \
        --argjson task_created_at "$task_created_at" \
        '.state = $state | .task_id = $task_id | .task_created_at = $task_created_at' \
        <<<"$record"
}

make_request_tombstone() {
    local record=$1
    local removed_at=${2:-}

    if [ -z "$removed_at" ]; then
        removed_at=$(date -u '+%Y-%m-%dT%H:%M:%SZ') || return 1
    fi  # empty removed_at would fail request_tombstone_filter and brick lookup/wait

    jq -ce --arg removed_at "$removed_at" '
        if .state == "removed" then {
            version,
            request_id,
            task_id,
            task_created_at,
            state,
            removed_at: $removed_at
        }
        else error("cannot archive a non-removed AgentQ request")
        end
    ' <<<"$record"
}

request_tombstone_matches_record() {
    local tombstone=$1
    local record=$2
    local request_id
    local task_id
    local task_created_at

    request_id=$(jq -r '.request_id' <<<"$record")
    task_id=$(jq -r '.task_id' <<<"$record")
    task_created_at=$(jq -r '.task_created_at' <<<"$record")
    jq -e \
        --arg request_id "$request_id" \
        --arg task_id "$task_id" \
        --arg task_created_at "$task_created_at" '
        def canonical_integer_string:
            tostring
            | sub("^0+"; "")
            | if . == "" then "0" else . end;
        .request_id == $request_id
        and (.task_id | canonical_integer_string) == ($task_id | canonical_integer_string)
        and .task_created_at == $task_created_at
        and .state == "removed"
    ' <<<"$tombstone" >/dev/null
}

archive_removed_request() {
    local request_id=$1
    local record=$2
    local record_path
    local tombstone_path
    local tombstone
    local existing_tombstone

    [ "$(jq -r '.state' <<<"$record")" = removed ] || fail "cannot archive a non-removed AgentQ request: $request_id"
    record_path=$(request_record_path "$request_id")
    tombstone_path=$(request_tombstone_path "$request_id")
    # `|| return 1` is load-bearing: this function runs inside `if !` / `||`
    # contexts where errexit is suspended, so a failing `$( )` leaves tombstone
    # EMPTY and execution continues -- an empty tombstone would be written, the
    # live record deleted, and the request id could then be reused (the submit
    # path treats an unreadable tombstone as "never used").  Same fail-open
    # class as the 2026-10-06 --workdir defect.
    tombstone=$(make_request_tombstone "$record") || return 1

    if [ -e "$tombstone_path" ]; then
        existing_tombstone=$(read_request_tombstone "$request_id") || fail "invalid AgentQ request tombstone: $tombstone_path"
        request_tombstone_matches_record "$existing_tombstone" "$record" || fail "AgentQ request tombstone conflicts with the active record: $request_id"
        tombstone=$existing_tombstone
    else
        write_request_tombstone "$request_id" "$tombstone" || return 1
    fi

    remove_runtime_temporary_file "$record_path" 'request record' || return 1
    remove_cancellation_marker_for_task \
        "$(jq -r '.task_id' <<<"$record")" \
        "$(jq -r '.task_created_at' <<<"$record")" || return 1
    printf '%s\n' "$tombstone"
}

write_runtime_marker() {
    local marker_path=$1
    local value=$2
    local marker_directory=${marker_path%/*}
    local marker_name=${marker_path##*/}
    local temporary

    temporary=$(umask 077; make_temporary_file "$marker_directory" ".${marker_name}" '.new') ||
        fail "cannot create temporary AgentQ runtime marker: $marker_path"

    if ! write_temporary_contents "$temporary" "$value" ||
        ! install_temporary_file "$temporary" "$marker_path"; then
        if ! remove_runtime_temporary_file "$temporary" 'runtime marker temporary file'; then
            fail "cannot write AgentQ runtime marker; temporary cleanup failed: $marker_path"
        fi
        fail "cannot write AgentQ runtime marker: $marker_path"
    fi
}

repair_removed_request_records() {
    local record_files=()
    local record_path
    local request_id
    local record
    local record_state
    local record_ids=()
    local output
    local read_status=0
    local repair_guard_stderr=''

    shopt -s nullglob
    record_files=("$request_directory"/*.json)
    shopt -u nullglob
    [ "${#record_files[@]}" -gt 0 ] || return 0

    # The request ids are collected here, in the parent shell: the body loop
    # below runs left of a pipe, so an array filled there would never arrive
    # (the $( )/pipeline trap this repo has recorded four times).  The
    # filename-shape check is kept here verbatim.
    for record_path in "${record_files[@]}"; do
        request_id=${record_path##*/}
        request_id=${request_id%.json}
        is_request_id "$request_id" || fail "invalid AgentQ request record filename: $record_path"
        record_ids+=("$request_id")
    done

    # Fast path: the guards AND the aggregate run inside ONE subshell whose
    # stderr is discarded.  Any guard failure, a length mismatch, a malformed
    # record, or a body that cannot be read makes it exit non-zero -- and then
    # the original per-file loop below runs verbatim and reproduces the exact
    # stderr and exit status (guard message + the caller's "missing ..." line,
    # or jq's own parse error plus both fail messages).  This is what makes the
    # fold byte-for-byte faithful: an aggregate jq cannot reproduce a per-file
    # jq's error text, so any failure falls back to the code that can.
    #
    # On a well-formed tree it emits one "id\nrecord" pair per removed record
    # (usually none), which is all repair ever acts on -- the other states are
    # validated but not otherwise consulted.
    if output=$(
        {
            for record_path in "${record_files[@]}"; do
                # A vanished record emits the `null` placeholder, exactly as
                # load_request_records does.  A bare `continue` would drop one
                # line while the positional binding still carries its id, and
                # the length check above would then reject the whole batch --
                # turning one concurrent removal back into the failure this
                # whole arm exists to avoid.
                if ! request_record_path_guards_or_fail "$record_path"; then
                    printf 'null\n'
                    continue
                fi
                printf '%s\n' "$(<"$record_path")"
            done | jq -rs --args "$request_removed_records_filter" -- "${record_ids[@]}"
        } 2>/dev/null
    ); then
        while IFS= read -r request_id; do
            [ -n "$request_id" ] || continue
            IFS= read -r record || fail "cannot archive removed AgentQ request during repair: $request_id"
            archive_removed_request "$request_id" "$record" >/dev/null ||
                fail "cannot archive removed AgentQ request during repair: $request_id"
        done <<<"$output"
        return 0
    fi

    # Fallback: the original loop, unchanged.  record_task_id is not read here
    # (repair only branches on the state), so it is not decoded.
    repair_guard_stderr=$(mktemp "${TMPDIR:-/tmp}/agentq-repair-guard.XXXXXX") || return 1
    for record_path in "${record_files[@]}"; do
        request_id=${record_path##*/}
        request_id=${request_id%.json}
        is_request_id "$request_id" || fail "invalid AgentQ request record filename: $record_path"
        # rc=1 is the vanished verdict (neither `-e` nor `-L`); every other
        # failure still takes the original `|| fail` path below, because the
        # reader prints its own guard message before `fail` exits the subshell.
        # The status is captured IMMEDIATELY: `[ $? -eq 1 ]` in the elif
        # branch would test the status of the `if` condition's own evaluation.
        #
        # `|| read_status=$?` is load-bearing, not decoration: under `set -e` a
        # bare `output=$( )` whose command substitution exits non-zero kills the
        # SERVER before the next line runs, so without it the vanished verdict
        # was unreachable and this loop died silently with rc=2 and no message.
        # Measured while adding the vanish arm (A-F2).  This is the record's
        # fourth `$( )` trap.
        output=$(read_request_record_state_and_body "$request_id" 2>"$repair_guard_stderr") ||
            read_status=$?
        read_status=${read_status:-0}
        if [ "$read_status" -eq 1 ]; then
            continue
        elif [ "$read_status" -ne 0 ]; then
            cat "$repair_guard_stderr" >&2
            rm -f -- "$repair_guard_stderr"
            fail "missing AgentQ request record during recovery: $record_path"
        fi
        record_state=${output%%$'\n'*}
        output=${output#*$'\n'}
        record=${output#*$'\n'}
        if [ "$record_state" = removed ]; then
            if ! archive_removed_request "$request_id" "$record" >/dev/null; then
                rm -f -- "$repair_guard_stderr"
                fail "cannot archive removed AgentQ request during repair: $request_id"
            fi
        fi
    done
    rm -f -- "$repair_guard_stderr"
}

migrate_removed_request_records() {
    local marker_value=''

    if [ -e "$request_layout_marker" ] || [ -L "$request_layout_marker" ]; then
        runtime_marker_file_is_safe "$request_layout_marker" || fail "invalid AgentQ request layout marker: $request_layout_marker"
        runtime_marker_file_is_safe "$request_layout_marker" || fail "invalid AgentQ request layout marker: $request_layout_marker"
        IFS= read -r marker_value < "$request_layout_marker" || marker_value=''
        [ "$marker_value" = v2 ] || fail "unsupported AgentQ request layout marker: $request_layout_marker"
    else
        write_runtime_marker "$request_layout_marker" v2
    fi

    # A tombstone and its active record cannot be switched atomically. Recheck
    # every layout load so a crash after writing the tombstone repairs itself.
    repair_removed_request_records
}

request_tombstones_need_pruning() {
    local current_epoch
    local marker_epoch=''

    if [ ! -e "$request_tombstone_prune_marker" ] && [ ! -L "$request_tombstone_prune_marker" ]; then
        return 0
    fi
    runtime_marker_file_is_safe "$request_tombstone_prune_marker" || fail "invalid AgentQ tombstone prune marker: $request_tombstone_prune_marker"
    runtime_marker_file_is_safe "$request_tombstone_prune_marker" || fail "invalid AgentQ tombstone prune marker: $request_tombstone_prune_marker"
    IFS= read -r marker_epoch < "$request_tombstone_prune_marker" || marker_epoch=''
    is_positive_integer "$marker_epoch" || return 0
    current_epoch=$(date +%s)
    is_positive_integer "$current_epoch" || fail 'cannot determine the current time for AgentQ tombstone pruning'
    [ "$current_epoch" -lt "$marker_epoch" ] && return 1
    [ $((current_epoch - marker_epoch)) -ge "$request_tombstone_prune_interval" ]
}

prune_request_tombstones() {
    local current_epoch

    request_tombstones_need_pruning || return 0
    path_chain_is_safe "$request_tombstone_directory" ||
        fail "invalid AgentQ request tombstone directory path: $request_tombstone_directory"
    find "$request_tombstone_directory" -type f -name '*.json' -mtime +"$request_tombstone_retention_days" -exec rm -f -- {} + || fail 'failed to prune expired AgentQ request tombstones'
    current_epoch=$(date +%s)
    is_positive_integer "$current_epoch" || fail 'cannot determine the current time for AgentQ tombstone pruning'
    write_runtime_marker "$request_tombstone_prune_marker" "$current_epoch"
}

ensure_request_record_layout() {
    prune_runtime_temporary_files
    prune_request_temporary_files
    prune_cancellation_temporary_files
    migrate_removed_request_records
    prune_request_tombstones
}

request_payload() {
    local workdir=$1
    local label=$2
    shift 2

    # The variable must not be named `label`: jq 1.6 (el9/fedora/EPEL, and
    # every jq before 1.6.3) lexes `label` as a reserved keyword, so `$label`
    # here was a compile error and payload fell back to null -- which then
    # failed request_record_filter, corrupting every submit on such a host.
    # `task_label` is already used elsewhere for a non-reserved name (rule E).
    # The KEY `label` may stay bare: `key: expr` is the `NAME ':' expr` form,
    # which even reserved words lex as keys (verified jq-1.6).
    jq -cn --arg workdir "$workdir" --arg task_label "$label" \
        '{workdir: $workdir, label: $task_label, argv: $ARGS.positional}' \
        --args -- "$@"
}

request_payload_matches() {
    local record=$1
    local payload=$2
    local payload_file
    local payload_jq_file
    local command_status

    payload_file=$(umask 077; make_temporary_file "$runtime_directory" '.agentq-payload') || return 1
    if ! require_runtime_temporary_file "$payload_file" ||
        ! require_runtime_temporary_file "$payload_file" ||
        ! require_runtime_temporary_file "$payload_file" ||
        ! printf '%s\n' "$payload" > "$payload_file" ||
        ! require_runtime_temporary_file "$payload_file"; then
        cleanup_request_payload_after_failure "$payload_file" || return 1
        return 1
    fi
    if ! payload_jq_file=$(jq_file_argument "$payload_file") ||
        ! require_runtime_temporary_file "$payload_file"; then
        cleanup_request_payload_after_failure "$payload_file" || return 1
        return 1
    fi
    require_runtime_temporary_file "$payload_file" || {
        cleanup_request_payload_after_failure "$payload_file" || return 1
        return 1
    }
    if jq -e --slurpfile payload "$payload_jq_file" '.payload == $payload[0]' <<<"$record" >/dev/null; then
        command_status=0
    else
        command_status=$?
    fi
    if ! remove_runtime_temporary_file "$payload_file"; then
        printf '%s: failed to remove the temporary request payload file\n' "$program" >&2
        [ "$command_status" -ne 0 ] || command_status=1
    fi
    return "$command_status"
}

acquire_request_lock() {
    local request_id=$1
    local candidate="$request_lock_directory/$request_id"
    local candidate_parent
    local attempt=0
    local lock_pid=''
    local lock_identity=''
    local request_lock_holder
    local request_lock_message

    case "$candidate" in
        */*)
            candidate_parent=${candidate%/*}
            [ -n "$candidate_parent" ] || candidate_parent=/
            ;;
        *)
            candidate_parent=.
            ;;
    esac

    path_chain_is_safe "$candidate" || fail "invalid AgentQ request lock path: $candidate"
    set_current_process_lock_metadata || fail "cannot determine AgentQ request lock owner"

    while [ "$attempt" -lt "$lock_acquire_attempts" ]; do
        [ ! -L "$candidate_parent" ] || fail "invalid AgentQ request lock parent path: $candidate_parent"
        [ ! -L "$candidate" ] || fail "invalid AgentQ request lock path: $candidate"
        if mkdir -- "$candidate" 2>/dev/null; then
            if ! write_lock_metadata "$candidate/pid"; then
                attempt=$((attempt + 1))
                [ "$attempt" -lt "$lock_acquire_attempts" ] ||
                    fail "cannot initialize AgentQ request lock: $candidate"
                sleep "$lock_retry_delay_seconds"
                continue
            fi
            request_lock=$candidate
            return 0
        fi

        [ ! -L "$candidate_parent" ] || fail "invalid AgentQ request lock parent path: $candidate_parent"
        [ ! -L "$candidate" ] || fail "invalid AgentQ request lock path: $candidate"
        if read_lock_metadata "$candidate/pid"; then
            if process_is_confirmed_dead "$lock_pid" "$lock_identity"; then
                if ! remove_stale_lock "$candidate" request "$lock_pid" "$lock_identity"; then
                    fail "cannot recover stale AgentQ request lock: $candidate"
                fi
                continue
            fi
        elif lock_directory_is_stale_empty "$candidate"; then
            if ! remove_stale_lock "$candidate" request '' '' true; then
                fail "cannot recover empty AgentQ request lock: $candidate"
            fi
            continue
        fi

        attempt=$((attempt + 1))
        sleep "$lock_retry_delay_seconds"
    done

    request_lock_holder=''
    if [ -n "$lock_pid" ]; then
        request_lock_holder="held by pid $lock_pid (started: $lock_identity)"
    fi
    request_lock_message="AgentQ request is already being submitted: $request_id"
    if [ -n "$request_lock_holder" ]; then
        request_lock_message="$request_lock_message ($request_lock_holder)"
    fi
    fail "$request_lock_message" lock_contention
}

find_request_task() {
    local task_label=$1
    local raw_status_file
    local matches
    local match_count
    local task

    raw_status_file=$(umask 077; make_temporary_file "$runtime_directory" '.agentq-reconcile-status' '.json') ||
        fail 'cannot allocate a reconciliation status temporary file'
    reconcile_raw_status_file=$raw_status_file
    require_runtime_temporary_file "$raw_status_file"
    require_runtime_temporary_file "$raw_status_file"
    require_runtime_temporary_file "$raw_status_file"
    require_runtime_temporary_file "$raw_status_file"
    # A transient Pueue read failure must NOT be reported as "no matching task".
    # `fail` is `exit 2`, and `exit` inside the `$( )` at every call site ends only
    # the subshell: the caller then sees an empty string and a false condition,
    # concludes the task is gone, and archives a LIVE request as `removed`.
    # Return a distinct status instead; each caller raises the hard failure in its
    # own shell (see the guard at the top of the matching `else`).
    run_pueue status --json > "$raw_status_file" || {
        remove_runtime_temporary_file "$raw_status_file" 'reconciliation raw status file' || true
        reconcile_raw_status_file=''
        return 3
    }
    require_runtime_temporary_file "$raw_status_file"
    validate_pueue_task_id_precision_in_file "$raw_status_file"
    require_runtime_temporary_file "$raw_status_file"
    validate_pueue_task_shape_in_file "$raw_status_file"
    require_runtime_temporary_file "$raw_status_file"
    matches=$(jq -ce --arg group "$group_name" --arg task_label "$task_label" '
        [
            .tasks[]
            | select(.group == $group and .label == $task_label)
            | {id, created_at}
        ]
    ' < "$raw_status_file") || {
        remove_runtime_temporary_file "$raw_status_file" 'reconciliation raw status file' || true
        reconcile_raw_status_file=''
        return 3
    }
    match_count=$(jq -r 'length' <<<"$matches")

    case "$match_count" in
        0)
            remove_runtime_temporary_file "$raw_status_file" 'reconciliation raw status file' || fail 'failed to clean AgentQ reconciliation raw status temporary file'
            reconcile_raw_status_file=''
            return 1
            ;;
        1)
            task=$(jq -c '.[0]' <<<"$matches") || {
                remove_runtime_temporary_file "$raw_status_file" 'reconciliation raw status file' || fail 'failed to clean AgentQ reconciliation raw status temporary file'
                reconcile_raw_status_file=''
                fail 'cannot render the matching Pueue task while reconciling an AgentQ request'
            }
            remove_runtime_temporary_file "$raw_status_file" 'reconciliation raw status file' || fail 'failed to clean AgentQ reconciliation raw status temporary file'
            reconcile_raw_status_file=''
            printf '%s\n' "$task"
            ;;
        *)
            remove_runtime_temporary_file "$raw_status_file" 'reconciliation raw status file' || true
            reconcile_raw_status_file=''
            return 4
            ;;
    esac
}

validate_visible_task_metadata() {
    local task=$1

    jq -e '
        if type != "object" then
            false
        elif (.id | type) != "number" then
            false
        elif (.id < 0) or ((.id | floor) != .id) then
            false
        elif (.created_at | type) != "string" then
            false
        elif (.created_at | length) == 0 then
            false
        else
            true
        end
    ' <<<"$task" >/dev/null ||
        fail 'invalid visible Pueue task metadata while recovering an AgentQ submit'
}

reconcile_accepted_request() {
    local request_id=$1
    local record=$2
    local task_label
    local expected_task_id
    local expected_task_created_at
    local task
    local observed_task_id
    local observed_task_created_at

    [ "$(jq -r '.state' <<<"$record")" = accepted ] || fail "cannot reconcile a non-accepted AgentQ request: $request_id"
    task_label=$(jq -r '.task_label' <<<"$record")
    expected_task_id=$(jq -r '.task_id' <<<"$record")
    expected_task_created_at=$(jq -r '.task_created_at' <<<"$record")
    is_task_id "$expected_task_id" || fail "invalid task id in AgentQ request record: $request_id"
    validate_task_id_precision "$expected_task_id"

    find_request_task_rc=0
    task=$(find_request_task "$task_label") || find_request_task_rc=$?
    if [ "$find_request_task_rc" -ne 0 ] && [ "$find_request_task_rc" -ne 1 ]; then
        return "$find_request_task_rc"
    fi
    if [ "$find_request_task_rc" -eq 0 ]; then
        if ! jq -e '
            if type != "object" then
                false
            elif (.id | type) != "number" then
                false
            elif (.id < 0) or ((.id | floor) != .id) then
                false
            elif (.created_at | type) != "string" then
                false
            elif (.created_at | length) == 0 then
                false
            else
                true
            end
        ' <<<"$task" >/dev/null; then
            fail "invalid visible Pueue task metadata while reconciling AgentQ request: $request_id"
        fi
        observed_task_id=$(jq -r '.id' <<<"$task")
        observed_task_created_at=$(jq -r '.created_at' <<<"$task")
        validate_task_id_precision "$observed_task_id"
        if [ "$observed_task_id" != "$expected_task_id" ] || [ "$observed_task_created_at" != "$expected_task_created_at" ]; then
            fail "AgentQ request record does not match the visible Pueue task: $request_id"
        fi
        printf '%s\n' "$record"
        return 0
    fi

    # Errexit is OFF here (this function runs as an `if` condition), so a bare
    # `$( )` failure would continue with an empty record and archive it.
    record=$(set_request_state "$record" removed "$expected_task_id" "$(jq -Rn --arg value "$expected_task_created_at" '$value')") || {
        fail "cannot update the AgentQ request record during removing-recovery: $request_id"
    }
    if ! record=$(archive_removed_request "$request_id" "$record"); then
        printf '%s: failed to archive removed AgentQ request during recovery: %s\n' "$program" "$request_id" >&2
        return 1
    fi
    printf '%s\n' "$record"
    return 1
}

reconcile_removing_request() {
