    esac
}

managed_daemon_is_active() {
    local launch_output
    case "$platform_kind" in
        windows)
            command -v powershell.exe >/dev/null 2>&1 || return 1
            # shellcheck disable=SC2016
            AGENTQ_PUEUED_PATH="$pueued_path_windows" powershell.exe \
                -NoProfile \
                -NonInteractive \
                -Command '
                    $target = $env:AGENTQ_PUEUED_PATH
                    foreach ($process in @(Get-Process -Name pueued -ErrorAction SilentlyContinue)) {
                        try {
                            if ($process.Path -ieq $target) {
                                exit 0
                            }
                        } catch {
                        }
                    }
                    exit 1
                ' >/dev/null 2>&1
            ;;
        unix)
            case "$platform" in
                Linux*)
                    command -v systemctl >/dev/null 2>&1 || return 1
                    systemctl --user is-active --quiet agentq-pueued.service
                    ;;
                Darwin*)
                    command -v launchctl >/dev/null 2>&1 || return 1
                    macos_launch_service_target
                    # No pipe: under `set -o pipefail` a quiet grep that exits
                    # on its first match can make launchctl take SIGPIPE, turn
                    # the pipeline non-zero, and report a RUNNING service as
                    # inactive -- start_managed_daemon then kickstarts it.
                    # Here-strings have no second writer, so the same predicate
                    # cannot be inverted by a race.
                    launch_output=$(launchctl print "$macos_launch_service" 2>/dev/null) || return 1
                    grep -q 'state = running' <<<"$launch_output"
                    ;;
                *)
                    return 1
                    ;;
            esac
            ;;
    esac
}

start_managed_daemon() {
    case "$platform_kind" in
        windows)
            [ -r "$startup_script" ] || fail "missing AgentQ startup script: $startup_script"
            command -v powershell.exe >/dev/null 2>&1 || fail 'powershell.exe is required to start Pueue on Windows'
            if ! powershell.exe \
                -NoProfile \
                -NonInteractive \
                -ExecutionPolicy Bypass \
                -File "$startup_script_path" >/dev/null; then
                fail 'failed to start the managed Windows Pueue daemon'
            fi
            ;;
        unix)
            case "$platform" in
                Linux*)
                    command -v systemctl >/dev/null 2>&1 || fail 'systemctl is required to start AgentQ on Linux'
                    if ! systemctl --user start agentq-pueued.service; then
                        fail 'failed to start systemd user service agentq-pueued.service'
                    fi
                    ;;
                Darwin*)
                    command -v launchctl >/dev/null 2>&1 || fail 'launchctl is required to start AgentQ on macOS'
                    macos_launch_service_target
                    case "$macos_launch_service" in
                        system/*)
                            fail 'system LaunchDaemon com.agentq.pueued is inactive; rerun the AgentQ installer in an interactive sudo session'
                            ;;
                    esac
                    if ! launchctl kickstart "$macos_launch_service"; then
                        fail 'failed to start launchd service com.agentq.pueued'
                    fi
                    ;;
            esac
            ;;
    esac
}

macos_launch_service_target() {
    local macos_uid

    macos_uid=$(id -u)
    macos_launch_service="system/com.agentq.pueued"
    if [ -f /Library/LaunchDaemons/com.agentq.pueued.plist ] || launchctl print "$macos_launch_service" >/dev/null 2>&1; then
        return 0
    fi

    macos_launch_service="gui/$macos_uid/com.agentq.pueued"
    if launchctl print "$macos_launch_service" >/dev/null 2>&1; then
        return 0
    fi

    macos_launch_service="user/$macos_uid/com.agentq.pueued"
    if launchctl print "$macos_launch_service" >/dev/null 2>&1; then
        return 0
    fi

    macos_launch_service="gui/$macos_uid/com.agentq.pueued"
    if launchctl print "gui/$macos_uid" >/dev/null 2>&1; then
        return 0
    fi

    macos_launch_service="user/$macos_uid/com.agentq.pueued"
}

ensure_daemon() {
    local attempt=0

    ensure_not_in_maintenance

    if run_pueue status --json >/dev/null 2>&1; then
        recover_removing_requests || fail 'failed to recover removing AgentQ requests'
        return 0
    fi

    if managed_daemon_is_active; then
        while [ "$attempt" -lt "$startup_attempts" ]; do
            if run_pueue status --json >/dev/null 2>&1; then
                recover_removing_requests || fail 'failed to recover removing AgentQ requests'
                return 0
            fi
            attempt=$((attempt + 1))
            sleep 1
        done

        fail 'Pueue daemon service is active but unreachable; refusing to restart it because AgentQ tasks may still be running'
    fi

    ensure_not_in_maintenance
    start_managed_daemon
    attempt=0
    while [ "$attempt" -lt "$startup_attempts" ]; do
        if run_pueue status --json >/dev/null 2>&1; then
            recover_removing_requests || fail 'failed to recover removing AgentQ requests'
            return 0
        fi
        attempt=$((attempt + 1))
        sleep 1
    done

    fail "Pueue daemon is unavailable after ${startup_attempts}s"
}

ensure_group() {
    local group_file
    local group_exists=false
    local jq_status

    group_file=$(umask 077; make_temporary_file "$runtime_directory" '.agentq-group' '.json') ||
        fail 'cannot allocate a group status temporary file'
    group_raw_file=$group_file
    require_runtime_temporary_file "$group_file"
    require_runtime_temporary_file "$group_file"
    require_runtime_temporary_file "$group_file"
    require_runtime_temporary_file "$group_file"
    if ! run_pueue group --json > "$group_file"; then
        fail 'cannot inspect the AgentQ group'
    fi
    require_runtime_temporary_file "$group_file"
    jq -e 'type == "object"' < "$group_file" >/dev/null ||
        fail 'AgentQ group response is invalid JSON'
    if jq -e --arg name "$group_name" 'has($name)' < "$group_file" >/dev/null; then
        group_exists=true
    else
        jq_status=$?
        case "$jq_status" in
            1) ;;
            *) fail 'cannot inspect the AgentQ group' ;;
        esac
    fi
    remove_runtime_temporary_file "$group_file" 'group raw response file' ||
        fail 'failed to clean AgentQ group raw response temporary file'
    group_raw_file=''
    if [ "$group_exists" = true ]; then
        if ! run_pueue parallel --group "$group_name" 1 >/dev/null; then
            return 1
        fi
    else
        if ! run_pueue group add --parallel 1 "$group_name" >/dev/null; then
            return 1
        fi
    fi
}

verify_group() {
    local group_file

    group_file=$(umask 077; make_temporary_file "$runtime_directory" '.agentq-group' '.json') ||
        fail 'cannot allocate a group status temporary file'
    group_raw_file=$group_file
    require_runtime_temporary_file "$group_file"
    require_runtime_temporary_file "$group_file"
    require_runtime_temporary_file "$group_file"
    require_runtime_temporary_file "$group_file"
    run_pueue group --json > "$group_file" || fail 'cannot inspect the AgentQ group'
    require_runtime_temporary_file "$group_file"
    jq -e --arg name "$group_name" '
        (.[$name] | type) == "object"
        and .[$name].parallel_tasks == 1
    ' < "$group_file" >/dev/null || fail "AgentQ group is missing or has unexpected parallelism: $group_name"
    remove_runtime_temporary_file "$group_file" 'group raw response file' || fail 'failed to clean AgentQ group raw response temporary file'
    group_raw_file=''
}

normalize_workdir() {
    local input=$1

    case "$platform_kind" in
        windows)
            case "$input" in
                /*|[A-Za-z]:[\\/]*|\\\\*) ;;
                *) fail "working directory must be absolute: $input" ;;
            esac
            local unix_path
            local windows_path
            unix_path=$(cygpath -u "$input" 2>/dev/null) || fail "invalid working directory: $input"
            [ -d "$unix_path" ] || fail "working directory does not exist: $input"
            windows_path=$(cygpath -aw "$unix_path") || fail "cannot normalize working directory: $input"
            printf '%s\n' "$windows_path"
            ;;
        unix)
            case "$input" in
                /*) ;;
                *) fail "working directory must be absolute: $input" ;;
            esac
            [ -d "$input" ] || fail "working directory does not exist: $input"
            # The cd can still fail if the directory vanished since the check;
            # report it here so the caller's `|| return` never swallows a silent
            # empty path.
            (CDPATH=; cd -- "$input" && pwd -P) || fail "cannot resolve the working directory: $input"
            ;;
    esac
}

# shellcheck disable=SC2016
compact_filter='
def canonical_integer_string:
    tostring
    | sub("^0+"; "")
    | if . == "" then "0" else . end;
def same_task_id($left; $right):
    ($left | canonical_integer_string) == ($right | canonical_integer_string);
def lifecycle:
    .status as $status
    | if ($status | has("Running")) then $status.Running
      elif ($status | has("Done")) then $status.Done
      else {} end;
def compact:
    lifecycle as $lifecycle
    | {
        id,
        label: .label,
        group,
        path,
        created_at,
        start: ($lifecycle.start // null),
        end: ($lifecycle.end // null),
        status
    };
def decorate($markers; $requests):
    . as $task
    | ($markers | map(select(
        same_task_id(.task_id; $task.id)
        and (.created_at == $task.created_at)
    )) | first) as $marker
    | ($requests | map(select(
        (.state == "accepted" or .state == "removing")
        and same_task_id(.task_id; $task.id)
        and (.task_created_at == $task.created_at)
    )) | first) as $request
    | if $request == null then . else
        .label = $request.payload.label
        | .agentq = ((.agentq // {}) + {
            request_id: $request.request_id,
            removal_pending: ($request.state == "removing")
        })
      end
    | if $marker == null then .
      elif $marker.state == "requested" then
        .agentq = ((.agentq // {}) + {
            cancellation_requested_at: $marker.requested_at,
            cancellation_reason: $marker.reason
        })
      else
        .agentq = ((.agentq // {}) + {
            cancellation_pending_at: $marker.requested_at,
            cancellation_reason: $marker.reason
        })
      end;
'

load_cancellation_markers() {
    local marker_files=()
    local marker_path
    local marker_parent
    local marker_task_id
    local marker
    local marker_status=0

    shopt -s nullglob
    marker_files=("$cancellation_directory"/*.json)
    shopt -u nullglob

    if [ "${#marker_files[@]}" -eq 0 ]; then
        printf '%s\n' '[]'
        return 0
    fi

    {
        for marker_path in "${marker_files[@]}"; do
            marker_task_id=${marker_path##*/}
            marker_task_id=${marker_task_id%.json}
            is_task_id "$marker_task_id" || fail "invalid AgentQ cancellation marker filename: $marker_path"
            [ "$(canonical_task_id "$marker_task_id")" = "$marker_task_id" ] ||
                fail "non-canonical AgentQ cancellation marker filename: $marker_path"
            marker_parent=${marker_path%/*}
            [ -n "$marker_parent" ] || marker_parent=.
            # vanish-between-glob-and-read is a race, not a guard violation
            # (same 2026-10-13 reasoning as load_request_records)
            [ -e "$marker_path" ] || continue
            [ -d "$marker_parent" ] && [ ! -L "$marker_parent" ] ||
                fail "invalid AgentQ cancellation marker path: $marker_path"
            [ -f "$marker_path" ] && [ ! -L "$marker_path" ] ||
                fail "invalid AgentQ cancellation marker path: $marker_path"
            # Same race as load_request_records: a lock-free reader
            # (status/logs) can interleave with remove_cancellation_marker_for_task,
            # which runs under the operation lock.  A marker that VANISHED is
            # skipped -- and skipping is safe here because markers are NOT
            # positionally bound to ids (the aggregate filter validates each one
            # on its own).  Measured 2026-10-22: without this, a vanished marker
            # made the pipeline fail and the whole command exited 1 -- a code the
            # contract does not define for this, printed together with
            # reason=protocol_error, i.e. an exit code that contradicted its own
            # machine-readable line.
            request_metadata_file_is_safe "$marker_path" || {
                tracked_path_vanished "$marker_path" && continue
                fail "invalid AgentQ cancellation marker path: $marker_path"
            }
            request_metadata_file_is_safe "$marker_path" || {
                tracked_path_vanished "$marker_path" && continue
                fail "invalid AgentQ cancellation marker path: $marker_path"
            }
            validate_task_id_precision "$marker_task_id"
            # rc=1 is the vanished verdict; `|| marker_status=$?` (not a bare
            # assignment) because under `set -e` a failing `$( )` assignment
            # kills the server before the next line -- the fourth time this
            # repo has hit that trap.  Anything else non-zero (jq rejects the
            # marker body with 5) keeps the ORIGINAL loud failure: without the
            # `fail` below the loop would print an EMPTY marker line instead,
            # the aggregate would silently accept it, and `status` would exit 0
            # on a corrupt marker -- measured 2026-10-22 by reverting the branch.
            marker=$(cancellation_marker_is_valid "$marker_path" "$marker_task_id") ||
                marker_status=$?
            if [ "${marker_status:-0}" -eq 1 ]; then
                marker_status=0
                continue
            fi
            if [ "${marker_status:-0}" -ne 0 ]; then
                marker_status=0
                fail "invalid AgentQ cancellation marker: $marker_path"
            fi
            printf '%s\n' "$marker"
        done
    } | jq -cse '
        def valid_task_id:
            if type != "number" then
                false
            else
                (. >= 0) and ((floor) == .)
            end;
        def valid_marker:
            (.task_id | valid_task_id)
            and (.created_at | type) == "string"
            and (.created_at | length) > 0
            and (.requested_at | type) == "string"
            and (.requested_at | length) > 0
            and (.reason | type) == "string"
            and (.reason | length) > 0
            and ((.state? == null) or .state == "pending" or .state == "requested");
        if all(.[]; valid_marker) then
            map(if .state? == null then . + {state: "requested"} else . end)
        else error("invalid AgentQ cancellation marker")
        end
    '
}

request_record_path() {
    local request_id=$1

    is_request_id "$request_id" || fail "invalid AgentQ request record id: $request_id"
    printf '%s/%s.json\n' "$request_directory" "$request_id"
}

request_tombstone_path() {
    local request_id=$1

    is_request_id "$request_id" || fail "invalid AgentQ request tombstone id: $request_id"
    printf '%s/%s.json\n' "$request_tombstone_directory" "$request_id"
}

request_task_label() {
    printf 'agentq:%s\n' "$1"
}

# The record predicate, kept in one place so the validating reader and the
# reader that also needs `.state` cannot drift apart.
request_record_filter='
        def valid_task_id:
            if type != "number" then
                false
            else
                (. >= 0) and ((floor) == .)
            end;
        if (
            (.version == 1)
            and (.request_id == $request_id)
            and (.payload | type) == "object"
            and (.payload.workdir | type) == "string"
            and (.payload.label | type) == "string"
            and (.payload.argv | type) == "array"
            and all(.payload.argv[]; type == "string")
            and (.task_label == ("agentq:" + .request_id))
            and (.state == "prepared" or .state == "adding" or .state == "accepted" or .state == "removing" or .state == "removed")
            and (
                if .state == "prepared" or .state == "adding" then
                    .task_id == null and .task_created_at == null
                else
                    (.task_id | valid_task_id)
                    and (.task_created_at | type) == "string"
                    and (.task_created_at | length) > 0
                end
            )
            and (.created_at | type) == "string"
            and (.created_at | length) > 0
        ) then . else error("invalid AgentQ request record") end
'

# The batch form of `request_record_filter`: validate every record against its
# own filename-derived id (positional binding, exactly as load_request_records
# does), then emit, for each record in state `removed`, its request id and its
# serialisation as two lines.  This exists so repair can find the removed records
# in ONE jq instead of one per file, while keeping the predicate identical to the
# per-file reader -- note it uses `request_record_filter` (which ACCEPTS
# `removed`), NOT the `load_request_records` filter, whose `valid_request` gate
# rejects `removed` (see PLAN.md A23).  The parameter is named `$request_id` on
# purpose: it is the same name the embedded filter references, so the body is
# reused verbatim rather than rewritten.  `tojson` framing (not @tsv) matches
# recover_removing_requests; @tsv would double-escape what tojson already emits.
request_removed_records_filter="
def valid(\$request_id): (
$request_record_filter
);
. as \$records
| (\$ARGS.positional) as \$ids
| if ((\$records | length) != (\$ids | length)) then
    error(\"invalid AgentQ request record\")
  else . end
| [ range(0; length) as \$i
    | (\$records[\$i]
       | if . == null then empty
         else valid(\$ids[\$i])
         end) ]
| .[]
| select(.state == \"removed\")
| (.request_id, tojson)
"

# The batch form of `request_record_filter` that emits EVERY record's identity
# and body (not only the removed ones): the wait-recovery scan needs the state
# and task id of every record to decide which one matches the vanished task.
# Same positional binding and same predicate as the per-file reader, so the two
# cannot drift (rule E).  Four lines per record: request id, state, task id
# (empty when null, matching the per-file reader's `// ""`), and the body.
request_records_states_filter="
def valid(\$request_id): (
$request_record_filter
);
. as \$records
| (\$ARGS.positional) as \$ids
| if ((\$records | length) != (\$ids | length)) then
    error(\"invalid AgentQ request record\")
  else . end
| range(0; length) as \$i
| (\$records[\$i] | valid(\$ids[\$i]))
| (\$ids[\$i], .state, ((.task_id // \"\") | tostring), tojson)
"

# The tombstone predicate, kept in one place so the validating reader and the
# batch reader below cannot drift (rule E).
request_tombstone_filter='
        def valid_task_id:
            if type != "number" then
                false
            else
                (. >= 0) and ((floor) == .)
            end;
        if (
            (.version == 1)
            and (.request_id == $request_id)
            and (.task_id | valid_task_id)
            and (.task_created_at | type) == "string"
            and (.task_created_at | length) > 0
            and (.state == "removed")
            and (.removed_at | type) == "string"
            and (.removed_at | length) > 0
        ) then .
        else error("invalid AgentQ request tombstone")
        end
'

# The batch form of `request_tombstone_filter`: validate every tombstone against
# its own filename-derived id, then emit, per tombstone, its request id, task id
# and task_created_at as three lines.  Lets the wait-recovery scan find the
# matching tombstone in ONE jq instead of three per file.
request_tombstones_states_filter="
def valid(\$request_id): (
$request_tombstone_filter
);
. as \$tombstones
| (\$ARGS.positional) as \$ids
| if ((\$tombstones | length) != (\$ids | length)) then
    error(\"invalid AgentQ request tombstone\")
  else . end
# null is the placeholder the producer emits for a tombstone that vanished
# between the glob and the read (the same contract as
# request_removed_records_filter on the record side).  It is dropped AFTER the
# positional binding, so a skip cannot shift a later tombstone onto the id
# before it; null can never be a real tombstone, which is what made a bare
# continue in the producer fatal.  (No backticks in this comment: the filter is
# a DOUBLE-quoted shell string, so they would run as command substitution --
# measured 2026-10-23, the shell tried to execute the commands "null" and
# "continue".)
| range(0; length) as \$i
| if \$tombstones[\$i] == null then empty
  else (\$tombstones[\$i] | valid(\$ids[\$i]))
  | (\$ids[\$i], (.task_id | tostring), .task_created_at)
  end
"

# The batch form of the `select(.task_id == $id) | .task_created_at // empty`
# probe that task_instance_created_at_is_recorded runs per file.  TOLERANT on
# purpose: the per-file loop swallows a malformed file (`2>/dev/null ||
# continue`) and keeps scanning, so this filter must NOT be used where a bad
# record should fail closed.  It answers a single boolean: does ANY slurped
# file record this task id with this creation time?  A malformed file makes the
# whole slurp fail, which sends the caller to its verbatim fallback.
request_instance_probe_filter='
[ .[] | select(.task_id == $id) | select((.task_created_at // empty) == $expected) ]
| length > 0
'

# request_record_is_valid was folded into read_request_record + the shared
# request_record_path_guards_or_fail: it was a THIRD copy of the guard sequence
# (rule E), and its two consecutive identical guards bought nothing --
# path_chain_is_safe walks every component with `[ -L ]`, so the copy in the
# caller and the copy in the callee were the same walk on the same path with
# nothing between them (the same measurement that trimmed load_request_records
# from 4 guards to 2).  Its one caller was read_request_record.

request_tombstone_is_valid() {
    local tombstone_path=$1
    local request_id=$2
    local tombstone_body
    local tombstone_read_status

    # Same vanish verdict as its record twin: 1 means the tombstone is GONE.
    # Its delete sites are prune_request_tombstones (lock only) and nothing
    # else, so this arm is a defensive consistency measure rather than a
    # measured race -- but a reader that calls a vanished tombstone "invalid
    # path" is the same wrong verdict in either file, and the two readers must
    # not disagree about what "gone" means.
    request_tombstone_path_guards_or_fail "$tombstone_path" || return 1
    # Silent read first, for the same reason as the record twin above: a bare
    # `jq < "$path"` prints bash's redirection error on a vanished file, and the
    # clients forward the remote stderr.
    tombstone_read_status=0
    tombstone_body=$(cat -- "$tombstone_path" 2>/dev/null) || tombstone_read_status=$?
    if [ "$tombstone_read_status" -ne 0 ]; then
        tracked_path_vanished "$tombstone_path" && return 1
        fail "invalid AgentQ request tombstone: $tombstone_path"
    fi
    jq -ce --arg request_id "$request_id" "$request_tombstone_filter" <<<"$tombstone_body" ||
        fail "invalid AgentQ request tombstone: $tombstone_path"
}

# The tombstone-path guard sequence, in ONE place so the per-file reader above
# and the batch reader in wait_reconcile_missing_task cannot drift (rule E).
# Mirrors read_request_tombstone + request_tombstone_is_valid: existence, then
# ONE guard before the precision probe and ONE after it -- the same shape as the
# record twin request_record_path_guards_or_fail, kept in step with it.  The
# probe reads the file's TEXT (grep/sed) while the guard reads its IDENTITY (the
# non-symlink path chain), so the pair brackets the window in which the file
# could be swapped between the two reads; the two extra copies that used to sit
# before the probe were identical consecutive calls with nothing between them.
# Measured 2026-10-11 (8 tombstones, real 8-component sandbox paths): the loop
# drops from 45ms to 18ms.  It calls `fail`, so a caller that discards stderr to
# fall back gets the same verdict as the per-file path.
request_tombstone_path_guards_or_fail() {
    local tombstone_path=$1

    # rc=1 is the VANISHED verdict, exactly as in the record twin
    # request_record_path_guards_or_fail.  Without these arms the bare `fail`
    # below exited before any caller could see that the file was simply GONE,
    # which made two things dead: the `null` placeholder the wait batch scan
    # emits for a vanished tombstone, and the vanish arm of
    # read_request_tombstone.  Measured 2026-10-23 by injecting the rm right
    # after the existence check in read_request_tombstone: `lookup` answered
    # `invalid AgentQ request tombstone path` + exit 2 instead of converging to
    # not_found, on both 0.1.18 and the tree that was supposed to have fixed it.
    #
    # "Present but unsafe" still fails loudly -- only "neither a file nor a
    # symlink" is treated as gone (a dangling symlink is an object whose TARGET
    # is missing, so it stays fatal).
    [ -e "$tombstone_path" ] || [ -L "$tombstone_path" ] || return 1
    request_metadata_file_is_safe "$tombstone_path" || {
        tracked_path_vanished "$tombstone_path" && return 1
        fail "invalid AgentQ request tombstone path: $tombstone_path"
    }
    validate_task_id_precision_in_file "$tombstone_path"
    request_metadata_file_is_safe "$tombstone_path" || {
        tracked_path_vanished "$tombstone_path" && return 1
        fail "invalid AgentQ request tombstone path: $tombstone_path"
    }
}

request_records_filter='
def valid_task_id:
    if type != "number" then
        false
    else
        (. >= 0) and ((floor) == .)
    end;
def valid_record($request_id):
    (.version == 1)
    and (.request_id == $request_id)
    and (.payload | type) == "object"
    and (.payload.workdir | type) == "string"
    and (.payload.label | type) == "string"
    and (.payload.argv | type) == "array"
    and all(.payload.argv[]; type == "string")
    and (.task_label == ("agentq:" + .request_id))
    and (.state == "prepared" or .state == "adding" or .state == "accepted" or .state == "removing" or .state == "removed")
    and (
        if .state == "prepared" or .state == "adding" then
            .task_id == null and .task_created_at == null
        else
            (.task_id | valid_task_id)
            and (.task_created_at | type) == "string"
            and (.task_created_at | length) > 0
        end
    )
    and (.created_at | type) == "string"
    and (.created_at | length) > 0;
def valid_request:
    (.version == 1)
    and (.request_id | type) == "string"
    and (.payload | type) == "object"
    and (.payload.workdir | type) == "string"
    and (.payload.label | type) == "string"
    and (.payload.argv | type) == "array"
    and all(.payload.argv[]; type == "string")
    and (.task_label == ("agentq:" + .request_id))
    and (.state == "prepared" or .state == "adding" or .state == "accepted" or .state == "removing")
    and (
        if .state == "prepared" or .state == "adding" then
            .task_id == null and .task_created_at == null
        else
            (.task_id | valid_task_id)
            and (.task_created_at | type) == "string"
            and (.task_created_at | length) > 0
        end
    )
    and (.created_at | type) == "string"
    and (.created_at | length) > 0;
. as $records
| ($ARGS.positional) as $request_ids
| if (($records | length) != ($request_ids | length)) then
    error("invalid AgentQ request record")
  else . end
| [ range(0; length) as $index
    | .[$index] as $record
    # `null` is the placeholder the producer emits for a record that vanished
    # between the glob and the read (see load_request_records).  It is dropped
    # here, AFTER the positional binding, so a skip cannot shift a later record
    # onto the id of the record before it.  `null` can never be a real record:
    # the binding below rejects it, which is what made a bare `continue` fatal.
    | if $record == null then empty
      elif ($record | valid_record($request_ids[$index])) then $record
      else error("invalid AgentQ request record")
      end ]
| if all(.[]; valid_request) then . else error("invalid AgentQ request record") end
'

load_request_records() {
    local record_files=()
    local record_ids=()
    local record_path
    local record_parent
    local request_id
    local record

    shopt -s nullglob
    record_files=("$request_directory"/*.json)
    shopt -u nullglob

    if [ "${#record_files[@]}" -eq 0 ]; then
        printf '%s\n' '[]'
        return 0
    fi

    # The request ids are collected here, in the parent shell: the loop that
    # feeds jq below runs inside a pipeline subshell, so an array filled there
    # would never reach the jq invocation.  This loop is pure bash and forks
    # nothing.
    for record_path in "${record_files[@]}"; do
        request_id=${record_path##*/}
        record_ids+=("${request_id%.json}")
    done

    {
    for record_path in "${record_files[@]}"; do
        request_id=${record_path##*/}
        request_id=${request_id%.json}
        is_request_id "$request_id" || fail "invalid AgentQ request record filename: $record_path"
        # No standalone path-chain walk here: the guard two lines down
        # (request_metadata_file_is_safe) walks the same chain on the same path,
        # and a second walk of an 8-component path is not free (measured on 272
        # records: 724ms with it, 510ms without).  The parent/file checks below
        # are bash builtins and stay.
        record_parent=${record_path%/*}
        [ -n "$record_parent" ] || record_parent=.
        # A concurrent archiver (remove recovery, wait reconcile) may delete a
        # record between the glob above and this read.  Vanishing is a RACE,
        # not a path-guard violation: skipping keeps the scanner rescan-friendly
        # (the next invocation sees the tombstone) instead of failing every
        # lock-holding command with a transient protocol_error (measured
        # 2026-10-13, review round 4).  A file that EXISTS but fails the guard
        # below is still fatal.
        #
        # The skip MUST emit a placeholder.  `record_ids` is collected in the
        # parent shell from the same glob, and the aggregate jq binds ids to
        # records POSITIONALLY, so a bare `continue` shifts every later record
        # onto its predecessor's id: the binding check then rejects the pair and
        # the whole load errors out.  Measured 2026-10-16 with a deterministic
        # window: `status` printed `jq: error (at <stdin>:1): invalid AgentQ
        # request record` on stderr and lost the vanished task's label
        # decoration, and `recover_removing_requests` swallowed the failure
        # (its `records=$(load_request_records)` has no guard), so the command
        # still exited 0.  A `null` keeps one JSON value per glob entry, so the
        # alignment survives any skip and the filter drops the placeholder.
        [ -e "$record_path" ] || { printf 'null\n'; continue; }
        [ -d "$record_parent" ] && [ ! -L "$record_parent" ] ||
            fail "invalid AgentQ request record path: $record_path"
        [ -f "$record_path" ] && [ ! -L "$record_path" ] ||
            fail "invalid AgentQ request record path: $record_path"
        # ONE guard before the precision probe and ONE after it.  The probe
        # reads the file's TEXT (grep/sed) while the guard reads its IDENTITY
        # (the non-symlink path chain), so the pair brackets the window in which
        # the file could be swapped between the two reads.  Four copies of the
        # same call on the same path with nothing between them bought no
        # additional coverage: `path_chain_is_safe` walks every path component
        # with `[ -L ]`, so each copy is a full chain walk, and this loop runs
        # for every record on every command.  Measured (272 records, macOS):
        # 4 guards 1040ms -> 1 guard 263ms; the whole producer loop 1696ms ->
        # 1083ms, with byte-identical stdout/stderr and exit code.
        # A record that vanishes between the existence check above and the
        # read below (a concurrent archiver: remove recovery, wait reconcile)
        # breaks any guard in this block.  "Gone" gets the SAME placeholder as
        # the top guard; "present but unsafe" stays fatal.  The read paths run
        # lock-free, so nothing serialises them against the archiver, and a
        # single concurrent removal could otherwise turn an unrelated
        # status/doctor into protocol_error (exit 2).
        #
        # The vanished check runs ONLY on a guard failure, so the normal path
        # costs no extra stat -- this loop already had its guard count reduced
        # for exactly that reason (4 guards 1040ms -> 1 guard 263ms, measured
        # on 272 records).
        request_metadata_file_is_safe "$record_path" || {
            if tracked_path_vanished "$record_path"; then printf 'null\n'; continue; fi
            fail "invalid AgentQ request record path: $record_path"
        }
        validate_task_id_precision_in_file "$record_path"
        request_metadata_file_is_safe "$record_path" || {
            if tracked_path_vanished "$record_path"; then printf 'null\n'; continue; fi
            fail "invalid AgentQ request record path: $record_path"
        }
        # Silent read: `record=$(<"$record_path")` fails the right way when the
        # archiver wins the race -- but bash prints its OWN redirection error
        # first, and that error is written to the top-level stderr no matter
        # what wraps the loop (measured 2026-10-23: `status` exited 0, skipped
        # correctly, and still carried `<path>: No such file or directory`; the
        # clients scan the remote stderr for `reason=`, so noise on a successful
        # call is a defect by itself).  `cat`'s error IS its own stderr and IS
        # suppressed by the redirect.
        record=$(cat -- "$record_path" 2>/dev/null) || {
            if tracked_path_vanished "$record_path"; then printf 'null\n'; continue; fi
            fail "invalid AgentQ request record: $record_path"
        }
        printf '%s\n' "$record"
        done
    } | jq -cse --args "$request_records_filter" -- "${record_ids[@]}"
}

release_request_metadata_files() {
    local cleanup_status=0

    if [ -n "$request_records_file" ]; then
        remove_runtime_temporary_file "$request_records_file" || cleanup_status=1
