            -NoProfile \
            -NonInteractive \
            -ExecutionPolicy Bypass \
            -File "$helper_windows" \
            -SourcePath "$source_windows" \
            -DestinationPath "$destination_windows" \
            -DestinationDirectory "$parent_windows" \
