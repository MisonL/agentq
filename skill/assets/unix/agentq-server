    # operation between them means no TOCTOU bracket; removed as drift bait.)
    AGENTQ_DURABLE_PATH=$path perl -MIO::Handle -MFcntl=:DEFAULT -e '
        my $path = $ENV{AGENTQ_DURABLE_PATH};
        my $ok = eval {
            sysopen(my $handle, $path, O_RDONLY) or die;
            $handle->sync() or die;
            close($handle) or die;
            1;
        };
        exit($ok ? 0 : 1);
    ' >/dev/null 2>&1
}

