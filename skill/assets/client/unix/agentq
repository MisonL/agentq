        else
            windows_encoding_input_cleanup_status=$?
            if [ "$windows_encoding_status" -eq 0 ]; then
                windows_encoding_status=$windows_encoding_input_cleanup_status
            fi
        fi
        if windows_encoding_remove_file "$windows_encoding_output" "$windows_encoding_output_identity"; then
            windows_encoding_output_cleanup_status=0
        else
            windows_encoding_output_cleanup_status=$?
            if [ "$windows_encoding_status" -eq 0 ]; then
                windows_encoding_status=$windows_encoding_output_cleanup_status
            fi
        fi
        return "$windows_encoding_status"
    fi
    if windows_encoding_verify_identity "$windows_encoding_input" "$windows_encoding_input_identity" 'before Base64 conversion' &&
        windows_encoding_verify_identity "$windows_encoding_output" "$windows_encoding_output_identity" 'before Base64 conversion' &&
        windows_encoding_require_existing_file "$windows_encoding_input" &&
        windows_encoding_require_file "$windows_encoding_output"; then
        :
    else
        windows_encoding_status=$?
        if windows_encoding_remove_file "$windows_encoding_input" "$windows_encoding_input_identity"; then
            windows_encoding_input_cleanup_status=0
        else
            windows_encoding_input_cleanup_status=$?
            if [ "$windows_encoding_status" -eq 0 ]; then
                windows_encoding_status=$windows_encoding_input_cleanup_status
            fi
        fi
        if windows_encoding_remove_file "$windows_encoding_output" "$windows_encoding_output_identity"; then
            windows_encoding_output_cleanup_status=0
        else
            windows_encoding_output_cleanup_status=$?
            if [ "$windows_encoding_status" -eq 0 ]; then
                windows_encoding_status=$windows_encoding_output_cleanup_status
            fi
        fi
        return "$windows_encoding_status"
    fi
    if ! base64 < "$windows_encoding_input" | tr -d '\n' > "$windows_encoding_output"; then
        windows_encoding_status=1
        if windows_encoding_remove_file "$windows_encoding_input" "$windows_encoding_input_identity"; then
            windows_encoding_input_cleanup_status=0
        else
            windows_encoding_input_cleanup_status=$?
            if [ "$windows_encoding_status" -eq 0 ]; then
                windows_encoding_status=$windows_encoding_input_cleanup_status
            fi
        fi
        if windows_encoding_remove_file "$windows_encoding_output" "$windows_encoding_output_identity"; then
            windows_encoding_output_cleanup_status=0
        else
            windows_encoding_output_cleanup_status=$?
            if [ "$windows_encoding_status" -eq 0 ]; then
                windows_encoding_status=$windows_encoding_output_cleanup_status
            fi
        fi
        return "$windows_encoding_status"
    fi
    if windows_encoding_verify_identity "$windows_encoding_input" "$windows_encoding_input_identity" 'before reading' &&
        windows_encoding_verify_identity "$windows_encoding_output" "$windows_encoding_output_identity" 'before reading' &&
        windows_encoding_require_existing_file "$windows_encoding_input" &&
        windows_encoding_require_existing_file "$windows_encoding_output"; then
        :
    else
        windows_encoding_status=$?
        if windows_encoding_remove_file "$windows_encoding_input" "$windows_encoding_input_identity"; then
            windows_encoding_input_cleanup_status=0
        else
            windows_encoding_input_cleanup_status=$?
            if [ "$windows_encoding_status" -eq 0 ]; then
                windows_encoding_status=$windows_encoding_input_cleanup_status
            fi
        fi
        if windows_encoding_remove_file "$windows_encoding_output" "$windows_encoding_output_identity"; then
            windows_encoding_output_cleanup_status=0
        else
            windows_encoding_output_cleanup_status=$?
            if [ "$windows_encoding_status" -eq 0 ]; then
                windows_encoding_status=$windows_encoding_output_cleanup_status
            fi
        fi
        return "$windows_encoding_status"
    fi
    windows_encoding_require_existing_file "$windows_encoding_output" || {
        windows_encoding_status=$?
        if windows_encoding_remove_file "$windows_encoding_input" "$windows_encoding_input_identity"; then
            windows_encoding_input_cleanup_status=0
        else
            windows_encoding_input_cleanup_status=$?
        fi
        if windows_encoding_remove_file "$windows_encoding_output" "$windows_encoding_output_identity"; then
            windows_encoding_output_cleanup_status=0
        else
            windows_encoding_output_cleanup_status=$?
        fi
        if [ "$windows_encoding_input_cleanup_status" -ne 0 ] ||
            [ "$windows_encoding_output_cleanup_status" -ne 0 ]; then
            return 2
        fi
        return "$windows_encoding_status"
    }
    cat "$windows_encoding_output"
    if windows_encoding_remove_file "$windows_encoding_input" "$windows_encoding_input_identity"; then
        windows_encoding_input_cleanup_status=0
    else
        windows_encoding_input_cleanup_status=$?
    fi
    if windows_encoding_remove_file "$windows_encoding_output" "$windows_encoding_output_identity"; then
        windows_encoding_output_cleanup_status=0
    else
        windows_encoding_output_cleanup_status=$?
    fi
    if [ "$windows_encoding_input_cleanup_status" -ne 0 ] ||
        [ "$windows_encoding_output_cleanup_status" -ne 0 ]; then
        return 2
    fi
}

# Windows remote command lines are TRUNCATED, not rejected, once they exceed the
# remote shell's limit -- and the limit depends on the shell sshd was configured
# with (measured on a real host: Git Bash 8,176 / cmd.exe 8,155 /
# powershell.exe 8,125).  The reparse-path hardening pushed the protocol probe's
# script to 3,216 characters, which encodes to an 8,658-character command line:
# over all three.  The base64 was cut mid-stream, PowerShell reported
# "TerminatorExpectedAtEndOfString", and every command on that host failed with
# a message that pointed at the deployment instead of at the client.
#
# So the script body does NOT go on the command line.  It is written to a
# protected temporary and fed to `powershell.exe ... -Command -` on stdin, which
# leaves a fixed 76-character command line regardless of how large the script
# grows.  Measured on the same host: 8,658 -> rc=1 with empty output (dead);
# 76 -> rc=0 with the correct token.
#
# The file is registered with the same identity-checked temporary machinery the
# Windows argument path uses, and run_platform_probe verifies that identity
# immediately before handing the file to ssh -- the protection is not bypassed.
make_windows_probe_script_file() {
    windows_probe_script_text=$1
    resolve_agentq_temp_directory || return $?
    # A Windows target runs TWO probes in sequence (platform, then protocol), and
    # both call this function.  Each call overwrites the global naming the
    # previous temporary, which would orphan it -- the EXIT trap can only clean
    # the file it still knows about.  Remove the previous one first.
    if [ -n "$platform_probe_stdin_file" ]; then
        windows_argument_remove_file "$platform_probe_stdin_file" "$platform_probe_stdin_identity" || return $?
        platform_probe_stdin_file=''
        platform_probe_stdin_identity=''
    fi
    platform_probe_stdin_file=$(mktemp "$agentq_temp_directory/agentq-probe-script.XXXXXX") || return 1
    platform_probe_stdin_identity=$(windows_argument_file_identity "$platform_probe_stdin_file") || {
        printf '%s: cannot record Windows probe script temporary identity\n' "$program" >&2
        windows_argument_remove_file "$platform_probe_stdin_file" ''
        platform_probe_stdin_file=''
        return 1
    }
    printf '%s' "$windows_probe_script_text" > "$platform_probe_stdin_file" || return 1
    windows_argument_require_existing_file "$platform_probe_stdin_file" || return $?
    windows_argument_verify_identity "$platform_probe_stdin_file" "$platform_probe_stdin_identity" 'after writing Windows probe script' || return $?
}

# The fixed command line: everything after this point is fed on stdin.
windows_probe_command_line() {
    printf '%s\n' "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command -"
}

# Wrap a probe script so the exit status survives the REMOTE shell, not just
# PowerShell.  When sshd's DefaultShell is powershell.exe, an outer PowerShell
# flattens a native child's non-zero exit code to 1 (measured: inner 2/42/43/
# 44/45/124 all arrive as 1) -- which destroys the launcher's exit-code
# contract (42-45 distinguish missing / incompatible / unsafe / too-large).
# Git Bash and cmd.exe both pass it through unchanged.
#
# The fix is out of band: the script prints its token, then prints
# "agentq-exit:<code>", and the caller takes the code from stdout.  Measured on
# the same host: the token survived all three outer shells intact while only the
# exit-code column was flattened under the PowerShell outer shell.
windows_probe_script_with_exit_token() {
    windows_probe_script_body=$1
    # A probe signals failure with `exit N`.  That ends the whole script, so a
    # token line appended after the body would never run -- and under an outer
    # PowerShell the code would arrive flattened to 1 with nothing to recover it.
    # So every `exit N` in the body is rewritten to write the token AT the exit
    # site and then really exit.  The rewrite is textual and local to the body:
    # the probes' only `exit` calls are the contract codes, and the pattern is
    # anchored to `; exit <digits>` or a statement-initial `exit <digits>` so an
    # `exit` inside a string cannot match.
    #
    # The first version rewrote `exit N` to `$agentqProbeExit = N` and reported
    # the variable in a trailer.  That was measured wrong on 2026-10-06: an
    # assignment does NOT terminate, and the failure branches are sequential
    # `if` statements, not an if/else chain -- so a missing launcher fell through
    # every later check and the unconditional final `...-ready` write, and the
    # LAST code assigned (44, reparse-unsafe) won the token.  The client then
    # reported "protocol probe failed" + 44 instead of "deployment is
    # incomplete" + 2, and the 42/43 branches were unreachable.  Writing the
    # token before `exit` restores the original control flow exactly.
    windows_probe_rewritten_body=$(printf '%s' "$windows_probe_script_body" |
        sed -E 's/(^[[:space:]]*|;[[:space:]]*)exit ([0-9]+)/\1[Console]::Out.Write("agentq-exit:" + \2); exit \2/g')
    printf '%s\n' "$windows_probe_rewritten_body"
    # Reached only when the body completed without exiting: the success path.
    printf '%s\n' '[Console]::Out.Write("agentq-exit:0")'
    printf '%s\n' 'exit 0'
}

windows_probe_command() {
    windows_platform_script='$ProgressPreference = "SilentlyContinue"; [Console]::Out.Write("agentq-windows")'
    make_windows_probe_script_file "$(windows_probe_script_with_exit_token "$windows_platform_script")" || return $?
    windows_probe_prepared_command_line=$(windows_probe_command_line) || return $?
}

windows_agentq_protocol_probe_command() {
    # shellcheck disable=SC2016
    windows_protocol_script='$ProgressPreference = "SilentlyContinue"; $launcher = "C:\ProgramData\AgentQ\agentq-launcher.ps1"; function Test-NonReparseLauncherPath { param([string]$Path); if ([string]::IsNullOrWhiteSpace($Path)) { return $false }; try { $fullPath = [System.IO.Path]::GetFullPath($Path); $item = Get-Item -LiteralPath $fullPath -Force -ErrorAction Stop } catch { return $false }; if ($item.PSIsContainer -or (($item.Attributes -band [System.IO.FileAttributes]::ReparsePoint) -ne 0)) { return $false }; $parent = [System.IO.Directory]::GetParent($fullPath); while ($null -ne $parent) { $parentItem = Get-Item -LiteralPath $parent.FullName -Force -ErrorAction SilentlyContinue; if ($null -eq $parentItem -or !$parentItem.PSIsContainer -or (($parentItem.Attributes -band [System.IO.FileAttributes]::ReparsePoint) -ne 0)) { return $false }; $parent = $parent.Parent }; return $true }; $launcherItem = if ([string]::IsNullOrWhiteSpace($launcher)) { $null } else { Get-Item -LiteralPath $launcher -Force -ErrorAction SilentlyContinue }; if ([string]::IsNullOrWhiteSpace($launcher) -or ($null -eq $launcherItem)) { [Console]::Out.Write("agentq-windows-launcher-missing"); exit 42 }; if (!(Test-NonReparseLauncherPath -Path $launcher)) { [Console]::Out.Write("agentq-windows-launcher-invalid"); exit 44 }; $maximumLauncherBytes = 262144; $launcherStream = $null; try { $launcherStream = [System.IO.File]::Open($launcher, [System.IO.FileMode]::Open, [System.IO.FileAccess]::Read, [System.IO.FileShare]::Read); $launcherBytes = [byte[]]::new($maximumLauncherBytes + 1); $launcherOffset = 0; while ($launcherOffset -lt $launcherBytes.Length) { $readCount = $launcherStream.Read($launcherBytes, $launcherOffset, $launcherBytes.Length - $launcherOffset); if ($readCount -eq 0) { break }; $launcherOffset += $readCount } } catch { [Console]::Out.Write("agentq-windows-launcher-invalid"); exit 44 } finally { if ($null -ne $launcherStream) { $launcherStream.Dispose() } }; if ($launcherOffset -gt $maximumLauncherBytes) { [Console]::Out.Write("agentq-windows-launcher-too-large"); exit 45 }; try { if ($launcherOffset -ge 3 -and $launcherBytes[0] -eq 0xEF -and $launcherBytes[1] -eq 0xBB -and $launcherBytes[2] -eq 0xBF) { $launcherEncoding = [System.Text.UTF8Encoding]::new($true, $true); $launcherContentOffset = 3 } elseif ($launcherOffset -ge 2 -and $launcherBytes[0] -eq 0xFF -and $launcherBytes[1] -eq 0xFE) { $launcherEncoding = [System.Text.UnicodeEncoding]::new($false, $true, $true); $launcherContentOffset = 2 } elseif ($launcherOffset -ge 2 -and $launcherBytes[0] -eq 0xFE -and $launcherBytes[1] -eq 0xFF) { $launcherEncoding = [System.Text.UnicodeEncoding]::new($true, $true, $true); $launcherContentOffset = 2 } else { $launcherEncoding = [System.Text.UTF8Encoding]::new($false, $true); $launcherContentOffset = 0 }; $contents = $launcherEncoding.GetString($launcherBytes, $launcherContentOffset, $launcherOffset - $launcherContentOffset) } catch { [Console]::Out.Write("agentq-windows-launcher-invalid"); exit 44 }; if ($contents.IndexOf("ArgumentsBase64", [System.StringComparison]::Ordinal) -lt 0) { [Console]::Out.Write("agentq-windows-launcher-incompatible"); exit 43 }; [Console]::Out.Write("agentq-windows-launcher-ready")'
    make_windows_probe_script_file "$(windows_probe_script_with_exit_token "$windows_protocol_script")" || return $?
    windows_probe_prepared_command_line=$(windows_probe_command_line) || return $?
}

# Read a probe's status from its out-of-band token when it carries one.
#
# A Windows probe ends by printing "agentq-exit:<code>" (see
# windows_probe_script_with_exit_token).  That is authoritative, because the SSH
# exit code is flattened to 1 by an outer PowerShell when sshd's DefaultShell is
# powershell.exe.  When the token is absent the probe is not one of ours, so the
# SSH exit code stands.
# Sets: windows_probe_token_status, windows_probe_token_output.
windows_probe_apply_exit_token() {
    windows_probe_token_ssh_status=$1
    windows_probe_token_raw=$2
    windows_probe_token_status=$windows_probe_token_ssh_status
    windows_probe_token_output=$windows_probe_token_raw
    case "$windows_probe_token_raw" in
        *agentq-exit:*)
            windows_probe_token_code=${windows_probe_token_raw##*agentq-exit:}
            windows_probe_token_code=${windows_probe_token_code%%[!0-9]*}
            # At most three digits (protocol codes are 0-255); a longer token
            # cannot be one of ours and is ignored exactly like a missing one.
            if [ "${#windows_probe_token_code}" -gt 3 ]; then
                windows_probe_token_code=''
            fi
            if [ -n "$windows_probe_token_code" ]; then
                windows_probe_token_status=$windows_probe_token_code
                windows_probe_token_output=${windows_probe_token_raw%agentq-exit:*}
            fi
            ;;
    esac
}

probe_native_windows_platform() {
    windows_probe_command || {
        printf '%s: cannot encode the Windows PowerShell platform probe; iconv and base64 are required\n' "$program" >&2
        return 2
    }
    windows_platform_command=$windows_probe_prepared_command_line
    if windows_platform_output=$(run_platform_probe_with_recovery "$windows_platform_command" "$platform_probe_stdin_file"); then
        windows_platform_ssh_status=0
    else
        windows_platform_ssh_status=$?
    fi
    windows_probe_apply_exit_token "$windows_platform_ssh_status" "$windows_platform_output"
    windows_platform_status=$windows_probe_token_status
    windows_platform_output=$windows_probe_token_output

    if [ "$windows_platform_status" -eq 0 ] && [ "$windows_platform_output" = agentq-windows ]; then
        remote_platform=windows
        return 0
    fi
    if [ "$windows_platform_status" -eq 0 ]; then
        printf '%s: native Windows platform probe returned an unexpected response\n' "$program" >&2
        return 2
    fi

    printf '%s: native Windows platform probe failed after a Windows shell was detected\n' "$program" >&2
    return "$windows_platform_status"
}

probe_windows_agentq_protocol() {
    windows_agentq_protocol_probe_command || {
        printf '%s: cannot encode the Windows AgentQ protocol probe; iconv and base64 are required\n' "$program" >&2
        return 2
    }
    windows_protocol_command=$windows_probe_prepared_command_line
    if windows_protocol_output=$(run_platform_probe_with_recovery "$windows_protocol_command" "$platform_probe_stdin_file"); then
        windows_protocol_ssh_status=0
    else
        windows_protocol_ssh_status=$?
    fi
    windows_probe_apply_exit_token "$windows_protocol_ssh_status" "$windows_protocol_output"
    windows_protocol_status=$windows_probe_token_status
    windows_protocol_output=$windows_probe_token_output

    if [ "$windows_protocol_status" -eq 0 ] && [ "$windows_protocol_output" = agentq-windows-launcher-ready ]; then
        return 0
    fi
    if [ "$windows_protocol_status" -eq 42 ] && [ "$windows_protocol_output" = agentq-windows-launcher-missing ]; then
        printf '%s: remote Windows AgentQ deployment is incomplete: C:/ProgramData/AgentQ/agentq-launcher.ps1 is missing; upgrade AgentQ on %s before using it\n' \
            "$program" "$host" >&2
        return 2
    fi
    if [ "$windows_protocol_status" -eq 43 ] && [ "$windows_protocol_output" = agentq-windows-launcher-incompatible ]; then
        printf '%s: remote Windows AgentQ deployment is incompatible: C:/ProgramData/AgentQ/agentq-launcher.ps1 does not support the ArgumentsBase64 protocol; upgrade AgentQ on %s before using it\n' \
            "$program" "$host" >&2
        return 2
    fi

    # A mismatched response with SSH status 0 is still a protocol failure.
    # Returning the 0 verbatim made the probe advisory: the message printed and
    # the command ran anyway (measured 2026-10-06).  The platform probe next
    # door already fails closed here; this aligns the two.  Nonzero statuses
    # (44/45/124) still propagate for their callers' diagnostics.
    if [ "$windows_protocol_status" -eq 0 ]; then
        windows_protocol_status=2
    fi
    printf '%s: native Windows AgentQ service protocol probe failed on %s\n' "$program" "$host" >&2
    return "$windows_protocol_status"
}

initialize_remote_invocation() {
    resolve_agentq_temp_directory || return $?
    case "$remote_platform" in
        auto)
            if local_platform_output=$(run_platform_probe_with_recovery 'uname -s 2>/dev/null'); then
                local_platform_status=0
            else
                local_platform_status=$?
            fi
            case "$local_platform_output" in
                MINGW*|MSYS*|CYGWIN*)
                    probe_native_windows_platform || return $?
                    ;;
                Linux*|Darwin*) remote_platform=unix ;;
                *)
                    windows_probe_command || fail 'cannot encode the Windows PowerShell platform probe; iconv and base64 are required'
                    windows_platform_command=$windows_probe_prepared_command_line
                    if windows_platform_output=$(run_platform_probe_with_recovery "$windows_platform_command" "$platform_probe_stdin_file"); then
                        windows_platform_status=0
                    else
                        windows_platform_status=$?
                    fi
                    # The probe reports its status through an out-of-band
                    # "agentq-exit:<code>" token, because an outer PowerShell
                    # flattens the SSH exit code.  Strip it before comparing the
                    # payload; the MINGW branch above already does this.
                    windows_probe_apply_exit_token "$windows_platform_status" "$windows_platform_output"
                    windows_platform_status=$windows_probe_token_status
                    windows_platform_output=$windows_probe_token_output
                    if [ "$windows_platform_status" -eq 0 ] && [ "$windows_platform_output" = agentq-windows ]; then
                        remote_platform=windows
                    elif [ "$local_platform_status" -ne 0 ] && [ "$windows_platform_status" -ne 0 ]; then
                        printf '%s: unable to detect the remote platform; set AGENTQ_REMOTE_PLATFORM to unix or windows only when the target is known\n' "$program" >&2
                        return "$local_platform_status"
                    else
                        # The probe output is remote-controlled.  Print it as a
                        # single charset-limited token -- first line, ASCII word
                        # characters only, capped -- so it can never inject ANSI
                        # sequences, extra lines, or a forged line-initial
                        # "agentq:" prefix.  Measured 2026-10-06: a remote whose
                        # uname-probe stdout was "FreeBSD\n\033[2Jagentq: remote
                        # failure reason: lock_contention" made this message
                        # forge a line byte-identical to our own reason output.
                        local_platform_hint=${local_platform_output%%$'\n'*}
                        local_platform_hint=${local_platform_hint//[!A-Za-z0-9_.-]/}
                        local_platform_hint=${local_platform_hint:0:32}
                        printf '%s: unsupported or undetectable remote platform (probe reported: %s)\n' "$program" "${local_platform_hint:-empty}" >&2
                        return 2
                    fi
                    ;;
            esac
            ;;
        unix|windows)
            ;;
        *)
            fail 'AGENTQ_REMOTE_PLATFORM must be auto, unix, or windows'
            ;;
    esac

    if [ "$remote_platform" = windows ]; then
        probe_windows_agentq_protocol || return $?
    fi

    case "$remote_platform" in
        unix)
            # shellcheck disable=SC2016
            remote_base_command='agentq_run() { agentq_server="$HOME/.local/bin/agentq"; exec "$agentq_server" "$@"; }; agentq_run'
            remote_command=$remote_base_command
            ;;
        windows)
            remote_argument_file=$(mktemp "$agentq_temp_directory/agentq-arguments.XXXXXX") || fail 'cannot create a temporary Windows argument stream'
            remote_argument_file_identity=$(windows_argument_file_identity "$remote_argument_file") || {
                printf '%s: cannot record Windows argument temporary identity: %s\n' "$program" "$remote_argument_file" >&2
                windows_argument_status=1
                if windows_argument_remove_file "$remote_argument_file" "$remote_argument_file_identity"; then
                    windows_argument_cleanup_status=0
                else
                    windows_argument_cleanup_status=$?
                    if [ "$windows_argument_status" -eq 0 ]; then
                        windows_argument_status=$windows_argument_cleanup_status
                    fi
                fi
                return "$windows_argument_status"
            }
            windows_argument_require_file "$remote_argument_file" || return $?
            remote_base_command=''
            remote_command=''
            ;;
    esac
}

reset_windows_argument_stream() {
    [ "$remote_platform" = windows ] || return 0
    windows_argument_require_file "$remote_argument_file" || return $?
    windows_argument_verify_identity "$remote_argument_file" "$remote_argument_file_identity" 'before reset' || return $?
    : > "$remote_argument_file"
    windows_argument_require_file "$remote_argument_file" || return $?
    windows_argument_verify_identity "$remote_argument_file" "$remote_argument_file_identity" 'after reset' || return $?
    remote_input_file=''
    remote_input_file_identity=''
}

build_windows_remote_command() {
    [ -n "$remote_argument_file" ] || fail 'internal error: Windows argument stream is unavailable'
    resolve_agentq_temp_directory || return $?
    windows_argument_require_file "$remote_argument_file" || return $?
    windows_argument_verify_identity "$remote_argument_file" "$remote_argument_file_identity" 'before Base64 input' || return $?
    remote_input_file=$(mktemp "$agentq_temp_directory/agentq-windows-arguments.XXXXXX") || fail 'cannot create a temporary Windows argument payload'
    remote_input_file_identity=$(windows_argument_file_identity "$remote_input_file") || {
        printf '%s: cannot record Windows argument payload identity: %s\n' "$program" "$remote_input_file" >&2
        windows_argument_status=1
        if windows_argument_remove_file "$remote_input_file" "$remote_input_file_identity"; then
            windows_argument_cleanup_status=0
        else
            windows_argument_cleanup_status=$?
            if [ "$windows_argument_status" -eq 0 ]; then
                windows_argument_status=$windows_argument_cleanup_status
            fi
        fi
        remote_input_file=''
        remote_input_file_identity=''
        return "$windows_argument_status"
    }
    if windows_argument_require_file "$remote_input_file"; then
        :
    else
        windows_argument_status=$?
        if windows_argument_remove_file "$remote_input_file" "$remote_input_file_identity"; then
            windows_argument_cleanup_status=0
        else
            windows_argument_cleanup_status=$?
            if [ "$windows_argument_status" -eq 0 ]; then
                windows_argument_status=$windows_argument_cleanup_status
            fi
        fi
        remote_input_file=''
        remote_input_file_identity=''
        return "$windows_argument_status"
    fi
    windows_argument_require_existing_file "$remote_argument_file" || return $?
    base64 < "$remote_argument_file" > "$remote_input_file" || fail 'cannot encode the Windows argument stream'
    windows_argument_require_file "$remote_argument_file" || return $?
    windows_argument_require_file "$remote_input_file" || return $?
    windows_argument_verify_identity "$remote_argument_file" "$remote_argument_file_identity" 'after Base64 input' || return $?
    windows_argument_verify_identity "$remote_input_file" "$remote_input_file_identity" 'after Base64 output' || return $?
    [ -s "$remote_input_file" ] || fail 'internal error: Windows argument stream is empty'
    # shellcheck disable=SC2016
    # Win32-OpenSSH can terminate a non-TTY stdin stream before PowerShell's
    # -File parameter binder receives the base64 payload. Use an encoded
    # wrapper that reads stdin explicitly, then invokes the protected launcher.
    windows_launcher_wrapper='$ProgressPreference = "SilentlyContinue"; $maximumArgumentPayloadCharacters = 1048576; $payloadBuffer = [char[]]::new(4096); $payloadBuilder = [System.Text.StringBuilder]::new(); while ($true) { $payloadReadCount = [Console]::In.Read($payloadBuffer, 0, $payloadBuffer.Length); if ($payloadReadCount -le 0) { break }; if (($payloadBuilder.Length + $payloadReadCount) -gt $maximumArgumentPayloadCharacters) { [Console]::Error.WriteLine("agentq: Windows argument payload exceeds $maximumArgumentPayloadCharacters characters"); [Console]::Error.WriteLine("agentq-exit:2"); exit 2 }; [void]$payloadBuilder.Append($payloadBuffer, 0, $payloadReadCount) }; $payload = $payloadBuilder.ToString(); & "C:\ProgramData\AgentQ\agentq-launcher.ps1" -ArgumentsBase64 $payload; $launcherExitCode = Get-Variable -Name LASTEXITCODE -ErrorAction SilentlyContinue; if ($null -eq $launcherExitCode) { [Console]::Error.WriteLine("agentq-exit:1"); exit 1 }; $agentqLauncherExit = [int]$launcherExitCode.Value; [Console]::Error.WriteLine("agentq-exit:$agentqLauncherExit"); exit $agentqLauncherExit'
    windows_launcher_encoded=$(encode_windows_powershell "$windows_launcher_wrapper") || fail 'cannot encode the Windows AgentQ launcher wrapper; iconv and base64 are required'
    [ -n "$windows_launcher_encoded" ] || fail 'cannot encode the Windows AgentQ launcher wrapper'
    remote_command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand $windows_launcher_encoded"
}

make_client_temporary_file() {
    # mktemp honors $TMPDIR, which macOS points at /var/folders/... -- long, but
    # the client has no unix-socket path limit, so that is fine here.  The -t
    # form is deliberately NOT used: it is GNU-only, and this client must run on
    # BSD userlands too.  A fallback keeps the failure mode explicit rather than
    # silently redirecting ssh's stderr to a path nobody reads.
    client_temporary_directory=$1
    client_temporary_prefix=$2
    if [ -n "$client_temporary_directory" ] && [ -d "$client_temporary_directory" ]; then
        mktemp "$client_temporary_directory/$client_temporary_prefix.XXXXXX" 2>/dev/null && return 0
    fi
    mktemp "/tmp/$client_temporary_prefix.XXXXXX" 2>/dev/null && return 0
    printf '%s: cannot allocate a temporary file for %s\n' "$program" "$client_temporary_prefix" >&2
    return 1
}

run_ssh_logged() {
    ssh_log_file=$1
    ssh_remote_command=$2
    ssh_input_file=${3:-}

    agentq_ssh_log_require_file "$ssh_log_file" || return $?
    agentq_ssh_log_remove_file "$ssh_log_file" || return $?
    agentq_ssh_log_require_file "$ssh_log_file" || return $?
    # OpenSSH writes the remote command's stderr to the LOCAL stderr; -E carries
    # only ssh's own diagnostics.  Measured on macOS with a real sshd: a remote
    # `printf ... >&2` lands on the local stderr and the -E file gets nothing.
    # Without this capture the server's reason line would be discarded here --
    # which is exactly what happened before this fix.  Capture into a protected
    # file (umask 077), never echo it.
    ssh_stderr_capture=''
    ssh_stderr_capture_identity=''
    ssh_stderr_redirection='/dev/null'
    if ssh_stderr_capture=$(umask 077; make_client_temporary_file "${agentq_temp_directory:-$ssh_log_file}" 'agentq-ssh-stderr'); then
        ssh_stderr_redirection=$ssh_stderr_capture
        # Record the identity immediately.  windows_argument_remove_file refuses
        # to delete a temporary whose identity was never recorded, so skipping
        # this would make the file unremovable by cleanup_client_runtime -- the
        # opposite of what registering it there is for.  A capture we cannot
        # attribute is dropped rather than tracked, which keeps the old
        # /dev/null behaviour instead of leaking an unattributable file.
        if ! ssh_stderr_capture_identity=$(windows_argument_file_identity "$ssh_stderr_capture"); then
            ssh_stderr_capture_identity=''
            ssh_stderr_redirection='/dev/null'
            ssh_stderr_capture=''
        fi
    fi
    if [ -n "$ssh_input_file" ]; then
        agentq_ssh_input_require_file "$ssh_input_file" || return $?
        if [ "$remote_platform" = windows ]; then
            if windows_argument_expected_identity=$(windows_argument_identity_for_path "$ssh_input_file"); then
                windows_argument_verify_identity "$ssh_input_file" "$windows_argument_expected_identity" 'before SSH consumption' || return $?
            else
                printf '%s: refusing to consume an untracked Windows argument temporary: %s\n' "$program" "$ssh_input_file" >&2
                return 2
            fi
        fi
        agentq_ssh_input_require_existing_file "$ssh_input_file" || return $?
        if "$ssh_binary" \
            -E "$ssh_log_file" \
            -o LogLevel=ERROR \
            $ssh_credential_option_lines \
            -o ConnectTimeout=10 \
            -o ServerAliveInterval=15 \
            -o ServerAliveCountMax=12 \
            -o TCPKeepAlive=yes \
            -- "$host" "$ssh_remote_command" < "$ssh_input_file" 2>"$ssh_stderr_redirection"; then
            ssh_status=0
        else
            ssh_status=$?
        fi
    else
        if "$ssh_binary" \
            -E "$ssh_log_file" \
            -o LogLevel=ERROR \
            $ssh_credential_option_lines \
            -o ConnectTimeout=10 \
            -o ServerAliveInterval=15 \
            -o ServerAliveCountMax=12 \
            -o TCPKeepAlive=yes \
            -- "$host" "$ssh_remote_command" 2>"$ssh_stderr_redirection"; then
            ssh_status=0
        else
            ssh_status=$?
        fi
    fi

    agentq_remote_failure_reason_value=''
    if [ -n "$ssh_stderr_capture" ]; then
        if [ -s "$ssh_stderr_capture" ]; then
            if ssh_failure_reason=$(agentq_remote_failure_reason "$ssh_stderr_capture"); then
                agentq_remote_failure_reason_value=$ssh_failure_reason
            fi
            # On a Windows target the wrapper's out-of-band token is the
            # authoritative exit code: sshd with DefaultShell=powershell.exe
            # flattens every nonzero native exit to 1, so the SSH code loses the
            # 2/3/4/5/6 the recovery logic depends on.  The wrapper emits the
            # token for both DefaultShell values, and it agrees with the SSH
            # code whenever the SSH code is trustworthy, so preferring it is
            # safe; unix targets never emit it.
            if [ "$remote_platform" = windows ]; then
                if ssh_exit_token=$(agentq_remote_exit_token "$ssh_stderr_capture"); then
                    ssh_status=$ssh_exit_token
                fi
            fi
        fi
        # Identity-checked removal, like every other temporary in this file --
        # NOT `rm -f ... || true`.  That form was the one place a removal failure
        # was swallowed and never folded into the exit status.  cleanup_client_runtime
        # also removes this path, so a failure here is not fatal: it is reported
        # and the EXIT trap retries.
        if windows_argument_remove_file "$ssh_stderr_capture" "$ssh_stderr_capture_identity"; then
            :
        else
            ssh_stderr_capture_status=$?
            printf '%s: failed to remove the ssh stderr capture: %s\n' "$program" "$ssh_stderr_capture" >&2
            if [ "$ssh_status" -eq 0 ]; then
                ssh_status=$ssh_stderr_capture_status
            fi
        fi
        ssh_stderr_capture=''
        ssh_stderr_capture_identity=''
    fi
    agentq_ssh_log_require_file "$ssh_log_file" || return $?
    if [ -s "$ssh_log_file" ]; then
        agentq_ssh_log_require_file "$ssh_log_file" || return $?
        write_ssh_diagnostic_metadata "$ssh_log_file"
    fi
    return "$ssh_status"
}

run_submit_with_recovery() {
    agentq_recovery_request_id=$1
