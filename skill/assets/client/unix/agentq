            else
                agentq_recovery_log_cleanup_status=$?
                if [ "$agentq_recovery_status" -eq 0 ]; then
                    agentq_recovery_status=$agentq_recovery_log_cleanup_status
                fi
            fi
            return "$agentq_recovery_status"
        fi
        if [ "$agentq_recovery_status" -eq 5 ]; then
            if recovery_output_require_existing_file "$agentq_recovery_output_file"; then
                cat "$agentq_recovery_output_file"
            else
                agentq_recovery_status=$?
            fi
            if recovery_output_remove_file "$agentq_recovery_output_file"; then
                agentq_recovery_output_cleanup_status=0
            else
                agentq_recovery_output_cleanup_status=$?
                if [ "$agentq_recovery_status" -eq 0 ]; then
                    agentq_recovery_status=$agentq_recovery_output_cleanup_status
                fi
            fi
            if agentq_ssh_log_remove_file "$agentq_recovery_log_file"; then
                agentq_recovery_log_cleanup_status=0
            else
                agentq_recovery_log_cleanup_status=$?
                if [ "$agentq_recovery_status" -eq 0 ]; then
                    agentq_recovery_status=$agentq_recovery_log_cleanup_status
                fi
            fi
            return "$agentq_recovery_status"
        fi
        if [ "$agentq_recovery_status" -eq 255 ] && ssh_transport_error "$agentq_recovery_log_file"; then
            if recovery_output_remove_file "$agentq_recovery_output_file"; then
                agentq_recovery_output_cleanup_status=0
            else
                agentq_recovery_output_cleanup_status=$?
                if [ "$agentq_recovery_cleanup_failure_status" -eq 0 ]; then
                    agentq_recovery_cleanup_failure_status=$agentq_recovery_output_cleanup_status
                fi
            fi
            if agentq_ssh_log_remove_file "$agentq_recovery_log_file"; then
                agentq_recovery_log_cleanup_status=0
            else
                agentq_recovery_log_cleanup_status=$?
                if [ "$agentq_recovery_cleanup_failure_status" -eq 0 ]; then
                    agentq_recovery_cleanup_failure_status=$agentq_recovery_log_cleanup_status
                fi
            fi
            continue
        fi

        if recovery_output_require_existing_file "$agentq_recovery_output_file"; then
            cat "$agentq_recovery_output_file"
        else
            agentq_recovery_status=$?
        fi
        if recovery_output_remove_file "$agentq_recovery_output_file"; then
            agentq_recovery_output_cleanup_status=0
        else
            agentq_recovery_output_cleanup_status=$?
            if [ "$agentq_recovery_status" -eq 0 ]; then
                agentq_recovery_status=$agentq_recovery_output_cleanup_status
            fi
        fi
        if agentq_ssh_log_remove_file "$agentq_recovery_log_file"; then
            agentq_recovery_log_cleanup_status=0
        else
            agentq_recovery_log_cleanup_status=$?
            if [ "$agentq_recovery_status" -eq 0 ]; then
