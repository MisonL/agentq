# wait with a client-side deadline.  The ssh child runs in the background and
# is polled once per second; when the budget elapses the local ssh is killed
# and 124 is returned (the probe-timeout convention; the recovery loop's
# 255-retry branch never sees it).  On unix targets the remote wait itself is
# also bounded with coreutils `timeout`, because killing the LOCAL ssh does
# not stop the remote process -- measured 2026-10-28 over a real sshd: without
# the bound each elapsed-budget poll leaves one `agentq-server wait` (plus its
# `pueue wait --quiet` child) alive until the task ends, so a polling caller
# accumulates them linearly (1,2,3,4,5 across five polls).  They do NOT hold
# the server operation lock -- `wait_for_task` releases it before `pueue wait`
# -- that earlier note here was wrong; what they hold is a process and a
# pueued connection.  Windows targets have no equivalent guaranteed on PATH,
# so there the bound is local-only.  On a
# completed (non-timed-out) run the ssh status is recovered from the child,
# the server reason token is extracted from a captured stderr exactly as
# run_ssh_logged does, and the output/log temporaries are LEFT in place for
# the recovery loop's own cleanup paths.
run_wait_ssh_with_timeout() {
    wait_ssh_command=$1
    wait_ssh_input=${2:-}
    operation_output_require_file "$agentq_operation_output_file" || return $?

    wait_remote_command=$wait_ssh_command
    if [ "$remote_platform" != windows ]; then
        # Bound the REMOTE wait with coreutils `timeout`: killing the local ssh
        # does not stop the remote process, so without the bound each
        # elapsed-budget poll leaves one `agentq-server wait` (plus its
        # `pueue wait --quiet` child) alive until the task ends -- measured
        # 2026-10-28 over a real sshd, 1,2,3,4,5 across five polls.  The
        # orphan does not hold the operation lock (the server releases it
        # before `pueue wait`); what it holds is a process and a pueued
        # connection, which a polling caller accumulates linearly.
        #
        # The bound is NOT a `timeout <N>s <command>` prefix.  The unix remote
        # command BEGINS with a function definition
        # (`agentq_run() { ... }; agentq_run 'wait' '5'`), and shell grammar
        # allows a function definition only in command position, so a prefix
        # makes the whole line a syntax error -- measured 2026-10-16: dash says
        # `Syntax error: "(" unexpected` and bash says `syntax error near
        # unexpected token '('`, the remote executes NOTHING, and every
        # `wait --timeout` died with an empty response.  Instead the budget
        # travels as a leading assignment statement (valid anywhere) that
        # `agentq_run` honours; see remote_base_command.
        wait_remote_command="AGENTQ_WAIT_BUDGET=${wait_timeout_seconds}s; $wait_ssh_command"
    fi

    wait_ssh_stderr_capture=$(umask 077; make_client_temporary_file "$agentq_temp_directory" 'agentq-wait-stderr') || {
        printf '%s: cannot create a temporary stderr capture for wait\n' "$program" >&2
        return 2
    }
    wait_ssh_stderr_capture_identity=$(windows_argument_file_identity "$wait_ssh_stderr_capture") || {
        wait_ssh_stderr_capture_identity=''
        if operation_output_remove_file "$wait_ssh_stderr_capture" 2>/dev/null; then
            :
        fi
        printf '%s: cannot track the wait stderr capture temporary: %s\n' "$program" "$wait_ssh_stderr_capture" >&2
        return 2
    }

    if [ -n "$wait_ssh_input" ]; then
        agentq_ssh_input_require_file "$wait_ssh_input" || return $?
        "$ssh_binary" \
            -E "$agentq_operation_log_file" \
            -o LogLevel=ERROR \
            $ssh_credential_option_lines \
            -o ConnectTimeout=10 \
            -o ServerAliveInterval=15 \
            -o ServerAliveCountMax=12 \
            -o TCPKeepAlive=yes \
            -- "$host" "$wait_remote_command" < "$wait_ssh_input" > "$agentq_operation_output_file" 2>"$wait_ssh_stderr_capture" &
    else
        "$ssh_binary" \
            -E "$agentq_operation_log_file" \
            -o LogLevel=ERROR \
            $ssh_credential_option_lines \
            -o ConnectTimeout=10 \
            -o ServerAliveInterval=15 \
            -o ServerAliveCountMax=12 \
            -o TCPKeepAlive=yes \
            -- "$host" "$wait_remote_command" > "$agentq_operation_output_file" 2>"$wait_ssh_stderr_capture" &
    fi
    agentq_operation_ssh_pid=$!
    wait_ssh_child_pid=$agentq_operation_ssh_pid
    wait_ssh_elapsed=0
    wait_ssh_timed_out=0
    while kill -0 "$agentq_operation_ssh_pid" >/dev/null 2>&1; do
        if [ "$wait_ssh_elapsed" -ge "$wait_timeout_seconds" ]; then
            kill "$agentq_operation_ssh_pid" >/dev/null 2>&1 || true
            wait "$agentq_operation_ssh_pid" >/dev/null 2>&1 || true
            wait_ssh_timed_out=1
            break
        fi
        sleep 1
        wait_ssh_elapsed=$((wait_ssh_elapsed + 1))
    done
    # Save before clearing: a bare `wait` with no argument returns the status
    # of the PREVIOUS command (here the deadline loop's last `kill -0`, which
    # is 1 for a child that just exited), not the child's own status --
    # measured 2026-10-15: a completed fast wait was reported as exit 1.
    agentq_operation_ssh_pid=''

    if [ "$wait_ssh_timed_out" -eq 1 ]; then
        if operation_output_remove_file "$agentq_operation_output_file"; then
            :
        else
            return $?
        fi
        if agentq_ssh_log_remove_file "$agentq_operation_log_file"; then
            :
        else
            return $?
        fi
        if windows_argument_remove_file "$wait_ssh_stderr_capture" "$wait_ssh_stderr_capture_identity"; then
            wait_ssh_stderr_capture=''
            wait_ssh_stderr_capture_identity=''
        else
            return $?
        fi
        return 124
    fi

    # Condition context for BOTH the wait builtin and the status capture:
    # under `set -e` a bare `wait <pid>` whose child exited non-zero trips
    # errexit and kills the shell with the child's code (measured 2026-10-15:
    # a 255 from ssh exited the shell before `wait_ssh_status=$?` could run,
    # so the transport-retry branch never saw the 255).
    if wait "$wait_ssh_child_pid" >/dev/null 2>&1; then
        wait_ssh_status=0
    else
        wait_ssh_status=$?
    fi

    agentq_remote_failure_reason_value=''
    if [ -s "$wait_ssh_stderr_capture" ]; then
        if ssh_failure_reason=$(agentq_remote_failure_reason "$wait_ssh_stderr_capture"); then
            agentq_remote_failure_reason_value=$ssh_failure_reason
        fi
        if [ "$remote_platform" = windows ]; then
            if ssh_exit_token=$(agentq_remote_exit_token "$wait_ssh_stderr_capture"); then
                wait_ssh_status=$ssh_exit_token
            fi
        fi
    fi
    if windows_argument_remove_file "$wait_ssh_stderr_capture" "$wait_ssh_stderr_capture_identity"; then
        wait_ssh_stderr_capture=''
        wait_ssh_stderr_capture_identity=''
    else
        printf '%s: failed to remove the wait stderr capture: %s\n' "$program" "$wait_ssh_stderr_capture" >&2
        # NOT `wait_ssh_status=$?` here: by this point `$?` is the `[` test's
        # status (always 0), not the failed removal's -- so the assignment
        # silently turned a cleanup failure into a success.  The intent is
        # "report the failure only when ssh itself succeeded", and a cleanup
        # failure has no exit code of its own in the contract, so the general
        # failure code is what gets reported.  (shellcheck SC2319, 2026-10-18.)
        if [ "$wait_ssh_status" -eq 0 ]; then
            wait_ssh_status=1
        fi
    fi

    if [ -s "$agentq_operation_log_file" ]; then
        write_ssh_diagnostic_metadata "$agentq_operation_log_file"
    fi
    return "$wait_ssh_status"
}

recovery_output_file_is_safe() {
    recovery_output_guard_file=$1
    [ -n "$recovery_output_guard_file" ] || return 1
    recovery_output_parent=${recovery_output_guard_file%/*}
    recovery_output_name=${recovery_output_guard_file##*/}
    [ -n "$recovery_output_name" ] || return 1
    [ "$recovery_output_parent" != "$recovery_output_guard_file" ] || recovery_output_parent=.
    agentq_client_temp_path_is_safe "$recovery_output_parent" || return 1
    [ ! -L "$recovery_output_guard_file" ] || return 1
    if [ -e "$recovery_output_guard_file" ] && [ ! -f "$recovery_output_guard_file" ]; then
        return 1
    fi
    return 0
}

recovery_output_require_file() {
    if recovery_output_file_is_safe "$1"; then
        return 0
    fi
    printf '%s: unsafe submit recovery output temporary file: %s\n' "$program" "$1" >&2
    return 2
}

recovery_output_require_existing_file() {
    if recovery_output_file_is_safe "$1" && [ -f "$1" ]; then
        return 0
    fi
    printf '%s: unsafe submit recovery output temporary file: %s\n' "$program" "$1" >&2
    return 2
}

recovery_output_remove_file() {
    if recovery_output_file_is_safe "$1"; then
        if ! rm -f -- "$1"; then
            printf '%s: failed to remove submit recovery output temporary file: %s\n' "$program" "$1" >&2
            return 1
        fi
        if [ -e "$1" ] || [ -L "$1" ]; then
            printf '%s: submit recovery output temporary file remained after cleanup: %s\n' "$program" "$1" >&2
            return 1
        fi
        return 0
    fi
    printf '%s: refusing to remove an unsafe submit recovery output temporary file: %s\n' "$program" "$1" >&2
    return 2
}

run_submit_recovery_ssh() {
    recovery_ssh_command=$1
    recovery_ssh_input=${2:-}
    recovery_output_require_file "$agentq_recovery_output_file" || return $?
    if run_ssh_logged "$agentq_recovery_log_file" "$recovery_ssh_command" "$recovery_ssh_input" > "$agentq_recovery_output_file"; then
        recovery_ssh_status=0
    else
        recovery_ssh_status=$?
    fi
    return "$recovery_ssh_status"
}

agentq_stop_background_ssh() {
    # A signal handler that only exits leaves the backgrounded ssh child alive,
    # which is a local orphan the caller cannot see; the client kills it here
    # before returning 130.  Killing the local ssh does NOT reap the remote
    # command -- measured 2026-10-28 against a real sshd: a remote `sleep 60`
    # and a remote `agentq-server wait` both outlived SIGTERM and SIGKILL of
    # the local ssh.  What bounds the remote wait is the AGENTQ_WAIT_BUDGET
    # wrapper on the command itself (unix targets with coreutils `timeout`);
    # on a Windows target there is no such bound, and the remote wait lives
    # until the task ends.  Only the wait-with-timeout path backgrounds an ssh
    # (the platform probe does too, but it runs inside a $( ) subshell, so its
    # pid never reaches this shell -- that path is bounded by its own 30s probe
    # timeout instead).
    if [ -n "${agentq_operation_ssh_pid:-}" ]; then
        kill "$agentq_operation_ssh_pid" >/dev/null 2>&1 || true
        wait "$agentq_operation_ssh_pid" >/dev/null 2>&1 || true
        agentq_operation_ssh_pid=''
    fi
}

