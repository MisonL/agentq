# Emit the ssh option lines that depend on the credential source.  Read-only by
# design: the caller consumes this through a command substitution, and a
# command substitution runs in a subshell, so any global set in here would be
# discarded.  (This project has been bitten by that three times.)
ssh_credential_options() {
    if [ "$agentq_credential_source" = '' ]; then
        printf '%s\n' '-o BatchMode=yes'
    else
        printf '%s\n' '-o BatchMode=no'
        printf '%s\n' "-o NumberOfPasswordPrompts=$agentq_number_of_password_prompts"
    fi
}

