run_platform_probe() {
    platform_probe_command=$1
    # Optional: a file whose contents are fed to the remote command on stdin.
    # Windows probes use this so the script body never enters the remote
    # command LINE, which Windows truncates (see PLAN.md A5a).
    platform_probe_stdin_file=${2:-}
    # The identity is NOT reset when a stdin file is supplied: it was recorded by
    # make_windows_probe_script_file, and clearing it here would make the
    # identity check below reject the client's own probe temporary ("without a
    # recorded identity").  Only the no-stdin case (a plain `uname -s` probe)
    # resets the globals, because then there is nothing to consume.
    if [ -z "$platform_probe_stdin_file" ]; then
        platform_probe_stdin_identity=''
    fi
    resolve_agentq_temp_directory || return $?
    command -v stat >/dev/null 2>&1 || {
        printf '%s: stat is required to protect platform probe temporary identity\n' "$program" >&2
        return 2
    }
    platform_probe_output_file=$(mktemp "$agentq_temp_directory/agentq-platform-output.XXXXXX") || return 2
    platform_probe_output_identity=$(platform_probe_file_identity "$platform_probe_output_file") || {
        # Preserve, and say so: removal is identity-gated (the same rule as
        # run_ssh_logged), so the file is deliberately left behind.  The path
        # must appear in THIS line -- the previous shape cleared the global and
        # then called the remover with an empty path, which printed
        # "unsafe platform probe temporary file: " (no file name) and could
        # never have removed anything.
        printf '%s: cannot record platform probe output temporary identity; preserving it: %s\n' \
            "$program" "$platform_probe_output_file" >&2
        platform_probe_output_file=''
        return 2
    }
    if platform_probe_require_file "$platform_probe_output_file"; then
        :
    else
        platform_probe_status=$?
        if platform_probe_remove_file "$platform_probe_output_file" "$platform_probe_output_identity"; then
            platform_probe_output_cleanup_status=0
        else
            platform_probe_output_cleanup_status=$?
            if [ "$platform_probe_status" -eq 0 ]; then
                platform_probe_status=$platform_probe_output_cleanup_status
            fi
        fi
        return "$platform_probe_status"
    fi
    platform_probe_log_file=$(mktemp "$agentq_temp_directory/agentq-platform-log.XXXXXX") || {
        platform_probe_status=2
        if platform_probe_remove_file "$platform_probe_output_file" "$platform_probe_output_identity"; then
            platform_probe_output_cleanup_status=0
        else
            platform_probe_output_cleanup_status=$?
            if [ "$platform_probe_status" -eq 0 ]; then
                platform_probe_status=$platform_probe_output_cleanup_status
            fi
        fi
        return "$platform_probe_status"
    }
    platform_probe_log_identity=$(platform_probe_file_identity "$platform_probe_log_file") || {
        # Same shape as the output-file branch above: name the preserved file,
        # remove the output file (whose identity IS known), and do not attempt
        # an identity-gated removal of the log file with an empty path.
        printf '%s: cannot record platform probe log temporary identity; preserving it: %s\n' \
            "$program" "$platform_probe_log_file" >&2
        platform_probe_log_file=''
        platform_probe_status=2
        if platform_probe_remove_file "$platform_probe_output_file" "$platform_probe_output_identity"; then
            platform_probe_output_cleanup_status=0
        else
            platform_probe_output_cleanup_status=$?
            if [ "$platform_probe_status" -eq 0 ]; then
                platform_probe_status=$platform_probe_output_cleanup_status
            fi
        fi
        return "$platform_probe_status"
    }
    if platform_probe_require_file "$platform_probe_log_file"; then
        :
    else
        platform_probe_status=$?
        if platform_probe_remove_file "$platform_probe_output_file" "$platform_probe_output_identity"; then
            platform_probe_output_cleanup_status=0
        else
            platform_probe_output_cleanup_status=$?
            if [ "$platform_probe_status" -eq 0 ]; then
                platform_probe_status=$platform_probe_output_cleanup_status
            fi
        fi
        if platform_probe_remove_file "$platform_probe_log_file" "$platform_probe_log_identity"; then
            platform_probe_log_cleanup_status=0
        else
            platform_probe_log_cleanup_status=$?
            if [ "$platform_probe_status" -eq 0 ]; then
                platform_probe_status=$platform_probe_log_cleanup_status
            fi
        fi
        return "$platform_probe_status"
    fi
    if platform_probe_verify_identity "$platform_probe_output_file" "$platform_probe_output_identity" 'before probe' &&
        platform_probe_verify_identity "$platform_probe_log_file" "$platform_probe_log_identity" 'before probe'; then
        :
    else
        platform_probe_status=$?
        if platform_probe_remove_file "$platform_probe_output_file" "$platform_probe_output_identity"; then
            platform_probe_output_cleanup_status=0
        else
            platform_probe_output_cleanup_status=$?
            if [ "$platform_probe_status" -eq 0 ]; then
                platform_probe_status=$platform_probe_output_cleanup_status
            fi
        fi
        if platform_probe_remove_file "$platform_probe_log_file" "$platform_probe_log_identity"; then
            platform_probe_log_cleanup_status=0
        else
            platform_probe_log_cleanup_status=$?
            if [ "$platform_probe_status" -eq 0 ]; then
                platform_probe_status=$platform_probe_log_cleanup_status
            fi
        fi
        return "$platform_probe_status"
    fi

    if platform_probe_require_file "$platform_probe_output_file" &&
        platform_probe_require_file "$platform_probe_log_file"; then
        :
    else
        platform_probe_status=$?
        if platform_probe_remove_file "$platform_probe_output_file" "$platform_probe_output_identity"; then
            platform_probe_output_cleanup_status=0
        else
            platform_probe_output_cleanup_status=$?
            if [ "$platform_probe_status" -eq 0 ]; then
                platform_probe_status=$platform_probe_output_cleanup_status
            fi
        fi
        if platform_probe_remove_file "$platform_probe_log_file" "$platform_probe_log_identity"; then
            platform_probe_log_cleanup_status=0
        else
            platform_probe_log_cleanup_status=$?
            if [ "$platform_probe_status" -eq 0 ]; then
                platform_probe_status=$platform_probe_log_cleanup_status
            fi
        fi
        return "$platform_probe_status"
    fi

    if [ -n "$platform_probe_stdin_file" ]; then
        if platform_probe_stdin_identity=$(windows_argument_identity_for_path "$platform_probe_stdin_file"); then
            windows_argument_verify_identity "$platform_probe_stdin_file" "$platform_probe_stdin_identity" 'before platform probe SSH consumption' || return $?
        else
            printf '%s: refusing to consume an untracked platform probe stdin temporary: %s\n' "$program" "$platform_probe_stdin_file" >&2
            return 2
        fi
        platform_probe_require_existing_file "$platform_probe_stdin_file" || return $?
    fi

    # The remote command's stderr must NOT be inherited.  OpenSSH sends it to the
    # LOCAL stderr (-E carries only ssh's own diagnostics), so without this the
    # remote could write arbitrary text -- including a forged
    # `agentq: remote failure reason: <class>` line -- straight onto the caller's
    # stderr, before the client has printed anything of its own.  The probe runs
    # before any operation dispatch, and this path does not consume the reason
    # channel at all, so discarding it loses nothing and closes the surface.
    # Every other ssh call site in this client captures and redacts through
    # run_ssh_logged; the probe is the only one that used to bypass that.
    if [ -n "$platform_probe_stdin_file" ]; then
        "$ssh_binary" \
            -E "$platform_probe_log_file" \
            -o LogLevel=ERROR \
            $ssh_credential_option_lines \
            -o ConnectTimeout=10 \
            -o ServerAliveInterval=15 \
            -o ServerAliveCountMax=12 \
            -o TCPKeepAlive=yes \
            -- "$host" "$platform_probe_command" < "$platform_probe_stdin_file" > "$platform_probe_output_file" 2>/dev/null &
    else
        "$ssh_binary" \
            -E "$platform_probe_log_file" \
            -o LogLevel=ERROR \
            $ssh_credential_option_lines \
            -o ConnectTimeout=10 \
            -o ServerAliveInterval=15 \
            -o ServerAliveCountMax=12 \
            -o TCPKeepAlive=yes \
            -- "$host" "$platform_probe_command" > "$platform_probe_output_file" 2>/dev/null &
    fi
    platform_probe_pid=$!
    platform_probe_elapsed=0
    platform_probe_timed_out=0
    while kill -0 "$platform_probe_pid" >/dev/null 2>&1; do
        if [ "$platform_probe_elapsed" -ge "$platform_probe_timeout" ]; then
            kill "$platform_probe_pid" >/dev/null 2>&1 || true
            wait "$platform_probe_pid" >/dev/null 2>&1 || true
            platform_probe_timed_out=1
            break
        fi
        sleep 1
        platform_probe_elapsed=$((platform_probe_elapsed + 1))
    done

    if [ "$platform_probe_timed_out" -eq 1 ]; then
        platform_probe_status=124
        printf '%s: remote platform/protocol probe timed out after %s seconds on %s\n' \
            "$program" "$platform_probe_timeout" "$host" >&2
    elif wait "$platform_probe_pid"; then
        platform_probe_status=0
    else
        platform_probe_status=$?
    fi

    if platform_probe_require_existing_file "$platform_probe_output_file" &&
        platform_probe_require_existing_file "$platform_probe_log_file"; then
        :
    else
        platform_probe_status=$?
        if platform_probe_remove_file "$platform_probe_output_file" "$platform_probe_output_identity"; then
            platform_probe_output_cleanup_status=0
        else
            platform_probe_output_cleanup_status=$?
            if [ "$platform_probe_status" -eq 0 ]; then
                platform_probe_status=$platform_probe_output_cleanup_status
            fi
        fi
        if platform_probe_remove_file "$platform_probe_log_file" "$platform_probe_log_identity"; then
            platform_probe_log_cleanup_status=0
        else
            platform_probe_log_cleanup_status=$?
            if [ "$platform_probe_status" -eq 0 ]; then
                platform_probe_status=$platform_probe_log_cleanup_status
            fi
        fi
        return "$platform_probe_status"
    fi
    if platform_probe_verify_identity "$platform_probe_output_file" "$platform_probe_output_identity" 'before reading' &&
        platform_probe_verify_identity "$platform_probe_log_file" "$platform_probe_log_identity" 'before reading'; then
        :
    else
        platform_probe_status=$?
        if platform_probe_remove_file "$platform_probe_output_file" "$platform_probe_output_identity"; then
            platform_probe_output_cleanup_status=0
        else
            platform_probe_output_cleanup_status=$?
            if [ "$platform_probe_status" -eq 0 ]; then
                platform_probe_status=$platform_probe_output_cleanup_status
            fi
        fi
        if platform_probe_remove_file "$platform_probe_log_file" "$platform_probe_log_identity"; then
            platform_probe_log_cleanup_status=0
        else
            platform_probe_log_cleanup_status=$?
            if [ "$platform_probe_status" -eq 0 ]; then
                platform_probe_status=$platform_probe_log_cleanup_status
            fi
        fi
        return "$platform_probe_status"
    fi

    if [ "$platform_probe_status" -eq 255 ]; then
        if platform_probe_require_existing_file "$platform_probe_log_file"; then
            if [ -s "$platform_probe_log_file" ]; then
                if ssh_transport_error "$platform_probe_log_file"; then
                    platform_probe_status=254
                fi
                write_ssh_diagnostic_metadata "$platform_probe_log_file"
            fi
        else
            platform_probe_status=$?
            platform_probe_output_cleanup_status=0
            platform_probe_log_cleanup_status=0
            platform_probe_remove_file "$platform_probe_output_file" "$platform_probe_output_identity" ||
                platform_probe_output_cleanup_status=$?
            platform_probe_remove_file "$platform_probe_log_file" "$platform_probe_log_identity" ||
                platform_probe_log_cleanup_status=$?
            return "$platform_probe_status"
        fi
    fi
    if platform_probe_require_existing_file "$platform_probe_output_file"; then
        :
    else
        platform_probe_status=$?
        platform_probe_output_cleanup_status=0
        platform_probe_log_cleanup_status=0
        if platform_probe_remove_file "$platform_probe_output_file" "$platform_probe_output_identity"; then
            :
        else
            platform_probe_output_cleanup_status=$?
        fi
        if platform_probe_remove_file "$platform_probe_log_file" "$platform_probe_log_identity"; then
            :
        else
            platform_probe_log_cleanup_status=$?
        fi
        return "$platform_probe_status"
    fi
    # wc's status is what the guard must see: in a pipeline the status is tr's,
    # and tr on empty input succeeds -- measured 2026-10-13, the old single
    # pipeline never fired its guard and the 64KB truncation fell open to an
    # unbounded cat when wc failed.  Measure in two steps, then validate.
    platform_probe_output_bytes=$(wc -c < "$platform_probe_output_file") || {
        printf '%s: cannot measure platform probe output size\n' "$program" >&2
        platform_probe_output_cleanup_status=1
        platform_probe_log_cleanup_status=0
        platform_probe_remove_file "$platform_probe_output_file" "$platform_probe_output_identity" || platform_probe_output_cleanup_status=$?
        platform_probe_remove_file "$platform_probe_log_file" "$platform_probe_log_identity" || platform_probe_log_cleanup_status=$?
        return 2
    }
    platform_probe_output_bytes=$(printf '%s' "$platform_probe_output_bytes" | tr -d '[:space:]')
    case "$platform_probe_output_bytes" in
        ''|*[!0-9]*)
            printf '%s: cannot measure platform probe output size\n' "$program" >&2
            return 2
            ;;
    esac
    platform_probe_output_max=${platform_probe_output_limit:-65536}
    if platform_probe_require_existing_file "$platform_probe_output_file"; then
        :
    else
        platform_probe_status=$?
        platform_probe_output_cleanup_status=0
        platform_probe_log_cleanup_status=0
        if platform_probe_remove_file "$platform_probe_output_file" "$platform_probe_output_identity"; then
            :
        else
            platform_probe_output_cleanup_status=$?
        fi
        if platform_probe_remove_file "$platform_probe_log_file" "$platform_probe_log_identity"; then
            :
        else
            platform_probe_log_cleanup_status=$?
        fi
        return "$platform_probe_status"
    fi
    if [ "$platform_probe_output_bytes" -gt "$platform_probe_output_max" ]; then
        if ! dd if="$platform_probe_output_file" bs=1 count="$platform_probe_output_max" 2>/dev/null; then
            printf '%s: failed to read bounded platform probe output\n' "$program" >&2
            platform_probe_output_cleanup_status=1
        else
            printf '\n[platform probe stdout truncated after %s bytes]\n' "$platform_probe_output_max"
            platform_probe_output_cleanup_status=0
        fi
    else
        cat "$platform_probe_output_file"
        platform_probe_output_cleanup_status=0
    fi
    if platform_probe_remove_file "$platform_probe_output_file" "$platform_probe_output_identity"; then
        :
    else
        platform_probe_cleanup_status=$?
        if [ "$platform_probe_output_cleanup_status" -eq 0 ]; then
            platform_probe_output_cleanup_status=$platform_probe_cleanup_status
        fi
    fi
    if platform_probe_remove_file "$platform_probe_log_file" "$platform_probe_log_identity"; then
        platform_probe_log_cleanup_status=0
    else
        platform_probe_log_cleanup_status=$?
    fi
    if [ "$platform_probe_output_cleanup_status" -ne 0 ] ||
        [ "$platform_probe_log_cleanup_status" -ne 0 ]; then
        return 2
    fi
    platform_probe_output_file=''
    platform_probe_output_identity=''
    platform_probe_log_file=''
    platform_probe_log_identity=''
    return "$platform_probe_status"
}

run_platform_probe_with_recovery() {
    platform_probe_command=$1
    platform_probe_recovery_stdin=${2:-}
    platform_probe_attempt=0

    while :; do
        if platform_probe_output=$(run_platform_probe "$platform_probe_command" "$platform_probe_recovery_stdin"); then
            platform_probe_status=0
        else
            platform_probe_status=$?
        fi

        if [ "$platform_probe_status" -ne 254 ]; then
            printf '%s\n' "$platform_probe_output"
            return "$platform_probe_status"
        fi

        platform_probe_attempt=$((platform_probe_attempt + 1))
        if [ "$platform_probe_attempt" -gt "$operation_retry_attempts" ]; then
            printf '%s\n' "$platform_probe_output"
            printf '%s: SSH transport remained unavailable while detecting the remote platform\n' "$program" >&2
            return 255
        fi

        printf '%s: SSH transport lost while detecting the remote platform; retrying %s/%s...\n' \
            "$program" "$platform_probe_attempt" "$operation_retry_attempts" >&2
        sleep "$operation_retry_delay"
    done
}

encode_windows_powershell() {
    command -v iconv >/dev/null 2>&1 || return 127
    command -v base64 >/dev/null 2>&1 || return 127

    resolve_agentq_temp_directory || return $?
    windows_encoding_input=$(mktemp "$agentq_temp_directory/agentq-windows-powershell.XXXXXX") || return 1
    windows_encoding_input_identity=$(windows_encoding_file_identity "$windows_encoding_input") || {
        # Preserve, and say so: the removal below is identity-gated, so the file
        # is deliberately left behind.  The path must appear in THIS line -- the
        # previous shape cleared the global and then called the remover with an
        # empty path, which printed an "unsafe temporary" line with no file name
        # and could never have removed anything.
        printf '%s: cannot record Windows PowerShell encoding input identity; preserving it: %s\n' \
            "$program" "$windows_encoding_input" >&2
        windows_encoding_input=''
        return 1
    }
    if windows_encoding_require_file "$windows_encoding_input"; then
        :
    else
        windows_encoding_status=$?
        if windows_encoding_remove_file "$windows_encoding_input" "$windows_encoding_input_identity"; then
            windows_encoding_input_cleanup_status=0
        else
            windows_encoding_input_cleanup_status=$?
            if [ "$windows_encoding_status" -eq 0 ]; then
                windows_encoding_status=$windows_encoding_input_cleanup_status
            fi
        fi
        return "$windows_encoding_status"
    fi
    windows_encoding_output=$(mktemp "$agentq_temp_directory/agentq-windows-powershell-base64.XXXXXX") || {
        windows_encoding_status=1
        if windows_encoding_remove_file "$windows_encoding_input" "$windows_encoding_input_identity"; then
            windows_encoding_input_cleanup_status=0
        else
            windows_encoding_input_cleanup_status=$?
            if [ "$windows_encoding_status" -eq 0 ]; then
                windows_encoding_status=$windows_encoding_input_cleanup_status
            fi
        fi
        return "$windows_encoding_status"
    }
    windows_encoding_output_identity=$(windows_encoding_file_identity "$windows_encoding_output") || {
        # Same shape: name the preserved output file, remove the INPUT (whose
        # identity is known), and skip the identity-gated removal of the output.
        printf '%s: cannot record Windows PowerShell encoding output identity; preserving it: %s\n' \
            "$program" "$windows_encoding_output" >&2
        windows_encoding_output=''
        windows_encoding_status=1
        if windows_encoding_remove_file "$windows_encoding_input" "$windows_encoding_input_identity"; then
            windows_encoding_input_cleanup_status=0
        else
            windows_encoding_input_cleanup_status=$?
            if [ "$windows_encoding_status" -eq 0 ]; then
                windows_encoding_status=$windows_encoding_input_cleanup_status
            fi
        fi
        return "$windows_encoding_status"
    }
    if windows_encoding_require_file "$windows_encoding_output"; then
        :
    else
        windows_encoding_status=$?
        if windows_encoding_remove_file "$windows_encoding_input" "$windows_encoding_input_identity"; then
            windows_encoding_input_cleanup_status=0
        else
            windows_encoding_input_cleanup_status=$?
            if [ "$windows_encoding_status" -eq 0 ]; then
                windows_encoding_status=$windows_encoding_input_cleanup_status
            fi
        fi
        if windows_encoding_remove_file "$windows_encoding_output" "$windows_encoding_output_identity"; then
            windows_encoding_output_cleanup_status=0
        else
            windows_encoding_output_cleanup_status=$?
            if [ "$windows_encoding_status" -eq 0 ]; then
                windows_encoding_status=$windows_encoding_output_cleanup_status
            fi
        fi
        return "$windows_encoding_status"
    fi

    if windows_encoding_verify_identity "$windows_encoding_input" "$windows_encoding_input_identity" 'before UTF-16LE conversion' &&
        windows_encoding_verify_identity "$windows_encoding_output" "$windows_encoding_output_identity" 'before UTF-16LE conversion'; then
        :
    else
        windows_encoding_status=$?
        if windows_encoding_remove_file "$windows_encoding_input" "$windows_encoding_input_identity"; then
            windows_encoding_input_cleanup_status=0
        else
            windows_encoding_input_cleanup_status=$?
            if [ "$windows_encoding_status" -eq 0 ]; then
                windows_encoding_status=$windows_encoding_input_cleanup_status
            fi
        fi
        if windows_encoding_remove_file "$windows_encoding_output" "$windows_encoding_output_identity"; then
            windows_encoding_output_cleanup_status=0
        else
            windows_encoding_output_cleanup_status=$?
            if [ "$windows_encoding_status" -eq 0 ]; then
                windows_encoding_status=$windows_encoding_output_cleanup_status
            fi
        fi
        return "$windows_encoding_status"
    fi
    if ! printf '%s' "$1" | iconv -f UTF-8 -t UTF-16LE > "$windows_encoding_input"; then
        windows_encoding_status=1
        if windows_encoding_remove_file "$windows_encoding_input" "$windows_encoding_input_identity"; then
            windows_encoding_input_cleanup_status=0
        else
            windows_encoding_input_cleanup_status=$?
            if [ "$windows_encoding_status" -eq 0 ]; then
                windows_encoding_status=$windows_encoding_input_cleanup_status
            fi
        fi
        if windows_encoding_remove_file "$windows_encoding_output" "$windows_encoding_output_identity"; then
            windows_encoding_output_cleanup_status=0
        else
            windows_encoding_output_cleanup_status=$?
            if [ "$windows_encoding_status" -eq 0 ]; then
                windows_encoding_status=$windows_encoding_output_cleanup_status
            fi
        fi
        return "$windows_encoding_status"
    fi
    if windows_encoding_verify_identity "$windows_encoding_input" "$windows_encoding_input_identity" 'before Base64 conversion' &&
        windows_encoding_verify_identity "$windows_encoding_output" "$windows_encoding_output_identity" 'before Base64 conversion' &&
        windows_encoding_require_existing_file "$windows_encoding_input" &&
        windows_encoding_require_file "$windows_encoding_output"; then
        :
    else
        windows_encoding_status=$?
        if windows_encoding_remove_file "$windows_encoding_input" "$windows_encoding_input_identity"; then
            windows_encoding_input_cleanup_status=0
        else
            windows_encoding_input_cleanup_status=$?
            if [ "$windows_encoding_status" -eq 0 ]; then
                windows_encoding_status=$windows_encoding_input_cleanup_status
            fi
        fi
        if windows_encoding_remove_file "$windows_encoding_output" "$windows_encoding_output_identity"; then
            windows_encoding_output_cleanup_status=0
        else
            windows_encoding_output_cleanup_status=$?
            if [ "$windows_encoding_status" -eq 0 ]; then
                windows_encoding_status=$windows_encoding_output_cleanup_status
            fi
        fi
        return "$windows_encoding_status"
    fi
    if ! base64 < "$windows_encoding_input" | tr -d '\n' > "$windows_encoding_output"; then
        windows_encoding_status=1
        if windows_encoding_remove_file "$windows_encoding_input" "$windows_encoding_input_identity"; then
            windows_encoding_input_cleanup_status=0
        else
            windows_encoding_input_cleanup_status=$?
            if [ "$windows_encoding_status" -eq 0 ]; then
                windows_encoding_status=$windows_encoding_input_cleanup_status
            fi
        fi
        if windows_encoding_remove_file "$windows_encoding_output" "$windows_encoding_output_identity"; then
            windows_encoding_output_cleanup_status=0
        else
            windows_encoding_output_cleanup_status=$?
            if [ "$windows_encoding_status" -eq 0 ]; then
                windows_encoding_status=$windows_encoding_output_cleanup_status
            fi
        fi
        return "$windows_encoding_status"
    fi
    if windows_encoding_verify_identity "$windows_encoding_input" "$windows_encoding_input_identity" 'before reading' &&
        windows_encoding_verify_identity "$windows_encoding_output" "$windows_encoding_output_identity" 'before reading' &&
        windows_encoding_require_existing_file "$windows_encoding_input" &&
        windows_encoding_require_existing_file "$windows_encoding_output"; then
        :
    else
        windows_encoding_status=$?
        if windows_encoding_remove_file "$windows_encoding_input" "$windows_encoding_input_identity"; then
            windows_encoding_input_cleanup_status=0
        else
            windows_encoding_input_cleanup_status=$?
            if [ "$windows_encoding_status" -eq 0 ]; then
                windows_encoding_status=$windows_encoding_input_cleanup_status
            fi
        fi
        if windows_encoding_remove_file "$windows_encoding_output" "$windows_encoding_output_identity"; then
            windows_encoding_output_cleanup_status=0
        else
            windows_encoding_output_cleanup_status=$?
            if [ "$windows_encoding_status" -eq 0 ]; then
                windows_encoding_status=$windows_encoding_output_cleanup_status
            fi
        fi
        return "$windows_encoding_status"
    fi
    windows_encoding_require_existing_file "$windows_encoding_output" || {
        windows_encoding_status=$?
        if windows_encoding_remove_file "$windows_encoding_input" "$windows_encoding_input_identity"; then
            windows_encoding_input_cleanup_status=0
        else
            windows_encoding_input_cleanup_status=$?
        fi
        if windows_encoding_remove_file "$windows_encoding_output" "$windows_encoding_output_identity"; then
            windows_encoding_output_cleanup_status=0
        else
            windows_encoding_output_cleanup_status=$?
        fi
        if [ "$windows_encoding_input_cleanup_status" -ne 0 ] ||
            [ "$windows_encoding_output_cleanup_status" -ne 0 ]; then
            return 2
        fi
        return "$windows_encoding_status"
    }
    cat "$windows_encoding_output"
    if windows_encoding_remove_file "$windows_encoding_input" "$windows_encoding_input_identity"; then
        windows_encoding_input_cleanup_status=0
    else
        windows_encoding_input_cleanup_status=$?
    fi
    if windows_encoding_remove_file "$windows_encoding_output" "$windows_encoding_output_identity"; then
        windows_encoding_output_cleanup_status=0
    else
        windows_encoding_output_cleanup_status=$?
    fi
    if [ "$windows_encoding_input_cleanup_status" -ne 0 ] ||
        [ "$windows_encoding_output_cleanup_status" -ne 0 ]; then
        return 2
    fi
}

# Windows remote command lines are TRUNCATED, not rejected, once they exceed the
# remote shell's limit -- and the limit depends on the shell sshd was configured
# with (measured on a real host: Git Bash 8,176 / cmd.exe 8,155 /
# powershell.exe 8,125).  The reparse-path hardening pushed the protocol probe's
# script to 3,216 characters, which encodes to an 8,658-character command line:
# over all three.  The base64 was cut mid-stream, PowerShell reported
# "TerminatorExpectedAtEndOfString", and every command on that host failed with
# a message that pointed at the deployment instead of at the client.
#
# So the script body does NOT go on the command line.  It is written to a
# protected temporary and fed to `powershell.exe ... -Command -` on stdin, which
# leaves a fixed 76-character command line regardless of how large the script
# grows.  Measured on the same host: 8,658 -> rc=1 with empty output (dead);
# 76 -> rc=0 with the correct token.
#
# The file is registered with the same identity-checked temporary machinery the
# Windows argument path uses, and run_platform_probe verifies that identity
# immediately before handing the file to ssh -- the protection is not bypassed.
make_windows_probe_script_file() {
    windows_probe_script_text=$1
    resolve_agentq_temp_directory || return $?
    # A Windows target runs TWO probes in sequence (platform, then protocol), and
    # both call this function.  Each call overwrites the global naming the
    # previous temporary, which would orphan it -- the EXIT trap can only clean
    # the file it still knows about.  Remove the previous one first.
    if [ -n "$platform_probe_stdin_file" ]; then
        windows_argument_remove_file "$platform_probe_stdin_file" "$platform_probe_stdin_identity" || return $?
        platform_probe_stdin_file=''
        platform_probe_stdin_identity=''
    fi
    platform_probe_stdin_file=$(mktemp "$agentq_temp_directory/agentq-probe-script.XXXXXX") || return 1
    platform_probe_stdin_identity=$(windows_argument_file_identity "$platform_probe_stdin_file") || {
        printf '%s: cannot record Windows probe script temporary identity\n' "$program" >&2
        windows_argument_remove_file "$platform_probe_stdin_file" ''
        platform_probe_stdin_file=''
        return 1
    }
    printf '%s' "$windows_probe_script_text" > "$platform_probe_stdin_file" || return 1
    windows_argument_require_existing_file "$platform_probe_stdin_file" || return $?
    windows_argument_verify_identity "$platform_probe_stdin_file" "$platform_probe_stdin_identity" 'after writing Windows probe script' || return $?
}

# The fixed command line: everything after this point is fed on stdin.
windows_probe_command_line() {
    printf '%s\n' "powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command -"
}

# Wrap a probe script so the exit status survives the REMOTE shell, not just
# PowerShell.  When sshd's DefaultShell is powershell.exe, an outer PowerShell
# flattens a native child's non-zero exit code to 1 (measured: inner 2/42/43/
# 44/45/124 all arrive as 1) -- which destroys the launcher's exit-code
# contract (42-45 distinguish missing / incompatible / unsafe / too-large).
# Git Bash and cmd.exe both pass it through unchanged.
#
# The fix is out of band: the script prints its token, then prints
# "agentq-exit:<code>", and the caller takes the code from stdout.  Measured on
# the same host: the token survived all three outer shells intact while only the
# exit-code column was flattened under the PowerShell outer shell.
windows_probe_script_with_exit_token() {
    windows_probe_script_body=$1
    # A probe signals failure with `exit N`.  That ends the whole script, so a
    # token line appended after the body would never run -- and under an outer
    # PowerShell the code would arrive flattened to 1 with nothing to recover it.
    # So every `exit N` in the body is rewritten to write the token AT the exit
    # site and then really exit.  The rewrite is textual and local to the body:
    # the probes' only `exit` calls are the contract codes, and the pattern is
    # anchored to `; exit <digits>` or a statement-initial `exit <digits>` so an
    # `exit` inside a string cannot match.
    #
    # The first version rewrote `exit N` to `$agentqProbeExit = N` and reported
    # the variable in a trailer.  That was measured wrong on 2026-10-06: an
    # assignment does NOT terminate, and the failure branches are sequential
    # `if` statements, not an if/else chain -- so a missing launcher fell through
    # every later check and the unconditional final `...-ready` write, and the
    # LAST code assigned (44, reparse-unsafe) won the token.  The client then
    # reported "protocol probe failed" + 44 instead of "deployment is
    # incomplete" + 2, and the 42/43 branches were unreachable.  Writing the
    # token before `exit` restores the original control flow exactly.
    windows_probe_rewritten_body=$(printf '%s' "$windows_probe_script_body" |
        sed -E 's/(^[[:space:]]*|;[[:space:]]*)exit ([0-9]+)/\1[Console]::Out.Write("agentq-exit:" + \2); exit \2/g')
    printf '%s\n' "$windows_probe_rewritten_body"
    # Reached only when the body completed without exiting: the success path.
    printf '%s\n' '[Console]::Out.Write("agentq-exit:0")'
    printf '%s\n' 'exit 0'
}

windows_probe_command() {
    windows_platform_script='$ProgressPreference = "SilentlyContinue"; [Console]::Out.Write("agentq-windows")'
    make_windows_probe_script_file "$(windows_probe_script_with_exit_token "$windows_platform_script")" || return $?
    windows_probe_prepared_command_line=$(windows_probe_command_line) || return $?
}

windows_agentq_protocol_probe_command() {
    # shellcheck disable=SC2016
    windows_protocol_script='$ProgressPreference = "SilentlyContinue"; $launcher = "C:\ProgramData\AgentQ\agentq-launcher.ps1"; function Test-NonReparseLauncherPath { param([string]$Path); if ([string]::IsNullOrWhiteSpace($Path)) { return $false }; try { $fullPath = [System.IO.Path]::GetFullPath($Path); $item = Get-Item -LiteralPath $fullPath -Force -ErrorAction Stop } catch { return $false }; if ($item.PSIsContainer -or (($item.Attributes -band [System.IO.FileAttributes]::ReparsePoint) -ne 0)) { return $false }; $parent = [System.IO.Directory]::GetParent($fullPath); while ($null -ne $parent) { $parentItem = Get-Item -LiteralPath $parent.FullName -Force -ErrorAction SilentlyContinue; if ($null -eq $parentItem -or !$parentItem.PSIsContainer -or (($parentItem.Attributes -band [System.IO.FileAttributes]::ReparsePoint) -ne 0)) { return $false }; $parent = $parent.Parent }; return $true }; $launcherItem = if ([string]::IsNullOrWhiteSpace($launcher)) { $null } else { Get-Item -LiteralPath $launcher -Force -ErrorAction SilentlyContinue }; if ([string]::IsNullOrWhiteSpace($launcher) -or ($null -eq $launcherItem)) { [Console]::Out.Write("agentq-windows-launcher-missing"); exit 42 }; if (!(Test-NonReparseLauncherPath -Path $launcher)) { [Console]::Out.Write("agentq-windows-launcher-invalid"); exit 44 }; $maximumLauncherBytes = 262144; $launcherStream = $null; try { $launcherStream = [System.IO.File]::Open($launcher, [System.IO.FileMode]::Open, [System.IO.FileAccess]::Read, [System.IO.FileShare]::Read); $launcherBytes = [byte[]]::new($maximumLauncherBytes + 1); $launcherOffset = 0; while ($launcherOffset -lt $launcherBytes.Length) { $readCount = $launcherStream.Read($launcherBytes, $launcherOffset, $launcherBytes.Length - $launcherOffset); if ($readCount -eq 0) { break }; $launcherOffset += $readCount } } catch { [Console]::Out.Write("agentq-windows-launcher-invalid"); exit 44 } finally { if ($null -ne $launcherStream) { $launcherStream.Dispose() } }; if ($launcherOffset -gt $maximumLauncherBytes) { [Console]::Out.Write("agentq-windows-launcher-too-large"); exit 45 }; try { if ($launcherOffset -ge 3 -and $launcherBytes[0] -eq 0xEF -and $launcherBytes[1] -eq 0xBB -and $launcherBytes[2] -eq 0xBF) { $launcherEncoding = [System.Text.UTF8Encoding]::new($true, $true); $launcherContentOffset = 3 } elseif ($launcherOffset -ge 2 -and $launcherBytes[0] -eq 0xFF -and $launcherBytes[1] -eq 0xFE) { $launcherEncoding = [System.Text.UnicodeEncoding]::new($false, $true, $true); $launcherContentOffset = 2 } elseif ($launcherOffset -ge 2 -and $launcherBytes[0] -eq 0xFE -and $launcherBytes[1] -eq 0xFF) { $launcherEncoding = [System.Text.UnicodeEncoding]::new($true, $true, $true); $launcherContentOffset = 2 } else { $launcherEncoding = [System.Text.UTF8Encoding]::new($false, $true); $launcherContentOffset = 0 }; $contents = $launcherEncoding.GetString($launcherBytes, $launcherContentOffset, $launcherOffset - $launcherContentOffset) } catch { [Console]::Out.Write("agentq-windows-launcher-invalid"); exit 44 }; if ($contents.IndexOf("ArgumentsBase64", [System.StringComparison]::Ordinal) -lt 0) { [Console]::Out.Write("agentq-windows-launcher-incompatible"); exit 43 }; [Console]::Out.Write("agentq-windows-launcher-ready")'
    make_windows_probe_script_file "$(windows_probe_script_with_exit_token "$windows_protocol_script")" || return $?
    windows_probe_prepared_command_line=$(windows_probe_command_line) || return $?
}

# Read a probe's status from its out-of-band token when it carries one.
#
# A Windows probe ends by printing "agentq-exit:<code>" (see
# windows_probe_script_with_exit_token).  That is authoritative, because the SSH
# exit code is flattened to 1 by an outer PowerShell when sshd's DefaultShell is
# powershell.exe.  When the token is absent the probe is not one of ours, so the
# SSH exit code stands.
# Sets: windows_probe_token_status, windows_probe_token_output.
windows_probe_apply_exit_token() {
    windows_probe_token_ssh_status=$1
    windows_probe_token_raw=$2
    windows_probe_token_status=$windows_probe_token_ssh_status
    windows_probe_token_output=$windows_probe_token_raw
    case "$windows_probe_token_raw" in
        *agentq-exit:*)
            windows_probe_token_code=${windows_probe_token_raw##*agentq-exit:}
            windows_probe_token_code=${windows_probe_token_code%%[!0-9]*}
            # At most three digits (protocol codes are 0-255); a longer token
            # cannot be one of ours and is ignored exactly like a missing one.
            # 256-999 are also not protocol codes and fold on return/exit
            # (256 reads 0 under bash and dash, measured 2026-10-13) -- same
            # rejection as the operation-path parser above.
            if [ "${#windows_probe_token_code}" -gt 3 ]; then
                windows_probe_token_code=''
            fi
            case "$windows_probe_token_code" in
                2[5-9][0-9]|[3-9][0-9][0-9])
                    windows_probe_token_code=''
                    ;;
            esac
            if [ -n "$windows_probe_token_code" ]; then
                windows_probe_token_status=$windows_probe_token_code
                windows_probe_token_output=${windows_probe_token_raw%agentq-exit:*}
            fi
            ;;
    esac
}

probe_native_windows_platform() {
    windows_probe_command || {
        printf '%s: cannot encode the Windows PowerShell platform probe; iconv and base64 are required\n' "$program" >&2
        return 2
    }
    windows_platform_command=$windows_probe_prepared_command_line
    if windows_platform_output=$(run_platform_probe_with_recovery "$windows_platform_command" "$platform_probe_stdin_file"); then
        windows_platform_ssh_status=0
    else
        windows_platform_ssh_status=$?
    fi
    windows_probe_apply_exit_token "$windows_platform_ssh_status" "$windows_platform_output"
    windows_platform_status=$windows_probe_token_status
    windows_platform_output=$windows_probe_token_output

    if [ "$windows_platform_status" -eq 0 ] && [ "$windows_platform_output" = agentq-windows ]; then
        remote_platform=windows
        return 0
    fi
    if [ "$windows_platform_status" -eq 0 ]; then
        printf '%s: native Windows platform probe returned an unexpected response\n' "$program" >&2
        return 2
    fi

    printf '%s: native Windows platform probe failed after a Windows shell was detected\n' "$program" >&2
    return "$windows_platform_status"
}

probe_windows_agentq_protocol() {
    windows_agentq_protocol_probe_command || {
        printf '%s: cannot encode the Windows AgentQ protocol probe; iconv and base64 are required\n' "$program" >&2
        return 2
    }
    windows_protocol_command=$windows_probe_prepared_command_line
    if windows_protocol_output=$(run_platform_probe_with_recovery "$windows_protocol_command" "$platform_probe_stdin_file"); then
        windows_protocol_ssh_status=0
    else
        windows_protocol_ssh_status=$?
    fi
    windows_probe_apply_exit_token "$windows_protocol_ssh_status" "$windows_protocol_output"
    windows_protocol_status=$windows_probe_token_status
    windows_protocol_output=$windows_probe_token_output

    if [ "$windows_protocol_status" -eq 0 ] && [ "$windows_protocol_output" = agentq-windows-launcher-ready ]; then
        return 0
    fi
    if [ "$windows_protocol_status" -eq 42 ] && [ "$windows_protocol_output" = agentq-windows-launcher-missing ]; then
        printf '%s: remote Windows AgentQ deployment is incomplete: C:/ProgramData/AgentQ/agentq-launcher.ps1 is missing; upgrade AgentQ on %s before using it\n' \
            "$program" "$host" >&2
        return 2
    fi
    if [ "$windows_protocol_status" -eq 43 ] && [ "$windows_protocol_output" = agentq-windows-launcher-incompatible ]; then
        printf '%s: remote Windows AgentQ deployment is incompatible: C:/ProgramData/AgentQ/agentq-launcher.ps1 does not support the ArgumentsBase64 protocol; upgrade AgentQ on %s before using it\n' \
            "$program" "$host" >&2
        return 2
    fi

    # A mismatched response with SSH status 0 is still a protocol failure.
    # Returning the 0 verbatim made the probe advisory: the message printed and
    # the command ran anyway (measured 2026-10-06).  The platform probe next
    # door already fails closed here; this aligns the two.  Nonzero statuses
    # (44/45/124) still propagate for their callers' diagnostics.
    if [ "$windows_protocol_status" -eq 0 ]; then
        windows_protocol_status=2
    fi
    # The launcher probe is the FIRST ssh call when AGENTQ_REMOTE_PLATFORM=windows
    # is set explicitly, so a launch failure surfaces here rather than at the
    # platform-probe branch -- measured 2026-10-30: exit 126/127 with "native
    # Windows AgentQ service protocol probe failed on <host>", which points the
    # operator at the remote deployment for a local misconfiguration.
    refuse_unlaunchable_ssh_binary "$windows_protocol_status"
    printf '%s: native Windows AgentQ service protocol probe failed on %s\n' "$program" "$host" >&2
    return "$windows_protocol_status"
}

# The platform cache answers ONE question: which platform did this host
# resolve to last time auto-detection succeeded?  Stored at
# $HOME/.config/agentq/platform-cache/<safe-host>.json as
# {"platform":"unix"|"windows","probed_at":<epoch>,"probe_ms":<n>}.
# A cache hit replaces the PLATFORM probe only.  The launcher-protocol probe
# still runs on every windows invocation: initialize_remote_invocation calls
# probe_windows_agentq_protocol unconditionally once the platform is known,
# and platform_cache_write fires before it -- so an entry is not proof that
# the launcher answered.  That is deliberate (fail-closed): a host whose
# launcher broke after the cache was written must be re-checked, not trusted.
# (An earlier comment here claimed the entry already included the launcher
# verdict; the code never did.  Corrected 2026-10-22.)  Bypasses: AGENTQ_REMOTE_PLATFORM set
# explicitly (never reaches auto), AGENTQ_PLATFORM_PROBE_CACHE=off, an
# unparsable/expired entry (falls through to probing), and any filesystem
# hiccup (cache problems must never break a working command -- a cache that
# cannot be read is indistinguishable from an empty one).
platform_probe_cache_ttl=${AGENTQ_PLATFORM_PROBE_CACHE_TTL:-604800}
platform_cache_enabled() {
    # Normalised like AGENTQ_REMOTE_PLATFORM, not enumerated: PS `-eq "off"` is
    # case-insensitive by language rule, so the Windows twin disables the cache
    # for every case shape of "off" -- a hand-written list of the 8 spellings
    # was one short (OfF enabled here, disabled there).  One canonical form
    # cannot drift again.
    platform_cache_switch=$(printf '%s' "${AGENTQ_PLATFORM_PROBE_CACHE:-on}" | tr '[:upper:]' '[:lower:]')
    case "$platform_cache_switch" in
        off) return 1 ;;
        *) return 0 ;;
    esac
}

platform_cache_path_for_host() {
    # The cache file is named by a hash of the WHOLE host string.  Hashing the
    # sanitized form instead (the first version did) collapses distinct hosts
    # onto one file -- `a-b`, `a:b`, `a@b`, `a b` and `a,b` all sanitize to
    # `a-b` -- so two hosts could share a verdict, and `AGENTQ_HOST` is user
    # input.  Only the hash reaches the path, so no character can escape the
    # directory.  The digest also needs a fallback: `shasum` is a Perl script
    # that minimal Linux images ship without, and a failed pipeline here used
    # to yield an empty hash (the pipeline's status is `cut`'s, which succeeds),
    # collapsing EVERY host onto `<dir>/platform-cache/.json`.
    platform_cache_digest=''
    if command -v shasum >/dev/null 2>&1; then
        platform_cache_digest=$(printf '%s' "$host" | LC_ALL=C shasum -a 256 2>/dev/null | cut -c1-16)
    elif command -v sha256sum >/dev/null 2>&1; then
        platform_cache_digest=$(printf '%s' "$host" | LC_ALL=C sha256sum 2>/dev/null | cut -c1-16)
    elif command -v openssl >/dev/null 2>&1; then
        platform_cache_digest=$(printf '%s' "$host" | LC_ALL=C openssl dgst -sha256 2>/dev/null | sed 's/.*[ =]//' | cut -c1-16)
    fi
    case "$platform_cache_digest" in
        [0-9a-f][0-9a-f]*) ;;
        # No usable digest tool: skip the cache entirely rather than let every
        # host share one file.  Returning a failure here is a cache MISS by
        # contract (the caller falls through to probing), never a command error.
        *) return 1 ;;
    esac
    printf '%s/platform-cache/%s.json' "$cache_state_directory" "$platform_cache_digest"
}

platform_cache_read() {
    platform_cache_enabled || return 1
    case "$remote_platform" in
        auto) ;;
        *) return 1 ;;
    esac
    platform_cache_file=$(platform_cache_path_for_host) || return 1
    [ -f "$platform_cache_file" ] && [ ! -L "$platform_cache_file" ] || return 1
    platform_cache_platform=$(LC_ALL=C sed -n 's/.*"platform":"\([a-z]*\)".*/\1/p' "$platform_cache_file" | tail -n 1)
    case "$platform_cache_platform" in
        unix|windows) ;;
        *) return 1 ;;
    esac
    platform_cache_age=$(LC_ALL=C sed -n 's/.*"probed_at":\([0-9]*\).*/\1/p' "$platform_cache_file" | tail -n 1)
    # is_bounded_positive_integer, not a bare charset test: a leading-zero
    # value passes `[ !0-9 ]` and `[ -le ]` (test parses decimal), then dies
    # INSIDE `$((now - age))` -- dash parses `0…` as octal, "Illegal number:
    # 0179…" is fatal, and the whole client exits 2 with a syntax-error-looking
    # message on EVERY command until the file is removed (measured 2026-10-21).
    # The bound (2147483647) also rejects absurd future timestamps into a
    # graceful cache miss.  Same validator the cache TTL env var uses.
    is_bounded_positive_integer "$platform_cache_age" || return 1
    platform_cache_now=$(date +%s) || return 1
    case "$platform_cache_now" in
        ''|*[!0-9]*) return 1 ;;
    esac
    # A timestamp from the future (clock skew, or an entry written by a machine
    # whose clock was ahead) must not make the entry immortal: with only the
    # `-le ttl` test, now - probed_at is negative and always passes.
    [ "$platform_cache_age" -le "$platform_cache_now" ] || return 1
    [ $((platform_cache_now - platform_cache_age)) -le "$platform_probe_cache_ttl" ] || return 1
    remote_platform=$platform_cache_platform
    return 0
}

platform_cache_write() {
    # Called after a successful probe resolution only.  Failures here are
    # non-fatal: a cache we cannot write simply means every run probes again,
    # which is the pre-cache behaviour.
    platform_cache_enabled || return 0
    platform_cache_file=$(platform_cache_path_for_host) || return 0
    # 0700/0600 like every other client-made file: the default umask (usually
    # 022) would leave the directory world-readable and the entry world-writable
    # path if the dir is shared, and a plain `>` would follow a pre-planted
    # symlink at the entry path (the read side already refuses symlinks).  The
    # write is atomic (temp + mv) so a concurrent reader never sees a partial
    # line; a failure at any step just means "no cache".
    if (umask 077; mkdir -p -- "${platform_cache_file%/*}") 2>/dev/null; then
        platform_cache_now=$(date +%s) || platform_cache_now=0
        platform_cache_temporary=$(umask 077; mktemp "${platform_cache_file}.XXXXXX" 2>/dev/null) || return 0
        if [ -L "$platform_cache_temporary" ]; then
            rm -f -- "$platform_cache_temporary" 2>/dev/null || true
            return 0
        fi
        if printf '{"platform":"%s","probed_at":%s,"probe_ms":0}\n' \
            "$remote_platform" "$platform_cache_now" > "$platform_cache_temporary" 2>/dev/null &&
            [ ! -L "$platform_cache_file" ] &&
            mv -f -- "$platform_cache_temporary" "$platform_cache_file" 2>/dev/null; then
            :
        else
            rm -f -- "$platform_cache_temporary" 2>/dev/null || true
        fi
    fi
    return 0
}

initialize_remote_platform_by_probe() {
    case "$remote_platform" in
        auto) ;;
        *) return 0 ;;
    esac
    if local_platform_output=$(run_platform_probe_with_recovery 'uname -s 2>/dev/null'); then
        local_platform_status=0
    else
        local_platform_status=$?
    fi
    case "$local_platform_output" in
        MINGW*|MSYS*|CYGWIN*)
            probe_native_windows_platform || return $?
            platform_cache_write
            return 0
            ;;
        Linux*|Darwin*)
            remote_platform=unix
            platform_cache_write
            return 0
            ;;
    esac
    # 255 is OpenSSH's own failure code: by the time the local probe returns it,
    # either the recovery loop has already spent its whole transport-retry budget
    # (it re-runs only classified transport failures, and returns 255 when the
    # budget is gone) or ssh failed for a reason the Windows probe would hit
    # identically -- authentication, host key, name resolution.  Running the
    # Windows probe next would spend a SECOND full budget against the same wall
    # (~70s with the default six attempts) and could not change the diagnosis.
    # Deliberately NOT applied to 124: a probe timeout on a slow host says
    # nothing about the platform, and that probe is the only way to find out.
    if [ "$local_platform_status" -eq 255 ]; then
        printf '%s: unable to detect the remote platform: the SSH connection failed before the probe could complete\n' "$program" >&2
        return 255
    fi
    windows_probe_command || fail 'cannot encode the Windows PowerShell platform probe; iconv and base64 are required'
    windows_platform_command=$windows_probe_prepared_command_line
    if windows_platform_output=$(run_platform_probe_with_recovery "$windows_platform_command" "$platform_probe_stdin_file"); then
        windows_platform_status=0
    else
        windows_platform_status=$?
    fi
    # The probe reports its status through an out-of-band
    # "agentq-exit:<code>" token, because an outer PowerShell
    # flattens the SSH exit code.  Strip it before comparing the
    # payload; the MINGW branch above already does this.
    windows_probe_apply_exit_token "$windows_platform_status" "$windows_platform_output"
    windows_platform_status=$windows_probe_token_status
    windows_platform_output=$windows_probe_token_output
    if [ "$windows_platform_status" -eq 0 ] && [ "$windows_platform_output" = agentq-windows ]; then
        remote_platform=windows
        # Written here, BEFORE the launcher-protocol probe that
        # initialize_remote_invocation runs next: the entry caches only the
        # platform verdict, and the launcher probe re-runs on every windows
        # invocation (see the platform_cache_read header).
        platform_cache_write
        return 0
    elif [ "$local_platform_status" -ne 0 ] && [ "$windows_platform_status" -ne 0 ]; then
        refuse_unlaunchable_ssh_binary "$local_platform_status"
        printf '%s: unable to detect the remote platform; set AGENTQ_REMOTE_PLATFORM to unix or windows only when the target is known\n' "$program" >&2
        return "$local_platform_status"
    else
        # The probe output is remote-controlled.  Print it as a
        # single charset-limited token -- first line, ASCII word
        # characters only, capped -- so it can never inject ANSI
        # sequences, extra lines, or a forged line-initial
        # "agentq:" prefix.  Measured 2026-10-06: a remote whose
        # uname-probe stdout was "FreeBSD\n\033[2Jagentq: remote
        # failure reason: lock_contention" made this message
        # forge a line byte-identical to our own reason output.
        #
        # POSIX parameter expansion only: this file is #!/bin/sh
        # and on Debian/Ubuntu /bin/sh is dash, which dies with
        # `Bad substitution` on the `$'\n'`, `${x//pat/}` and
        # `${x:0:N}` forms this used to use -- the shell died
        # BEFORE the printf, so an operator on those hosts saw a
        # raw shell error instead of the diagnostic.  Measured
        # 2026-10-12 (dash exit 2, no message; macOS /bin/sh --
        # bash -- printed it fine, which is why the two forms
        # could coexist until now).  `smoke/05`'s
        # unsupported-platform case probes for a strict POSIX
        # shell and pins both the exit code and the message.
        local_platform_hint=$(printf '%s\n' "$local_platform_output" |
            LC_ALL=C sed -n 's/[^A-Za-z0-9_.-]//g; p; q' | cut -c1-32)
        printf '%s: unsupported or undetectable remote platform (probe reported: %s)\n' "$program" "${local_platform_hint:-empty}" >&2
        return 2
    fi
}

initialize_remote_invocation() {
    resolve_agentq_temp_directory || return $?
    case "$remote_platform" in
        auto)
            # Cache first: a probe costs one full SSH round trip (plus the
            # measured 30s budget on slow Windows hosts), and the resolved
            # platform of a given host does not change between calls.  The
            # cache records the FINAL platform verdict (unix, or windows plus
            # a passing launcher-protocol verdict), so a hit skips BOTH
            # probes.  AGENTQ_REMOTE_PLATFORM (explicit) and
            # AGENTQ_PLATFORM_PROBE_CACHE=off bypass it.
            #
            # There is NO invalidation path: a hit is trusted until the TTL
            # expires.  A target redeployed onto the other platform therefore
            # fails until then (the windows branch below still runs its
            # launcher probe and fails closed; a stale `unix` verdict fails on
            # the response), which is why the recovery is documented as an
            # explicit action -- set AGENTQ_REMOTE_PLATFORM, or turn the cache
            # off, or delete the entry -- rather than an automatic fallback.
            # An earlier comment here claimed a failed run "also invalidates
            # the entry"; no code did that (measured 2026-10-16).
            if platform_cache_read; then
                :
            else
                initialize_remote_platform_by_probe
            fi
            ;;
        unix|windows)
            ;;
        *)
            fail 'AGENTQ_REMOTE_PLATFORM must be auto, unix, or windows'
            ;;
    esac

    if [ "$remote_platform" = windows ]; then
        probe_windows_agentq_protocol || return $?
    fi

    case "$remote_platform" in
        unix)
            # shellcheck disable=SC2016
            # `agentq_run` honours AGENTQ_WAIT_BUDGET when the caller set it:
            # the wait path prepends `AGENTQ_WAIT_BUDGET=<N>s; ` to the command
            # (see run_wait_ssh_with_timeout) so the REMOTE wait is bounded by
            # coreutils `timeout` and dies with the budget instead of living
            # until the task ends -- measured 2026-10-28 over a real sshd: an
            # unbounded remote wait survives killing the local ssh and a
            # polling caller accumulates one per poll.  The orphan does not
            # hold the server's operation lock (`wait_for_task` releases it
            # before `pueue wait`); what it holds is a process and a pueued
            # connection.  `command -v` degrades to a local-only bound -- the
            # shape Windows targets already have -- when the target ships no
            # timeout (macOS has none by default, and a non-interactive ssh
            # PATH may miss a Homebrew one).  Every other operation leaves the
            # variable unset, so this is inert for them.
            remote_base_command='agentq_run() { agentq_server="$HOME/.local/bin/agentq"; if [ -n "$AGENTQ_WAIT_BUDGET" ] && command -v timeout >/dev/null 2>&1; then exec timeout "$AGENTQ_WAIT_BUDGET" "$agentq_server" "$@"; fi; exec "$agentq_server" "$@"; }; agentq_run'
            remote_command=$remote_base_command
            ;;
        windows)
            remote_argument_file=$(mktemp "$agentq_temp_directory/agentq-arguments.XXXXXX") || fail 'cannot create a temporary Windows argument stream'
            remote_argument_file_identity=$(windows_argument_file_identity "$remote_argument_file") || {
                printf '%s: cannot record Windows argument temporary identity: %s\n' "$program" "$remote_argument_file" >&2
                windows_argument_status=1
                if windows_argument_remove_file "$remote_argument_file" "$remote_argument_file_identity"; then
                    windows_argument_cleanup_status=0
                else
                    windows_argument_cleanup_status=$?
                    if [ "$windows_argument_status" -eq 0 ]; then
                        windows_argument_status=$windows_argument_cleanup_status
                    fi
                fi
                return "$windows_argument_status"
            }
            windows_argument_require_file "$remote_argument_file" || return $?
            remote_base_command=''
            remote_command=''
            ;;
    esac
}

reset_windows_argument_stream() {
    [ "$remote_platform" = windows ] || return 0
    windows_argument_require_file "$remote_argument_file" || return $?
    windows_argument_verify_identity "$remote_argument_file" "$remote_argument_file_identity" 'before reset' || return $?
    : > "$remote_argument_file"
    windows_argument_require_file "$remote_argument_file" || return $?
    windows_argument_verify_identity "$remote_argument_file" "$remote_argument_file_identity" 'after reset' || return $?
    remote_input_file=''
    remote_input_file_identity=''
}

build_windows_remote_command() {
    [ -n "$remote_argument_file" ] || fail 'internal error: Windows argument stream is unavailable'
    resolve_agentq_temp_directory || return $?
    windows_argument_require_file "$remote_argument_file" || return $?
    windows_argument_verify_identity "$remote_argument_file" "$remote_argument_file_identity" 'before Base64 input' || return $?
    remote_input_file=$(mktemp "$agentq_temp_directory/agentq-windows-arguments.XXXXXX") || fail 'cannot create a temporary Windows argument payload'
    remote_input_file_identity=$(windows_argument_file_identity "$remote_input_file") || {
        printf '%s: cannot record Windows argument payload identity: %s\n' "$program" "$remote_input_file" >&2
        # drop tracking: cleanup refuses an unattributable temporary (see run_ssh_logged)
        remote_input_file=''
        windows_argument_status=1
        if windows_argument_remove_file "$remote_input_file" "$remote_input_file_identity"; then
            windows_argument_cleanup_status=0
        else
            windows_argument_cleanup_status=$?
            if [ "$windows_argument_status" -eq 0 ]; then
                windows_argument_status=$windows_argument_cleanup_status
            fi
        fi
        remote_input_file=''
        remote_input_file_identity=''
        return "$windows_argument_status"
    }
    if windows_argument_require_file "$remote_input_file"; then
        :
    else
        windows_argument_status=$?
        if windows_argument_remove_file "$remote_input_file" "$remote_input_file_identity"; then
            windows_argument_cleanup_status=0
        else
            windows_argument_cleanup_status=$?
            if [ "$windows_argument_status" -eq 0 ]; then
                windows_argument_status=$windows_argument_cleanup_status
            fi
        fi
        remote_input_file=''
        remote_input_file_identity=''
        return "$windows_argument_status"
    fi
    windows_argument_require_existing_file "$remote_argument_file" || return $?
    base64 < "$remote_argument_file" > "$remote_input_file" || fail 'cannot encode the Windows argument stream'
    windows_argument_require_file "$remote_argument_file" || return $?
    windows_argument_require_file "$remote_input_file" || return $?
    windows_argument_verify_identity "$remote_argument_file" "$remote_argument_file_identity" 'after Base64 input' || return $?
    windows_argument_verify_identity "$remote_input_file" "$remote_input_file_identity" 'after Base64 output' || return $?
    [ -s "$remote_input_file" ] || fail 'internal error: Windows argument stream is empty'
    # shellcheck disable=SC2016
    # Win32-OpenSSH can terminate a non-TTY stdin stream before PowerShell's
    # -File parameter binder receives the base64 payload. Use an encoded
    # wrapper that reads stdin explicitly, then invokes the protected launcher.
    windows_launcher_wrapper='$ProgressPreference = "SilentlyContinue"; $maximumArgumentPayloadCharacters = 1048576; $payloadStream = [Console]::OpenStandardInput(); $payloadBuilder = [System.Text.StringBuilder]::new(); while ($true) { $payloadReadByte = $payloadStream.ReadByte(); if ($payloadReadByte -lt 0) { break }; if (($payloadBuilder.Length + 1) -gt $maximumArgumentPayloadCharacters) { [Console]::Error.WriteLine("agentq: Windows argument payload exceeds $maximumArgumentPayloadCharacters characters"); [Console]::Error.WriteLine("agentq-exit:2"); exit 2 }; [void]$payloadBuilder.Append([char]$payloadReadByte) }; $payload = $payloadBuilder.ToString(); & "C:\ProgramData\AgentQ\agentq-launcher.ps1" -ArgumentsBase64 $payload; $launcherExitCode = Get-Variable -Name LASTEXITCODE -ErrorAction SilentlyContinue; if ($null -eq $launcherExitCode) { [Console]::Error.WriteLine("agentq-exit:1"); exit 1 }; $agentqLauncherExit = [int]$launcherExitCode.Value; [Console]::Error.WriteLine("agentq-exit:$agentqLauncherExit"); exit $agentqLauncherExit'
    windows_launcher_encoded=$(encode_windows_powershell "$windows_launcher_wrapper") || fail 'cannot encode the Windows AgentQ launcher wrapper; iconv and base64 are required'
    [ -n "$windows_launcher_encoded" ] || fail 'cannot encode the Windows AgentQ launcher wrapper'
    remote_command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand $windows_launcher_encoded"
}

make_client_temporary_file() {
    # mktemp honors $TMPDIR, which macOS points at /var/folders/... -- long, but
    # the client has no unix-socket path limit, so that is fine here.  The -t
    # form is deliberately NOT used: it is GNU-only, and this client must run on
    # BSD userlands too.  A fallback keeps the failure mode explicit rather than
    # silently redirecting ssh's stderr to a path nobody reads.
    client_temporary_directory=$1
    client_temporary_prefix=$2
    if [ -n "$client_temporary_directory" ] && [ -d "$client_temporary_directory" ]; then
        mktemp "$client_temporary_directory/$client_temporary_prefix.XXXXXX" 2>/dev/null && return 0
    fi
    mktemp "/tmp/$client_temporary_prefix.XXXXXX" 2>/dev/null && return 0
    printf '%s: cannot allocate a temporary file for %s\n' "$program" "$client_temporary_prefix" >&2
    return 1
}

run_ssh_logged() {
    ssh_log_file=$1
    ssh_remote_command=$2
    ssh_input_file=${3:-}

    # Clear the reason FIRST, before any early return.  This global carries the
    # controlled `reason=<class>` token the server sent on THIS ssh call, and
    # callers read it to classify a failure (retryable lock contention vs an
    # argument error).  The early returns below -- the log-file guards, the
    # Windows arg-identity check -- bail out WITHOUT reaching ssh, so if the
    # clear sat after them (its old position, mid-function) a retry that failed
    # a LOCAL guard would still carry the PREVIOUS attempt's reason and report
    # `remote failure reason: lock_contention` for a call that never contacted
    # the server (measured 2026-10-12: a retry loop's second attempt that failed
    # the local guard printed the first attempt's reason).  Clearing on entry
    # makes the value describe only the attempt that set it.
    agentq_remote_failure_reason_value=''

    agentq_ssh_log_require_file "$ssh_log_file" || return $?
    agentq_ssh_log_remove_file "$ssh_log_file" || return $?
    agentq_ssh_log_require_file "$ssh_log_file" || return $?
    # OpenSSH writes the remote command's stderr to the LOCAL stderr; -E carries
    # only ssh's own diagnostics.  Measured on macOS with a real sshd: a remote
    # `printf ... >&2` lands on the local stderr and the -E file gets nothing.
    # Without this capture the server's reason line would be discarded here --
    # which is exactly what happened before this fix.  Capture into a protected
    # file (umask 077), never echo it.
    ssh_stderr_capture=''
    ssh_stderr_capture_identity=''
    ssh_stderr_redirection='/dev/null'
    if ssh_stderr_capture=$(umask 077; make_client_temporary_file "${agentq_temp_directory:-$ssh_log_file}" 'agentq-ssh-stderr'); then
        ssh_stderr_redirection=$ssh_stderr_capture
        # Record the identity immediately.  windows_argument_remove_file refuses
        # to delete a temporary whose identity was never recorded, so skipping
        # this would make the file unremovable by cleanup_client_runtime -- the
        # opposite of what registering it there is for.  A capture we cannot
        # attribute is dropped rather than tracked, which keeps the old
        # /dev/null behaviour instead of leaking an unattributable file.
        if ! ssh_stderr_capture_identity=$(windows_argument_file_identity "$ssh_stderr_capture"); then
            ssh_stderr_capture_identity=''
            ssh_stderr_redirection='/dev/null'
            ssh_stderr_capture=''
        fi
    fi
    if [ -n "$ssh_input_file" ]; then
        agentq_ssh_input_require_file "$ssh_input_file" || return $?
        if [ "$remote_platform" = windows ]; then
            if windows_argument_expected_identity=$(windows_argument_identity_for_path "$ssh_input_file"); then
                windows_argument_verify_identity "$ssh_input_file" "$windows_argument_expected_identity" 'before SSH consumption' || return $?
            else
                printf '%s: refusing to consume an untracked Windows argument temporary: %s\n' "$program" "$ssh_input_file" >&2
                return 2
            fi
        fi
        agentq_ssh_input_require_existing_file "$ssh_input_file" || return $?
        if "$ssh_binary" \
            -E "$ssh_log_file" \
            -o LogLevel=ERROR \
            $ssh_credential_option_lines \
            -o ConnectTimeout=10 \
            -o ServerAliveInterval=15 \
            -o ServerAliveCountMax=12 \
            -o TCPKeepAlive=yes \
            -- "$host" "$ssh_remote_command" < "$ssh_input_file" 2>"$ssh_stderr_redirection"; then
            ssh_status=0
        else
            ssh_status=$?
        fi
    else
        if "$ssh_binary" \
            -E "$ssh_log_file" \
            -o LogLevel=ERROR \
            $ssh_credential_option_lines \
            -o ConnectTimeout=10 \
            -o ServerAliveInterval=15 \
            -o ServerAliveCountMax=12 \
            -o TCPKeepAlive=yes \
            -- "$host" "$ssh_remote_command" 2>"$ssh_stderr_redirection"; then
            ssh_status=0
        else
            ssh_status=$?
        fi
    fi

    agentq_remote_failure_reason_value=''
    if [ -n "$ssh_stderr_capture" ]; then
        if [ -s "$ssh_stderr_capture" ]; then
            if ssh_failure_reason=$(agentq_remote_failure_reason "$ssh_stderr_capture"); then
                agentq_remote_failure_reason_value=$ssh_failure_reason
            fi
            # On a Windows target the wrapper's out-of-band token is the
            # authoritative exit code: sshd with DefaultShell=powershell.exe
            # flattens every nonzero native exit to 1, so the SSH code loses the
            # 2/3/4/5/6 the recovery logic depends on.  The wrapper emits the
            # token for both DefaultShell values, and it agrees with the SSH
            # code whenever the SSH code is trustworthy, so preferring it is
            # safe; unix targets never emit it.
            if [ "$remote_platform" = windows ]; then
                if ssh_exit_token=$(agentq_remote_exit_token "$ssh_stderr_capture"); then
                    ssh_status=$ssh_exit_token
                fi
            fi
        fi
        # Identity-checked removal, like every other temporary in this file --
        # NOT `rm -f ... || true`.  That form was the one place a removal failure
        # was swallowed and never folded into the exit status.  cleanup_client_runtime
        # also removes this path, so a failure here is not fatal: it is reported,
        # folded into the exit status, and the variable is then cleared -- the
        # EXIT trap does NOT retry (comment used to claim it did; measured
        # 2026-10-13: 2943-2944 unconditionally clear the variable).
        if windows_argument_remove_file "$ssh_stderr_capture" "$ssh_stderr_capture_identity"; then
            :
        else
            ssh_stderr_capture_status=$?
            printf '%s: failed to remove the ssh stderr capture: %s\n' "$program" "$ssh_stderr_capture" >&2
            if [ "$ssh_status" -eq 0 ]; then
                ssh_status=$ssh_stderr_capture_status
            fi
        fi
        ssh_stderr_capture=''
        ssh_stderr_capture_identity=''
    fi
    agentq_ssh_log_require_file "$ssh_log_file" || return $?
    if [ -s "$ssh_log_file" ]; then
        agentq_ssh_log_require_file "$ssh_log_file" || return $?
        write_ssh_diagnostic_metadata "$ssh_log_file"
    fi
    # This is the single funnel every operation, submit and mutation call goes
    # through, so the launch refusal is placed here rather than at each caller's
    # diagnostic branch: measured 2026-10-30, `submit`/`cancel`/`remove` exited
    # 126/127 with NO stderr at all while `status` printed the misleading
    # platform advice.  It only fires on a status that is already 126/127 AND
    # when the local probe agrees, so a remote command that exits 127 (the
    # remote agentq-server is missing) is untouched.  See
    # refuse_unlaunchable_ssh_binary for the measurement and the boundary.
    refuse_unlaunchable_ssh_binary "$ssh_status"
    return "$ssh_status"
}

# Forward the controlled server reason class for a failed submit attempt,
# exactly as the read/mutation operation paths do (grep the two consumers of
# agentq_remote_failure_reason_value).  SKILL.md promises that BOTH clients
# forward this line; before this helper the submit recovery loop never read
# the global, so a caller could not distinguish a retryable lock rejection
# (reason=lock_contention) from an argument error on the command that hits
# lock contention most often.  Measured 2026-10-13: same stub fixture,
# cancel printed the reason, submit printed nothing.
agentq_submit_forward_reason() {
    if [ "$agentq_recovery_status" -ne 0 ] && [ -n "$agentq_remote_failure_reason_value" ]; then
        printf '%s: remote failure reason: %s\n' "$program" "$agentq_remote_failure_reason_value" >&2
    fi
}

run_submit_with_recovery() {
    agentq_recovery_request_id=$1
    agentq_recovery_submit_command=$2
    agentq_recovery_submit_input=$3
    agentq_recovery_lookup_command=$4
    agentq_recovery_lookup_input=$5
    agentq_recovery_attempt=0
    agentq_recovery_cleanup_failure_status=0
    resolve_agentq_temp_directory || return $?
    agentq_recovery_output_file=$(mktemp "$agentq_temp_directory/agentq-submit.XXXXXX") || {
        printf '%s: cannot create a temporary file for submit recovery\n' "$program" >&2
        return 2
    }
    recovery_output_require_file "$agentq_recovery_output_file" || return $?
    agentq_recovery_log_file=$(mktemp "$agentq_temp_directory/agentq-submit-log.XXXXXX") || {
        agentq_recovery_status=2
        if recovery_output_remove_file "$agentq_recovery_output_file"; then
            recovery_output_cleanup_status=0
        else
            recovery_output_cleanup_status=$?
            if [ "$agentq_recovery_status" -eq 0 ]; then
                agentq_recovery_status=$recovery_output_cleanup_status
            fi
        fi
        printf '%s: cannot create a temporary SSH log for submit recovery\n' "$program" >&2
        agentq_submit_forward_reason
        return "$agentq_recovery_status"
    }

    while :; do
        if run_submit_recovery_ssh "$agentq_recovery_submit_command" "$agentq_recovery_submit_input"; then
            if recovery_output_require_existing_file "$agentq_recovery_output_file" &&
                validate_json_response "$agentq_recovery_output_file" submit "$agentq_recovery_request_id"; then
                :
            else
                agentq_recovery_status=$?
                if recovery_output_remove_file "$agentq_recovery_output_file"; then
                    agentq_recovery_output_cleanup_status=0
                else
                    agentq_recovery_output_cleanup_status=$?
                    if [ "$agentq_recovery_status" -eq 0 ]; then
                        agentq_recovery_status=$agentq_recovery_output_cleanup_status
                    fi
                fi
                if agentq_ssh_log_remove_file "$agentq_recovery_log_file"; then
                    agentq_recovery_log_cleanup_status=0
                else
                    agentq_recovery_log_cleanup_status=$?
                    if [ "$agentq_recovery_status" -eq 0 ]; then
                        agentq_recovery_status=$agentq_recovery_log_cleanup_status
                    fi
                fi
                agentq_submit_forward_reason
                return "$agentq_recovery_status"
            fi
            recovery_output_require_existing_file "$agentq_recovery_output_file" || return $?
            cat "$agentq_recovery_output_file"
            if recovery_output_remove_file "$agentq_recovery_output_file"; then
                agentq_recovery_output_cleanup_status=0
            else
                agentq_recovery_output_cleanup_status=$?
            fi
            if agentq_ssh_log_remove_file "$agentq_recovery_log_file"; then
                agentq_recovery_log_cleanup_status=0
            else
                agentq_recovery_log_cleanup_status=$?
            fi
            if [ "$agentq_recovery_output_cleanup_status" -ne 0 ]; then
                return "$agentq_recovery_output_cleanup_status"
            fi
            if [ "$agentq_recovery_log_cleanup_status" -ne 0 ]; then
                return "$agentq_recovery_log_cleanup_status"
            fi
            return "$agentq_recovery_cleanup_failure_status"
        else
            agentq_recovery_status=$?
        fi

        if [ "$agentq_recovery_status" -ne 255 ] || ! ssh_transport_error "$agentq_recovery_log_file"; then
            if recovery_output_require_existing_file "$agentq_recovery_output_file"; then
                cat "$agentq_recovery_output_file"
            else
                agentq_recovery_status=$?
            fi
            if recovery_output_remove_file "$agentq_recovery_output_file"; then
                agentq_recovery_output_cleanup_status=0
            else
                agentq_recovery_output_cleanup_status=$?
                if [ "$agentq_recovery_status" -eq 0 ]; then
                    agentq_recovery_status=$agentq_recovery_output_cleanup_status
                fi
            fi
            if agentq_ssh_log_remove_file "$agentq_recovery_log_file"; then
                agentq_recovery_log_cleanup_status=0
            else
                agentq_recovery_log_cleanup_status=$?
                if [ "$agentq_recovery_status" -eq 0 ]; then
                    agentq_recovery_status=$agentq_recovery_log_cleanup_status
                fi
            fi
            agentq_submit_forward_reason
            return "$agentq_recovery_status"
        fi

        agentq_recovery_attempt=$((agentq_recovery_attempt + 1))
        if [ "$agentq_recovery_attempt" -gt "$submit_retry_attempts" ]; then
            if recovery_output_remove_file "$agentq_recovery_output_file"; then
                agentq_recovery_output_cleanup_status=0
            else
                agentq_recovery_output_cleanup_status=$?
                if [ "$agentq_recovery_status" -eq 0 ]; then
                    agentq_recovery_status=$agentq_recovery_output_cleanup_status
                fi
            fi
            if agentq_ssh_log_remove_file "$agentq_recovery_log_file"; then
                agentq_recovery_log_cleanup_status=0
            else
                agentq_recovery_log_cleanup_status=$?
                if [ "$agentq_recovery_status" -eq 0 ]; then
                    agentq_recovery_status=$agentq_recovery_log_cleanup_status
                fi
            fi
            printf '%s: SSH transport remained unavailable while submitting request %s; recover later with: %s --host %s lookup %s\n' \
                "$program" "$agentq_recovery_request_id" "$program" "$host" "$agentq_recovery_request_id" >&2
            agentq_submit_forward_reason
            return "$agentq_recovery_status"
        fi

        printf '%s: SSH transport lost while submitting request %s; reconciling attempt %s/%s...\n' \
            "$program" "$agentq_recovery_request_id" "$agentq_recovery_attempt" "$submit_retry_attempts" >&2
        sleep "$submit_retry_delay"

        if run_submit_recovery_ssh "$agentq_recovery_lookup_command" "$agentq_recovery_lookup_input"; then
            agentq_recovery_status=0
            if recovery_output_require_existing_file "$agentq_recovery_output_file" &&
                validate_json_response "$agentq_recovery_output_file" lookup "$agentq_recovery_request_id"; then
                :
            else
                agentq_recovery_status=$?
                if recovery_output_remove_file "$agentq_recovery_output_file"; then
                    agentq_recovery_output_cleanup_status=0
                else
                    agentq_recovery_output_cleanup_status=$?
                    if [ "$agentq_recovery_status" -eq 0 ]; then
                        agentq_recovery_status=$agentq_recovery_output_cleanup_status
                    fi
                fi
                if agentq_ssh_log_remove_file "$agentq_recovery_log_file"; then
                    agentq_recovery_log_cleanup_status=0
                else
                    agentq_recovery_log_cleanup_status=$?
                    if [ "$agentq_recovery_status" -eq 0 ]; then
                        agentq_recovery_status=$agentq_recovery_log_cleanup_status
                    fi
                fi
                agentq_submit_forward_reason
                return "$agentq_recovery_status"
            fi
            recovery_output_require_existing_file "$agentq_recovery_output_file" || return $?
            cat "$agentq_recovery_output_file"
            if recovery_output_remove_file "$agentq_recovery_output_file"; then
                agentq_recovery_output_cleanup_status=0
            else
                agentq_recovery_output_cleanup_status=$?
            fi
            if agentq_ssh_log_remove_file "$agentq_recovery_log_file"; then
                agentq_recovery_log_cleanup_status=0
            else
                agentq_recovery_log_cleanup_status=$?
            fi
            if [ "$agentq_recovery_output_cleanup_status" -eq 0 ]; then
                return "$agentq_recovery_log_cleanup_status"
            fi
            return "$agentq_recovery_output_cleanup_status"
        else
            agentq_recovery_status=$?
        fi

        if [ "$agentq_recovery_status" -eq 3 ] ||
            [ "$agentq_recovery_status" -eq 4 ] ||
            [ "$agentq_recovery_status" -eq 5 ]; then
            if recovery_output_require_existing_file "$agentq_recovery_output_file" &&
                validate_json_response "$agentq_recovery_output_file" lookup "$agentq_recovery_request_id"; then
                :
            else
                agentq_recovery_status=$?
                if recovery_output_remove_file "$agentq_recovery_output_file"; then
                    agentq_recovery_output_cleanup_status=0
                else
                    agentq_recovery_output_cleanup_status=$?
                    if [ "$agentq_recovery_status" -eq 0 ]; then
                        agentq_recovery_status=$agentq_recovery_output_cleanup_status
                    fi
                fi
                if agentq_ssh_log_remove_file "$agentq_recovery_log_file"; then
                    agentq_recovery_log_cleanup_status=0
                else
                    agentq_recovery_log_cleanup_status=$?
                    if [ "$agentq_recovery_status" -eq 0 ]; then
                        agentq_recovery_status=$agentq_recovery_log_cleanup_status
                    fi
                fi
                agentq_submit_forward_reason
                return "$agentq_recovery_status"
            fi
        fi

        if [ "$agentq_recovery_status" -eq 3 ]; then
            if recovery_output_remove_file "$agentq_recovery_output_file"; then
                agentq_recovery_output_cleanup_status=0
            else
                agentq_recovery_output_cleanup_status=$?
            fi
            if agentq_ssh_log_remove_file "$agentq_recovery_log_file"; then
                agentq_recovery_log_cleanup_status=0
            else
                agentq_recovery_log_cleanup_status=$?
            fi
            if [ "$agentq_recovery_output_cleanup_status" -ne 0 ]; then
                return "$agentq_recovery_output_cleanup_status"
            fi
            if [ "$agentq_recovery_log_cleanup_status" -ne 0 ]; then
                return "$agentq_recovery_log_cleanup_status"
            fi
            continue
        fi
        if [ "$agentq_recovery_status" -eq 4 ]; then
            if recovery_output_require_existing_file "$agentq_recovery_output_file"; then
                cat "$agentq_recovery_output_file"
            else
                agentq_recovery_status=$?
            fi
            if recovery_output_remove_file "$agentq_recovery_output_file"; then
                agentq_recovery_output_cleanup_status=0
            else
                agentq_recovery_output_cleanup_status=$?
                if [ "$agentq_recovery_status" -eq 0 ]; then
                    agentq_recovery_status=$agentq_recovery_output_cleanup_status
                fi
            fi
            if agentq_ssh_log_remove_file "$agentq_recovery_log_file"; then
                agentq_recovery_log_cleanup_status=0
            else
                agentq_recovery_log_cleanup_status=$?
                if [ "$agentq_recovery_status" -eq 0 ]; then
                    agentq_recovery_status=$agentq_recovery_log_cleanup_status
                fi
            fi
            agentq_submit_forward_reason
            return "$agentq_recovery_status"
        fi
        if [ "$agentq_recovery_status" -eq 5 ]; then
            if recovery_output_require_existing_file "$agentq_recovery_output_file"; then
                cat "$agentq_recovery_output_file"
            else
                agentq_recovery_status=$?
            fi
            if recovery_output_remove_file "$agentq_recovery_output_file"; then
                agentq_recovery_output_cleanup_status=0
            else
                agentq_recovery_output_cleanup_status=$?
                if [ "$agentq_recovery_status" -eq 0 ]; then
                    agentq_recovery_status=$agentq_recovery_output_cleanup_status
                fi
            fi
            if agentq_ssh_log_remove_file "$agentq_recovery_log_file"; then
                agentq_recovery_log_cleanup_status=0
            else
                agentq_recovery_log_cleanup_status=$?
                if [ "$agentq_recovery_status" -eq 0 ]; then
                    agentq_recovery_status=$agentq_recovery_log_cleanup_status
                fi
            fi
            agentq_submit_forward_reason
            return "$agentq_recovery_status"
        fi
        if [ "$agentq_recovery_status" -eq 255 ] && ssh_transport_error "$agentq_recovery_log_file"; then
            if recovery_output_remove_file "$agentq_recovery_output_file"; then
                agentq_recovery_output_cleanup_status=0
            else
                agentq_recovery_output_cleanup_status=$?
                if [ "$agentq_recovery_cleanup_failure_status" -eq 0 ]; then
                    agentq_recovery_cleanup_failure_status=$agentq_recovery_output_cleanup_status
                fi
            fi
            if agentq_ssh_log_remove_file "$agentq_recovery_log_file"; then
                agentq_recovery_log_cleanup_status=0
            else
                agentq_recovery_log_cleanup_status=$?
                if [ "$agentq_recovery_cleanup_failure_status" -eq 0 ]; then
                    agentq_recovery_cleanup_failure_status=$agentq_recovery_log_cleanup_status
                fi
            fi
            continue
        fi

        if recovery_output_require_existing_file "$agentq_recovery_output_file"; then
            cat "$agentq_recovery_output_file"
        else
            agentq_recovery_status=$?
        fi
        if recovery_output_remove_file "$agentq_recovery_output_file"; then
            agentq_recovery_output_cleanup_status=0
        else
            agentq_recovery_output_cleanup_status=$?
            if [ "$agentq_recovery_status" -eq 0 ]; then
                agentq_recovery_status=$agentq_recovery_output_cleanup_status
            fi
        fi
        if agentq_ssh_log_remove_file "$agentq_recovery_log_file"; then
            agentq_recovery_log_cleanup_status=0
        else
            agentq_recovery_log_cleanup_status=$?
            if [ "$agentq_recovery_status" -eq 0 ]; then
                agentq_recovery_status=$agentq_recovery_log_cleanup_status
            fi
        fi
        agentq_submit_forward_reason
        return "$agentq_recovery_status"
    done
}

run_safe_operation_with_recovery() {
    agentq_operation_name=$1
    agentq_operation_command=$2
    agentq_operation_input=$3
    agentq_operation_request_id=${4:-}
    agentq_operation_expected_task_id=${5:-}
    # The validation profile: usually the operation name, but the status and
    # doctor modes answer with shapes of their own, so their call sites pass it
    # explicitly rather than weakening the shared filter.
    agentq_operation_profile=${6:-$1}
    agentq_operation_attempt=0
    resolve_agentq_temp_directory || return $?
    agentq_operation_output_file=$(mktemp "$agentq_temp_directory/agentq-operation.XXXXXX") || {
        printf '%s: cannot create a temporary file for %s recovery\n' "$program" "$agentq_operation_name" >&2
        return 2
    }
    operation_output_require_file "$agentq_operation_output_file" || return $?
    agentq_operation_log_file=$(mktemp "$agentq_temp_directory/agentq-operation-log.XXXXXX") || {
        agentq_operation_status=2
        if operation_output_remove_file "$agentq_operation_output_file"; then
            operation_output_cleanup_status=0
        else
            operation_output_cleanup_status=$?
        fi
        printf '%s: cannot create a temporary SSH log for %s recovery\n' "$program" "$agentq_operation_name" >&2
        return "$agentq_operation_status"
    }

    while :; do
        # Every runner call sits in its own if/else: under `set -e` a bare
        # call returning non-zero trips errexit before `$?` can be captured
        # (measured 2026-10-15: 124 from a timed-out wait exited the shell
        # through the EXIT trap), and an `elif` whose condition is a function
        # call is NOT exempt on this bash either (a 255 killed the shell
        # before the else branch could capture it -- measured the same day).
        agentq_operation_status=0
        if [ "$agentq_operation_name" = wait ] && [ -n "$wait_timeout_seconds" ]; then
            if run_wait_ssh_with_timeout "$agentq_operation_command" "$agentq_operation_input"; then
                :
            else
                agentq_operation_status=$?
            fi
            if [ "$agentq_operation_status" -eq 124 ]; then
                # The budget elapsed while the task is still running.  Exit 6
                # is the contract's "final state could not be confirmed"
                # class -- a timed-out wait is exactly that, not an error and
                # not retryable.  Both temporaries are already removed inside
                # run_wait_ssh_with_timeout.
                printf '%s: wait budget of %s seconds elapsed; task %s may still be running\n' \
                    "$program" "$wait_timeout_seconds" "${agentq_operation_expected_task_id:-?}" >&2
                return 6
            fi
        else
            if run_operation_ssh "$agentq_operation_command" "$agentq_operation_input"; then
                :
            else
                agentq_operation_status=$?
            fi
        fi
        # A transport loss must reach the retry check below WITHOUT passing
        # through the gate's else, which overwrites the status with `$?` --
        # by then `$?` is the failed `[` test's 1, not the runner's 255
        # (measured 2026-10-15: ssh exit 255 arrived at the caller as 1 and
        # the transport retry never ran).  Head straight to the retry check.
        if [ "$agentq_operation_status" -eq 255 ]; then
            :
        elif [ "$agentq_operation_status" -eq 0 ]; then
            # Capture the validation result IMMEDIATELY: the gate's else below
            # cannot read `$?` for this, because by the time the else runs, `$?`
            # is the failed `[` test's 1, not the validation's code (measured
            # 2026-10-15: a lock-rejected status 2 surfaced to the caller as 1).
            if operation_output_require_existing_file "$agentq_operation_output_file" &&
                validate_json_response "$agentq_operation_output_file" "$agentq_operation_profile" "$agentq_operation_request_id" "$agentq_operation_expected_task_id"; then
                if [ "$agentq_operation_name" = wait ]; then
                    if validate_wait_response "$agentq_operation_output_file" 0 "$agentq_operation_expected_task_id"; then
                        :
                    else
                        agentq_operation_status=$?
                        if operation_output_remove_file "$agentq_operation_output_file"; then
                            :
                        else
                            operation_output_cleanup_status=$?
                            if [ "$agentq_operation_status" -eq 0 ]; then
                                agentq_operation_status=$operation_output_cleanup_status
                            fi
                        fi
                        if agentq_ssh_log_remove_file "$agentq_operation_log_file"; then
                            :
                        else
                            operation_log_cleanup_status=$?
                            if [ "$agentq_operation_status" -eq 0 ]; then
                                agentq_operation_status=$operation_log_cleanup_status
                            fi
                        fi
                        return "$agentq_operation_status"
                    fi
                fi
                :
            else
                # The response failed protocol validation (or the output file
                # vanished).  Capture `$?` here, where it is still the
                # validation's rc, NOT in the gate's else below (there `$?` is
                # the failed gate test's 1 -- measured 2026-10-15).
                # (`agentq_operation_validated` used to be assigned in both
                # arms of this if and was never read; removed 2026-10-18 after
                # the linter's unused-variable rule flagged it -- a comment
                # describing a variable that no longer exists is how a dead
                # mechanism stays looking alive.)
                agentq_operation_status=$?
                if operation_output_remove_file "$agentq_operation_output_file"; then
                    :
                else
                    operation_output_cleanup_status=$?
                    if [ "$agentq_operation_status" -eq 0 ]; then
                        agentq_operation_status=$operation_output_cleanup_status
                    fi
                fi
                if agentq_ssh_log_remove_file "$agentq_operation_log_file"; then
                    :
                else
                    operation_log_cleanup_status=$?
                    if [ "$agentq_operation_status" -eq 0 ]; then
                        agentq_operation_status=$operation_log_cleanup_status
                    fi
                fi
                return "$agentq_operation_status"
            fi
            operation_output_require_existing_file "$agentq_operation_output_file" || return $?
            cat "$agentq_operation_output_file"
            if operation_output_remove_file "$agentq_operation_output_file"; then
                agentq_operation_output_cleanup_status=0
            else
                agentq_operation_output_cleanup_status=$?
            fi
            if agentq_ssh_log_remove_file "$agentq_operation_log_file"; then
                agentq_operation_log_cleanup_status=0
            else
                agentq_operation_log_cleanup_status=$?
            fi
            if [ "$agentq_operation_output_cleanup_status" -eq 0 ]; then
                return "$agentq_operation_log_cleanup_status"
            fi
            return "$agentq_operation_output_cleanup_status"
        else
            # Validation failed (or the output file vanished).  Do NOT read
            # `$?` here: it is the failed gate test's 1, not the validation
            # status.  The validation status was already folded into
            # agentq_operation_status inside the then-branch (see the
            # validated=0 capture), so keep the status as-is.
            :
        fi

        if [ "$agentq_operation_name" = lookup ] && {
            [ "$agentq_operation_status" -eq 3 ] ||
            [ "$agentq_operation_status" -eq 4 ] ||
            [ "$agentq_operation_status" -eq 5 ]
        }; then
            if operation_output_require_existing_file "$agentq_operation_output_file" &&
                validate_json_response "$agentq_operation_output_file" lookup "$agentq_operation_request_id"; then
                :
            else
                agentq_operation_status=$?
                if operation_output_remove_file "$agentq_operation_output_file"; then
                    :
                else
                    operation_output_cleanup_status=$?
                    if [ "$agentq_operation_status" -eq 0 ]; then
                        agentq_operation_status=$operation_output_cleanup_status
                    fi
                fi
                if agentq_ssh_log_remove_file "$agentq_operation_log_file"; then
                    :
                else
                    operation_log_cleanup_status=$?
                    if [ "$agentq_operation_status" -eq 0 ]; then
                        agentq_operation_status=$operation_log_cleanup_status
                    fi
                fi
                return "$agentq_operation_status"
            fi
        fi

        # The reason class is the only channel by which a caller driving this
        # client can tell a retryable lock rejection from an argument error, so
        # surface it for every failed operation -- not only for the two mutating
        # commands.  Only the controlled token is forwarded; raw diagnostics stay
        # withheld below.
        if [ "$agentq_operation_status" -ne 0 ] && [ -n "$agentq_remote_failure_reason_value" ]; then
            printf '%s: remote failure reason: %s\n' "$program" "$agentq_remote_failure_reason_value" >&2
        fi

        if [ "$agentq_operation_status" -ne 255 ] || ! ssh_transport_error "$agentq_operation_log_file"; then
            refuse_unlaunchable_ssh_binary "$agentq_operation_status"
            if [ "$agentq_operation_name" = wait ] && {
                [ "$agentq_operation_status" -eq 1 ] ||
                [ "$agentq_operation_status" -eq 5 ] ||
                [ "$agentq_operation_status" -eq 6 ]
            }; then
                if operation_output_require_existing_file "$agentq_operation_output_file" &&
                    validate_wait_response "$agentq_operation_output_file" "$agentq_operation_status" "$agentq_operation_expected_task_id"; then
                    :
                else
                    agentq_wait_validation_status=$?
                    if operation_output_remove_file "$agentq_operation_output_file"; then
                        :
                    else
                        operation_output_cleanup_status=$?
                        if [ "$agentq_wait_validation_status" -eq 0 ]; then
                            agentq_wait_validation_status=$operation_output_cleanup_status
                        fi
                    fi
                    if agentq_ssh_log_remove_file "$agentq_operation_log_file"; then
                        :
                    else
                        operation_log_cleanup_status=$?
                        if [ "$agentq_wait_validation_status" -eq 0 ]; then
                            agentq_wait_validation_status=$operation_log_cleanup_status
                        fi
                    fi
                    return "$agentq_wait_validation_status"
                fi
            fi
            if operation_output_require_existing_file "$agentq_operation_output_file"; then
                cat "$agentq_operation_output_file"
            else
                agentq_operation_status=$?
            fi
            if operation_output_remove_file "$agentq_operation_output_file"; then
                operation_output_cleanup_status=0
            else
                operation_output_cleanup_status=$?
                if [ "$agentq_operation_status" -eq 0 ]; then
                    agentq_operation_status=$operation_output_cleanup_status
                fi
            fi
            if agentq_ssh_log_remove_file "$agentq_operation_log_file"; then
                operation_log_cleanup_status=0
            else
                operation_log_cleanup_status=$?
                if [ "$agentq_operation_status" -eq 0 ]; then
                    agentq_operation_status=$operation_log_cleanup_status
                fi
            fi
            return "$agentq_operation_status"
        fi

        agentq_operation_attempt=$((agentq_operation_attempt + 1))
        if [ "$agentq_operation_attempt" -gt "$operation_retry_attempts" ]; then
            if operation_output_remove_file "$agentq_operation_output_file"; then
                operation_output_cleanup_status=0
            else
                operation_output_cleanup_status=$?
                if [ "$agentq_operation_status" -eq 0 ]; then
                    agentq_operation_status=$operation_output_cleanup_status
                fi
            fi
            if agentq_ssh_log_remove_file "$agentq_operation_log_file"; then
                operation_log_cleanup_status=0
            else
                operation_log_cleanup_status=$?
                if [ "$agentq_operation_status" -eq 0 ]; then
                    agentq_operation_status=$operation_log_cleanup_status
                fi
            fi
            printf '%s: SSH transport remained unavailable while running %s on %s\n' \
                "$program" "$agentq_operation_name" "$host" >&2
            return "$agentq_operation_status"
        fi

        printf '%s: SSH transport lost while running %s; retrying %s/%s...\n' \
            "$program" "$agentq_operation_name" "$agentq_operation_attempt" "$operation_retry_attempts" >&2
        sleep "$operation_retry_delay"
    done
}

# Every one of these feeds a `[ ... -ge/-gt ... ]` comparison or a `sleep`.
# A value past the shell's integer range does not fail that test -- dash prints
# "Illegal number" and the comparison reads as FALSE, so the deadline never
# fires (a hung probe waits forever) and the retry limit never fires (infinite
# retries).  Bounded, exactly like --timeout and the cache TTL above.
is_bounded_positive_integer "$submit_retry_attempts" || fail 'AGENTQ_SUBMIT_RETRY_ATTEMPTS must be a positive integer of at most 2147483647'
is_bounded_positive_integer "$submit_retry_delay" || fail 'AGENTQ_SUBMIT_RETRY_DELAY must be a positive integer of at most 2147483647'
is_bounded_positive_integer "$operation_retry_attempts" || fail 'AGENTQ_OPERATION_RETRY_ATTEMPTS must be a positive integer of at most 2147483647'
is_bounded_positive_integer "$operation_retry_delay" || fail 'AGENTQ_OPERATION_RETRY_DELAY must be a positive integer of at most 2147483647'
is_bounded_positive_integer "$platform_probe_timeout" || fail 'AGENTQ_PLATFORM_PROBE_TIMEOUT must be a positive integer of at most 2147483647'
# The cache TTL feeds `[ $((now - probed_at)) -le "$ttl" ]`; an unvalidated
# value ("abc", or one past the shell's integer range) makes that test fail
# LOUDLY on stderr under dash and read as false, i.e. the cache silently
# vanishes.  Validated here like every other numeric environment variable.
is_bounded_positive_integer "$platform_probe_cache_ttl" || fail 'AGENTQ_PLATFORM_PROBE_CACHE_TTL must be a positive integer of at most 2147483647'

# Resolve and validate the credential source before anything reaches ssh --
# including the platform probe, which is itself an ssh call that runs before
# operation dispatch.  A source that is configured but unusable is refused here
# rather than silently degrading to key-only authentication.
resolve_credential_source
prepare_credential_delivery || exit $?
ssh_credential_option_lines=$(ssh_credential_options)

# Exported rather than prefixed per call site: all four ssh invocations need
# them, and the probe path runs ssh in the background, where a per-command
# prefix would have to be repeated identically in two branches.
#
# The `-n` test is load-bearing.  An exported but EMPTY SSH_ASKPASS is not the
# same as an unset one to OpenSSH: it tests `getenv(...) != NULL`, which an
# empty string satisfies, and then tries to exec the empty string as a program.
# So the askpass environment is set only when there really is a program, which
# is also exactly what the AGENTQ_PASSWORD_PROMPT source needs -- there ssh must
# read the terminal itself.
if [ -n "$agentq_askpass_program" ]; then
    SSH_ASKPASS=$agentq_askpass_program
    SSH_ASKPASS_REQUIRE=force
    export SSH_ASKPASS SSH_ASKPASS_REQUIRE
else
    # The prompt source means "let ssh ask on the terminal", so a conflicting
    # SSH_ASKPASS_REQUIRE inherited from the environment must not silently
    # redirect the prompt somewhere else.
    unset SSH_ASKPASS SSH_ASKPASS_REQUIRE 2>/dev/null || true
fi

host=$default_host
# Only the OPTION TOKENS are folded here, never their values: `--host`'s argument
# is passed to ssh untouched.  The Windows twin matches these tokens with `-eq`,
# which is case-INSENSITIVE by language rule, so `--VERSION`, `--HELP`, `HELP` and
# `-H` answered there while this `case` refused them with exit 2 (measured
# 2026-10-27: the same input gave 0 and 2).  Same rule and same fix as sshp's
# first-token fold and the operation fold below -- normalise the value the parser
# matches, do not widen every pattern.
while [ "$#" -gt 0 ]; do
    global_option=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
    case "$global_option" in
        --host)
            [ "$#" -ge 2 ] || fail '--host requires an SSH host'
            host=$2
            shift 2
            ;;
        -h|--help|help)
            usage
            exit 0
            ;;
        --version)
            # Local only: reports the CLIENT's version constant.  The server's
            # version comes from `doctor` (agentq= line); the two are separate
            # deployments and deliberately not negotiated (docs/PLAN.md B2).
            printf '%s %s\n' "$program" "$agentq_client_version"
            exit 0
            ;;
        *)
            break
            ;;
    esac
done

# A host has a SHAPE, not just a length.  The Windows twin refuses a
# whitespace-only host (IsNullOrWhiteSpace) and one that begins with a hyphen
# (StartsWith("-")); this client checked only for emptiness, so the same argv
# exited 2 there and 255 here -- and 255 is the RETRYABLE transport class, so a
# caller following the contract would retry a permanent typo forever after
# paying an SSH round trip.  Measured 2026-10-27 for `--host -x`, `--host ' '`
# and the rest of the whitespace family.  Order is the twin's: blank, then
# hyphen.  Locale caveat: `[![:space:]]` matches NBSP and U+3000 under a UTF-8
# locale (as .NET does) but not under LC_ALL=C.
case "$host" in
    *[![:space:]]*) : ;;
    *) fail 'no SSH host configured; pass --host or set AGENTQ_HOST' ;;
esac
case "$host" in
    -*) fail 'SSH host must not begin with a hyphen' ;;
esac
[ "$#" -ge 1 ] || {
    usage >&2
    exit 2
}

resolve_ssh_binary
resolve_json_parser

# Each operation branch below calls initialize_remote_invocation itself, AFTER
# its arguments are fully validated.  Order is the Windows twin's contract: a
# local typo must exit 2 without an SSH round trip, and on an unreachable host
# it must not read as a transport failure (255) or pay the probe/retry budget.
# The parser is the single validator -- no shape is checked twice.

operation=$1
shift
# Normalised like AGENTQ_REMOTE_PLATFORM above: the Windows twin's switch is
# case-INSENSITIVE by language rule, so `STATUS` and `--WORKDIR` dispatch there
# while this `case` refused them (the twin-parity rule: same input, same
# answer).  Only the tokens the local parser matches are folded -- values
# (workdir, label, the command after --) and what goes on the remote command
# (branch bodies emit literal lowercase words) are untouched.
operation=$(printf '%s' "$operation" | tr '[:upper:]' '[:lower:]')

case "$operation" in
    submit)
        workdir=''
        label='command'
        request_id=''
        stdin_script=false
        while [ "$#" -gt 0 ]; do
            # Fold only the option token; the value is read from $2 verbatim.
            submit_option=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')
            case "$submit_option" in
                --workdir)
                    [ "$#" -ge 2 ] || fail '--workdir requires a directory'
                    workdir=$2
                    shift 2
                    ;;
                --label)
                    [ "$#" -ge 2 ] || fail '--label requires a label'
                    label=$2
                    shift 2
                    ;;
                --request-id)
                    [ "$#" -ge 2 ] || fail '--request-id requires a value'
                    request_id=$2
                    shift 2
                    ;;
                --stdin-script)
                    stdin_script=true
                    shift
                    ;;
                --)
                    shift
                    break
                    ;;
                *)
                    fail "unknown submit option: $1"
                    ;;
            esac
        done
        [ -n "$workdir" ] || fail '--workdir is required'
        if [ "$stdin_script" = true ]; then
            [ "$#" -eq 0 ] || fail 'submit --stdin-script takes the script from standard input; drop the command after --'
        else
            [ "$#" -gt 0 ] || fail 'submit requires a command after --, or --stdin-script with the script on standard input'
        fi
        if [ -z "$request_id" ]; then
            request_id=$(generate_request_id)
        fi
        is_request_id "$request_id" || fail '--request-id must be 16-128 ASCII letters, numbers, dots, underscores, or hyphens and start with a letter or number'

        initialize_remote_invocation
        append_arg submit
        append_arg --workdir
        append_arg "$workdir"
        append_arg --label
        append_arg "$label"
        append_arg --request-id
        append_arg "$request_id"
        append_arg --
        if [ "$stdin_script" = true ]; then
            # The script travels as ONE base64 argument through the documented
            # decode pattern (`printf %s <b64> | base64 -d | sh`) -- the base64
            # alphabet needs no quoting, so the payload survives every hop
            # (ssh, the remote shell, Pueue's argv) byte-exactly.  The bound is
            # the target's argv limit, which the payload must fit into as a
            # single argument: Linux caps one argv element at MAX_ARG_STRLEN
            # (128 KiB); a Windows target re-encodes argv onto a CreateProcess
            # command line capped at 32767 characters, so the payload plus the
            # rest of the server invocation must stay under that.  Bigger
            # scripts belong in a staged file (SKILL.md).
            if [ -t 0 ]; then
                fail 'submit --stdin-script needs the script on standard input (pipe or redirect it)'
            fi
            command -v base64 >/dev/null 2>&1 || fail 'submit --stdin-script requires base64 on PATH'
            # Cap the read as well as the result.  The size check below runs on
            # the encoded length, so without a bound a multi-gigabyte stdin is
            # buffered into a shell variable first and only then rejected --
            # `head -c` stops reading at the cap, and the extra byte it is
            # allowed to pass through is what makes an over-cap payload
            # detectable (base64 of limit+1 bytes is longer than the limit).
            # The read is by BYTES and the check is on base64 CHARACTERS; the
            # 4/3 expansion means the byte cap must be the character cap scaled
            # down, which is why this is generous rather than exact.
            if [ "$remote_platform" = windows ]; then
                stdin_script_limit=$stdin_script_windows_limit
            else
                stdin_script_limit=$stdin_script_unix_limit
            fi
            if stdin_script_b64=$(head -c "$((stdin_script_limit * 3 / 4 + 1))" | base64 | tr -d '\n'); then
                :
            else
                fail 'cannot base64-encode the script from standard input'
            fi
            [ -n "$stdin_script_b64" ] || fail 'submit --stdin-script received no script on standard input'
            if [ "${#stdin_script_b64}" -gt "$stdin_script_limit" ]; then
                fail "the script is too large for --stdin-script (base64 length ${#stdin_script_b64} exceeds $stdin_script_limit on this target); stage it as a file and submit a command that reads it"
            fi
            # The decode pipeline's LAST stage is `sh`, so on a target without
            # `base64` the `base64 -d` stage dies, `sh` reads empty input and
            # exits 0, and the task lands in Done/Success having executed
            # NOTHING -- a fail-open, because the client's own
            # `command -v base64` check runs on the LOCAL machine.  The guard
            # therefore has to make the pipeline's own terminal status nonzero:
            # it sits BEFORE the pipeline, on the `||`, so the failure is
            # produced instead of executed.  (An `||`-attached recovery clause
            # after the pipeline does NOT do this -- it runs only after the
            # pipeline already exited 0.  Measured 2026-10-16.)  This keeps the
            # documented `printf %s <b64> | base64 -d | sh` shape (SKILL.md)
            # and the script's exit code is still the task's status.
            append_arg sh
            append_arg -c
            append_arg "command -v base64 >/dev/null 2>&1 || { echo 'agentq: --stdin-script requires base64 on the target' >&2; exit 2; }; printf %s $stdin_script_b64 | base64 -d | sh"
        else
            for argument in "$@"; do
                append_arg "$argument"
            done
        fi

        if [ "$remote_platform" = windows ]; then
            build_windows_remote_command
            submit_command=$remote_command
            submit_input_file=$remote_input_file
            submit_input_file_identity=$remote_input_file_identity
            reset_windows_argument_stream
            append_arg lookup
            append_arg "$request_id"
            build_windows_remote_command
            lookup_command=$remote_command
            lookup_input_file=$remote_input_file
            lookup_input_file_identity=$remote_input_file_identity
        else
            submit_command=$remote_command
            remote_command=$remote_base_command
            append_arg lookup
            append_arg "$request_id"
            lookup_command=$remote_command
            submit_input_file=''
            lookup_input_file=''
        fi
        run_submit_with_recovery "$request_id" "$submit_command" "$submit_input_file" "$lookup_command" "$lookup_input_file"
        exit $?
        ;;
    lookup)
        [ "$#" -eq 1 ] || fail 'lookup requires one request id'
        is_request_id "$1" || fail 'request id must be 16-128 ASCII letters, numbers, dots, underscores, or hyphens and start with a letter or number'
        lookup_request_id=$1
        initialize_remote_invocation
        append_arg lookup
        append_arg "$1"
        ;;
    status)
        # Three modes, three server responses: the full decorated queue, the
        # compact summary, and the single decorated task (wrapped in {"task":
        # ...} like logs and wait).  A bare numeric id is the local hint the
        # user probably wanted `logs` -- the server has no positional status.
        # Shape is validated BEFORE the probe; the if-chain below re-checks the
        # same shapes (unreachable fails then) and owns the values.
        status_option_1=$(printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]')
        case "$#" in
            0) ;;
            1) [ "$status_option_1" = '--summary' ] || fail 'status accepts --summary or --task <task-id>; for one task log, use logs <task-id>' ;;
            2) { [ "$status_option_1" = '--task' ] && is_task_id "$2"; } || fail 'status accepts --summary or --task <task-id>' ;;
            *) fail 'status accepts --summary or --task <task-id>' ;;
        esac
        initialize_remote_invocation
        agentq_operation_profile=$operation
        if [ "$#" -eq 0 ]; then
            append_arg status
        elif [ "$#" -eq 2 ] && [ "$status_option_1" = '--task' ]; then
            is_task_id "$2" || fail 'task id must be a non-negative integer'
            append_arg status
            append_arg --task
            append_arg "$2"
            agentq_operation_profile=status_task
            status_expected_task_id=$2
        elif [ "$#" -eq 1 ] && [ "$status_option_1" = '--summary' ]; then
            append_arg status
            append_arg --summary
            agentq_operation_profile=status_summary
        elif [ "$#" -eq 1 ]; then
            fail 'status accepts --summary or --task <task-id>; for one task log, use logs <task-id>'
        else
            fail 'status accepts --summary or --task <task-id>'
        fi
        ;;
    doctor)
        # Default queue section is the compact summary; --full restores the
        # historical decorated dump.  doctor itself is NOT read-only (it starts
        # the pueued service); that warning lives in the usage text.
        [ "$#" -eq 0 ] || { [ "$#" -eq 1 ] && [ "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" = '--full' ]; } || fail 'doctor accepts --full or no arguments'
        initialize_remote_invocation
        agentq_operation_profile=$operation
        if [ "$#" -eq 0 ]; then
            append_arg doctor
        elif [ "$#" -eq 1 ] && [ "$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')" = '--full' ]; then
            append_arg doctor
            append_arg --full
        else
            fail 'doctor accepts --full or no arguments'
        fi
        ;;
    logs)
        [ "$#" -eq 1 ] || [ "$#" -eq 3 ] || fail 'logs requires a task id and optional --tail <lines>'
        is_task_id "$1" || fail 'task id must be a non-negative integer'
        if [ "$#" -eq 3 ]; then
            [ "$(printf '%s' "$2" | tr '[:upper:]' '[:lower:]')" = '--tail' ] || fail 'logs accepts only --tail <lines>'
            is_positive_integer_or_all "$3" || fail '--tail must be a positive integer or all'
        fi
        initialize_remote_invocation
        append_arg logs
        append_arg "$1"
        if [ "$#" -eq 3 ]; then
            append_arg --tail
            append_arg "$3"
        fi
        ;;
    cancel)
        [ "$#" -eq 1 ] || fail 'cancel requires one task id'
        is_task_id "$1" || fail 'task id must be a non-negative integer'
        initialize_remote_invocation
        append_arg cancel
        append_arg "$1"
        ;;
    remove)
        remove_option_1=$(printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]')
        remove_option_3=$(printf '%s' "${3:-}" | tr '[:upper:]' '[:lower:]')
        if [ "$#" -eq 3 ] && [ "$remove_option_1" = '--label' ]; then
            [ "$remove_option_3" = '--confirm' ] || fail 'remove --label requires --confirm: a batch removal must be explicitly acknowledged'
            [ -n "$2" ] || fail 'remove --label requires a non-empty label'
        elif [ "$#" -eq 2 ] && [ "$remove_option_1" = '--label' ]; then
            fail 'remove --label requires --confirm: a batch removal must be explicitly acknowledged'
        else
            [ "$#" -eq 1 ] || fail 'remove requires one task id, or --label <label> --confirm'
            is_task_id "$1" || fail 'task id must be a non-negative integer'
        fi
        initialize_remote_invocation
        if [ "$#" -eq 3 ] && [ "$remove_option_1" = '--label' ]; then
            append_arg remove
            append_arg --label
            append_arg "$2"
            append_arg --confirm
            remove_batch=1
        else
            append_arg remove
            append_arg "$1"
        fi
        ;;
    wait)
        [ "$#" -eq 1 ] || [ "$#" -eq 3 ] || fail 'wait requires a task id and optional --timeout <seconds>'
        is_task_id "$1" || fail 'task id must be a non-negative integer'
        if [ "$#" -eq 3 ]; then
            [ "$(printf '%s' "$2" | tr '[:upper:]' '[:lower:]')" = '--timeout' ] || fail 'wait accepts only --timeout <seconds>'
            is_bounded_positive_integer "$3" || fail '--timeout must be a positive integer of at most 2147483647'
            wait_timeout_seconds=$3
        elif [ -n "$wait_timeout" ]; then
            is_bounded_positive_integer "$wait_timeout" || fail 'AGENTQ_WAIT_TIMEOUT must be a positive integer of at most 2147483647'
            wait_timeout_seconds=$wait_timeout
        fi
        initialize_remote_invocation
        append_arg wait
        append_arg "$1"
        # The budget is CLIENT-side: run_wait_ssh_with_timeout kills the local
        # ssh at the deadline and bounds the remote wait with `timeout <N>s`.
        # The server's `wait` arm takes exactly one task id, so forwarding
        # --timeout there would be a protocol_error (measured: the server
        # answers `wait requires one task id`, exit 2).  Nothing goes on the
        # remote command.
        ;;
    *)
        fail "unknown command: $operation"
        ;;
esac

if [ "$remote_platform" = windows ]; then
    build_windows_remote_command
fi

case "$operation" in
    lookup|status|logs|wait|doctor)
        if [ "$operation" = lookup ]; then
            run_safe_operation_with_recovery "$operation" "$remote_command" "$remote_input_file" "$lookup_request_id"
        elif [ "$operation" = logs ] || [ "$operation" = wait ]; then
            run_safe_operation_with_recovery "$operation" "$remote_command" "$remote_input_file" '' "$1"
        elif [ "$operation" = status ] && [ -n "$status_expected_task_id" ]; then
            run_safe_operation_with_recovery "$operation" "$remote_command" "$remote_input_file" '' "$status_expected_task_id" "$agentq_operation_profile"
        else
            run_safe_operation_with_recovery "$operation" "$remote_command" "$remote_input_file" '' '' "$agentq_operation_profile"
        fi
        exit $?
        ;;
    cancel|remove)
        mutation_log_file=$(mktemp "$agentq_temp_directory/agentq-mutation-log.XXXXXX") || fail "cannot create a temporary SSH log for $operation"
        mutation_output_file=$(mktemp "$agentq_temp_directory/agentq-mutation-output.XXXXXX") || fail "cannot create a temporary output file for $operation"
        mutation_output_require_file "$mutation_output_file" || exit $?
        mutation_status=2
        mutation_body_suppressed=0
        if run_mutation_ssh "$remote_command" "$remote_input_file"; then
            if mutation_output_require_existing_file "$mutation_output_file"; then
                if [ "$operation" = remove ] && [ "$remove_batch" -eq 1 ]; then
                    if validate_json_response "$mutation_output_file" remove_batch '' ''; then
                        mutation_status=0
                    else
                        mutation_status=$?
                    fi
                elif validate_json_response "$mutation_output_file" "$operation" '' "$1"; then
                    mutation_status=0
                else
                    mutation_status=$?
                fi
            else
                mutation_status=$?
            fi
        else
            mutation_status=$?
            if [ "$operation" = cancel ] && [ "$mutation_status" -eq 4 ]; then
                if mutation_output_require_existing_file "$mutation_output_file"; then
                    if validate_json_response "$mutation_output_file" cancel_pending '' "$1"; then
                        :
                    else
                        # The exit code stays 4.  It is the server's own
                        # contract statement ("cannot decide safely; STOP, do
                        # not retry"), and a body that fails validation is a
                        # reason to trust the response LESS, not to downgrade it
                        # to 2 -- which reads as "protocol/parameter error, fix
                        # your arguments and try again", the opposite of what a
                        # cancellation_pending state requires.  The validation
                        # diagnostic has already been printed by
                        # validate_json_response.
                        #
                        # The unvalidated body must NOT reach stdout either
                        # (the `-ne 2` cat guard below used to suppress it only
                        # as a side effect of the downgrade), hence the flag.
                        mutation_body_suppressed=1
                    fi
                else
                    # Same rule for an unreadable/absent body: keep 4, print
                    # nothing that did not pass validation.
                    mutation_body_suppressed=1
                fi
            fi
        fi
        # cancel/remove take this path, and it is precisely the path where the
        # reason class matters most: `task_not_running` and `lock_contention` are
        # both exit 2 and call for opposite responses.  Without this the class
        # would be available for every read-only operation and missing for the
        # two mutating ones.  Raw diagnostics stay withheld here as everywhere
        # else; only the controlled token is forwarded.
        if [ "$mutation_status" -ne 0 ] && [ -n "$agentq_remote_failure_reason_value" ]; then
            printf '%s: remote failure reason: %s\n' "$program" "$agentq_remote_failure_reason_value" >&2
        fi
        if [ "$mutation_status" -ne 2 ] && [ "$mutation_body_suppressed" -eq 0 ]; then
            if mutation_output_require_existing_file "$mutation_output_file"; then
                cat "$mutation_output_file"
            else
                mutation_status=$?
            fi
        fi
        if mutation_output_remove_file "$mutation_output_file"; then
            :
        else
            mutation_output_cleanup_status=$?
            if [ "$mutation_status" -eq 0 ]; then
                mutation_status=$mutation_output_cleanup_status
            fi
        fi
        mutation_output_file=''
        if agentq_ssh_log_remove_file "$mutation_log_file"; then
            :
        else
            mutation_log_cleanup_status=$?
            if [ "$mutation_status" -eq 0 ]; then
                mutation_status=$mutation_log_cleanup_status
            fi
        fi
        mutation_log_file=''
        exit "$mutation_status"
        ;;
esac
