        # The reason class is the only channel by which a caller driving this
        # client can tell a retryable lock rejection from an argument error, so
        # surface it for every failed operation -- not only for the two mutating
        # commands.  Only the controlled token is forwarded; raw diagnostics stay
        # withheld below.
        if [ "$agentq_operation_status" -ne 0 ] && [ -n "$agentq_remote_failure_reason_value" ]; then
            printf '%s: remote failure reason: %s\n' "$program" "$agentq_remote_failure_reason_value" >&2
        fi

        if [ "$agentq_operation_status" -ne 255 ] || ! ssh_transport_error "$agentq_operation_log_file"; then
            if [ "$agentq_operation_name" = wait ] && {
                [ "$agentq_operation_status" -eq 1 ] ||
                [ "$agentq_operation_status" -eq 5 ] ||
                [ "$agentq_operation_status" -eq 6 ]
            }; then
                if operation_output_require_existing_file "$agentq_operation_output_file" &&
                    validate_wait_response "$agentq_operation_output_file" "$agentq_operation_status" "$agentq_operation_expected_task_id"; then
                    :
                else
                    agentq_wait_validation_status=$?
                    if operation_output_remove_file "$agentq_operation_output_file"; then
                        :
                    else
                        operation_output_cleanup_status=$?
                        if [ "$agentq_wait_validation_status" -eq 0 ]; then
                            agentq_wait_validation_status=$operation_output_cleanup_status
                        fi
                    fi
                    if agentq_ssh_log_remove_file "$agentq_operation_log_file"; then
                        :
                    else
                        operation_log_cleanup_status=$?
                        if [ "$agentq_wait_validation_status" -eq 0 ]; then
                            agentq_wait_validation_status=$operation_log_cleanup_status
                        fi
                    fi
                    return "$agentq_wait_validation_status"
                fi
            fi
            if operation_output_require_existing_file "$agentq_operation_output_file"; then
                cat "$agentq_operation_output_file"
            else
                agentq_operation_status=$?
            fi
            if operation_output_remove_file "$agentq_operation_output_file"; then
                operation_output_cleanup_status=0
            else
                operation_output_cleanup_status=$?
                if [ "$agentq_operation_status" -eq 0 ]; then
                    agentq_operation_status=$operation_output_cleanup_status
                fi
            fi
            if agentq_ssh_log_remove_file "$agentq_operation_log_file"; then
                operation_log_cleanup_status=0
            else
                operation_log_cleanup_status=$?
                if [ "$agentq_operation_status" -eq 0 ]; then
                    agentq_operation_status=$operation_log_cleanup_status
                fi
            fi
            return "$agentq_operation_status"
        fi

        agentq_operation_attempt=$((agentq_operation_attempt + 1))
        if [ "$agentq_operation_attempt" -gt "$operation_retry_attempts" ]; then
            if operation_output_remove_file "$agentq_operation_output_file"; then
                operation_output_cleanup_status=0
            else
                operation_output_cleanup_status=$?
                if [ "$agentq_operation_status" -eq 0 ]; then
                    agentq_operation_status=$operation_output_cleanup_status
                fi
            fi
            if agentq_ssh_log_remove_file "$agentq_operation_log_file"; then
                operation_log_cleanup_status=0
            else
                operation_log_cleanup_status=$?
                if [ "$agentq_operation_status" -eq 0 ]; then
                    agentq_operation_status=$operation_log_cleanup_status
                fi
            fi
            printf '%s: SSH transport remained unavailable while running %s on %s\n' \
                "$program" "$agentq_operation_name" "$host" >&2
            return "$agentq_operation_status"
        fi

        printf '%s: SSH transport lost while running %s; retrying %s/%s...\n' \
            "$program" "$agentq_operation_name" "$agentq_operation_attempt" "$operation_retry_attempts" >&2
        sleep "$operation_retry_delay"
    done
}

is_positive_integer "$submit_retry_attempts" || fail 'AGENTQ_SUBMIT_RETRY_ATTEMPTS must be a positive integer'
is_positive_integer "$submit_retry_delay" || fail 'AGENTQ_SUBMIT_RETRY_DELAY must be a positive integer'
is_positive_integer "$operation_retry_attempts" || fail 'AGENTQ_OPERATION_RETRY_ATTEMPTS must be a positive integer'
is_positive_integer "$operation_retry_delay" || fail 'AGENTQ_OPERATION_RETRY_DELAY must be a positive integer'
is_positive_integer "$platform_probe_timeout" || fail 'AGENTQ_PLATFORM_PROBE_TIMEOUT must be a positive integer'

# Resolve and validate the credential source before anything reaches ssh --
# including the platform probe, which is itself an ssh call that runs before
# operation dispatch.  A source that is configured but unusable is refused here
# rather than silently degrading to key-only authentication.
resolve_credential_source
prepare_credential_delivery || exit $?
ssh_credential_option_lines=$(ssh_credential_options)

# Exported rather than prefixed per call site: all four ssh invocations need
# them, and the probe path runs ssh in the background, where a per-command
# prefix would have to be repeated identically in two branches.
#
# The `-n` test is load-bearing.  An exported but EMPTY SSH_ASKPASS is not the
# same as an unset one to OpenSSH: it tests `getenv(...) != NULL`, which an
# empty string satisfies, and then tries to exec the empty string as a program.
# So the askpass environment is set only when there really is a program, which
# is also exactly what the AGENTQ_PASSWORD_PROMPT source needs -- there ssh must
# read the terminal itself.
if [ -n "$agentq_askpass_program" ]; then
    SSH_ASKPASS=$agentq_askpass_program
    SSH_ASKPASS_REQUIRE=force
    export SSH_ASKPASS SSH_ASKPASS_REQUIRE
else
    # The prompt source means "let ssh ask on the terminal", so a conflicting
    # SSH_ASKPASS_REQUIRE inherited from the environment must not silently
    # redirect the prompt somewhere else.
    unset SSH_ASKPASS SSH_ASKPASS_REQUIRE 2>/dev/null || true
fi

host=$default_host
while [ "$#" -gt 0 ]; do
    case "$1" in
        --host)
            [ "$#" -ge 2 ] || fail '--host requires an SSH host'
            host=$2
            shift 2
            ;;
        -h|--help|help)
            usage
            exit 0
            ;;
        *)
            break
            ;;
    esac
done

[ -n "$host" ] || fail 'no SSH host configured; pass --host or set AGENTQ_HOST'
[ "$#" -ge 1 ] || {
    usage >&2
    exit 2
}

resolve_ssh_binary
resolve_json_parser
initialize_remote_invocation

operation=$1
shift

case "$operation" in
    submit)
        workdir=''
        label='command'
        request_id=''
        while [ "$#" -gt 0 ]; do
            case "$1" in
                --workdir)
                    [ "$#" -ge 2 ] || fail '--workdir requires a directory'
                    workdir=$2
                    shift 2
                    ;;
                --label)
                    [ "$#" -ge 2 ] || fail '--label requires a label'
                    label=$2
                    shift 2
                    ;;
                --request-id)
                    [ "$#" -ge 2 ] || fail '--request-id requires a value'
                    request_id=$2
                    shift 2
                    ;;
                --)
                    shift
                    break
                    ;;
                *)
                    fail "unknown submit option: $1"
                    ;;
            esac
        done
        [ -n "$workdir" ] || fail '--workdir is required'
        [ "$#" -gt 0 ] || fail 'submit requires a command after --'
        if [ -z "$request_id" ]; then
            request_id=$(generate_request_id)
        fi
        is_request_id "$request_id" || fail '--request-id must be 16-128 ASCII letters, numbers, dots, underscores, or hyphens and start with a letter or number'

        append_arg submit
        append_arg --workdir
        append_arg "$workdir"
        append_arg --label
        append_arg "$label"
        append_arg --request-id
        append_arg "$request_id"
        append_arg --
        for argument in "$@"; do
            append_arg "$argument"
        done

        if [ "$remote_platform" = windows ]; then
            build_windows_remote_command
            submit_command=$remote_command
            submit_input_file=$remote_input_file
            submit_input_file_identity=$remote_input_file_identity
            reset_windows_argument_stream
            append_arg lookup
            append_arg "$request_id"
            build_windows_remote_command
            lookup_command=$remote_command
            lookup_input_file=$remote_input_file
            lookup_input_file_identity=$remote_input_file_identity
        else
            submit_command=$remote_command
            remote_command=$remote_base_command
            append_arg lookup
            append_arg "$request_id"
            lookup_command=$remote_command
            submit_input_file=''
            lookup_input_file=''
        fi
        run_submit_with_recovery "$request_id" "$submit_command" "$submit_input_file" "$lookup_command" "$lookup_input_file"
        exit $?
        ;;
    lookup)
        [ "$#" -eq 1 ] || fail 'lookup requires one request id'
        is_request_id "$1" || fail 'request id must be 16-128 ASCII letters, numbers, dots, underscores, or hyphens and start with a letter or number'
        lookup_request_id=$1
        append_arg lookup
        append_arg "$1"
        ;;
    status|doctor)
        [ "$#" -eq 0 ] || fail "$operation accepts no arguments"
        append_arg "$operation"
        ;;
    logs)
        [ "$#" -eq 1 ] || [ "$#" -eq 3 ] || fail 'logs requires a task id and optional --tail <lines>'
        is_task_id "$1" || fail 'task id must be a non-negative integer'
        append_arg logs
        append_arg "$1"
        if [ "$#" -eq 3 ]; then
            [ "$2" = '--tail' ] || fail 'logs accepts only --tail <lines>'
            is_positive_integer_or_all "$3" || fail '--tail must be a positive integer or all'
            append_arg --tail
            append_arg "$3"
        fi
        ;;
    cancel|wait|remove)
        [ "$#" -eq 1 ] || fail "$operation requires one task id"
        is_task_id "$1" || fail 'task id must be a non-negative integer'
        append_arg "$operation"
        append_arg "$1"
        ;;
    *)
        fail "unknown command: $operation"
        ;;
esac

if [ "$remote_platform" = windows ]; then
    build_windows_remote_command
fi

case "$operation" in
    lookup|status|logs|wait|doctor)
        if [ "$operation" = lookup ]; then
            run_safe_operation_with_recovery "$operation" "$remote_command" "$remote_input_file" "$lookup_request_id"
        elif [ "$operation" = logs ] || [ "$operation" = wait ]; then
            run_safe_operation_with_recovery "$operation" "$remote_command" "$remote_input_file" '' "$1"
        else
            run_safe_operation_with_recovery "$operation" "$remote_command" "$remote_input_file"
        fi
        exit $?
        ;;
    cancel|remove)
        mutation_log_file=$(mktemp "$agentq_temp_directory/agentq-mutation-log.XXXXXX") || fail "cannot create a temporary SSH log for $operation"
        mutation_output_file=$(mktemp "$agentq_temp_directory/agentq-mutation-output.XXXXXX") || fail "cannot create a temporary output file for $operation"
        mutation_output_require_file "$mutation_output_file" || exit $?
        mutation_status=2
        if run_mutation_ssh "$remote_command" "$remote_input_file"; then
            if mutation_output_require_existing_file "$mutation_output_file"; then
                if validate_json_response "$mutation_output_file" "$operation" '' "$1"; then
                    mutation_status=0
                else
                    mutation_status=$?
                fi
            else
                mutation_status=$?
            fi
        else
            mutation_status=$?
            if [ "$operation" = cancel ] && [ "$mutation_status" -eq 4 ]; then
                if mutation_output_require_existing_file "$mutation_output_file"; then
                    if validate_json_response "$mutation_output_file" cancel_pending '' "$1"; then
                        :
                    else
                        mutation_status=$?
                    fi
                else
                    mutation_status=$?
                fi
            fi
        fi
        # cancel/remove take this path, and it is precisely the path where the
        # reason class matters most: `task_not_running` and `lock_contention` are
        # both exit 2 and call for opposite responses.  Without this the class
        # would be available for every read-only operation and missing for the
        # two mutating ones.  Raw diagnostics stay withheld here as everywhere
        # else; only the controlled token is forwarded.
        if [ "$mutation_status" -ne 0 ] && [ -n "$agentq_remote_failure_reason_value" ]; then
            printf '%s: remote failure reason: %s\n' "$program" "$agentq_remote_failure_reason_value" >&2
        fi
        if [ "$mutation_status" -ne 2 ]; then
            if mutation_output_require_existing_file "$mutation_output_file"; then
                cat "$mutation_output_file"
            else
                mutation_status=$?
            fi
        fi
        if mutation_output_remove_file "$mutation_output_file"; then
            :
        else
            mutation_output_cleanup_status=$?
            if [ "$mutation_status" -eq 0 ]; then
                mutation_status=$mutation_output_cleanup_status
            fi
        fi
        mutation_output_file=''
        if agentq_ssh_log_remove_file "$mutation_log_file"; then
            :
        else
            mutation_log_cleanup_status=$?
            if [ "$mutation_status" -eq 0 ]; then
                mutation_status=$mutation_log_cleanup_status
            fi
        fi
        mutation_log_file=''
        exit "$mutation_status"
        ;;
esac
