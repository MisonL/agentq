    agentq_recovery_log_file=$(mktemp "$agentq_temp_directory/agentq-submit-log.XXXXXX") || {
        agentq_recovery_status=2
        if recovery_output_remove_file "$agentq_recovery_output_file"; then
            recovery_output_cleanup_status=0
        else
            recovery_output_cleanup_status=$?
            if [ "$agentq_recovery_status" -eq 0 ]; then
                agentq_recovery_status=$recovery_output_cleanup_status
            fi
        fi
        printf '%s: cannot create a temporary SSH log for submit recovery\n' "$program" >&2
        return "$agentq_recovery_status"
    }

    while :; do
        if run_submit_recovery_ssh "$agentq_recovery_submit_command" "$agentq_recovery_submit_input"; then
            if recovery_output_require_existing_file "$agentq_recovery_output_file" &&
                validate_json_response "$agentq_recovery_output_file" submit "$agentq_recovery_request_id"; then
                :
            else
                agentq_recovery_status=$?
                if recovery_output_remove_file "$agentq_recovery_output_file"; then
                    agentq_recovery_output_cleanup_status=0
                else
                    agentq_recovery_output_cleanup_status=$?
                    if [ "$agentq_recovery_status" -eq 0 ]; then
                        agentq_recovery_status=$agentq_recovery_output_cleanup_status
                    fi
                fi
                if agentq_ssh_log_remove_file "$agentq_recovery_log_file"; then
                    agentq_recovery_log_cleanup_status=0
                else
                    agentq_recovery_log_cleanup_status=$?
                    if [ "$agentq_recovery_status" -eq 0 ]; then
                        agentq_recovery_status=$agentq_recovery_log_cleanup_status
                    fi
                fi
                return "$agentq_recovery_status"
            fi
            recovery_output_require_existing_file "$agentq_recovery_output_file" || return $?
            cat "$agentq_recovery_output_file"
            if recovery_output_remove_file "$agentq_recovery_output_file"; then
                agentq_recovery_output_cleanup_status=0
            else
                agentq_recovery_output_cleanup_status=$?
            fi
            if agentq_ssh_log_remove_file "$agentq_recovery_log_file"; then
                agentq_recovery_log_cleanup_status=0
            else
                agentq_recovery_log_cleanup_status=$?
            fi
            if [ "$agentq_recovery_output_cleanup_status" -ne 0 ]; then
                return "$agentq_recovery_output_cleanup_status"
            fi
            if [ "$agentq_recovery_log_cleanup_status" -ne 0 ]; then
                return "$agentq_recovery_log_cleanup_status"
            fi
            return "$agentq_recovery_cleanup_failure_status"
        else
            agentq_recovery_status=$?
        fi

        if [ "$agentq_recovery_status" -ne 255 ] || ! ssh_transport_error "$agentq_recovery_log_file"; then
            if recovery_output_require_existing_file "$agentq_recovery_output_file"; then
                cat "$agentq_recovery_output_file"
            else
                agentq_recovery_status=$?
            fi
            if recovery_output_remove_file "$agentq_recovery_output_file"; then
                agentq_recovery_output_cleanup_status=0
            else
                agentq_recovery_output_cleanup_status=$?
                if [ "$agentq_recovery_status" -eq 0 ]; then
                    agentq_recovery_status=$agentq_recovery_output_cleanup_status
                fi
            fi
            if agentq_ssh_log_remove_file "$agentq_recovery_log_file"; then
                agentq_recovery_log_cleanup_status=0
            else
                agentq_recovery_log_cleanup_status=$?
                if [ "$agentq_recovery_status" -eq 0 ]; then
                    agentq_recovery_status=$agentq_recovery_log_cleanup_status
                fi
            fi
            return "$agentq_recovery_status"
        fi

        agentq_recovery_attempt=$((agentq_recovery_attempt + 1))
        if [ "$agentq_recovery_attempt" -gt "$submit_retry_attempts" ]; then
            if recovery_output_remove_file "$agentq_recovery_output_file"; then
                agentq_recovery_output_cleanup_status=0
            else
                agentq_recovery_output_cleanup_status=$?
                if [ "$agentq_recovery_status" -eq 0 ]; then
                    agentq_recovery_status=$agentq_recovery_output_cleanup_status
                fi
            fi
            if agentq_ssh_log_remove_file "$agentq_recovery_log_file"; then
                agentq_recovery_log_cleanup_status=0
            else
                agentq_recovery_log_cleanup_status=$?
                if [ "$agentq_recovery_status" -eq 0 ]; then
                    agentq_recovery_status=$agentq_recovery_log_cleanup_status
                fi
            fi
            printf '%s: SSH transport remained unavailable while submitting request %s; recover later with: %s --host %s lookup %s\n' \
                "$program" "$agentq_recovery_request_id" "$program" "$host" "$agentq_recovery_request_id" >&2
            return "$agentq_recovery_status"
        fi

        printf '%s: SSH transport lost while submitting request %s; reconciling attempt %s/%s...\n' \
            "$program" "$agentq_recovery_request_id" "$agentq_recovery_attempt" "$submit_retry_attempts" >&2
        sleep "$submit_retry_delay"

        if run_submit_recovery_ssh "$agentq_recovery_lookup_command" "$agentq_recovery_lookup_input"; then
            agentq_recovery_status=0
            if recovery_output_require_existing_file "$agentq_recovery_output_file" &&
                validate_json_response "$agentq_recovery_output_file" lookup "$agentq_recovery_request_id"; then
                :
            else
                agentq_recovery_status=$?
                if recovery_output_remove_file "$agentq_recovery_output_file"; then
                    agentq_recovery_output_cleanup_status=0
                else
                    agentq_recovery_output_cleanup_status=$?
                    if [ "$agentq_recovery_status" -eq 0 ]; then
                        agentq_recovery_status=$agentq_recovery_output_cleanup_status
                    fi
                fi
                if agentq_ssh_log_remove_file "$agentq_recovery_log_file"; then
                    agentq_recovery_log_cleanup_status=0
                else
                    agentq_recovery_log_cleanup_status=$?
                    if [ "$agentq_recovery_status" -eq 0 ]; then
                        agentq_recovery_status=$agentq_recovery_log_cleanup_status
                    fi
                fi
                return "$agentq_recovery_status"
            fi
            recovery_output_require_existing_file "$agentq_recovery_output_file" || return $?
            cat "$agentq_recovery_output_file"
            if recovery_output_remove_file "$agentq_recovery_output_file"; then
                agentq_recovery_output_cleanup_status=0
            else
                agentq_recovery_output_cleanup_status=$?
            fi
            if agentq_ssh_log_remove_file "$agentq_recovery_log_file"; then
                agentq_recovery_log_cleanup_status=0
            else
                agentq_recovery_log_cleanup_status=$?
            fi
            if [ "$agentq_recovery_output_cleanup_status" -eq 0 ]; then
                return "$agentq_recovery_log_cleanup_status"
            fi
            return "$agentq_recovery_output_cleanup_status"
        else
            agentq_recovery_status=$?
        fi

        if [ "$agentq_recovery_status" -eq 3 ] ||
            [ "$agentq_recovery_status" -eq 4 ] ||
            [ "$agentq_recovery_status" -eq 5 ]; then
            if recovery_output_require_existing_file "$agentq_recovery_output_file" &&
                validate_json_response "$agentq_recovery_output_file" lookup "$agentq_recovery_request_id"; then
                :
            else
                agentq_recovery_status=$?
                if recovery_output_remove_file "$agentq_recovery_output_file"; then
                    agentq_recovery_output_cleanup_status=0
                else
                    agentq_recovery_output_cleanup_status=$?
                    if [ "$agentq_recovery_status" -eq 0 ]; then
                        agentq_recovery_status=$agentq_recovery_output_cleanup_status
                    fi
                fi
                if agentq_ssh_log_remove_file "$agentq_recovery_log_file"; then
                    agentq_recovery_log_cleanup_status=0
                else
                    agentq_recovery_log_cleanup_status=$?
                    if [ "$agentq_recovery_status" -eq 0 ]; then
                        agentq_recovery_status=$agentq_recovery_log_cleanup_status
                    fi
                fi
                return "$agentq_recovery_status"
            fi
        fi

        if [ "$agentq_recovery_status" -eq 3 ]; then
            if recovery_output_remove_file "$agentq_recovery_output_file"; then
                agentq_recovery_output_cleanup_status=0
            else
                agentq_recovery_output_cleanup_status=$?
            fi
            if agentq_ssh_log_remove_file "$agentq_recovery_log_file"; then
                agentq_recovery_log_cleanup_status=0
            else
                agentq_recovery_log_cleanup_status=$?
            fi
            if [ "$agentq_recovery_output_cleanup_status" -ne 0 ]; then
                return "$agentq_recovery_output_cleanup_status"
            fi
            if [ "$agentq_recovery_log_cleanup_status" -ne 0 ]; then
                return "$agentq_recovery_log_cleanup_status"
            fi
            continue
        fi
        if [ "$agentq_recovery_status" -eq 4 ]; then
            if recovery_output_require_existing_file "$agentq_recovery_output_file"; then
                cat "$agentq_recovery_output_file"
            else
                agentq_recovery_status=$?
            fi
            if recovery_output_remove_file "$agentq_recovery_output_file"; then
                agentq_recovery_output_cleanup_status=0
            else
                agentq_recovery_output_cleanup_status=$?
                if [ "$agentq_recovery_status" -eq 0 ]; then
