#!/bin/sh

set -eu

program=${0##*/}
stat_flavor=''
config_path=${AGENTQ_CONFIG:-"$HOME/.config/agentq/config"}
configured_host=''
config_max_bytes=4096
config_marker='__AGENTQ_CONFIG_READ_BOUNDARY_9f3c7b2a__'
config_hex=''
config_snapshot_directory=''
config_snapshot_file=''
config_snapshot_directory_identity=''
config_snapshot_file_identity=''
config_source_identity=''
config_source_path_chain_identity=''
submit_retry_attempts=${AGENTQ_SUBMIT_RETRY_ATTEMPTS:-6}
submit_retry_delay=${AGENTQ_SUBMIT_RETRY_DELAY:-2}
operation_retry_attempts=${AGENTQ_OPERATION_RETRY_ATTEMPTS:-6}
operation_retry_delay=${AGENTQ_OPERATION_RETRY_DELAY:-2}
platform_probe_timeout=${AGENTQ_PLATFORM_PROBE_TIMEOUT:-30}
platform_probe_output_limit=65536
ssh_binary=${AGENTQ_SSH:-}
json_parser=${AGENTQ_JQ:-}
remote_platform=${AGENTQ_REMOTE_PLATFORM:-auto}
remote_argument_file=''
remote_input_file=''
submit_input_file=''
lookup_input_file=''
remote_argument_file_identity=''
remote_input_file_identity=''
submit_input_file_identity=''
lookup_input_file_identity=''
mutation_log_file=''
# Set by run_ssh_logged on every call: the controlled reason token found on the
# remote command's stderr, or empty.  A global rather than a return value because
# run_ssh_logged's exit status is already the ssh exit code, and both callers (the
# operation path and the mutation path) need the same value.
agentq_remote_failure_reason_value=''
# The protected file the remote command's stderr is captured into while an SSH
# call is in flight.  A global, and registered in cleanup_client_runtime, because
# run_ssh_logged can return early (an input temporary that fails its identity
# check, for instance) and those early returns run BEFORE its own removal at the
# end of the function -- so without this the capture outlived every one of them.
# Its identity is recorded at creation because the removal helper refuses to
# delete a path whose identity was never recorded, which is the same rule every
# other temporary here follows.
ssh_stderr_capture=''
ssh_stderr_capture_identity=''
mutation_output_file=''
agentq_recovery_log_file=''
agentq_recovery_output_file=''
agentq_operation_log_file=''
agentq_operation_output_file=''
platform_probe_output_file=''
platform_probe_log_file=''
platform_probe_output_identity=''
platform_probe_log_identity=''
platform_probe_stdin_file=''
platform_probe_stdin_identity=''
windows_probe_prepared_command_line=''
windows_encoding_input=''
windows_encoding_output=''
windows_encoding_input_identity=''
windows_encoding_output_identity=''
agentq_temp_directory=''
# Credential source for ssh password authentication.  Empty means "no password
# source configured", which keeps BatchMode=yes exactly as it always was -- the
# fail-fast, never-hangs behaviour an unattended queue depends on.  A non-empty
# value switches ssh to BatchMode=no plus an askpass program.
#
# AGENTQ_ASKPASS names a program (a system credential helper, or the user's own
# script) that ssh executes to obtain the secret.  AgentQ never reads, stores,
# or logs the secret itself: it only passes the program name through.  That is
# why this outranks the plaintext forms below.
agentq_credential_source=''
# The program ssh executes.  For the AGENTQ_ASKPASS source this is the user's
# own file and must NEVER be removed; for the AGENTQ_PASSWORD source it is a
# temporary this client creates and must always be removed.  The two are kept
# in separate variables so that cleanup can never touch a user-supplied path.
agentq_askpass_program=''
agentq_askpass_temporary=''
agentq_askpass_temporary_identity=''
agentq_credential_option_lines=''
agentq_password_prompt=0
agentq_number_of_password_prompts=1


# Every identity helper below needs the same thing from stat, and each call
# used to probe both flavors: GNU's `-c` (always fails on BSD) and BSD's `-f`.
# On a machine where a fork+exec costs ~15ms and one invocation makes dozens of
# them, that doubled the cost for nothing.  The flavor is probed once, near the
# top of the file, and everything after that uses only the form this platform
# supports.
detect_stat_flavor() {
    if [ -n "$stat_flavor" ]; then
        return 0
    fi
    if stat -c '%d:%i' -- "$0" >/dev/null 2>&1; then
        stat_flavor=gnu
    elif stat -f '%d:%i' "$0" >/dev/null 2>&1; then
        stat_flavor=bsd
    else
        return 1
    fi
}

# Emit `device:inode` for a path, or return non-zero.  Callers validate the
# output exactly as before.  Falls back to probing when the cache is unset, so
# this stays correct if it is ever called before main() has run -- the probe
# result is only cached when it happens in the top-level shell.
stat_device_inode() {
    stat_device_inode_path=$1
    stat_device_inode_identity=''

    if [ -z "$stat_flavor" ]; then
        detect_stat_flavor || return 1
    fi
    if [ "$stat_flavor" = gnu ]; then
        stat_device_inode_identity=$(stat -c '%d:%i' -- "$stat_device_inode_path" 2>/dev/null) || return 1
    else
        stat_device_inode_identity=$(stat -f '%d:%i' "$stat_device_inode_path" 2>/dev/null) || return 1
    fi
    printf '%s\n' "$stat_device_inode_identity"
}

# Probe the stat flavor once, in the top-level shell, as soon as the helper
# exists.  Placement matters twice over: the identity helpers are reached
# through command substitutions during config resolution -- before any of the
# top-level command dispatch -- and a probe cached inside a subshell is thrown
# away with it, so probing later would leave every one of those calls
# re-probing.  Defining the function first is what makes this callable here.
detect_stat_flavor || {
    # fail() is not defined until later in the file, so report this directly.
    printf '%s: cannot determine how to read file identity on this platform\n' "${0##*/}" >&2
    exit 2
}

config_snapshot_identity_for_path() {
    config_snapshot_identity_path=$1
    config_snapshot_identity=''

    if config_snapshot_identity=$(stat_device_inode "$config_snapshot_identity_path"); then
        :
    else
        return 1
    fi
    case "$config_snapshot_identity" in
        ''|*[!0-9:]*|*:*:*) return 1 ;;
    esac
    printf '%s\n' "$config_snapshot_identity"
}

config_source_path_chain_identity_for_path() {
    config_source_chain_guard_path=$1
    case "$config_source_chain_guard_path" in
        '') return 1 ;;
    esac
    case "/$config_source_chain_guard_path/" in
        */../*) return 1 ;;
    esac

    config_source_chain_probe='.'
    config_source_chain_remaining=$config_source_chain_guard_path
    case "$config_source_chain_remaining" in
        /*)
            config_source_chain_probe=/
            config_source_chain_remaining=${config_source_chain_remaining#/}
            ;;
    esac

    config_source_chain_identity=''
    while [ -n "$config_source_chain_remaining" ]; do
        case "$config_source_chain_remaining" in
            */*)
                config_source_chain_component=${config_source_chain_remaining%%/*}
                config_source_chain_remaining=${config_source_chain_remaining#*/}
                ;;
            *)
                config_source_chain_component=$config_source_chain_remaining
                config_source_chain_remaining=''
                ;;
        esac
        case "$config_source_chain_component" in
            ''|.) continue ;;
            ..) return 1 ;;
        esac
        if [ "$config_source_chain_probe" = / ]; then
            config_source_chain_probe=/$config_source_chain_component
        else
            config_source_chain_probe=$config_source_chain_probe/$config_source_chain_component
        fi
        [ ! -L "$config_source_chain_probe" ] || return 1
        config_source_chain_component_identity=$(config_snapshot_identity_for_path "$config_source_chain_probe") || return 1
        if [ -n "$config_source_chain_identity" ]; then
            config_source_chain_identity=$config_source_chain_identity/$config_source_chain_component_identity
        else
            config_source_chain_identity=$config_source_chain_component_identity
        fi
    done

    [ -n "$config_source_chain_identity" ] || return 1
    printf '%s\n' "$config_source_chain_identity"
}

config_snapshot_path_is_safe() {
    config_snapshot_guard_path=$1
    case "$config_snapshot_guard_path" in
        '') return 1 ;;
    esac
    case "/$config_snapshot_guard_path/" in
        */../*) return 1 ;;
    esac

    config_snapshot_probe='.'
    config_snapshot_remaining=$config_snapshot_guard_path
    case "$config_snapshot_remaining" in
        /*)
            config_snapshot_probe=/
            config_snapshot_remaining=${config_snapshot_remaining#/}
            ;;
    esac

    while [ -n "$config_snapshot_remaining" ]; do
        case "$config_snapshot_remaining" in
            */*)
                config_snapshot_component=${config_snapshot_remaining%%/*}
                config_snapshot_remaining=${config_snapshot_remaining#*/}
                ;;
            *)
                config_snapshot_component=$config_snapshot_remaining
                config_snapshot_remaining=''
                ;;
        esac
        [ -n "$config_snapshot_component" ] || continue
        [ "$config_snapshot_component" = . ] && continue
        if [ "$config_snapshot_probe" = / ]; then
            config_snapshot_probe=/$config_snapshot_component
        else
            config_snapshot_probe=$config_snapshot_probe/$config_snapshot_component
        fi
        [ ! -L "$config_snapshot_probe" ] || return 1
    done

    [ -d "$config_snapshot_guard_path" ] && [ ! -L "$config_snapshot_guard_path" ]
}

config_snapshot_directory_is_current() {
    [ -n "$config_snapshot_directory" ] || return 1
    config_snapshot_path_is_safe "$config_snapshot_directory" || return 1
    [ -d "$config_snapshot_directory" ] && [ ! -L "$config_snapshot_directory" ] || return 1
    [ -n "$config_snapshot_directory_identity" ] || return 1
    config_snapshot_directory_observed_identity=$(config_snapshot_identity_for_path "$config_snapshot_directory") || return 1
    [ "$config_snapshot_directory_observed_identity" = "$config_snapshot_directory_identity" ]
}

config_snapshot_file_is_current() {
    [ -n "$config_snapshot_file" ] || return 1
    config_snapshot_file_parent=${config_snapshot_file%/*}
    config_snapshot_file_name=${config_snapshot_file##*/}
    [ -n "$config_snapshot_file_name" ] || return 1
    [ "$config_snapshot_file_parent" != "$config_snapshot_file" ] || config_snapshot_file_parent=.
    config_snapshot_path_is_safe "$config_snapshot_file_parent" || return 1
    [ -f "$config_snapshot_file" ] && [ ! -L "$config_snapshot_file" ] || return 1
    [ -n "$config_snapshot_file_identity" ] || return 1
    config_snapshot_file_observed_identity=$(config_snapshot_identity_for_path "$config_snapshot_file") || return 1
    [ "$config_snapshot_file_observed_identity" = "$config_snapshot_file_identity" ]
}

config_source_file_is_current() {
    [ -n "$config_path" ] || return 1
    [ -f "$config_path" ] && [ ! -L "$config_path" ] || return 1
    [ -n "$config_source_path_chain_identity" ] || return 1
    config_source_path_chain_observed_identity=$(config_source_path_chain_identity_for_path "$config_path") || return 1
    [ "$config_source_path_chain_observed_identity" = "$config_source_path_chain_identity" ] || return 1
    [ -n "$config_source_identity" ] || return 1
    config_source_observed_identity=$(config_snapshot_identity_for_path "$config_path") || return 1
    [ "$config_source_observed_identity" = "$config_source_identity" ]
}

cleanup_config_snapshot() {
    cleanup_config_snapshot_status=0
    if [ -n "$config_snapshot_file" ]; then
        if [ -e "$config_snapshot_file" ] || [ -L "$config_snapshot_file" ]; then
            if config_snapshot_file_is_current; then
                if ! rm -f -- "$config_snapshot_file"; then
                    printf '%s: failed to remove configuration snapshot file; preserving it: %s\n' "$program" "$config_snapshot_file" >&2
                    cleanup_config_snapshot_status=1
                elif [ -e "$config_snapshot_file" ] || [ -L "$config_snapshot_file" ]; then
                    printf '%s: configuration snapshot file remained after cleanup; preserving it: %s\n' "$program" "$config_snapshot_file" >&2
                    cleanup_config_snapshot_status=1
                fi
            else
                printf '%s: refusing to remove an unsafe configuration snapshot file; preserving it: %s\n' "$program" "$config_snapshot_file" >&2
                cleanup_config_snapshot_status=1
            fi
        fi
        config_snapshot_file=''
        config_snapshot_file_identity=''
    fi
    if [ -n "$config_snapshot_directory" ]; then
        if [ -e "$config_snapshot_directory" ] || [ -L "$config_snapshot_directory" ]; then
            if config_snapshot_directory_is_current; then
                if ! rmdir -- "$config_snapshot_directory"; then
                    printf '%s: failed to remove configuration snapshot directory; preserving it: %s\n' "$program" "$config_snapshot_directory" >&2
                    cleanup_config_snapshot_status=1
                elif [ -e "$config_snapshot_directory" ] || [ -L "$config_snapshot_directory" ]; then
                    printf '%s: configuration snapshot directory remained after cleanup; preserving it: %s\n' "$program" "$config_snapshot_directory" >&2
                    cleanup_config_snapshot_status=1
                fi
            else
                printf '%s: refusing to remove an unsafe configuration snapshot directory; preserving it: %s\n' "$program" "$config_snapshot_directory" >&2
                cleanup_config_snapshot_status=1
            fi
        fi
        config_snapshot_directory=''
        config_snapshot_directory_identity=''
    fi
    return "$cleanup_config_snapshot_status"
}

trap cleanup_config_snapshot EXIT HUP INT TERM

if [ -L "$config_path" ]; then
    printf '%s: AGENTQ_CONFIG must be a regular file; symbolic links are not accepted\n' "$program" >&2
    exit 2
fi
if [ -e "$config_path" ] && [ ! -f "$config_path" ]; then
    printf '%s: AGENTQ_CONFIG must be a regular file\n' "$program" >&2
    exit 2
fi
if [ -r "$config_path" ]; then
    if ! command -v stat >/dev/null 2>&1; then
        printf '%s: stat is required to protect configuration snapshot identity\n' "$program" >&2
        exit 2
    fi
    if ! config_snapshot_directory=$(mktemp -d "${TMPDIR:-/tmp}/agentq-config.XXXXXX"); then
        printf '%s: cannot create a configuration snapshot\n' "$program" >&2
        exit 2
    fi
    if ! config_snapshot_directory=$(unset CDPATH; cd -- "$config_snapshot_directory" 2>/dev/null && pwd -P); then
        printf '%s: cannot resolve configuration snapshot directory\n' "$program" >&2
        exit 2
    fi
    if ! config_snapshot_directory_identity=$(config_snapshot_identity_for_path "$config_snapshot_directory"); then
        printf '%s: cannot record configuration snapshot directory identity\n' "$program" >&2
        exit 2
    fi
    if ! config_snapshot_directory_is_current; then
        printf '%s: configuration snapshot directory changed before reading\n' "$program" >&2
        exit 2
    fi
    if ! config_source_path_chain_identity=$(config_source_path_chain_identity_for_path "$config_path"); then
        printf '%s: AGENTQ_CONFIG path is unsafe or unavailable\n' "$program" >&2
        exit 2
    fi
    if ! config_source_identity=$(config_snapshot_identity_for_path "$config_path"); then
        printf '%s: cannot record AGENTQ_CONFIG identity\n' "$program" >&2
        exit 2
    fi
    if ! config_source_file_is_current; then
        printf '%s: AGENTQ_CONFIG changed before bounded read\n' "$program" >&2
        exit 2
    fi
    config_snapshot_file=$config_snapshot_directory/config
    if ! dd if="$config_path" bs=$((config_max_bytes + 1)) count=1 of="$config_snapshot_file" 2>/dev/null; then
        if [ -f "$config_snapshot_file" ] && [ ! -L "$config_snapshot_file" ]; then
            config_snapshot_file_identity=$(config_snapshot_identity_for_path "$config_snapshot_file") || config_snapshot_file_identity=''
        fi
        printf '%s: AGENTQ_CONFIG could not be read\n' "$program" >&2
        exit 2
    fi
    if ! config_snapshot_file_identity=$(config_snapshot_identity_for_path "$config_snapshot_file"); then
        printf '%s: cannot record configuration snapshot file identity\n' "$program" >&2
        exit 2
    fi
    if ! config_snapshot_file_is_current; then
        printf '%s: configuration snapshot file changed before validation\n' "$program" >&2
        exit 2
    fi
    if ! config_source_file_is_current; then
        printf '%s: AGENTQ_CONFIG changed during bounded read\n' "$program" >&2
        exit 2
    fi
    if ! config_hex=$(LC_ALL=C od -An -tx1 "$config_snapshot_file"); then
        printf '%s: AGENTQ_CONFIG could not be inspected\n' "$program" >&2
        exit 2
    fi
    case " $config_hex " in
        *[[:space:]]00[[:space:]]*)
            printf '%s: AGENTQ_CONFIG contains NUL bytes; text syntax is required\n' "$program" >&2
            exit 2
            ;;
    esac
    if ! config_probe=$(
        set -e
        config_snapshot_file_is_current
        dd if="$config_snapshot_file" bs=$((config_max_bytes + 1)) count=1 2>/dev/null
        printf '%s' "$config_marker"
    ); then
        printf '%s: AGENTQ_CONFIG could not be read\n' "$program" >&2
        exit 2
    fi
    config_probe_bytes=$(LC_ALL=C printf '%s' "$config_probe" | wc -c | tr -d '[:space:]')
    config_marker_bytes=$(LC_ALL=C printf '%s' "$config_marker" | wc -c | tr -d '[:space:]')
    config_bytes=$((config_probe_bytes - config_marker_bytes))
    if [ "$config_bytes" -gt "$config_max_bytes" ]; then
        printf '%s: AGENTQ_CONFIG exceeds the fixed limit of %s bytes\n' "$program" "$config_max_bytes" >&2
        exit 2
    fi
    if ! config_snapshot_file_is_current; then
        printf '%s: configuration snapshot file changed during validation\n' "$program" >&2
        exit 2
    fi
    config_text=${config_probe%"$config_marker"}
    configured_host=$(printf '%s' "$config_text" | sed -n 's/^AGENTQ_HOST=\([^[:space:]]*\)$/\1/p' | tail -n 1)
    if ! cleanup_config_snapshot; then
        printf '%s: configuration snapshot cleanup was not verified\n' "$program" >&2
        exit 2
    fi
fi

default_host=${AGENTQ_HOST:-$configured_host}

# ---------------------------------------------------------------------------
# Password authentication sources
#
# ssh only tries password / keyboard-interactive authentication when
# BatchMode=yes is absent (BatchMode sets `batch_flag` on those two methods, so
# they are never even offered -- it does not merely decline them), AND, with no
# tty, only when an askpass program answers the prompt.  Both halves are
# required: dropping BatchMode alone would leave ssh reading the terminal, and
# an askpass program alone is never consulted while BatchMode is on.
#
# Nothing here is enabled by default.  With no source configured the client
# behaves exactly as it did before this feature existed: BatchMode=yes, fail
# fast, never wait for input.
# ---------------------------------------------------------------------------

# Refuse to run rather than silently fall back to key-only auth: a silent
# fallback would leave the operator believing a password was being used.
credential_refuse() {
    printf '%s: %s\n' "$program" "$1" >&2
    printf '%s: refusing to run; unset the credential variable to go back to key-only authentication\n' \
        "$program" >&2
    exit 2
}

# A usable askpass program is a regular, executable, non-symlink file.  The
# symlink rejection matters most: a link could be repointed between this check
# and ssh's exec of it.
resolve_credential_source() {
    agentq_askpass_program=${AGENTQ_ASKPASS:-}

    if [ -n "$agentq_askpass_program" ]; then
        # ssh executes the WHOLE SSH_ASKPASS value as a single file name -- there is
        # no shell in between and no word splitting.  So the value is legal exactly
        # when it names an existing executable file, spaces and all: a path under
        # "Program Files" is fine, while a value carrying an argument or
        # surrounding quotes is not.  The test is therefore the FILE SYSTEM, not
        # the characters -- rejecting anything containing a space would refuse
        # good paths.
        #
        # When the whole value is not a file, say WHY, because "does not exist" is
        # wrong and misleading when the file is right there and only the shape is
        # off.  (Measured: a bare path authenticates; both of the shapes below fail.)
        if [ ! -e "$agentq_askpass_program" ] && [ ! -L "$agentq_askpass_program" ]; then
            case $agentq_askpass_program in
                *'"'*|*' '*)
                    credential_refuse "AGENTQ_ASKPASS must be a single executable path with no arguments and no quotes; ssh executes the whole value as one file name, so neither is supported: $agentq_askpass_program"
                    ;;
            esac
        fi
        if [ -L "$agentq_askpass_program" ]; then
            credential_refuse "AGENTQ_ASKPASS must be a regular file; symbolic links are not accepted: $agentq_askpass_program"
        fi
        if [ ! -e "$agentq_askpass_program" ]; then
            credential_refuse "AGENTQ_ASKPASS does not exist: $agentq_askpass_program"
        fi
        if [ ! -f "$agentq_askpass_program" ]; then
            credential_refuse "AGENTQ_ASKPASS must be a regular file: $agentq_askpass_program"
        fi
        if [ ! -x "$agentq_askpass_program" ]; then
            credential_refuse "AGENTQ_ASKPASS is not executable: $agentq_askpass_program"
        fi
        # An askpass program is the whole point of that variable; a password
        # alongside it would be silently ignored, which is worse than refusing.
        if [ -n "${AGENTQ_PASSWORD:-}" ]; then
            credential_refuse 'AGENTQ_ASKPASS and AGENTQ_PASSWORD are both set; set only one'
        fi
        # Same for the prompt source: with an askpass program configured the
        # prompt is silently unreachable, and silent ignoring is what this
        # function exists to refuse.
        if [ -n "${AGENTQ_PASSWORD_PROMPT:-}" ]; then
            credential_refuse 'AGENTQ_ASKPASS and AGENTQ_PASSWORD_PROMPT are both set; set only one'
        fi
        agentq_credential_source=askpass
        return 0
    fi

    if [ -n "${AGENTQ_PASSWORD:-}" ]; then
        # There is no way to check the permissions of an environment variable.
        # It is accepted because the user asked for it, and because it is
        # strictly better than a plaintext file on disk -- but it is NOT
        # protected, and the documentation says so.
        agentq_credential_source=password
        return 0
    fi

    case "${AGENTQ_PASSWORD_PROMPT:-}" in
        ''|0) ;;
        1)
            # ssh reads the password from the terminal.  With no terminal it
            # falls back to STDIN, and STDIN is where submit carries its
            # payload -- so a prompt source without a tty would silently eat
            # the request instead of failing.  Refuse, rather than find out.
            if [ ! -t 0 ]; then
                credential_refuse 'AGENTQ_PASSWORD_PROMPT requires a terminal, but standard input is not one'
            fi
            agentq_credential_source=prompt
            ;;
        *) credential_refuse 'AGENTQ_PASSWORD_PROMPT must be 1 (or unset)' ;;
    esac
}

# The askpass program is the only thing ssh sees; the secret never passes
# through this client as an argument.  For AGENTQ_PASSWORD the wrapper is a 0600
# temporary registered for removal on every exit path.  NOTE, precisely: the
# wrapper READS the password from the environment, so the password does sit in
# the environment of each ssh child that runs it -- that is unavoidable while the
# secret comes from an env var at all, and it is why AGENTQ_ASKPASS (a program
# the client never reads) is the preferred source.  What this buys is that the
# secret is never an argv (so never in a process listing) and never written to
# disk: the wrapper file itself contains only the literal string
# "$AGENTQ_PASSWORD", not its value.
prepare_credential_delivery() {
    [ "$agentq_credential_source" = password ] || return 0
    resolve_agentq_temp_directory || return $?

    agentq_askpass_temporary=''
    if agentq_askpass_temporary=$(umask 077; make_client_temporary_file "$agentq_temp_directory" 'agentq-askpass'); then
        :
    else
        agentq_askpass_temporary=''
        printf '%s: cannot allocate a temporary askpass program\n' "$program" >&2
        return 1
    fi
    if agentq_askpass_temporary_identity=$(windows_argument_file_identity "$agentq_askpass_temporary"); then
        :
    else
        printf '%s: cannot record askpass temporary identity: %s\n' "$program" "$agentq_askpass_temporary" >&2
        return 1
    fi
    # Written by redirection, never as an argv: the value must not appear in a
    # process listing.  The secret is read from the environment by the wrapper,
    # which is why the wrapper itself carries no credential.
    (umask 077; cat > "$agentq_askpass_temporary") <<'AGENTQ_ASKPASS_WRAPPER'
#!/bin/sh
printf '%s\n' "$AGENTQ_PASSWORD"
AGENTQ_ASKPASS_WRAPPER
    # A failed chmod is not a permission WIDENING -- creation already happened
    # under umask 077, so a failure leaves 0600, which is stricter than the 0700
    # asked for.  It is still reported rather than swallowed: the identity check
    # below compares device/inode only, so a lost chmod would be invisible, and
    # this file has been bitten before by a call that "succeeded" while changing
    # nothing (the Windows chmod-is-a-no-op case).
    if ! chmod 700 "$agentq_askpass_temporary" 2>/dev/null; then
        printf '%s: cannot set the askpass program mode to 0700 (it stays at the umask default, which is stricter): %s\n' \
            "$program" "$agentq_askpass_temporary" >&2
    fi
    windows_argument_verify_identity "$agentq_askpass_temporary" "$agentq_askpass_temporary_identity" 'after writing askpass program' || return $?
