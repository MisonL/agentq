        if windows_argument_remove_file "$agentq_askpass_temporary" "$agentq_askpass_temporary_identity"; then
            :
        else
            cleanup_client_runtime_askpass_status=$?
            if [ "$cleanup_client_runtime_status" -eq 0 ]; then
                cleanup_client_runtime_status=$cleanup_client_runtime_askpass_status
            fi
        fi
    fi
    if [ -n "$windows_encoding_input" ]; then
        if windows_encoding_remove_file "$windows_encoding_input" "$windows_encoding_input_identity"; then
            :
        else
            cleanup_client_runtime_windows_encoding_input_status=$?
            if [ "$cleanup_client_runtime_status" -eq 0 ]; then
                cleanup_client_runtime_status=$cleanup_client_runtime_windows_encoding_input_status
            fi
        fi
    fi
    if [ -n "$windows_encoding_output" ]; then
        if windows_encoding_remove_file "$windows_encoding_output" "$windows_encoding_output_identity"; then
            :
        else
            cleanup_client_runtime_windows_encoding_output_status=$?
            if [ "$cleanup_client_runtime_status" -eq 0 ]; then
                cleanup_client_runtime_status=$cleanup_client_runtime_windows_encoding_output_status
            fi
        fi
    fi
    return "$cleanup_client_runtime_status"
}

# The EXIT trap owns ALL cleanup (it calls cleanup_config_snapshot first, then
# removes every runtime temporary).  The signal traps must therefore run that
# same function and then EXIT -- not merely return.  A signal handler that
# returns lets the shell RESUME the interrupted operation (verified: a handler
# for HUP/INT/TERM that does not exit leaves the script running past the
# interrupt), so a Ctrl-C during `wait` would neither stop nor clean up.
# `sshp` and `install-client.sh` already use this `exit 130` form; this client
# was the one place they diverged.  The earlier `trap cleanup_config_snapshot
# EXIT HUP INT TERM` at the top rebinds HUP/INT/TERM to a function that trims
# only the config snapshot, so it is superseded here where the full runtime
# cleanup is defined.
trap cleanup_client_runtime EXIT
trap 'cleanup_client_runtime; exit 130' HUP INT TERM

windows_argument_identity_for_path() {
    windows_argument_lookup_path=$1
    case "$windows_argument_lookup_path" in
        "$remote_argument_file") printf '%s\n' "$remote_argument_file_identity" ;;
        "$remote_input_file") printf '%s\n' "$remote_input_file_identity" ;;
        "$submit_input_file") printf '%s\n' "$submit_input_file_identity" ;;
        "$lookup_input_file") printf '%s\n' "$lookup_input_file_identity" ;;
        "$platform_probe_stdin_file") printf '%s\n' "$platform_probe_stdin_identity" ;;
        "$agentq_askpass_temporary") printf '%s\n' "$agentq_askpass_temporary_identity" ;;
        *) return 1 ;;
    esac
}

resolve_ssh_binary() {
    if [ -n "$ssh_binary" ]; then
        [ -x "$ssh_binary" ] || fail "AGENTQ_SSH is not executable: $ssh_binary"
        return
    fi

    ssh_binary=$(command -v ssh 2>/dev/null || true)
    [ -n "$ssh_binary" ] || fail 'OpenSSH client is required; install ssh or set AGENTQ_SSH'
}

resolve_json_parser() {
    if [ -n "$json_parser" ]; then
        [ -x "$json_parser" ] || fail "AGENTQ_JQ is not executable: $json_parser"
        return
    fi

    json_parser=$(command -v jq 2>/dev/null || true)
    [ -n "$json_parser" ] || fail 'jq is required to validate AgentQ JSON responses; install jq or set AGENTQ_JQ'
}

write_response_metadata() {
    response_file=$1
    response_metadata_require_file "$response_file" || return $?
    response_metadata_require_file "$response_file" || return $?
    response_bytes=$(wc -c < "$response_file" | tr -d '[:space:]')
    printf '%s: raw response omitted for safety (%s bytes)\n' "$program" "$response_bytes" >&2
}

agentq_remote_failure_reason() {
    # 服务端在每条以 2 退出的失败路径上都会多打一行 `reason=<class>`（机读通道，
    # 见 agentq-server 的 fail()）。这里把它从 SSH 日志里取出来并**只**透传这一
    # 个受控的标识符：字符集限定为小写字母与下划线，所以远端无法借这一行把任意
    # 文本注入调用端的 stderr。日志原文的其余部分仍然只以脱敏元数据呈现。
    ssh_reason_log=$1
    agentq_ssh_log_require_existing_file "$ssh_reason_log" || return 1
    ssh_reason_value=$(LC_ALL=C tr -d '\r' < "$ssh_reason_log" |
        LC_ALL=C sed -n 's/^[^:]*: reason=\([a-z][a-z_]*\)$/\1/p' | tail -n 1)
    [ -n "$ssh_reason_value" ] || return 1
    printf '%s\n' "$ssh_reason_value"
}

# The Windows launcher wrapper reports its status out of band on stderr as
# `agentq-exit:<code>`, because an sshd whose DefaultShell is powershell.exe
# flattens the exit code of a native child to 1 -- so the SSH exit code cannot
# be trusted there.  Same discipline as the reason token above: extract only the
# controlled identifier (digits) and never echo the surrounding stderr.  Only
# the Windows wrapper emits it, so a unix target is unaffected.
agentq_remote_exit_token() {
    ssh_exit_token_log=$1
    agentq_ssh_log_require_existing_file "$ssh_exit_token_log" || return 1
    # At most three digits: the protocol codes are 0-255.  An unbounded token
    # was measured fail-open on 2026-10-06 -- a remote sending
    # `agentq-exit:99999999999999999999` made `return "$ssh_status"` fail with
    # "numeric argument required", which under `set -e` in a condition context
    # read as success, so the client exited 0 on a forged failure.  A token that
    # cannot be a protocol code is not ours; ignoring it falls back to the SSH
    # exit code, which is the fail-closed direction.
    ssh_exit_token_value=$(LC_ALL=C tr -d '\r' < "$ssh_exit_token_log" |
        LC_ALL=C sed -n 's/^agentq-exit:\([0-9]\{1,3\}\)$/\1/p' | tail -n 1)
    [ -n "$ssh_exit_token_value" ] || return 1
    printf '%s\n' "$ssh_exit_token_value"
}

write_ssh_diagnostic_metadata() {
    ssh_metadata_file=$1
    agentq_ssh_log_require_existing_file "$ssh_metadata_file" || return $?
    agentq_ssh_log_require_existing_file "$ssh_metadata_file" || return $?
    ssh_metadata_bytes=$(wc -c < "$ssh_metadata_file" | tr -d '[:space:]')
    if ssh_transport_error "$ssh_metadata_file"; then
        ssh_metadata_class=transport
    else
        agentq_ssh_log_require_existing_file "$ssh_metadata_file" || return $?
        if LC_ALL=C tr -d '\r' < "$ssh_metadata_file" | LC_ALL=C grep -E -q \
            '^([^:]*: )?(Permission denied|Host key verification failed|Could not resolve hostname|No supported authentication methods available)'; then
            ssh_metadata_class=authentication
        else
            ssh_metadata_class=ssh
        fi
    fi
    printf '%s: SSH diagnostic omitted for safety (class=%s, %s bytes)\n' \
        "$program" "$ssh_metadata_class" "$ssh_metadata_bytes" >&2
    # The class line alone does not tell the operator what to DO, and the next
    # line the caller prints on a failed platform probe ("set
    # AGENTQ_REMOTE_PLATFORM") actively points the wrong way: no value of that
    # variable fixes a missing key.  Measured on a real macOS host offering only
    # password auth: every AgentQ command failed with the AGENTQ_REMOTE_PLATFORM
    # hint and nothing else, which reads like a remote service fault.
    #
    # The hint goes HERE, not at the caller's decision point, because by then
    # both the log file and the class are gone: run_platform_probe is invoked as
    # `local_platform_output=$(run_platform_probe_with_recovery ...)`, and a
    # command substitution runs in a subshell, so the globals it sets (and the
    # temporary it cleans up) never reach the caller.  That is the same trap as
    # the A5a probe-script defect -- third time in this project.
    # The wording depends on whether a credential source is in play, because
    # the advice that fixes one case is wrong for the other: telling an operator
    # to install a key is useless when they already handed AgentQ a password,
    # and telling them their password was rejected is wrong when none was
    # configured.  The unconfigured branch is byte-for-byte the message this
    # client has always printed.
    if [ "$ssh_metadata_class" = authentication ]; then
        if [ "$agentq_credential_source" = '' ]; then
            printf '%s: ssh could not authenticate to %s; AgentQ runs ssh with BatchMode=yes, so it cannot answer a password prompt. Install a key for this host, or use an ssh-agent.\n' \
                "$program" "$host" >&2
            printf '%s: to authenticate with a password instead, set AGENTQ_ASKPASS to a program that prints it (for example a system credential helper), or set AGENTQ_PASSWORD.\n' \
                "$program" >&2
        else
            printf '%s: ssh could not authenticate to %s even though a credential source (%s) is configured. Either the password was rejected, or the host does not accept password authentication; keys are tried first, so a key is not the problem.\n' \
                "$program" "$host" "$agentq_credential_source" >&2
        fi
    fi
}

validate_json_response() {
    response_file=$1
    response_operation=$2
    response_expected_request_id=${3:-}
    response_expected_task_id=${4:-}
    response_require_existing_file "$response_file" || return $?
    # shellcheck disable=SC2016
    response_numeric_helpers='def parser_preserves_integer_digits: (9007199254740993 | tostring) == "9007199254740993"; def lexical_integer: (tostring | test("^[0-9]+(?:\\.0+)?$")); def nonnegative_integer: if type == "number" then (. >= 0 and (floor == .) and ((. <= 9007199254740991) or (parser_preserves_integer_digits and lexical_integer))) else false end; def canonical_integer_string: if . == 0 then "0" elif . <= 9007199254740991 then (floor | tostring | sub("^0+"; "") | if . == "" then "0" else . end) else (tostring | sub("\\.0+$"; "") | sub("^0+"; "") | if . == "" then "0" else . end) end; def canonical_decimal_key: tostring | sub("^0+"; "") | if . == "" then "0" else . end; def valid_status_task: (.value | type) == "object" and (.value.id | nonnegative_integer) and (.key | test("^[0-9]+$")) and ((.key | canonical_decimal_key) == .key) and ((.value.id | canonical_integer_string) == (.key | canonical_decimal_key)); def task_id_matches($expected): nonnegative_integer and (canonical_integer_string == ($expected | sub("^0+"; "") | if . == "" then "0" else . end)); def valid_done_result: if type == "string" then length > 0 elif type == "object" then length > 0 else false end;'
    # shellcheck disable=SC2016
    case "$response_operation" in
        submit)
            response_filter="$response_numeric_helpers"' .[0] as $response | if length == 1 and ($response | type == "object") and ($response.task_id | nonnegative_integer) and ($response.request_id | type == "string") and ($response.request_id | length > 0) and (($expected_request_id_present | not) or $response.request_id == $expected_request_id) and ($response.reused | type == "boolean") then true else false end'
            ;;
        lookup)
            response_filter="$response_numeric_helpers"' .[0] as $response | if length == 1 and ($response | type == "object") and ($response.request_id | type == "string") and ($response.request_id | length > 0) and (($expected_request_id_present | not) or $response.request_id == $expected_request_id) and ((($response | has("reused")) and (($response | has("state")) | not) and ($response.task_id | nonnegative_integer) and ($response.reused | type == "boolean")) or (($response | has("state")) and (($response | has("reused")) | not) and ($response.state | type == "string") and ($response | has("task_id")) and (if $response.state == "not_found" or $response.state == "not_started" or $response.state == "ambiguous" then $response.task_id == null elif $response.state == "accepted" or $response.state == "removing" or $response.state == "removed" then ($response.task_id | nonnegative_integer) else false end))) then true else false end'
            ;;
        status|doctor)
            response_filter="$response_numeric_helpers"' .[0] as $response | if length == 1 and ($response | type == "object") and ($response.tasks | type == "object") and ($response.tasks | to_entries | all(.[]; valid_status_task)) then true else false end'
            ;;
        logs)
            response_filter="$response_numeric_helpers"' .[0] as $response | if length == 1 and ($response | type == "object") and ($response.task | type == "object") and ($response.task.id | nonnegative_integer) and (if $expected_task_id_present then ($response.task.id | task_id_matches($expected_task_id)) else true end) and ($response | has("output")) and (((($response.output | type) == "string") and (($response | has("output_encoding") | not)) and (($response | has("output_base64") | not))) or ($response.output == null and $response.output_encoding == "base64" and (if ($response.output_base64 | type) == "string" then (($response.output_base64 | length) > 0 and ($response.output_base64 | test("^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"))) else false end))) then true else false end'
            ;;
        wait)
            response_filter="$response_numeric_helpers"' .[0] as $response | if length == 1 and ($response | type == "object") and (((($response.task | type) == "object") and ($response.task.id | nonnegative_integer) and (if $expected_task_id_present then ($response.task.id | task_id_matches($expected_task_id)) else true end) and (($response.task.status | type) == "object") and (($response.task.status.Done | type) == "object") and ($response.task.status.Done | has("result")) and ($response.task.status.Done.result | valid_done_result)) or (($response.task_id | nonnegative_integer) and (if $expected_task_id_present then ($response.task_id | task_id_matches($expected_task_id)) else true end) and ($response.state == "removed" or $response.state == "unavailable"))) then true else false end'
            ;;
        cancel)
            response_filter="$response_numeric_helpers"' .[0] as $response | if length == 1 and ($response | type == "object") and (($response.task_id | nonnegative_integer) and (if $expected_task_id_present then ($response.task_id | task_id_matches($expected_task_id)) else true end)) and ($response.action == "cancel_requested") and ($response.cancellation_requested_at | type == "string") and ($response.cancellation_requested_at | length > 0) and ((($response | has("cancellation_mode")) | not) or ($response.cancellation_mode == "queued_removed")) then true else false end'
            ;;
        cancel_pending)
            response_filter="$response_numeric_helpers"' .[0] as $response | if length == 1 and ($response | type == "object") and (($response.task_id | nonnegative_integer) and (if $expected_task_id_present then ($response.task_id | task_id_matches($expected_task_id)) else true end)) and ($response.state == "cancellation_pending") and ($response.cancellation_requested_at | type == "string") and ($response.cancellation_requested_at | length > 0) then true else false end'
            ;;
        remove)
            response_filter="$response_numeric_helpers"' .[0] as $response | if length == 1 and ($response | type == "object") and (($response.task_id | nonnegative_integer) and (if $expected_task_id_present then ($response.task_id | task_id_matches($expected_task_id)) else true end)) and ($response.removed == true) then true else false end'
            ;;
        *)
            response_filter='.[0] as $response | if length == 1 and ($response | type == "object") then true else false end'
            ;;
    esac

    response_require_existing_file "$response_file" || return $?
    if "$json_parser" -e -s --arg expected_request_id "$response_expected_request_id" \
        --arg expected_task_id "$response_expected_task_id" \
        --argjson expected_task_id_present "$(if [ -n "$response_expected_task_id" ]; then printf true; else printf false; fi)" \
        --argjson expected_request_id_present "$(if [ -n "$response_expected_request_id" ]; then printf true; else printf false; fi)" \
        "$response_filter" "$response_file" >/dev/null; then
        return 0
    fi

    response_require_existing_file "$response_file" || return $?
    if [ -s "$response_file" ]; then
        response_require_existing_file "$response_file" || return $?
        if "$json_parser" -s '.' "$response_file" >/dev/null 2>&1; then
            printf '%s: remote %s response failed the AgentQ JSON protocol validation\n' "$program" "$response_operation" >&2
        else
            printf '%s: remote %s response failed the AgentQ JSON protocol validation: invalid JSON response\n' "$program" "$response_operation" >&2
        fi
        write_response_metadata "$response_file"
    else
        printf '%s: remote %s response failed the AgentQ JSON protocol validation\n' "$program" "$response_operation" >&2
        printf '%s: raw response was empty\n' "$program" >&2
    fi
    return 2
}

validate_wait_response() {
    response_file=$1
    response_status=$2
    response_expected_task_id=${3:-}

    if validate_json_response "$response_file" wait '' "$response_expected_task_id"; then
        :
    else
        response_validation_status=$?
        return "$response_validation_status"
    fi

    case "$response_status" in
        0)
            wait_semantic_filter='.[0].task.status.Done.result == "Success"'
            ;;
        1)
            wait_semantic_filter="$response_numeric_helpers"' ((.[0].task | type) == "object") and ((.[0].task.status | type) == "object") and ((.[0].task.status.Done | type) == "object") and (.[0].task.status.Done | has("result")) and (.[0].task.status.Done.result | valid_done_result) and (.[0].task.status.Done.result != "Success")'
            ;;
        5)
            wait_semantic_filter="$response_numeric_helpers"' .[0].state == "removed" and (.[0].task_id | nonnegative_integer)'
            ;;
        6)
            wait_semantic_filter="$response_numeric_helpers"' .[0].state == "unavailable" and (.[0].task_id | nonnegative_integer)'
            ;;
        *)
            return 0
            ;;
    esac

    response_require_existing_file "$response_file" || return $?
    if "$json_parser" -e -s "$wait_semantic_filter" "$response_file" >/dev/null; then
        return 0
    fi

    printf '%s: remote wait response failed the AgentQ exit/result contract for exit %s\n' \
        "$program" "$response_status" >&2
    response_require_existing_file "$response_file" || return $?
    if [ -s "$response_file" ]; then
        write_response_metadata "$response_file"
    else
        printf '%s: raw response was empty\n' "$program" >&2
    fi
    return 2
}

quote_remote() {
    printf "'"
    printf '%s' "$1" | sed "s/'/'\\\\''/g"
    printf "'"
}

append_arg() {
    case "$remote_platform" in
        windows)
            [ -n "$remote_argument_file" ] || fail 'internal error: Windows argument stream is unavailable'
            windows_argument_require_file "$remote_argument_file" || return $?
            windows_argument_verify_identity "$remote_argument_file" "$remote_argument_file_identity" 'before append' || return $?
            printf '%s\0' "$1" >> "$remote_argument_file"
            windows_argument_verify_identity "$remote_argument_file" "$remote_argument_file_identity" 'after append' || return $?
            ;;
        unix)
            remote_command="$remote_command $(quote_remote "$1")"
            ;;
        *)
            fail "internal error: unsupported remote platform: $remote_platform"
            ;;
    esac
}

is_task_id() {
    case "$1" in
        ''|*[!0-9]*) return 1 ;;
        *) return 0 ;;
    esac
}

is_positive_integer_or_all() {
    case "$1" in
        all) return 0 ;;
        ''|*[!0-9]*|0) return 1 ;;
        *) return 0 ;;
    esac
}

is_positive_integer() {
    case "$1" in
        ''|*[!0-9]*|0) return 1 ;;
        *) return 0 ;;
    esac
}

is_request_id() {
    case "$1" in
        ''|*[!A-Za-z0-9._-]*|[!A-Za-z0-9]*) return 1 ;;
    esac

    [ "${#1}" -ge 16 ] && [ "${#1}" -le 128 ]
}

generate_request_id() {
    if command -v uuidgen >/dev/null 2>&1; then
        generated=$(uuidgen | tr '[:upper:]' '[:lower:]')
        printf 'aq-%s\n' "$generated"
        return
    fi

    if command -v openssl >/dev/null 2>&1; then
        generated=$(openssl rand -hex 16)
        printf 'aq-%s\n' "$generated"
        return
    fi

    fail 'uuidgen or openssl is required to create a durable AgentQ request id'
}

ssh_transport_error() {
    ssh_log_file=$1

    if ! agentq_ssh_log_file_is_safe "$ssh_log_file"; then
        printf '%s: refusing to inspect an unsafe SSH diagnostic temporary file: %s\n' "$program" "$ssh_log_file" >&2
        return 1
    fi
    [ -s "$ssh_log_file" ] || return 1
    agentq_ssh_log_require_existing_file "$ssh_log_file" || return $?
    LC_ALL=C tr -d '\r' < "$ssh_log_file" | LC_ALL=C grep -E -q \
        '^(ssh: connect to host [^[:space:]]+ port [0-9]+: (Connection (refused|timed out|reset by peer|aborted)|Operation timed out|No route to host|Network is unreachable|Host is down)|Connection reset by [^[:space:]]+ port [0-9]+\.?|Connection timed out during banner exchange|banner exchange: Connection to [^[:space:]]+ port [0-9]+: (Connection (timed out|reset by peer)|No route to host|Network is unreachable|Host is down)|kex_exchange_identification: (read: )?(Connection (reset by peer|timed out|refused)|No route to host|Network is unreachable|Host is down)|client_loop: .* (Broken pipe|Connection reset by peer)|packet_write_wait: Connection to [^:]+: Broken pipe|Write failed: Broken pipe|Read from remote host [^:]+: Connection reset by peer|Timeout, server [^[:space:]]+ not responding\.)$'
}

platform_probe_file_is_safe() {
    platform_probe_guard_file=$1
    [ -n "$platform_probe_guard_file" ] || return 1
    platform_probe_parent=${platform_probe_guard_file%/*}
    platform_probe_name=${platform_probe_guard_file##*/}
    [ -n "$platform_probe_name" ] || return 1
    [ "$platform_probe_parent" != "$platform_probe_guard_file" ] || platform_probe_parent=.
    agentq_client_temp_path_is_safe "$platform_probe_parent" || return 1
    [ ! -L "$platform_probe_guard_file" ] || return 1
    if [ -e "$platform_probe_guard_file" ] && [ ! -f "$platform_probe_guard_file" ]; then
        return 1
    fi
    return 0
}

platform_probe_require_file() {
    if platform_probe_file_is_safe "$1"; then
        return 0
    fi
    printf '%s: unsafe platform probe temporary file: %s\n' "$program" "$1" >&2
    return 2
}

platform_probe_require_existing_file() {
    if platform_probe_file_is_safe "$1" && [ -f "$1" ]; then
        return 0
    fi
    printf '%s: unsafe platform probe temporary file: %s\n' "$program" "$1" >&2
    return 2
}

platform_probe_file_identity() {
    platform_probe_identity_path=$1
    platform_probe_identity=''

    if platform_probe_identity=$(stat_device_inode "$platform_probe_identity_path"); then
        :
    else
        return 1
    fi
    case "$platform_probe_identity" in
        ''|*[!0-9:]*|*:*:*) return 1 ;;
    esac
    printf '%s\n' "$platform_probe_identity"
}

platform_probe_verify_identity() {
    platform_probe_verify_path=$1
    platform_probe_verify_expected_identity=$2
    platform_probe_verify_phase=$3

    if [ -z "$platform_probe_verify_expected_identity" ]; then
        printf '%s: refusing to use platform probe temporary without a recorded identity: %s\n' \
            "$program" "$platform_probe_verify_path" >&2
        return 2
    fi
    platform_probe_verify_observed_identity=$(platform_probe_file_identity "$platform_probe_verify_path") || {
        printf '%s: refusing to use platform probe temporary with an unreadable identity: %s\n' \
            "$program" "$platform_probe_verify_path" >&2
        return 1
    }
    if [ "$platform_probe_verify_observed_identity" != "$platform_probe_verify_expected_identity" ]; then
        printf '%s: platform probe temporary identity changed %s; preserving it: %s\n' \
            "$program" "$platform_probe_verify_phase" "$platform_probe_verify_path" >&2
        return 1
    fi
    return 0
}

platform_probe_remove_file() {
    platform_probe_remove_path=$1
    platform_probe_remove_expected_identity=${2:-}
    if platform_probe_file_is_safe "$platform_probe_remove_path"; then
        if [ -e "$platform_probe_remove_path" ] || [ -L "$platform_probe_remove_path" ]; then
            if [ -z "$platform_probe_remove_expected_identity" ]; then
                printf '%s: refusing to remove platform probe temporary without a recorded identity: %s\n' \
                    "$program" "$platform_probe_remove_path" >&2
                return 2
            fi
            platform_probe_remove_observed_identity=$(platform_probe_file_identity "$platform_probe_remove_path") || {
                printf '%s: refusing to remove platform probe temporary with an unreadable identity: %s\n' \
                    "$program" "$platform_probe_remove_path" >&2
                return 1
            }
            if [ "$platform_probe_remove_observed_identity" != "$platform_probe_remove_expected_identity" ]; then
                printf '%s: platform probe temporary identity changed during cleanup; preserving it: %s\n' \
                    "$program" "$platform_probe_remove_path" >&2
                return 1
            fi
        fi
        if ! rm -f -- "$platform_probe_remove_path"; then
            printf '%s: failed to remove platform probe temporary file: %s\n' "$program" "$1" >&2
            return 1
        fi
        if [ -e "$platform_probe_remove_path" ] || [ -L "$platform_probe_remove_path" ]; then
            printf '%s: platform probe temporary file remained after cleanup: %s\n' "$program" "$platform_probe_remove_path" >&2
            return 1
        fi
        return 0
    fi
    printf '%s: refusing to remove an unsafe platform probe temporary file: %s\n' "$program" "$1" >&2
    return 2
}

windows_encoding_file_is_safe() {
    windows_encoding_guard_file=$1
    [ -n "$windows_encoding_guard_file" ] || return 1
    windows_encoding_parent=${windows_encoding_guard_file%/*}
    windows_encoding_name=${windows_encoding_guard_file##*/}
    [ -n "$windows_encoding_name" ] || return 1
    [ "$windows_encoding_parent" != "$windows_encoding_guard_file" ] || windows_encoding_parent=.
    agentq_client_temp_path_is_safe "$windows_encoding_parent" || return 1
    [ ! -L "$windows_encoding_guard_file" ] || return 1
    if [ -e "$windows_encoding_guard_file" ] && [ ! -f "$windows_encoding_guard_file" ]; then
        return 1
    fi
    return 0
}

windows_encoding_require_file() {
    if windows_encoding_file_is_safe "$1"; then
        return 0
    fi
    printf '%s: unsafe Windows PowerShell encoding temporary file: %s\n' "$program" "$1" >&2
    return 2
}

windows_encoding_require_existing_file() {
    if windows_encoding_file_is_safe "$1" && [ -f "$1" ]; then
        return 0
    fi
    printf '%s: unsafe Windows PowerShell encoding temporary file: %s\n' "$program" "$1" >&2
    return 2
}

windows_encoding_file_identity() {
    windows_encoding_identity_path=$1
    windows_encoding_identity=''

    if windows_encoding_identity=$(stat_device_inode "$windows_encoding_identity_path"); then
        :
    else
        return 1
    fi
    case "$windows_encoding_identity" in
        ''|*[!0-9:]*|*:*:*) return 1 ;;
    esac
    printf '%s\n' "$windows_encoding_identity"
}

windows_encoding_verify_identity() {
    windows_encoding_verify_path=$1
    windows_encoding_verify_expected_identity=$2
    windows_encoding_verify_phase=$3

    if [ -z "$windows_encoding_verify_expected_identity" ]; then
        printf '%s: refusing to use Windows PowerShell encoding temporary without a recorded identity: %s\n' \
            "$program" "$windows_encoding_verify_path" >&2
        return 2
    fi
    windows_encoding_verify_observed_identity=$(windows_encoding_file_identity "$windows_encoding_verify_path") || {
        printf '%s: refusing to use Windows PowerShell encoding temporary with an unreadable identity: %s\n' \
            "$program" "$windows_encoding_verify_path" >&2
        return 1
    }
    if [ "$windows_encoding_verify_observed_identity" != "$windows_encoding_verify_expected_identity" ]; then
        printf '%s: Windows PowerShell encoding temporary identity changed %s; preserving it: %s\n' \
            "$program" "$windows_encoding_verify_phase" "$windows_encoding_verify_path" >&2
        return 1
    fi
    return 0
}

windows_encoding_remove_file() {
    windows_encoding_remove_path=$1
    windows_encoding_remove_expected_identity=${2:-}
    if windows_encoding_file_is_safe "$windows_encoding_remove_path"; then
        if [ -e "$windows_encoding_remove_path" ] || [ -L "$windows_encoding_remove_path" ]; then
            if [ -z "$windows_encoding_remove_expected_identity" ]; then
                printf '%s: refusing to remove Windows PowerShell encoding temporary without a recorded identity: %s\n' \
                    "$program" "$windows_encoding_remove_path" >&2
                return 2
            fi
            windows_encoding_remove_observed_identity=$(windows_encoding_file_identity "$windows_encoding_remove_path") || {
                printf '%s: refusing to remove Windows PowerShell encoding temporary with an unreadable identity: %s\n' \
                    "$program" "$windows_encoding_remove_path" >&2
                return 1
            }
            if [ "$windows_encoding_remove_observed_identity" != "$windows_encoding_remove_expected_identity" ]; then
                printf '%s: Windows PowerShell encoding temporary identity changed during cleanup; preserving it: %s\n' \
                    "$program" "$windows_encoding_remove_path" >&2
                return 1
            fi
        fi
        if ! rm -f -- "$windows_encoding_remove_path"; then
            printf '%s: failed to remove Windows PowerShell encoding temporary file: %s\n' "$program" "$windows_encoding_remove_path" >&2
            return 1
        fi
        if [ -e "$windows_encoding_remove_path" ] || [ -L "$windows_encoding_remove_path" ]; then
            printf '%s: Windows PowerShell encoding temporary file remained after cleanup: %s\n' "$program" "$windows_encoding_remove_path" >&2
            return 1
        fi
        return 0
    fi
    printf '%s: refusing to remove an unsafe Windows PowerShell encoding temporary file: %s\n' "$program" "$windows_encoding_remove_path" >&2
    return 2
}

run_platform_probe() {
    platform_probe_command=$1
    # Optional: a file whose contents are fed to the remote command on stdin.
    # Windows probes use this so the script body never enters the remote
    # command LINE, which Windows truncates (see PLAN.md A5a).
    platform_probe_stdin_file=${2:-}
    # The identity is NOT reset when a stdin file is supplied: it was recorded by
    # make_windows_probe_script_file, and clearing it here would make the
    # identity check below reject the client's own probe temporary ("without a
    # recorded identity").  Only the no-stdin case (a plain `uname -s` probe)
    # resets the globals, because then there is nothing to consume.
    if [ -z "$platform_probe_stdin_file" ]; then
        platform_probe_stdin_identity=''
    fi
    resolve_agentq_temp_directory || return $?
    command -v stat >/dev/null 2>&1 || {
        printf '%s: stat is required to protect platform probe temporary identity\n' "$program" >&2
        return 2
    }
    platform_probe_output_file=$(mktemp "$agentq_temp_directory/agentq-platform-output.XXXXXX") || return 2
    platform_probe_output_identity=$(platform_probe_file_identity "$platform_probe_output_file") || {
        printf '%s: cannot record platform probe output temporary identity\n' "$program" >&2
        platform_probe_status=2
        if platform_probe_remove_file "$platform_probe_output_file" ''; then
            platform_probe_output_cleanup_status=0
        else
            platform_probe_output_cleanup_status=$?
            if [ "$platform_probe_status" -eq 0 ]; then
                platform_probe_status=$platform_probe_output_cleanup_status
            fi
        fi
        return "$platform_probe_status"
    }
    if platform_probe_require_file "$platform_probe_output_file"; then
        :
    else
        platform_probe_status=$?
        if platform_probe_remove_file "$platform_probe_output_file" "$platform_probe_output_identity"; then
            platform_probe_output_cleanup_status=0
        else
            platform_probe_output_cleanup_status=$?
            if [ "$platform_probe_status" -eq 0 ]; then
                platform_probe_status=$platform_probe_output_cleanup_status
            fi
        fi
        return "$platform_probe_status"
    fi
    platform_probe_log_file=$(mktemp "$agentq_temp_directory/agentq-platform-log.XXXXXX") || {
        platform_probe_status=2
        if platform_probe_remove_file "$platform_probe_output_file" "$platform_probe_output_identity"; then
            platform_probe_output_cleanup_status=0
        else
            platform_probe_output_cleanup_status=$?
            if [ "$platform_probe_status" -eq 0 ]; then
                platform_probe_status=$platform_probe_output_cleanup_status
            fi
        fi
        return "$platform_probe_status"
    }
    platform_probe_log_identity=$(platform_probe_file_identity "$platform_probe_log_file") || {
        printf '%s: cannot record platform probe log temporary identity\n' "$program" >&2
        platform_probe_status=2
        if platform_probe_remove_file "$platform_probe_output_file" "$platform_probe_output_identity"; then
            platform_probe_output_cleanup_status=0
        else
            platform_probe_output_cleanup_status=$?
            if [ "$platform_probe_status" -eq 0 ]; then
                platform_probe_status=$platform_probe_output_cleanup_status
            fi
        fi
        if platform_probe_remove_file "$platform_probe_log_file" ''; then
            platform_probe_log_cleanup_status=0
        else
            platform_probe_log_cleanup_status=$?
            if [ "$platform_probe_status" -eq 0 ]; then
                platform_probe_status=$platform_probe_log_cleanup_status
            fi
        fi
        return "$platform_probe_status"
    }
    if platform_probe_require_file "$platform_probe_log_file"; then
        :
    else
        platform_probe_status=$?
        if platform_probe_remove_file "$platform_probe_output_file" "$platform_probe_output_identity"; then
            platform_probe_output_cleanup_status=0
        else
            platform_probe_output_cleanup_status=$?
            if [ "$platform_probe_status" -eq 0 ]; then
                platform_probe_status=$platform_probe_output_cleanup_status
            fi
        fi
        if platform_probe_remove_file "$platform_probe_log_file" "$platform_probe_log_identity"; then
            platform_probe_log_cleanup_status=0
        else
            platform_probe_log_cleanup_status=$?
            if [ "$platform_probe_status" -eq 0 ]; then
                platform_probe_status=$platform_probe_log_cleanup_status
            fi
        fi
        return "$platform_probe_status"
    fi
    if platform_probe_verify_identity "$platform_probe_output_file" "$platform_probe_output_identity" 'before probe' &&
        platform_probe_verify_identity "$platform_probe_log_file" "$platform_probe_log_identity" 'before probe'; then
        :
    else
        platform_probe_status=$?
        if platform_probe_remove_file "$platform_probe_output_file" "$platform_probe_output_identity"; then
            platform_probe_output_cleanup_status=0
        else
            platform_probe_output_cleanup_status=$?
            if [ "$platform_probe_status" -eq 0 ]; then
                platform_probe_status=$platform_probe_output_cleanup_status
            fi
        fi
        if platform_probe_remove_file "$platform_probe_log_file" "$platform_probe_log_identity"; then
            platform_probe_log_cleanup_status=0
        else
            platform_probe_log_cleanup_status=$?
            if [ "$platform_probe_status" -eq 0 ]; then
                platform_probe_status=$platform_probe_log_cleanup_status
            fi
        fi
        return "$platform_probe_status"
    fi

    if platform_probe_require_file "$platform_probe_output_file" &&
        platform_probe_require_file "$platform_probe_log_file"; then
        :
    else
        platform_probe_status=$?
        if platform_probe_remove_file "$platform_probe_output_file" "$platform_probe_output_identity"; then
            platform_probe_output_cleanup_status=0
        else
            platform_probe_output_cleanup_status=$?
            if [ "$platform_probe_status" -eq 0 ]; then
                platform_probe_status=$platform_probe_output_cleanup_status
            fi
        fi
        if platform_probe_remove_file "$platform_probe_log_file" "$platform_probe_log_identity"; then
            platform_probe_log_cleanup_status=0
        else
            platform_probe_log_cleanup_status=$?
            if [ "$platform_probe_status" -eq 0 ]; then
                platform_probe_status=$platform_probe_log_cleanup_status
            fi
        fi
        return "$platform_probe_status"
    fi

    if [ -n "$platform_probe_stdin_file" ]; then
        if platform_probe_stdin_identity=$(windows_argument_identity_for_path "$platform_probe_stdin_file"); then
            windows_argument_verify_identity "$platform_probe_stdin_file" "$platform_probe_stdin_identity" 'before platform probe SSH consumption' || return $?
        else
            printf '%s: refusing to consume an untracked platform probe stdin temporary: %s\n' "$program" "$platform_probe_stdin_file" >&2
            return 2
        fi
        platform_probe_require_existing_file "$platform_probe_stdin_file" || return $?
    fi

    # The remote command's stderr must NOT be inherited.  OpenSSH sends it to the
    # LOCAL stderr (-E carries only ssh's own diagnostics), so without this the
    # remote could write arbitrary text -- including a forged
    # `agentq: remote failure reason: <class>` line -- straight onto the caller's
    # stderr, before the client has printed anything of its own.  The probe runs
    # before any operation dispatch, and this path does not consume the reason
    # channel at all, so discarding it loses nothing and closes the surface.
    # Every other ssh call site in this client captures and redacts through
    # run_ssh_logged; the probe is the only one that used to bypass that.
    if [ -n "$platform_probe_stdin_file" ]; then
        "$ssh_binary" \
            -E "$platform_probe_log_file" \
            -o LogLevel=ERROR \
            $ssh_credential_option_lines \
            -o ConnectTimeout=10 \
            -o ServerAliveInterval=15 \
            -o ServerAliveCountMax=12 \
            -o TCPKeepAlive=yes \
            -- "$host" "$platform_probe_command" < "$platform_probe_stdin_file" > "$platform_probe_output_file" 2>/dev/null &
    else
        "$ssh_binary" \
            -E "$platform_probe_log_file" \
            -o LogLevel=ERROR \
            $ssh_credential_option_lines \
            -o ConnectTimeout=10 \
            -o ServerAliveInterval=15 \
            -o ServerAliveCountMax=12 \
            -o TCPKeepAlive=yes \
            -- "$host" "$platform_probe_command" > "$platform_probe_output_file" 2>/dev/null &
    fi
    platform_probe_pid=$!
    platform_probe_elapsed=0
    platform_probe_timed_out=0
    while kill -0 "$platform_probe_pid" >/dev/null 2>&1; do
        if [ "$platform_probe_elapsed" -ge "$platform_probe_timeout" ]; then
            kill "$platform_probe_pid" >/dev/null 2>&1 || true
            wait "$platform_probe_pid" >/dev/null 2>&1 || true
            platform_probe_timed_out=1
            break
        fi
        sleep 1
        platform_probe_elapsed=$((platform_probe_elapsed + 1))
    done

    if [ "$platform_probe_timed_out" -eq 1 ]; then
        platform_probe_status=124
        printf '%s: remote platform/protocol probe timed out after %s seconds on %s\n' \
            "$program" "$platform_probe_timeout" "$host" >&2
    elif wait "$platform_probe_pid"; then
        platform_probe_status=0
    else
        platform_probe_status=$?
    fi

    if platform_probe_require_existing_file "$platform_probe_output_file" &&
        platform_probe_require_existing_file "$platform_probe_log_file"; then
        :
    else
        platform_probe_status=$?
        if platform_probe_remove_file "$platform_probe_output_file" "$platform_probe_output_identity"; then
            platform_probe_output_cleanup_status=0
        else
            platform_probe_output_cleanup_status=$?
            if [ "$platform_probe_status" -eq 0 ]; then
                platform_probe_status=$platform_probe_output_cleanup_status
            fi
        fi
        if platform_probe_remove_file "$platform_probe_log_file" "$platform_probe_log_identity"; then
            platform_probe_log_cleanup_status=0
        else
            platform_probe_log_cleanup_status=$?
            if [ "$platform_probe_status" -eq 0 ]; then
                platform_probe_status=$platform_probe_log_cleanup_status
            fi
        fi
        return "$platform_probe_status"
    fi
    if platform_probe_verify_identity "$platform_probe_output_file" "$platform_probe_output_identity" 'before reading' &&
        platform_probe_verify_identity "$platform_probe_log_file" "$platform_probe_log_identity" 'before reading'; then
        :
    else
        platform_probe_status=$?
        if platform_probe_remove_file "$platform_probe_output_file" "$platform_probe_output_identity"; then
            platform_probe_output_cleanup_status=0
        else
            platform_probe_output_cleanup_status=$?
            if [ "$platform_probe_status" -eq 0 ]; then
                platform_probe_status=$platform_probe_output_cleanup_status
            fi
        fi
        if platform_probe_remove_file "$platform_probe_log_file" "$platform_probe_log_identity"; then
            platform_probe_log_cleanup_status=0
        else
            platform_probe_log_cleanup_status=$?
            if [ "$platform_probe_status" -eq 0 ]; then
                platform_probe_status=$platform_probe_log_cleanup_status
            fi
        fi
        return "$platform_probe_status"
    fi

    if [ "$platform_probe_status" -eq 255 ]; then
        if platform_probe_require_existing_file "$platform_probe_log_file"; then
            if [ -s "$platform_probe_log_file" ]; then
                if ssh_transport_error "$platform_probe_log_file"; then
                    platform_probe_status=254
                fi
                write_ssh_diagnostic_metadata "$platform_probe_log_file"
            fi
        else
            platform_probe_status=$?
            platform_probe_output_cleanup_status=0
            platform_probe_log_cleanup_status=0
            platform_probe_remove_file "$platform_probe_output_file" "$platform_probe_output_identity" ||
                platform_probe_output_cleanup_status=$?
            platform_probe_remove_file "$platform_probe_log_file" "$platform_probe_log_identity" ||
                platform_probe_log_cleanup_status=$?
            return "$platform_probe_status"
        fi
    fi
    if platform_probe_require_existing_file "$platform_probe_output_file"; then
        :
    else
        platform_probe_status=$?
        platform_probe_output_cleanup_status=0
        platform_probe_log_cleanup_status=0
        if platform_probe_remove_file "$platform_probe_output_file" "$platform_probe_output_identity"; then
            :
        else
            platform_probe_output_cleanup_status=$?
        fi
        if platform_probe_remove_file "$platform_probe_log_file" "$platform_probe_log_identity"; then
            :
        else
            platform_probe_log_cleanup_status=$?
        fi
        return "$platform_probe_status"
    fi
    platform_probe_output_bytes=$(wc -c < "$platform_probe_output_file" | tr -d '[:space:]') || {
        printf '%s: cannot measure platform probe output size\n' "$program" >&2
        platform_probe_output_cleanup_status=1
        platform_probe_log_cleanup_status=0
        platform_probe_remove_file "$platform_probe_output_file" "$platform_probe_output_identity" || platform_probe_output_cleanup_status=$?
        platform_probe_remove_file "$platform_probe_log_file" "$platform_probe_log_identity" || platform_probe_log_cleanup_status=$?
        return 2
    }
    platform_probe_output_max=${platform_probe_output_limit:-65536}
    if platform_probe_require_existing_file "$platform_probe_output_file"; then
        :
    else
        platform_probe_status=$?
        platform_probe_output_cleanup_status=0
        platform_probe_log_cleanup_status=0
        if platform_probe_remove_file "$platform_probe_output_file" "$platform_probe_output_identity"; then
            :
        else
            platform_probe_output_cleanup_status=$?
        fi
        if platform_probe_remove_file "$platform_probe_log_file" "$platform_probe_log_identity"; then
            :
        else
            platform_probe_log_cleanup_status=$?
        fi
        return "$platform_probe_status"
    fi
    if [ "$platform_probe_output_bytes" -gt "$platform_probe_output_max" ]; then
        if ! dd if="$platform_probe_output_file" bs=1 count="$platform_probe_output_max" 2>/dev/null; then
            printf '%s: failed to read bounded platform probe output\n' "$program" >&2
            platform_probe_output_cleanup_status=1
        else
            printf '\n[platform probe stdout truncated after %s bytes]\n' "$platform_probe_output_max"
            platform_probe_output_cleanup_status=0
        fi
    else
        cat "$platform_probe_output_file"
        platform_probe_output_cleanup_status=0
    fi
    if platform_probe_remove_file "$platform_probe_output_file" "$platform_probe_output_identity"; then
        :
    else
        platform_probe_cleanup_status=$?
        if [ "$platform_probe_output_cleanup_status" -eq 0 ]; then
            platform_probe_output_cleanup_status=$platform_probe_cleanup_status
        fi
    fi
    if platform_probe_remove_file "$platform_probe_log_file" "$platform_probe_log_identity"; then
        platform_probe_log_cleanup_status=0
    else
        platform_probe_log_cleanup_status=$?
    fi
    if [ "$platform_probe_output_cleanup_status" -ne 0 ] ||
        [ "$platform_probe_log_cleanup_status" -ne 0 ]; then
        return 2
    fi
    platform_probe_output_file=''
    platform_probe_output_identity=''
    platform_probe_log_file=''
    platform_probe_log_identity=''
    return "$platform_probe_status"
}

run_platform_probe_with_recovery() {
    platform_probe_command=$1
    platform_probe_recovery_stdin=${2:-}
    platform_probe_attempt=0

    while :; do
        if platform_probe_output=$(run_platform_probe "$platform_probe_command" "$platform_probe_recovery_stdin"); then
            platform_probe_status=0
        else
            platform_probe_status=$?
        fi

        if [ "$platform_probe_status" -ne 254 ]; then
            printf '%s\n' "$platform_probe_output"
            return "$platform_probe_status"
        fi

        platform_probe_attempt=$((platform_probe_attempt + 1))
        if [ "$platform_probe_attempt" -gt "$operation_retry_attempts" ]; then
            printf '%s\n' "$platform_probe_output"
            printf '%s: SSH transport remained unavailable while detecting the remote platform\n' "$program" >&2
            return 255
        fi

        printf '%s: SSH transport lost while detecting the remote platform; retrying %s/%s...\n' \
            "$program" "$platform_probe_attempt" "$operation_retry_attempts" >&2
        sleep "$operation_retry_delay"
    done
}

encode_windows_powershell() {
    command -v iconv >/dev/null 2>&1 || return 127
    command -v base64 >/dev/null 2>&1 || return 127

    resolve_agentq_temp_directory || return $?
    windows_encoding_input=$(mktemp "$agentq_temp_directory/agentq-windows-powershell.XXXXXX") || return 1
    windows_encoding_input_identity=$(windows_encoding_file_identity "$windows_encoding_input") || {
        printf '%s: cannot record Windows PowerShell encoding input identity: %s\n' "$program" "$windows_encoding_input" >&2
        windows_encoding_status=1
        if windows_encoding_remove_file "$windows_encoding_input" ''; then
            windows_encoding_input_cleanup_status=0
        else
            windows_encoding_input_cleanup_status=$?
            if [ "$windows_encoding_status" -eq 0 ]; then
                windows_encoding_status=$windows_encoding_input_cleanup_status
            fi
        fi
        return "$windows_encoding_status"
    }
    if windows_encoding_require_file "$windows_encoding_input"; then
        :
    else
        windows_encoding_status=$?
        if windows_encoding_remove_file "$windows_encoding_input" "$windows_encoding_input_identity"; then
            windows_encoding_input_cleanup_status=0
        else
            windows_encoding_input_cleanup_status=$?
            if [ "$windows_encoding_status" -eq 0 ]; then
                windows_encoding_status=$windows_encoding_input_cleanup_status
            fi
        fi
        return "$windows_encoding_status"
    fi
    windows_encoding_output=$(mktemp "$agentq_temp_directory/agentq-windows-powershell-base64.XXXXXX") || {
        windows_encoding_status=1
        if windows_encoding_remove_file "$windows_encoding_input" "$windows_encoding_input_identity"; then
            windows_encoding_input_cleanup_status=0
        else
            windows_encoding_input_cleanup_status=$?
            if [ "$windows_encoding_status" -eq 0 ]; then
