windows_argument_file_identity() {
    windows_argument_identity_path=$1
    windows_argument_identity=''

    if windows_argument_identity=$(stat_device_inode "$windows_argument_identity_path"); then
        :
    else
        return 1
    fi
    case "$windows_argument_identity" in
        ''|*[!0-9:]*|*:*:*) return 1 ;;
    esac
    printf '%s\n' "$windows_argument_identity"
}

windows_argument_verify_identity() {
    windows_argument_verify_path=$1
    windows_argument_verify_expected_identity=$2
    windows_argument_verify_phase=$3

    if [ -z "$windows_argument_verify_expected_identity" ]; then
        printf '%s: refusing to use Windows argument temporary without a recorded identity: %s\n' \
            "$program" "$windows_argument_verify_path" >&2
        return 2
    fi
    windows_argument_verify_observed_identity=$(windows_argument_file_identity "$windows_argument_verify_path") || {
        printf '%s: refusing to use Windows argument temporary with an unreadable identity: %s\n' \
            "$program" "$windows_argument_verify_path" >&2
        return 1
    }
    if [ "$windows_argument_verify_observed_identity" != "$windows_argument_verify_expected_identity" ]; then
        printf '%s: Windows argument temporary identity changed %s; preserving it: %s\n' \
            "$program" "$windows_argument_verify_phase" "$windows_argument_verify_path" >&2
        return 1
    fi
    return 0
}

windows_argument_remove_file() {
    windows_argument_remove_path=$1
    windows_argument_remove_expected_identity=${2:-}
    if windows_argument_file_is_safe "$windows_argument_remove_path"; then
        if [ -e "$windows_argument_remove_path" ] || [ -L "$windows_argument_remove_path" ]; then
            if [ -z "$windows_argument_remove_expected_identity" ]; then
                printf '%s: refusing to remove Windows argument temporary without a recorded identity: %s\n' \
                    "$program" "$windows_argument_remove_path" >&2
                return 2
            fi
            windows_argument_remove_observed_identity=$(windows_argument_file_identity "$windows_argument_remove_path") || {
                printf '%s: refusing to remove Windows argument temporary with an unreadable identity: %s\n' \
                    "$program" "$windows_argument_remove_path" >&2
                return 1
            }
            if [ "$windows_argument_remove_observed_identity" != "$windows_argument_remove_expected_identity" ]; then
                printf '%s: Windows argument temporary identity changed during cleanup; preserving it: %s\n' \
                    "$program" "$windows_argument_remove_path" >&2
                return 1
            fi
        fi
        if ! rm -f -- "$windows_argument_remove_path"; then
            printf '%s: failed to remove Windows argument temporary file: %s\n' "$program" "$windows_argument_remove_path" >&2
            return 1
        fi
        if [ -e "$windows_argument_remove_path" ] || [ -L "$windows_argument_remove_path" ]; then
            printf '%s: Windows argument temporary file remained after cleanup: %s\n' "$program" "$windows_argument_remove_path" >&2
            return 1
        fi
        return 0
    fi
    printf '%s: refusing to remove an unsafe Windows argument temporary file: %s\n' "$program" "$windows_argument_remove_path" >&2
    return 2
}

agentq_client_temp_path_is_safe() {
    agentq_client_temp_guard_path=$1
    case "$agentq_client_temp_guard_path" in
        '') return 1 ;;
    esac
    case "/$agentq_client_temp_guard_path/" in
        */../*) return 1 ;;
    esac

    agentq_client_temp_probe='.'
    agentq_client_temp_remaining=$agentq_client_temp_guard_path
    case "$agentq_client_temp_remaining" in
        /*)
            agentq_client_temp_probe=/
            agentq_client_temp_remaining=${agentq_client_temp_remaining#/}
            ;;
    esac

    while [ -n "$agentq_client_temp_remaining" ]; do
        case "$agentq_client_temp_remaining" in
            */*)
                agentq_client_temp_component=${agentq_client_temp_remaining%%/*}
                agentq_client_temp_remaining=${agentq_client_temp_remaining#*/}
                ;;
            *)
                agentq_client_temp_component=$agentq_client_temp_remaining
                agentq_client_temp_remaining=''
                ;;
        esac
        [ -n "$agentq_client_temp_component" ] || continue
        [ "$agentq_client_temp_component" = . ] && continue
        if [ "$agentq_client_temp_probe" = / ]; then
            agentq_client_temp_probe=/$agentq_client_temp_component
        else
            agentq_client_temp_probe=$agentq_client_temp_probe/$agentq_client_temp_component
        fi
        [ ! -L "$agentq_client_temp_probe" ] || return 1
    done

    [ -d "$agentq_client_temp_guard_path" ] && [ ! -L "$agentq_client_temp_guard_path" ]
}

