            fi
        fi
        return "$windows_encoding_status"
    }
    windows_encoding_output_identity=$(windows_encoding_file_identity "$windows_encoding_output") || {
        printf '%s: cannot record Windows PowerShell encoding output identity: %s\n' "$program" "$windows_encoding_output" >&2
        windows_encoding_status=1
        if windows_encoding_remove_file "$windows_encoding_input" "$windows_encoding_input_identity"; then
            windows_encoding_input_cleanup_status=0
        else
            windows_encoding_input_cleanup_status=$?
            if [ "$windows_encoding_status" -eq 0 ]; then
                windows_encoding_status=$windows_encoding_input_cleanup_status
            fi
        fi
        if windows_encoding_remove_file "$windows_encoding_output" ''; then
            windows_encoding_output_cleanup_status=0
        else
            windows_encoding_output_cleanup_status=$?
            if [ "$windows_encoding_status" -eq 0 ]; then
                windows_encoding_status=$windows_encoding_output_cleanup_status
            fi
        fi
        return "$windows_encoding_status"
    }
    if windows_encoding_require_file "$windows_encoding_output"; then
        :
    else
        windows_encoding_status=$?
        if windows_encoding_remove_file "$windows_encoding_input" "$windows_encoding_input_identity"; then
            windows_encoding_input_cleanup_status=0
        else
            windows_encoding_input_cleanup_status=$?
            if [ "$windows_encoding_status" -eq 0 ]; then
                windows_encoding_status=$windows_encoding_input_cleanup_status
            fi
        fi
        if windows_encoding_remove_file "$windows_encoding_output" "$windows_encoding_output_identity"; then
            windows_encoding_output_cleanup_status=0
        else
            windows_encoding_output_cleanup_status=$?
            if [ "$windows_encoding_status" -eq 0 ]; then
                windows_encoding_status=$windows_encoding_output_cleanup_status
            fi
        fi
        return "$windows_encoding_status"
    fi

    if windows_encoding_verify_identity "$windows_encoding_input" "$windows_encoding_input_identity" 'before UTF-16LE conversion' &&
        windows_encoding_verify_identity "$windows_encoding_output" "$windows_encoding_output_identity" 'before UTF-16LE conversion'; then
        :
    else
        windows_encoding_status=$?
        if windows_encoding_remove_file "$windows_encoding_input" "$windows_encoding_input_identity"; then
