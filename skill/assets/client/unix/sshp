windows_remote_command() {
    printf '%s\n' 'powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command -'
}

run_windows_remote_command() {
    windows_diagnostic_file=$1
    windows_interactive=$2
    windows_script=$3
    windows_command=$(windows_remote_command "$windows_script")

    case "$windows_interactive" in
        true) terminal_option=-tt ;;
        false) terminal_option=-T ;;
        *) fail "internal error: invalid Windows interactive state: $windows_interactive" ;;
    esac

    windows_script_file=$(mktemp "$ssh_runtime_directory/windows-powershell.XXXXXX") || fail 'cannot create a temporary Windows PowerShell script'
    require_runtime_file "$windows_script_file"
    # shellcheck disable=SC2016
    # Trailing BLANK line, i.e. two newlines: `-Command -` reads stdin in
    # interactive mode, where a pending block runs only when a blank line
    # terminates it and is DISCARDED SILENTLY at EOF.  The Windows twin appends
    # "`n`n" for exactly this reason (sshp.ps1 Get-WindowsProbeCommand); this
    # side wrote a single terminating newline, so the last statement of every
    # probe/install script was dropped without an error.  Measured 2026-10-21
    # by comparing the two implementations.
    if ! printf '%s\n%s\n%s\n\n' \
        '$ProgressPreference = "SilentlyContinue"' \
        '$env:MSYS_NO_PATHCONV = "1"' \
        "$windows_script" > "$windows_script_file"; then
        remove_runtime_file "$windows_script_file" || true
        fail 'cannot prepare the Windows PowerShell script'
    fi
    require_runtime_file "$windows_script_file"

    if [ "$windows_interactive" = true ]; then
        # Feed the script before terminal input, then stop the feeder on disconnect.
        windows_input_pipe="$ssh_runtime_directory/windows-input"
        command -v mkfifo >/dev/null 2>&1 || {
            remove_runtime_file "$windows_script_file" || true
            fail 'mkfifo is required for interactive Windows sessions'
        }
        runtime_fifo_is_safe "$windows_input_pipe" || {
            remove_runtime_file "$windows_script_file" || true
            fail 'cannot use an unsafe Windows session input pipe'
        }
        mkfifo "$windows_input_pipe" || {
            remove_runtime_file "$windows_script_file" || true
            fail 'cannot create the Windows session input pipe'
        }
        require_runtime_file "$windows_script_file"
        require_runtime_fifo "$windows_input_pipe"
        cat "$windows_script_file" - > "$windows_input_pipe" &
        windows_input_pid=$!
        require_runtime_fifo "$windows_input_pipe"
        if run_ssh_logged "$windows_diagnostic_file" \
            "$terminal_option" \
            -o ConnectTimeout=10 \
            -o ServerAliveInterval=10 \
            -o ServerAliveCountMax=6 \
            -o TCPKeepAlive=yes \
            -- "$host" "$windows_command" < "$windows_input_pipe"; then
            windows_status=0
        else
            windows_status=$?
        fi
        kill "$windows_input_pid" 2>/dev/null || true
        wait "$windows_input_pid" 2>/dev/null || true
        windows_input_pid=''
        remove_runtime_fifo "$windows_input_pipe" || true
        remove_runtime_file "$windows_script_file" || true
    else
        require_runtime_file "$windows_script_file"
        if run_ssh_logged_bounded "$windows_diagnostic_file" \
                "$terminal_option" \
                -o ConnectTimeout=10 \
                -o ServerAliveInterval=10 \
                -o ServerAliveCountMax=6 \
                -o TCPKeepAlive=yes \
                -- "$host" "$windows_command" < "$windows_script_file"; then
            windows_status=0
        else
            windows_status=$?
        fi
        remove_runtime_file "$windows_script_file" || true
    fi
    return "$windows_status"
}

run_windows_interactive_session_with_expect() {
    windows_diagnostic_file=$1
    expect_binary=$(command -v expect 2>/dev/null || true)
    [ -n "$expect_binary" ] || return 127
    require_runtime_file "$windows_diagnostic_file"
    remove_runtime_file "$windows_diagnostic_file" || fail 'cannot prepare the Windows session diagnostic file'
    windows_transcript_file="$windows_diagnostic_file.transcript"
    require_runtime_file "$windows_transcript_file"
    remove_runtime_file "$windows_transcript_file" || fail 'cannot prepare the Windows session transcript file'
    require_runtime_file "$windows_diagnostic_file"
    require_runtime_file "$windows_transcript_file"

    # shellcheck disable=SC2016
    if SSHP_EXPECT_HOST="$host" \
        SSHP_EXPECT_COMMAND="$windows_session_command" \
        SSHP_EXPECT_SSH="$ssh_binary" \
        SSHP_EXPECT_LOG="$windows_diagnostic_file" \
        SSHP_EXPECT_TRANSCRIPT="$windows_transcript_file" \
        "$expect_binary" -c '
set timeout -1
log_user 1
log_file -noappend $env(SSHP_EXPECT_TRANSCRIPT)
spawn $env(SSHP_EXPECT_SSH) \
    -tt \
    -o ConnectTimeout=10 \
    -o ServerAliveInterval=10 \
    -o ServerAliveCountMax=6 \
    -o TCPKeepAlive=yes \
    -E $env(SSHP_EXPECT_LOG) \
    -- $env(SSHP_EXPECT_HOST) $env(SSHP_EXPECT_COMMAND)
set detached 0
set interact_status [catch {
    interact -o -re {(?:Bye from Zellij!|Connection to [^[:space:]]+ closed(?: by remote host)?\.?)} {
        # Windows Zellij can emit its detach marker, or only close the SSH session,
        # while the ConPTY stays open.
        set detached 1
        catch {exec kill -TERM [exp_pid]}
    }
} interact_error]
log_file
set wait_status [catch {wait} result]
set transcript ""
if {[file exists $env(SSHP_EXPECT_TRANSCRIPT)]} {
    set transcript_channel [open $env(SSHP_EXPECT_TRANSCRIPT) r]
    fconfigure $transcript_channel -translation binary
    set transcript [read $transcript_channel]
    close $transcript_channel
}
set transport_line_seen [regexp {Connection to [^[:space:]]+ closed(?: by remote host)?\.?} $transcript]
if {$wait_status == 0 && [llength $result] >= 4 && [lindex $result 3] == 255 && $transport_line_seen} {
    set diagnostic [open $env(SSHP_EXPECT_LOG) a]
    puts $diagnostic "Connection to $env(SSHP_EXPECT_HOST) closed by remote host."
    close $diagnostic
}
if {$wait_status != 0} {
    set diagnostic [open $env(SSHP_EXPECT_LOG) a]
    puts $diagnostic "sshp: interactive SSH transport lost; child state unavailable after interact"
    close $diagnostic
    exit 255
}
if {$detached} {
    exit 0
}
if {[llength $result] >= 5 && [lindex $result 4] eq "CHILDKILLED"} {
    set diagnostic [open $env(SSHP_EXPECT_LOG) a]
    puts $diagnostic "sshp: interactive SSH transport lost; child terminated by [lindex $result 5]"
    close $diagnostic
    exit 255
}
if {$interact_status != 0} {
    set diagnostic [open $env(SSHP_EXPECT_LOG) a]
    puts $diagnostic "sshp: interactive SSH session ended unexpectedly: $interact_error"
    close $diagnostic
    exit 255
}
exit [lindex $result 3]
'; then
        windows_status=0
    else
        windows_status=$?
    fi
    require_runtime_file "$windows_diagnostic_file"
    require_runtime_file "$windows_transcript_file"
    if [ -f "$windows_transcript_file" ]; then
        require_runtime_file "$windows_diagnostic_file"
        require_existing_runtime_file "$windows_transcript_file" || {
            transcript_read_status=$?
            remove_runtime_file "$windows_transcript_file" || true
            return "$transcript_read_status"
        }
        cat "$windows_transcript_file" >> "$windows_diagnostic_file" || printf '%s\n' "$program: failed to collect interactive SSH transcript." >&2
    fi
    remove_runtime_file "$windows_transcript_file" || true
    return "$windows_status"
}

# The Windows session command, byte-for-byte the shape sshp.ps1's
# Get-WindowsSessionCommand emits: a short `powershell.exe -EncodedCommand`
# remote command whose script runs the Zellij the PROBE resolved.  Built once,
# after --check has exited, so --check never depends on it.
build_windows_session_command() {
    if [ -z "$windows_zellij_path" ]; then
        fail 'internal error: no resolved Zellij path from the probe; refusing to start a Windows session'
    fi
    # The path is remote-supplied text that becomes a single-quoted PowerShell
    # literal.  Refuse rather than escape, like the twin: a well-formed resolved
    # path contains none of these, so a value that does is a resolver defect or a
    # hostile probe answer, and neither may reshape the command.  CR and LF are
    # already impossible here -- probe_marker_value strips CR and reads one line
    # -- so this branch is the twin's guard mirrored for defence in depth, not a
    # fourth reachable state.
    case "$windows_zellij_path" in
        *"'"*)
            fail 'the resolved Zellij path contains a quote or line break; refusing to build the session command'
            ;;
    esac
    # NOT `[[:cntrl:]]`: in the C locale that class also contains DEL (0x7F),
    # which the twin's `[\x00-\x1f]` does not -- an over-strict guard is its own
    # one-sided divergence.  The class is built with printf so the range is the
    # bytes themselves rather than an escape the local grep may or may not
    # understand (measured: macOS grep accepts this, `\x` is not portable).
    windows_path_control_class=$(printf '[\001-\037]')
    path_control_matches=$(printf '%s\n' "$windows_zellij_path" | LC_ALL=C grep -E -c "$windows_path_control_class") || path_control_matches=0
    if [ "${path_control_matches:-0}" -gt 0 ]; then
        fail 'the resolved Zellij path contains a control character; refusing to build the session command'
    fi
    # 1024, not a round number of our own choosing: it is the twin's bound, and
    # the two clients must refuse the same answer.  smoke/19 reads it out of
    # sshp.ps1 rather than restating it.  The bound is the command-line budget:
    # this value rides a base64 payload inside a command line sshd TRUNCATES past
    # the DefaultShell limit (measured 8,125 for powershell.exe).
    #
    # The UNIT is the twin's too, and `${#windows_zellij_path}` is not it.  That
    # counts BYTES under dash (the /bin/sh on Debian/Ubuntu) and under any C
    # locale, and CODE POINTS under bash with a UTF-8 locale -- one path, three
    # answers (measured 2026-10-29: a 420-unit CJK path is 1220 bytes; bash
    # accepted it, dash and LC_ALL=C refused it, the twin accepted it.  600
    # emoji are 620 code points but 1220 units, so bash ACCEPTED what the twin
    # refuses).  .NET's String.Length counts UTF-16 CODE UNITS, so this counts
    # the UTF-16LE bytes and halves them -- the same number, and the unit the
    # command line actually spends, since the payload is base64 over UTF-16LE at
    # two bytes per unit.
    #
    # NOT `iconv ... >/dev/null` as a validity probe: on macOS that fails with
    # ENOTTY ("Inappropriate ioctl for device") once the conversion output is
    # large enough, so a perfectly valid long path reads as invalid (measured
    # 2026-10-29: 340 CJK chars fine, 360 fail, ASCII of twice the byte count
    # fine -- the trigger is not simply size).  A pipe or a regular file is
    # reliable.  Validity is a round trip instead, the same idiom the payload
    # check below uses: a truncated conversion cannot round-trip, and `wc -c`
    # on a failed pipeline would otherwise count a PREFIX -- an undercount that
    # only the payload check would catch, after a raw `iconv:` line had already
    # reached the user's terminal.
    command -v iconv >/dev/null 2>&1 || fail 'cannot encode the Windows session command; iconv is required'
    command -v base64 >/dev/null 2>&1 || fail 'cannot encode the Windows session command; base64 is required'
    windows_zellij_path_roundtrip=$(printf '%s' "$windows_zellij_path" |
        iconv -f UTF-8 -t UTF-16LE 2>/dev/null |
        iconv -f UTF-16LE -t UTF-8 2>/dev/null) || windows_zellij_path_roundtrip=''
    if [ "$windows_zellij_path_roundtrip" != "$windows_zellij_path" ]; then
        fail 'the resolved Zellij path is not valid UTF-8; refusing to build the session command'
    fi
    windows_zellij_path_utf16_bytes=$(printf '%s' "$windows_zellij_path" | iconv -f UTF-8 -t UTF-16LE | wc -c) ||
        windows_zellij_path_utf16_bytes=''
    windows_zellij_path_utf16_bytes=$(printf '%s' "$windows_zellij_path_utf16_bytes" | tr -d '[:space:]')
    case "$windows_zellij_path_utf16_bytes" in
        ''|*[!0123456789]*)
            fail 'cannot measure the resolved Zellij path; refusing to build the session command'
            ;;
    esac
    if [ "$((windows_zellij_path_utf16_bytes / 2))" -gt "$windows_zellij_path_limit" ]; then
        fail "the resolved Zellij path is longer than $windows_zellij_path_limit characters; refusing to build the session command"
    fi

    # `-Command` would put single quotes on a command line that cmd.exe must
    # parse; `-EncodedCommand` keeps the whole line to the base64 alphabet, so
    # the command survives any DefaultShell.  That is the twin's reasoning and
    # the reason this is not a plain `powershell.exe -Command`.
    # LF, not CRLF, between the two lines and no trailing newline: measured
    # 2026-10-29 against `[Convert]::ToBase64String` on the same asset -- the
    # PowerShell here-string in sshp.ps1 produces exactly this byte string.
    windows_session_script=$(printf '%s\n%s' \
        "\$ErrorActionPreference = 'Stop'" \
        "& '$windows_zellij_path' attach --create '$session'") ||
        fail 'cannot build the Windows session command'
    windows_session_payload=$(printf '%s' "$windows_session_script" | iconv -f UTF-8 -t UTF-16LE | base64 | tr -d '\n') ||
        fail 'cannot encode the Windows session command'
    # An interrupted encode yields SHORTER valid base64, which PowerShell then
    # runs as a truncated script -- so verify the round trip rather than trust
    # the exit status.  This is the same reason agentq's POSIX client verifies
    # UTF-16LE identity before sending (see the 23,210-char truncation in
    # docs/PLAN.md A21); here the corruption source is the pipeline, not sshd.
    windows_session_check=$(printf '%s' "$windows_session_payload" | base64 -d 2>/dev/null | iconv -f UTF-16LE -t UTF-8 2>/dev/null) ||
        windows_session_check=''
    if [ "$windows_session_check" != "$windows_session_script" ]; then
        fail 'the encoded Windows session command did not round-trip; refusing to start a Windows session'
    fi
    windows_session_command="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -EncodedCommand $windows_session_payload"
}

run_windows_interactive_session() {
    windows_diagnostic_file=$1

    if [ -t 0 ] && [ -t 1 ] && command -v expect >/dev/null 2>&1; then
        run_windows_interactive_session_with_expect "$windows_diagnostic_file"
        return $?
    fi

    # The command travels as ssh's REMOTE command, not as a line typed into the
    # remote shell.  It used to be a FIFO-fed `exec zellij attach --create
    # '<name>'` on the assumption that the Windows SSH server starts Git Bash as
    # its default shell -- but SKILL.md records three DefaultShell values, all
    # three measured on real hosts, and sshd's own default is `cmd.exe`.  That
    # line asked those shells to run a POSIX builtin (`exec` is not a cmd.exe
    # command and not a PowerShell one), and asked PATH for `zellij` at the very
    # moment the probe had just resolved it by absolute path -- the stale
    # SSH-server PATH the probe's own comment (see prepare_remote) exists to
    # avoid.  The twin sends an encoded command instead and is not exposed to
    # either.  Measured 2026-10-29.
    if run_ssh_logged "$windows_diagnostic_file" \
            -tt \
            -o ConnectTimeout=10 \
            -o ServerAliveInterval=10 \
            -o ServerAliveCountMax=6 \
            -o TCPKeepAlive=yes \
            -- "$host" "$windows_session_command"; then
        windows_status=0
    else
        windows_status=$?
    fi
    return "$windows_status"
}

prompt_install() {
    if [ ! -t 0 ]; then
        printf '%s\n' "$program: dependency installation requires an interactive local terminal." >&2
        return 1
    fi
    printf '%s' 'sshp: install the missing remote dependency automatically now? [y/N] ' >&2
    if IFS= read -r answer; then
        :
    else
        answer=
    fi

    case "$answer" in
        y|Y|yes|YES) return 0 ;;
        *)
            printf '%s\n' 'sshp: dependency installation declined.' >&2
            return 1
            ;;
    esac
}

probe_remote_unix() {
    run_ssh_logged_bounded "$1" \
        -T \
        -o ConnectTimeout=10 \
        -o ServerAliveInterval=10 \
        -o ServerAliveCountMax=6 \
        -o TCPKeepAlive=yes \
        -- "$host" "$remote_probe_command"
}

install_remote_unix() {
    run_ssh_logged_bounded "$1" \
        -tt \
        -o ConnectTimeout=10 \
        -o ServerAliveInterval=10 \
        -o ServerAliveCountMax=6 \
        -o TCPKeepAlive=yes \
        -- "$host" "$remote_install_command"
}

probe_reports_marker() {
    # $1 = probe output, $2 = an ERE anchored at BOTH ends of a line.
    #
    # The Windows twin matches `(?m)^__SSHP_READY__:Windows$` -- the marker
    # must be a WHOLE LINE.  This side matched a glob against the entire
    # output (`*__SSHP_READY__:*`), so a banner, motd, or shell-profile line
    # that merely CONTAINED the phrase was read as a protocol answer: measured
    # 2026-10-17, `banner: __SSHP_READY__:Linux is a phrase` exited 0 with
    # "persistent remote session: ..." while sshp.ps1 refused it (exit 2).
    # A remote that answers with a diagnostic mentioning a marker must not be
    # able to steer the client; the marker is the contract, and a contract is
    # a line, not a substring.
    #
    # CR is stripped first: the twin normalises CRLF (ConvertTo-MarkerText),
    # and a PowerShell-side answer can arrive with CRLF through sshd -- with a
    # `$`-anchored pattern a trailing CR would silently break every match.
    # grep -E is already a local dependency (ssh_transport_error uses it);
    # a `while read` pipeline would run in a subshell and lose the result.
    #
    # `grep -c` and an arithmetic test, NOT `grep -q`: under `set -o pipefail`
    # a quiet grep exits at its first match, `tr` takes SIGPIPE, and a FOUND
    # marker reads as ABSENT -- a real protocol answer dropped.  `-c` must read
    # every line to count, so the writer can never be killed early; the count
    # is what makes "found" mean found.  (A here-string would also avoid the
    # pipe, but this file is #!/bin/sh and dash has none.)
    marker_matches=$(printf '%s\n' "$1" | LC_ALL=C tr -d '\r' | LC_ALL=C grep -E -c "$2") || marker_matches=0
    [ "${marker_matches:-0}" -gt 0 ]
}

probe_marker_value() {
    # $1 = probe output, $2 = the marker's literal line prefix.  Prints the
    # FIRST matching line's remainder with surrounding whitespace trimmed, or
    # nothing -- the twin's `(?m)^<prefix>(.+)$` + `.Trim()`.
    #
    # Same CR normalisation as probe_reports_marker (the twin runs
    # ConvertTo-MarkerText before matching, and a PowerShell answer can arrive
    # with CRLF through sshd).  Every stage reads to EOF on purpose: `head -n 1`
    # would exit at the first match and SIGPIPE the writer, which is exactly how
    # smoke/19 once reported a FOUND marker as absent.
    #
    # $2 is a literal prefix (no BRE metacharacters), so it is safe to
    # interpolate; the VALUE -- which may contain slashes and quotes -- only
    # ever appears in the pattern space, never in the expression.
    marker_value_all=$(printf '%s\n' "$1" | LC_ALL=C tr -d '\r' | LC_ALL=C sed -n "s/^$2//p") || marker_value_all=''
    marker_value_first=$(printf '%s\n' "$marker_value_all" |
        LC_ALL=C sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' |
        LC_ALL=C sed -n '1p') || marker_value_first=''
    printf '%s' "$marker_value_first"
}

prepare_remote() {
    allow_install=$1
    installation_attempted=0
    reconnect_attempts=0
    probe_diagnostic_file="$ssh_runtime_directory/probe.stderr"
    install_diagnostic_file="$ssh_runtime_directory/install.stderr"

    while :; do
        remote_platform=''
        remote_ready=false
        windows_probe_required=false

        if probe_output=$(probe_remote_unix "$probe_diagnostic_file"); then
            if probe_reports_marker "$probe_output" '^__SSHP_WINDOWS_SHELL__:(MINGW|MSYS|CYGWIN).*$'; then
                remote_platform=windows
                windows_probe_required=true
            elif probe_reports_marker "$probe_output" '^__SSHP_READY__:.+$'; then
                remote_platform=unix
                remote_ready=true
            fi
        else
            unix_probe_status=$?
            if [ "$unix_probe_status" -eq 255 ] && ssh_transport_error "$probe_diagnostic_file"; then
                reconnect_attempts=$((reconnect_attempts + 1))
                if [ "$check_only" = true ] && [ "$reconnect_attempts" -gt "$check_reconnect_attempts" ]; then
                    printf '%s\n' "$program: SSH transport stayed down after $check_reconnect_attempts reconnect attempts; giving up (--check does not retry forever)." >&2
                    return 255
                fi
                printf '%s\n' "$program: initial SSH transport lost; reconnecting in ${reconnect_delay}s..." >&2
                sleep "$reconnect_delay"
                continue
            fi

            if probe_reports_marker "$probe_output" '^__SSHP_WINDOWS_SHELL__:(MINGW|MSYS|CYGWIN).*$' ||
                probe_reports_marker "$probe_output" '^__SSHP_INSTALL_REQUIRED__:(MINGW|MSYS|CYGWIN).*$' ||
                probe_reports_marker "$probe_output" '^__SSHP_INSTALL_UNAVAILABLE__:(MINGW|MSYS|CYGWIN).*$'; then
                remote_platform=windows
                windows_probe_required=true
            elif probe_reports_marker "$probe_output" '^__SSHP_INSTALL_REQUIRED__:.+$'; then
                remote_platform=unix
            elif probe_reports_marker "$probe_output" '^__SSHP_INSTALL_UNAVAILABLE__:.+$'; then
                printf '%s\n' "$program: persistent remote session unavailable: install tmux, GNU screen, or Zellij manually on the remote host." >&2
                return 127
            fi
        fi

        if [ "$remote_platform" = unix ]; then
            if [ "$remote_ready" = true ]; then
                return 0
            fi
            if [ "$allow_install" != true ]; then
                printf '%s\n' "$program: persistent remote session unavailable: tmux, GNU screen, or Zellij is required." >&2
                return 127
            fi
            if [ "$installation_attempted" -eq 1 ]; then
                printf '%s\n' "$program: installation completed, but the dependency is still unavailable in a fresh SSH session." >&2
                return 127
            fi
            if ! prompt_install; then
                return 1
            fi
            if install_remote_unix "$install_diagnostic_file"; then
                install_status=0
            else
                install_status=$?
            fi
            if [ "$install_status" -eq 255 ] && ssh_transport_error "$install_diagnostic_file"; then
                printf '%s\n' "$program: installation SSH transport was lost; installation state is unknown, so it will not be retried automatically." >&2
                return 255
            fi
            [ "$install_status" -eq 0 ] || return "$install_status"
            installation_attempted=1
            continue
        fi

        # Use native PowerShell for every Windows target, including Git Bash.
        # This avoids stale SSH-server PATH values after WinGet, Scoop, or Chocolatey installs.
        if probe_output=$(run_windows_remote_command "$probe_diagnostic_file" false "$windows_probe_script"); then
            if probe_reports_marker "$probe_output" '^__SSHP_READY__:Windows$'; then
                remote_platform=windows
                windows_zellij_path=$(probe_marker_value "$probe_output" '__SSHP_ZELLIJ__:')
                return 0
            fi
            printf '%s\n' "$program: remote dependency probe returned an unexpected Windows response." >&2
            return 2
        else
            windows_probe_status=$?
            if [ "$windows_probe_status" -eq 255 ] && ssh_transport_error "$probe_diagnostic_file"; then
                reconnect_attempts=$((reconnect_attempts + 1))
                if [ "$check_only" = true ] && [ "$reconnect_attempts" -gt "$check_reconnect_attempts" ]; then
                    printf '%s\n' "$program: SSH transport stayed down after $check_reconnect_attempts reconnect attempts; giving up (--check does not retry forever)." >&2
                    return 255
                fi
                printf '%s\n' "$program: initial SSH transport lost; reconnecting in ${reconnect_delay}s..." >&2
                sleep "$reconnect_delay"
                continue
            fi
            # Marker-first, status-second -- the Windows twin's routing
            # since 0.1.16.  An sshd whose DefaultShell is powershell.exe
            # flattens a native child's exit code to 1 (A5b), so an
            # installable host answers 1+REQUIRED; the old exact-42 check
            # called that "invalid Windows install status" (exit 2) and
            # pointed at the protocol instead of the missing dependency.
            # Measured 2026-10-17: this side exited 2 while sshp.ps1 exited
            # 127 on the same answer -- the same one-side-only divergence
            # 0.1.16 set out to end.  A zero status with this marker never
            # reaches this branch (that is the success branch above, which
            # refuses an unrecognised success response), and a transport
            # failure without our marker takes the 255 branch before this.
            # The markers are line-anchored (probe_reports_marker), like the
            # twin's `(?m)^...$`: a diagnostic that merely mentions one must
            # not route the client.
            if probe_reports_marker "$probe_output" '^__SSHP_INSTALL_REQUIRED__:Windows$'; then
                remote_platform=windows
            elif probe_reports_marker "$probe_output" '^__SSHP_INSTALL_UNAVAILABLE__:Windows$'; then
                printf '%s\n' "$program: persistent remote session unavailable: native Zellij is required on Windows and no supported installer was found." >&2
                return 127
            else
                refuse_unlaunchable_ssh_binary "$windows_probe_status"
                if [ "$windows_probe_required" = true ]; then
                    printf '%s\n' "$program: remote dependency probe failed for the Windows shell." >&2
                else
                    printf '%s\n' "$program: remote dependency probe failed for both Unix and Windows shells." >&2
                fi
                return "$windows_probe_status"
            fi
        fi

        if [ "$allow_install" != true ]; then
            printf '%s\n' "$program: persistent remote session unavailable: native Zellij is required on Windows." >&2
            return 127
        fi
        if [ "$installation_attempted" -eq 1 ]; then
            printf '%s\n' "$program: installation completed, but the dependency is still unavailable in a fresh SSH session." >&2
            return 127
        fi
        if ! prompt_install; then
            return 1
        fi
        if run_windows_remote_command "$install_diagnostic_file" false "$windows_install_script"; then
            install_status=0
        else
            install_status=$?
        fi
        if [ "$install_status" -eq 255 ] && ssh_transport_error "$install_diagnostic_file"; then
            printf '%s\n' "$program: installation SSH transport was lost; installation state is unknown, so it will not be retried automatically." >&2
            return 255
        fi
        [ "$install_status" -eq 0 ] || return "$install_status"
        installation_attempted=1
    done
}

remote_command="
if command -v tmux >/dev/null 2>&1; then
    exec tmux new-session -A -s '$session'
fi
if command -v screen >/dev/null 2>&1; then
    exec screen -xRR -S '$session'
fi
if command -v zellij >/dev/null 2>&1; then
    exec zellij attach --create '$session'
fi
printf '%s\\n' 'sshp: remote host has neither tmux, GNU screen, nor Zellij.' >&2
exit 127
"

if [ "$check_only" = true ]; then
    allow_install=false
else
    allow_install=true
fi
prepare_remote "$allow_install"

if [ "$check_only" = true ]; then
    case "$remote_platform" in
        windows) printf '%s\n' 'persistent remote session: Zellij (Windows)' ;;
        unix) printf '%s\n' 'persistent remote session: tmux, GNU screen, or Zellij' ;;
        *) fail 'internal error: remote platform was not set by the dependency probe' ;;
    esac
    exit 0
fi

# Built here, after --check has exited: --check is a read-only probe and must
# not acquire a dependency on iconv/base64 or on a well-formed resolved path.
if [ "$remote_platform" = windows ]; then
    build_windows_session_command
fi

while :; do
    case "$remote_platform" in
        windows)
            session_diagnostic_file="$ssh_runtime_directory/windows-session.stderr"
            if run_windows_interactive_session "$session_diagnostic_file"; then
                session_exit=0
            else
                session_exit=$?
            fi
            ;;
        unix)
            session_diagnostic_file="$ssh_runtime_directory/unix-session.stderr"
            if run_ssh_logged "$session_diagnostic_file" \
                -tt \
                -o ConnectTimeout=10 \
                -o ServerAliveInterval=10 \
                -o ServerAliveCountMax=6 \
                -o TCPKeepAlive=yes \
                -- "$host" "$remote_command"; then
                session_exit=0
            else
                session_exit=$?
            fi
            ;;
        *)
            fail "unsupported remote platform state: $remote_platform"
            ;;
    esac

    # OpenSSH reports lost transports as 255. A normal remote exit must not
    # reopen a session that the user intentionally closed or detached from.
    [ "$session_exit" -eq 255 ] || exit "$session_exit"
    ssh_transport_error "$session_diagnostic_file" || exit "$session_exit"

    printf '%s\n' "$program: SSH transport lost; reconnecting in ${reconnect_delay}s..." >&2
    sleep "$reconnect_delay"
done
