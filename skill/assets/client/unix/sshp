#!/bin/sh

set -eu

program=${0##*/}
reconnect_delay=${SSHP_RECONNECT_DELAY:-2}
# --check is the non-interactive, read-only probe.  The interactive session path
# may reconnect forever (a human is watching and can Ctrl-C), but --check has no
# terminal and no human: a remote that accepts the TCP connection and then drops
# it would spin `while :` forever.  Cap the reconnect attempts for --check only;
# the interactive path keeps its unbounded retry.
check_reconnect_attempts=3
ssh_binary=${SSHP_SSH:-}
sshp_noninteractive_output_limit=65536
ssh_runtime_directory=''
remote_platform=''
windows_input_pid=''
# The absolute Zellij path the Windows probe reported in `__SSHP_ZELLIJ__:`.
# Set by prepare_remote on the READY branch, consumed by
# build_windows_session_command.  Empty means "the probe never told us", which
# refuses the session -- it is never a licence to fall back to a bare name.
windows_zellij_path=''
windows_session_command=''
# The twin's bound, in sshp.ps1's Get-WindowsSessionCommand.  Named here rather
# than inlined so smoke/19 can read BOTH values out of the two assets and refuse
# to pass if they ever disagree -- a restated constant is a constant that drifts.
windows_zellij_path_limit=1024
# The session name rides the SAME `powershell.exe ... -EncodedCommand` command
# line as the resolved Zellij path, so it needs a budget too -- and until
# 2026-11-05 it had none: only the charset was guarded, while the PATH next to
# it was bounded at 1024.  Measured then: a 4000-character name built a
# 10986-character command line, past the 8125 at which powershell.exe truncates,
# so the tail -- including the closing quote -- was dropped silently and the
# session started with something nobody asked for.  With both values bounded at
# 1024 the worst case stays near 5.9K.  Same value as the twin's; smoke/19 reads
# both out of the assets rather than restating them.
session_name_limit=1024

usage() {
    cat <<EOF
Usage: $program [--check] <ssh-host-or-alias> [session-name]

Attach to a persistent tmux, GNU screen, or Zellij session on an SSH host.
The default session name is ghostty.
On a missing dependency, the first connection asks before installing it.
The --check mode only probes and never installs anything.

Examples:
  $program build-host
  $program build-host work
  $program --check build-host
EOF
}

fail() {
    printf '%s\n' "$program: $1" >&2
    exit 2
}

resolve_ssh_binary() {
    if [ -n "$ssh_binary" ]; then
        # `-x` tests the SEARCH BIT, which every directory has, so a directory
        # passed this guard and the failure came back as exit 126 with the
        # remote blamed ("remote dependency probe failed for both Unix and
        # Windows shells") -- measured 2026-10-27.  `-f` follows symlinks, so a
        # symlink to a real executable still works.
        if [ -e "$ssh_binary" ] && [ ! -f "$ssh_binary" ]; then
            fail "SSHP_SSH must be a regular file: $ssh_binary"
        fi
        [ -x "$ssh_binary" ] || fail "SSHP_SSH is not executable: $ssh_binary"
        return
    fi

    ssh_binary=$(command -v ssh 2>/dev/null || true)
    [ -n "$ssh_binary" ] || fail 'OpenSSH client is required; install ssh or set SSHP_SSH'
}

# The guard above tests the SEARCH BIT: it says the file MAY be executed, not
# that it CAN be.  Measured 2026-10-30 -- three ordinary shapes pass both the
# regular-file rule and `-x` and then make the SHELL (not the tool) report 126
# ("found but cannot be executed") or 127 ("not found", which is how a missing
# interpreter comes back) on every call: a 0755 file of plain text, a script
# whose interpreter does not exist, and a script whose shebang line ends in CR
# (a file last edited on Windows).  All three used to surface here as
# "remote dependency probe failed for both Unix and Windows shells" with exit
# 126/127 -- outside the documented contract, and blaming the REMOTE host for a
# LOCAL misconfiguration.  The Windows twin refuses the same configuration with
# exit 2 and "SSHP_SSH cannot be launched" (smoke/12).
#
# POSIX has no primitive that answers "would exec(2) succeed"; the cheap
# discriminators were measured and every one of them lies.  An EXIT-trap
# sentinel runs after a failed exec under dash but not under sh, bash or zsh;
# `set -e` plus a sentinel cannot tell a launch failure from a wrapper that
# legitimately exits 255; and the shell's own exec diagnostic cannot be
# separated from the child's, because redirections apply BEFORE the exec
# attempt.  So the question is settled the only way that is a measurement
# rather than a model: run the file.  `-V` is the argument the twin probes
# with; it opens no connection.  Only the shell's own two codes count -- 0 from
# real OpenSSH, 255 from a wrapper that rejects the flag, anything else: the
# file DID run, and a file that runs is never refused here.  That last part is
# what keeps a REMOTE 126/127 (a working ssh whose remote command failed)
# reported as a remote failure.
#
# Called only from a branch that is already failing, so a working configuration
# pays nothing and no fixture's call plan shifts.  Only an explicit SSHP_SSH is
# probed: a PATH-resolved ssh is the twin's unprobed branch too.  Residual
# boundary: a wrapper that answers 126/127 to `-V` yet works for real calls is
# refused -- on a call that had already failed -- and named; real OpenSSH exits
# 0.
refuse_unlaunchable_ssh_binary() {
    case "${1:-}" in
        126|127) ;;
        *) return 0 ;;
    esac
    [ -n "${SSHP_SSH:-}" ] || return 0
    ssh_launch_probe_status=0
    "$ssh_binary" -V </dev/null >/dev/null 2>&1 || ssh_launch_probe_status=$?
    case "$ssh_launch_probe_status" in
        126|127) fail "SSHP_SSH cannot be launched: $ssh_binary" ;;
    esac
    return 0
}

is_nonnegative_integer() {
    case "$1" in
        ''|*[!0123456789]*) return 1 ;;
        *) return 0 ;;
    esac
}

is_bounded_nonnegative_integer() {
    # Same 32-bit bound the Windows twin's [int]::TryParse enforces.  The
    # charset-only check used to accept a 20-digit value and the failure only
    # surfaced later, as a bare `sleep` usage error with exit 1 -- a
    # non-contract code, disconnected from the variable that caused it (measured
    # 2026-10-17 with SSHP_RECONNECT_DELAY=2147483648).  Digits-only stays:
    # `+5` and ` 5` are still refused.
    is_nonnegative_integer "$1" || return 1
    bounded_value=${1#"${1%%[!0]*}"}
    [ -n "$bounded_value" ] || bounded_value=0
    [ "${#bounded_value}" -le 10 ] || return 1
    [ "${#bounded_value}" -lt 10 ] && return 0
    [ "$bounded_value" -le 2147483647 ]
}

runtime_path_is_safe() {
    runtime_guard_path=$1
    case "$runtime_guard_path" in
        '') return 1 ;;
    esac
    case "/$runtime_guard_path/" in
        */../*) return 1 ;;
    esac

    runtime_guard_probe='.'
    runtime_guard_remaining=$runtime_guard_path
    case "$runtime_guard_remaining" in
        /*)
            runtime_guard_probe=/
            runtime_guard_remaining=${runtime_guard_remaining#/}
            ;;
    esac

    while [ -n "$runtime_guard_remaining" ]; do
        case "$runtime_guard_remaining" in
            */*)
                runtime_guard_component=${runtime_guard_remaining%%/*}
                runtime_guard_remaining=${runtime_guard_remaining#*/}
                ;;
            *)
                runtime_guard_component=$runtime_guard_remaining
                runtime_guard_remaining=''
                ;;
        esac
        [ -n "$runtime_guard_component" ] || continue
        [ "$runtime_guard_component" = . ] && continue
        if [ "$runtime_guard_probe" = / ]; then
            runtime_guard_probe=/$runtime_guard_component
        else
            runtime_guard_probe=$runtime_guard_probe/$runtime_guard_component
        fi
        [ ! -L "$runtime_guard_probe" ] || return 1
    done

    [ -d "$runtime_guard_path" ] && [ ! -L "$runtime_guard_path" ]
}

runtime_file_is_safe() {
    runtime_file_path=$1
    runtime_file_parent=${runtime_file_path%/*}
    runtime_file_name=${runtime_file_path##*/}
    [ -n "$runtime_file_name" ] || return 1
    [ "$runtime_file_parent" != "$runtime_file_path" ] || runtime_file_parent=.
    runtime_path_is_safe "$runtime_file_parent" || return 1
    [ ! -L "$runtime_file_path" ] || return 1
    if [ -e "$runtime_file_path" ] && [ ! -f "$runtime_file_path" ]; then
        return 1
    fi
    return 0
}

require_runtime_file() {
    runtime_file_is_safe "$1" || fail "unsafe SSH runtime file: $1"
}

require_existing_runtime_file() {
    if runtime_file_is_safe "$1" && [ -f "$1" ]; then
        return 0
    fi
    printf '%s: unsafe SSH runtime file: %s\n' "$program" "$1" >&2
    return 2
}

remove_runtime_file() {
    if runtime_file_is_safe "$1"; then
        if ! rm -f -- "$1"; then
            printf '%s\n' "$program: failed to remove SSH runtime file: $1" >&2
            return 1
        fi
        if [ -e "$1" ] || [ -L "$1" ]; then
            printf '%s\n' "$program: SSH runtime file remained after cleanup: $1" >&2
            return 1
        fi
        return 0
    fi
    printf '%s\n' "$program: refusing to remove an unsafe SSH runtime file: $1" >&2
    return 2
}

runtime_fifo_is_safe() {
    runtime_fifo_path=$1
    runtime_fifo_parent=${runtime_fifo_path%/*}
    runtime_fifo_name=${runtime_fifo_path##*/}
    [ -n "$runtime_fifo_name" ] || return 1
    [ "$runtime_fifo_parent" != "$runtime_fifo_path" ] || runtime_fifo_parent=.
    runtime_path_is_safe "$runtime_fifo_parent" || return 1
    [ ! -L "$runtime_fifo_path" ] || return 1
    if [ -e "$runtime_fifo_path" ] && [ ! -p "$runtime_fifo_path" ]; then
        return 1
    fi
    return 0
}

require_runtime_fifo() {
    runtime_fifo_is_safe "$1" || fail "unsafe SSH runtime FIFO: $1"
}

remove_runtime_fifo() {
    if runtime_fifo_is_safe "$1"; then
        if ! rm -f -- "$1"; then
            printf '%s\n' "$program: failed to remove SSH runtime FIFO: $1" >&2
            return 1
        fi
        if [ -e "$1" ] || [ -L "$1" ]; then
            printf '%s\n' "$program: SSH runtime FIFO remained after cleanup: $1" >&2
            return 1
        fi
        return 0
    fi
    printf '%s\n' "$program: refusing to remove an unsafe SSH runtime FIFO: $1" >&2
    return 2
}

remove_runtime_directory() {
    runtime_remove_directory=$1

    [ -n "$runtime_remove_directory" ] || return 0
    runtime_remove_parent=${runtime_remove_directory%/*}
    runtime_remove_name=${runtime_remove_directory##*/}
    [ -n "$runtime_remove_name" ] || {
        printf '%s\n' "$program: refusing to remove an unsafe SSH runtime directory: $runtime_remove_directory" >&2
        return 2
    }
    [ "$runtime_remove_parent" != "$runtime_remove_directory" ] || runtime_remove_parent=.
    if ! runtime_path_is_safe "$runtime_remove_parent"; then
        printf '%s\n' "$program: refusing to remove an unsafe SSH runtime directory: $runtime_remove_directory" >&2
        return 2
    fi
    if [ ! -e "$runtime_remove_directory" ] && [ ! -L "$runtime_remove_directory" ]; then
        return 0
    fi
    if ! runtime_path_is_safe "$runtime_remove_directory"; then
        printf '%s\n' "$program: refusing to remove an unsafe SSH runtime directory: $runtime_remove_directory" >&2
        return 2
    fi
    if ! rm -rf -- "$runtime_remove_directory"; then
        printf '%s\n' "$program: failed to remove SSH runtime directory: $runtime_remove_directory" >&2
        return 2
    fi
    if [ -e "$runtime_remove_directory" ] || [ -L "$runtime_remove_directory" ]; then
        printf '%s\n' "$program: SSH runtime directory remained after cleanup: $runtime_remove_directory" >&2
        return 2
    fi
}

ssh_transport_error() {
    ssh_log_file=$1

    if ! runtime_file_is_safe "$ssh_log_file"; then
        printf '%s: refusing to inspect an unsafe SSH runtime file: %s\n' "$program" "$ssh_log_file" >&2
        return 1
    fi
    [ -s "$ssh_log_file" ] || return 1
    require_existing_runtime_file "$ssh_log_file" || return $?
    # No pipe into a quiet grep; see the twin (client/unix/agentq
    # ssh_transport_error).  Here an inverted verdict would decide whether a
    # dead transport is retried at all.  grep reads ssh's own `-E` file
    # directly: it is written by the local OpenSSH (LF), and a here-string is
    # not available under this file's #!/bin/sh on dash.
    transport_matches=$(LC_ALL=C tr -d '\r' < "$ssh_log_file" | LC_ALL=C grep -E -c \
        '^(ssh: connect to host [^[:space:]]+ port [0123456789]+: (Connection (refused|timed out|reset by peer|aborted)|Operation timed out|No route to host|Network is unreachable|Host is down)|Connection reset by [^[:space:]]+ port [0123456789]+\.?|Connection to [^[:space:]]+ closed by remote host\.?|Connection timed out during banner exchange|banner exchange: Connection to [^[:space:]]+ port [0123456789]+: (Connection (timed out|reset by peer)|No route to host|Network is unreachable|Host is down)|kex_exchange_identification: (read: )?(Connection (reset by peer|timed out|refused)|No route to host|Network is unreachable|Host is down)|client_loop: .* (Broken pipe|Connection reset by peer)|packet_write_wait: Connection to [^:]+: Broken pipe|Write failed: Broken pipe|Read from remote host [^:]+: Connection reset by peer|Timeout, server [^[:space:]]+ not responding\.|sshp: interactive SSH transport lost; child (terminated by [[:alnum:]_-]+|state unavailable after interact)|sshp: interactive SSH session ended unexpectedly: .*)$') || transport_matches=0
    [ "${transport_matches:-0}" -gt 0 ]
}

write_ssh_diagnostic_metadata() {
    ssh_metadata_file=$1
    require_existing_runtime_file "$ssh_metadata_file" || return $?
    require_existing_runtime_file "$ssh_metadata_file" || return $?
    ssh_metadata_bytes=$(wc -c < "$ssh_metadata_file") && ssh_metadata_bytes=$(printf '%s' "$ssh_metadata_bytes" | tr -d '[:space:]') || return 1
    case "$ssh_metadata_bytes" in
        ''|*[!0123456789]*) return 1 ;;
    esac
    if ssh_transport_error "$ssh_metadata_file"; then
        ssh_metadata_class=transport
    else
        require_existing_runtime_file "$ssh_metadata_file" || return $?
        # `grep -c` + arithmetic, not `grep -q`: a quiet grep under pipefail
        # would read a FOUND match as absent and drop the authentication hint.
        # The `tr -d '\r'` is required (see ssh_transport_error).
        auth_matches=$(LC_ALL=C tr -d '\r' < "$ssh_metadata_file" | LC_ALL=C grep -E -c \
            '^([^:]*: )?(Permission denied|Host key verification failed|Could not resolve hostname|No supported authentication methods available)') || auth_matches=0
        if [ "${auth_matches:-0}" -gt 0 ]; then
            ssh_metadata_class=authentication
        else
            ssh_metadata_class=ssh
        fi
    fi
    printf '%s: SSH diagnostic omitted for safety (class=%s, %s bytes)\n' \
        "$program" "$ssh_metadata_class" "$ssh_metadata_bytes" >&2
}

cleanup_ssh_runtime() {
    if [ -n "$windows_input_pid" ]; then
        kill "$windows_input_pid" 2>/dev/null || true
        wait "$windows_input_pid" 2>/dev/null || true
        windows_input_pid=''
    fi
    if [ -n "$ssh_runtime_directory" ] &&
        { [ -d "$ssh_runtime_directory" ] || [ -L "$ssh_runtime_directory" ]; }; then
        remove_runtime_directory "$ssh_runtime_directory" || true
    fi
}

initialize_ssh_runtime() {
    umask 077
    runtime_parent_directory=$(unset CDPATH; cd -- "${TMPDIR:-/tmp}" 2>/dev/null && pwd -P) || fail 'cannot resolve the temporary directory'
    runtime_path_is_safe "$runtime_parent_directory" || fail 'temporary directory is not a safe directory'
    ssh_runtime_directory=$(mktemp -d "$runtime_parent_directory/sshp.XXXXXX") || fail 'cannot create a private runtime directory'
    runtime_path_is_safe "$ssh_runtime_directory" || fail 'created runtime directory is not safe'
}

run_ssh_logged() {
    ssh_log_file=$1
    shift
    ssh_message_file="${ssh_log_file}.message"

    require_runtime_file "$ssh_log_file"
    require_runtime_file "$ssh_message_file"
    remove_runtime_file "$ssh_log_file" || fail 'cannot clear SSH diagnostic log'
    remove_runtime_file "$ssh_message_file" || fail 'cannot clear SSH diagnostic message'
    require_runtime_file "$ssh_log_file"
    require_runtime_file "$ssh_message_file"
    if "$ssh_binary" -E "$ssh_log_file" -o LogLevel=ERROR "$@" 2> "$ssh_message_file"; then
        ssh_status=0
    else
        ssh_status=$?
    fi

    require_runtime_file "$ssh_log_file"
    require_runtime_file "$ssh_message_file"
    if [ -s "$ssh_message_file" ]; then
        require_existing_runtime_file "$ssh_message_file" || return $?
        cat "$ssh_message_file" >> "$ssh_log_file" || printf '%s\n' "$program: failed to collect SSH diagnostics." >&2
    fi
    if [ -s "$ssh_log_file" ]; then
        write_ssh_diagnostic_metadata "$ssh_log_file"
    fi
    return "$ssh_status"
}

# Dependency probes and installers are non-interactive and should never let
# remote stdout grow an unbounded shell variable. Interactive sessions keep
# using run_ssh_logged directly so their terminal stream remains untouched.
write_bounded_noninteractive_output() {
    sshp_bounded_output_file=$1
    require_existing_runtime_file "$sshp_bounded_output_file" || return $?
    sshp_bounded_output_bytes=$(wc -c < "$sshp_bounded_output_file") || return 2
    sshp_bounded_output_bytes=$(printf '%s' "$sshp_bounded_output_bytes" | tr -d '[:space:]')
    case "$sshp_bounded_output_bytes" in
        ''|*[!0123456789]*) return 2 ;;
    esac
    require_existing_runtime_file "$sshp_bounded_output_file" || return $?
    sshp_bounded_output_max=${sshp_noninteractive_output_limit:-65536}
    case "$sshp_bounded_output_max" in
        ''|*[!0123456789]*) return 2 ;;
    esac

    if [ "$sshp_bounded_output_bytes" -gt "$sshp_bounded_output_max" ]; then
        dd if="$sshp_bounded_output_file" bs=1 count="$sshp_bounded_output_max" 2>/dev/null || return 2
        printf '\n[sshp stdout truncated after %s bytes]\n' "$sshp_bounded_output_max"
    else
        cat "$sshp_bounded_output_file"
    fi
}

run_ssh_logged_bounded() {
    sshp_bounded_log_file=$1
    shift
    sshp_bounded_output_file=$(mktemp "$ssh_runtime_directory/sshp-output.XXXXXX") || fail 'cannot create a temporary SSH output file'
    require_runtime_file "$sshp_bounded_output_file"

    if run_ssh_logged "$sshp_bounded_log_file" "$@" > "$sshp_bounded_output_file"; then
        sshp_bounded_ssh_status=0
    else
        sshp_bounded_ssh_status=$?
    fi
    require_runtime_file "$sshp_bounded_output_file"

    if write_bounded_noninteractive_output "$sshp_bounded_output_file"; then
        sshp_bounded_output_status=0
    else
        sshp_bounded_output_status=$?
    fi
    if remove_runtime_file "$sshp_bounded_output_file"; then
        sshp_bounded_cleanup_status=0
    else
        sshp_bounded_cleanup_status=$?
    fi
    sshp_bounded_output_file=''

    if [ "$sshp_bounded_ssh_status" -eq 0 ] && [ "$sshp_bounded_output_status" -ne 0 ]; then
        sshp_bounded_ssh_status=$sshp_bounded_output_status
    fi
    if [ "$sshp_bounded_ssh_status" -eq 0 ] && [ "$sshp_bounded_cleanup_status" -ne 0 ]; then
        sshp_bounded_ssh_status=2
    fi
    return "$sshp_bounded_ssh_status"
}

check_only=false
# The token is folded to lower case before matching, never the host: the
# Windows twin's `-eq` is case-INSENSITIVE by language rule, so `--CHECK`,
# `-H` and `--HELP` were accepted there and refused here (measured 2026-10-21;
# same class as AGENTQ_REMOTE_PLATFORM, and the same fix -- normalise the
# value rather than widen every pattern).  A hostname is passed through
# untouched, and folding happens only for these two flag positions.
sshp_first_token=$(printf '%s' "${1:-}" | LC_ALL=C tr '[:upper:]' '[:lower:]')
case "$sshp_first_token" in
    --check)
        check_only=true
        shift
        # Help is recognised on the first token AFTER the optional --check,
        # exactly like the Windows twin (`$arguments[0]` after the shift) and
        # like this side's own `-h extra` case below (help wins over the extra
        # token).  Without this inner case, `sshp --check --help` fell through
        # to host validation and was refused with "must not be empty or begin
        # with a hyphen" (exit 2) while `sshp.ps1 --check --help` printed
        # usage and exited 0 -- measured 2026-10-17, the same input accepted
        # by one client and rejected by the other.  smoke/19 pins both forms.
        sshp_second_token=$(printf '%s' "${1:-}" | LC_ALL=C tr '[:upper:]' '[:lower:]')
        case "$sshp_second_token" in
            -h|--help)
                usage
                exit 0
                ;;
        esac
        ;;
    -h|--help)
        usage
        exit 0
        ;;
esac

[ "$#" -ge 1 ] && [ "$#" -le 2 ] || {
    usage >&2
    exit 2
}

host=$1
session=${2:-ghostty}

case "$host" in
    ''|-*)
        fail 'SSH host must not be empty or begin with a hyphen'
        ;;
esac

# Whitespace-only matches the Windows twin's IsNullOrWhiteSpace: a name ssh
# would have to quote its way through is not a name at all.
case "$host" in
    *[[:space:]]*)
        fail 'SSH host must not contain whitespace'
        ;;
esac

# Split the way the Windows twin splits: charset first, leading hyphen second,
# each with the message that actually describes it.  The single lumped pattern
# used to report "must contain only letters, numbers, dots, underscores, or
# hyphens" for `-s` -- a name that satisfies exactly that charset -- while the
# twin said "must not begin with a hyphen" (measured 2026-10-28).  The empty
# alternative stays in the charset branch to mirror the twin's `+` quantifier;
# it is unreachable here because ${2:-ghostty} substitutes for an empty name.
# The set is spelled out instead of written `A-Za-z`: a bracket RANGE is
# collation-dependent, and under bash with a locale that has a collation order
# (macOS defaults to en_US.UTF-8) `A-Z` also contains the accented Latin
# letters.  Measured 2026-11-06: `café` passed the range form under this
# host's /bin/sh (bash 3.2) and went on to the probe, while the Windows twin
# refused it with exit 2; dash, zsh and bash under any C locale refused it.
# An explicit list is matched byte for byte in every shell and locale
# (measured: sh/bash/dash/zsh x C/en_US.UTF-8).  Do not "simplify" it back.
case "$session" in
    ''|*[!abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_.-]*)
        fail 'session name must contain only letters, numbers, dots, underscores, or hyphens'
        ;;
    -*)
        fail 'session name must not begin with a hyphen'
        ;;
esac

# The bound is the command-line budget, the same one the resolved Zellij path
# already has: the name is embedded in a `powershell.exe ... -EncodedCommand`
# command line that sshd TRUNCATES past the DefaultShell limit.  It sits AFTER
# the charset guard on purpose -- that guard has already restricted the name to
# ASCII, which is what makes `${#session}` here the same number the twin's
# `String.Length` counts (bytes, code points and UTF-16 code units coincide
# only for ASCII; with a looser charset this would need the UTF-16 conversion
# the path uses, and smoke/19 pins the path's unit for exactly that reason).
if [ "${#session}" -gt "$session_name_limit" ]; then
    fail "session name must be at most $session_name_limit characters"
fi

resolve_ssh_binary
is_bounded_nonnegative_integer "$reconnect_delay" || fail 'SSHP_RECONNECT_DELAY must be a non-negative integer'
# Bind BOTH traps BEFORE initialize_ssh_runtime creates the private runtime
# directory.  If the signal traps are set only after runtime creation, a signal
# landing in the microsecond window between the two leaves the just-made
# directory (and its -E ssh diagnostic log) unreclaimed: on dash a fatal signal
# with no handler does NOT run the EXIT trap (measured 2026-10-12:
# `dash -c 'c(){ :;}; trap c EXIT; kill -INT $$'` exits 130 with no cleanup;
# bash and ksh do clean up), so on Debian/Ubuntu, where /bin/sh is dash, the
# directory would leak.  cleanup_ssh_runtime tolerates being called before
# creation: ssh_runtime_directory and windows_input_pid are pre-set to '' at the
# top of the file, and the function no-ops on empty values.
#
# The `|| true` on the signal trap mirrors the client's own hardened form.
# `cleanup_ssh_runtime` is total today (every step is `|| true`-guarded), so a
# bare `; exit 130` would not currently mis-fire -- but relying on that accident
# means the next edit to the cleanup body could silently swallow the 130 under
# `set -e`, turning an interrupted session into "failed".  Make 130 authoritative
# here too rather than depend on the function staying total.
#
# The EXIT slot is hardened the same way (measured 2026-10-13 on bash and dash):
# if the cleanup ever stops being total, a bare trap body under `set -e` would
# replace the session's exit code with the cleanup's -- the same accident the
# signal slot refuses to depend on.
trap 'cleanup_ssh_runtime || true' EXIT
trap 'cleanup_ssh_runtime || true; exit 130' HUP INT TERM
initialize_ssh_runtime

# shellcheck disable=SC2016
remote_probe_command='
set -eu
platform=$(uname -s 2>/dev/null || printf "%s" unknown)

case "$platform" in
    MINGW*|MSYS*|CYGWIN*)
        # Let native PowerShell decide Windows dependencies and executable paths.
